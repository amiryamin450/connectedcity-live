<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!--[if lt IE 9]>
  <script src="http://html5shim.googlecode.com/svn/trunk/html5.js"></script>
  <![endif]-->

  <title><%= content_for?(:title) ? yield(:title) : "ConnectedCity" %></title>
  <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "Connectbook" %>">
  <%= stylesheet_link_tag "application", :media => "all" %>
  <%= javascript_include_tag "application" %>
  <%= csrf_meta_tags %>
  <%= yield(:head) %>
</head>
<body class="">
  <%= render 'facebook' %>
  <div class="wrapper">
    <nav>
      <div class="row-fluid" id="header">
          <div class="row-fluid">
            <div class="logo span6">
              <a href="/" title="Connectbook.tv"><%= image_tag 'logo.png', width: 524 %></a>
            </div>
            <div class="span6">
              <div class="location-chooser">
                <%= render 'location_chooser' %>
              </div>

            </div>
          </div>
        <%= render 'main_menu' %>
      </div>
    </nav>
    <div class="">
      <div id="sidebar" class="<%= @sidebar_class %>">
          <%= render 'user_sidebar' %>
        </div>
        <div id="main-content">
          <div class="row-fluid">
            <div id="breadcrumbs">
              <div class="breadcrumb">
                <%= render_crumbs(separator: "<span class='divider'><i class='icon-angle-right'></i></span>".html_safe).html_safe %>
                <%= render 'social_media' %>
              </div>
            </div>
          </div>
          <div class="container-fluid content-holder">
          <%= render 'messages' %>
          <div class="row-fluid">
            <%= yield %>
          </div>
          <div style="margin-bottom: 1.5em;"></div>
          </div>

        </div>
    </div>
  </div>

  <script type="text/javascript" src="//s7.addthis.com/js/300/addthis_widget.js#pubid=ra-560968f4cf5a990a" async="async"></script>
</body>
</html>
