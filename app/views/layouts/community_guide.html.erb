<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <!--[if lt IE 9]>
      <script src="http://html5shim.googlecode.com/svn/trunk/html5.js"></script>
      <![endif]-->

      <title><%= content_for?(:title) ? yield(:title) : "Connectbook" %></title>
      <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "Connectbook" %>">
      <%= stylesheet_link_tag "application", :media => "all" %>
      <%= javascript_include_tag "application" %>
      <%= csrf_meta_tags %>
      <%= yield(:head) %>
    </head>
    <body class="">
      <div class="wrapper">
        <nav>
          <div class="row-fluid" id="header">
            <div class="span12">
              <div class="row-fluid">
                <div class="logo span6">
                  <a href="/" title="Connectbook.tv"><img src="/assets/logo.png" alt="" width="" height=""/></a>
                </div>
                <div class="span6">
                  <div class="user-nav">
                    <%= render 'top_nav' %>
                  </div>

                  <div class="location-chooser">
                    <%= render 'location_chooser' %>               
                  </div>

                </div>

              </div>
            </div>
            <%= render 'main_menu' %>
          </div>
        </nav>
        <div class="container-fluid">

          <div class="row-fluid">

            <div class="span12">
              <div class="row-fluid">
                <div class="span5">

                  <div class="row-fluid">
                    <div class="breadcrumb span12"><%= render_crumbs %></div>
                  </div>
                  <div class="row-fluid">
                    <div class="span8 offset4">
                      <h4><%= content_for?(:page_title) ? yield(:page_title) : '' %></h4>
                    </div>
                  </div>

                  <div class="row-fluid">
                    <div class="span4">
                      <div class="">
                        <%= render 'user_sidebar' %>
                      </div>
                    </div>
                    <div class="span8">
                      <div id="map-holder">
                        <div id="map"></div>
                      </div>

                      <div id="status_updates"><%= render :partial => 'status_updates' %></div>


                    </div>
                  </div>
                </div>
                <div class="span7">
                  <div class="row-fluid">
                    <div class="span12">


                      <div class="search-block">  
                        <div class="row-fluid">
                          <%= form_tag "#{@base_path}search/#{@vertical_market.slug}", method: :get do %>
                            <div class="input-append" style="display: inline;">
                              
                              <%= text_field_tag :query, params[:query], class: 'span8' %>
                              <button class="btn" type="submit">Search!</button>                        
                            </div>     

                          <!-- <button id="btn-facet" class="btn" type="button" style="margin-left: .75em;">Filter</button>  -->
                          <% end %>
                        </div>
                        <div class="row-fluid">
                          <div class="facets" id="facet-block">
                            <h6 class="filter-title">Filters</h6>
                            <%# yield :facets %>
                          </div>
                        </div>
                      </div>



                    </div>
                  </div>
                  <div class="row-fluid">
                    <div class="span12">
                      <%= yield %>

                    </div>
                  </div>

                </div>
              </div>
            </div>
          </div>

        </div>
        <div class="push"><!--// push // --></div>
      </div>
      <%= render :partial => 'footer' %>
    </body>
    </html>