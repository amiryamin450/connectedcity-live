<div class="pad10 holder" style="padding-left: 30px;">
  <%= simple_form_for(@location, :html => { :multipart => true, class: 'form-horizontal location_business', id: 'fileupload' }) do |f| %>
    <%= f.error_notification %>
    <div class="tabbable">
      <ul class="nav nav-pills">
        <% if current_user.has_role? :admin %>
          <li class="active">
            <a href="#location" data-toggle="tab">Location</a></li>
          <li>
            <a href="#info" data-toggle="tab">Info</a>
          </li>
        <% else %>
          <li class="active">
            <a href="#info" data-toggle="tab">Info</a>
          </li>
        <% end %>
        <% unless @location.is_profile %>
          <li>
            <a href="#operating-hours" data-toggle="tab">Operating Hours</a>
          </li>
        <% end %>
        <li>
          <a href="#profile" data-toggle="tab">Profile</a>
        </li>
        <li>
          <a href="#images" data-toggle="tab">Images</a>
        </li>
        <% if is_food_and_dining(@location) %>
          <li>
            <%= link_to("Menus", location_location_menus_path(@location)) %>
          </li>
        <% else %>
          <li>
            <%#= link_to("Flyers", location_location_menus_path(@location)) %>
          </li>
        <% end %>
        <% if @managers.present? %>
        <li>
          <a href="#managers" data-toggle="tab">Managers</a>
        </li>
        <% end %>
        <% if @location.vertical_market_category_ids.include?(100) %>
          <li>
            <a href="#agents" data-toggle="tab">Real Estate Agents</a>
          </li>
        <% end %>
        <% if @location.vertical_market_category_ids.include?(324) %>
          <li> <a href="#city-hall" data-toggle="tab">City Hall</a> </li>
          <li> <a href="#city-councillors" data-toggle="tab">City Councillors</a> </li>
          <li> <a href="#park-recreation-commissioners" data-toggle="tab">Parks & Recreation Commissioners</a> </li>
        <% end %>
        <% unless @location.new_record? %>
          <li>
            <a href="#ecommerce-store" data-toggle="tab">eCommerce Store</a>
          </li>
        <% end %>
      </ul>
      <div class="tab-content">
        <% if current_user.has_role? :admin %>
          <div class="tab-pane active" id="location">
            <%= f.association :country %>
            <%= f.association :province, collection: get_collection(Province, :country, :country_id, f.object)%>
            <%= f.association :municipality,label: "Metro/Sub-Region", collection: get_collection(Municipality, :province, :province_id, f.object )%>
            <%= f.association :city, collection: get_collection(City, :province, :pruid, f.object)%>
            <%= f.association :district, collection: get_collection(District, :city, :city_id, f.object) %>
            <%= f.association :neighborhood, collection: get_collection(Neighborhood, :district, :district_id, f.object) %>
            <%= f.association :sub_neighborhood, collection: get_collection(Neighborhood, :neighborhood, :neighborhood_id, f.object) %>
            <%= f.input :vertical_market_category_ids, label: "Vertical market categories", collection: @vertical_market_categories, input_html: { multiple: true }, disabled: !current_user.has_role?(:admin) %>
          </div>
          <div class="tab-pane" id="agents">
            <%= link_to 'Create New Agent', new_location_path(broker_id: @location.id), class: 'btn'  %>
          </div>
          
          <div class="tab-pane" id="city-hall">
            <% if @location.city_halls.size > 0 %>
              <table class="table table-bordered table-striped table-hover" style="width: 98%;">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Title</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% @location.city_halls.each do |hall| %>
                    <tr>
                      <td><%= hall.name %></td>
                      <td><%= hall.vertical_market_categories[0].name %></td>
                      <td>
                        <div class="btn-group">
                          <%= link_to 'Delete', '#', method: :delete, data: {confirm: 'Are you sure?' }, class: 'btn btn-mini' %>
                          <%= link_to 'Edit', '#', class: 'btn btn-mini' %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            <% end %>
            <%= link_to 'Create New City Hall Member', new_location_path(hall_id: @location.id), class: 'btn'  %>
          </div>
          <div class="tab-pane" id="city-councillors">
            <% if @location.city_councillors.size > 0 %>
              <table class="table table-bordered table-striped table-hover" style="width: 98%;">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Title</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% @location.city_councillors.each do |item| %>
                    <tr>
                      <td><%= item.name %></td>
                      <td><%= item.vertical_market_categories[0].name %></td>
                      <td>
                        <div class="btn-group">
                          <%= link_to 'Delete', '#', method: :delete, data: {confirm: 'Are you sure?' }, class: 'btn btn-mini' %>
                          <%= link_to 'Edit', '#', class: 'btn btn-mini' %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            <% end %>
            <%= link_to 'Create New City Councillors Member', new_location_path(councillor_id: @location.id), class: 'btn'  %>
          </div>
          <div class="tab-pane" id="park-recreation-commissioners">
            <% if @location.park_recreation_commissioners.size > 0 %>
              <table class="table table-bordered table-striped table-hover" style="width: 98%;">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Title</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% @location.park_recreation_commissioners.each do |item| %>
                    <tr>
                      <td><%= item.name %></td>
                      <td><%= item.vertical_market_categories[0].name %></td>
                      <td>
                        <div class="btn-group">
                          <%= link_to 'Delete', '#', method: :delete, data: {confirm: 'Are you sure?' }, class: 'btn btn-mini' %>
                          <%= link_to 'Edit', '#', class: 'btn btn-mini' %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            <% end %>
            <%= link_to 'Create New Parks & Recreation Commissioners Member', new_location_path(commissioner_id: @location.id), class: 'btn'  %>
          </div>
          
        <% end %>
        <div class="tab-pane <%= 'active' unless current_user.has_role? :admin %>" id="info">
          <%= f.input :broker_id, as: :hidden %>
          <%= f.input :hall_id, as: :hidden %>
          <%= f.input :councillor_id, as: :hidden %>
          <%= f.input :commissioner_id, as: :hidden %>
          <%= f.input :name %>
          <%= f.input :address %>
          <%= f.input :latitude, as: :hidden %>
          <%= f.input :longitude, as: :hidden %>
          <input id="value_address" class="hidden" value="<%= @location.address %>" ></input>
          <%= f.input :address_1 %>
          <%= f.input :postal_code %>
          <%= f.association :trade_associations %>
          <%= f.input :phone %>
          <%= f.input :show_phone %>
          <%= f.input :toll_free %>
          <%= f.input :show_toll_free %>
          <%= f.input :fax %>
          <%= f.input :show_fax %>
          <div class="control-group string optional">
            <label class="string optional control-label" for="location_brand_ids">Brands</label>
            <div class="controls">
              <%= f.text_field :brand_tokens, data: {load: @location.brands} %>
            </div>
          </div>
        </div>
        <div class="tab-pane" id="operating-hours">
          <table class="table table-striped table-compact table-bordered">
            <tr>
              <th>Day</th>
              <th>Opens At</th>
              <th>Closes At</th>
              <th>Closed</th>
            </tr>
            <%= f.simple_fields_for :operating_hours do |operating_hour| %>
              <tr>
                <th>
                  <%= operating_hour.object.day.to_s.humanize %></h4>
                  <%= operating_hour.input_field :day, as: :hidden %>
                </th>
                <td><%= operating_hour.input_field :starts_at, as: :time, label: false, style: "width: auto;", default: Time.parse('0:00') %></td>
                <td><%= operating_hour.input_field :ends_at, as: :time, label: false, style: "width: auto;", default: Time.parse('0:00') %></td>
                <td><%= operating_hour.input_field :closed, label: false %></td>
              </tr>
            <% end %>
          </table>
        </div>
        <div class="tab-pane" id="profile">
          <%= f.input :content, input_html: {class: '', style: 'width: 810px; height: 350px;', placeholder: 'Enter text ...'} %>
          <%= f.input :website_url %>
          <%= f.input :email %>
          <%= f.input :logo, label: "#{@location.is_profile ? 'My photo' : 'Logo'}", as: :logo_preview %>
          <%= f.input :delete_logo, as: :boolean %>
          <%= f.input :cover_photo, as: :logo_preview %>
          <%= f.input :delete_cover_photo, as: :boolean %>
        </div>
        <div class="tab-pane" id="images">
          <%= render 'location_images', :f => f  %>
        </div>
        <% if @managers.present? %>
        <div class="tab-pane" id="managers">
          <%= render 'managers'  %>
        </div>
        <% end %>
        <% unless @location.new_record? %>
          <div class="tab-pane" id="ecommerce-store">
            <% stripe_connect_status = StripeService.new(location: @location).stripe_connect_status %>
            <% if stripe_connect_status %>
              Stripe Account is connected
              <%= link_to 'Disconnect', location_disconnect_stripe_path(@location), onclick: "return confirm('Are you sure to disconnect your account?')" %>
            <% else %>
              <%= link_to 'Stripe Connect',location_connect_stripe_path(@location), class: 'd-block' %>
            <% end %>
            <%= link_to 'Product Management', location_products_path(@location), class: 'd-block' %>
          </div>
        <% end %>
      </div>
    </div>
    <div class="form-actions">
      <%= f.button :submit, class: 'btn-primary' %>
      <%= link_to 'Back', @location, class: 'btn' %>
    </div>
  <% end %>
</div>

<script src="https://maps.googleapis.com/maps/api/js?key=<%= ENV['GOOGLE_API_MAP_KEY'] %>&libraries=places&callback=initMap&sensor=false" async defer></script>

<script type="text/javascript">
  $(document).ready(function() {

      $('#location_country_id').on('change', function(event) {
        let countryId = event.target.value
        let url = countryId ? `/business/get_provinces_by_country?country_slug=${countryId}` : `/business/get_provinces_by_country`
        $.ajax({
          url: url,
          method: "GET",
          dataType: "json",
        }).done(function( response ) {
          resetProvince();
          resetMunicipality()
          resetCity();
          resetDistrict();
          resetNeighborhood();
          resetSubNeighborhood();
          $.each(response, function(index, province) {
            $('#location_province_id').append($('<option>', {
                value: province.id,
                text: province.name
            }));
          })
        });
      })

      $('#location_province_id').on('change', function(event) {
        let provinceSlug = event.target.value
        let url = provinceSlug ? `/business/get_municipalites_by_province?province_slug=${provinceSlug}` : `/business/get_municipalites_by_province`
        $.ajax({
          url: url,
          method: "GET",
          dataType: "json",
        }).done(function( response ) {
          resetMunicipality()
          resetCity();
          resetDistrict();
          resetNeighborhood();
          resetSubNeighborhood();
          $.each(response, function(index, municipality) {
            $('#location_municipality_id').append($('<option>', {
                value: municipality.id,
                text: municipality.name
            }));
          })
        });
      })

      $('#location_municipality_id').on('change', function(event){
        let municipalitySlug = event.target.value
        let url = municipalitySlug ? `/business/get_cities_by_municipality?municipality_slug=${municipalitySlug}` : `/business/get_cities_by_municipality`
        $.ajax({
          url: url,
          method: "GET",
          dataType: "json",
        }).done(function( response ) {
          resetCity();
          resetDistrict();
          resetNeighborhood();
          resetSubNeighborhood();
          $.each(response, function(index, city) {
            $('#location_city_id').append($('<option>', {
                value: city.id,
                text: city.csdname
            }));
          })
        });
      })


      $('#location_city_id').on('change', function(event) {
        let citySlug = event.target.value
        let url = citySlug ? `/business/get_districts_by_city?city_slug=${citySlug}` : `/business/get_districts_by_city`
        if(!citySlug){
          resetDistrict();
          resetNeighborhood();
          resetSubNeighborhood();
        }
        $.ajax({
          url: url,
          method: "GET",
          dataType: "json",
        }).done(function( response ) {
          resetDistrict();
          resetNeighborhood();
          resetSubNeighborhood();
          $.each(response, function(index, district) {
            $('#location_district_id').append($('<option>', {
                value: district.id,
                text: district.name
            }));
          })
        });
      })

      $('#location_district_id').on('change', function(event) {
        let districtSlug = event.target.value
        let url = districtSlug ? `/business/get_neighborhoods_by_district?district_slug=${districtSlug}` : `/business/get_neighborhoods_by_district`
        if(!districtSlug){
          resetNeighborhood();
          resetSubNeighborhood();
        }
        $.ajax({
          url: url,
          method: "GET",
          dataType: "json",
        }).done(function( response ) {
          resetNeighborhood();
          resetSubNeighborhood();
          $.each(response, function(index, neighborhood) {
            $('#location_neighborhood_id').append($('<option>', {
                value: neighborhood.nid,
                text: neighborhood.neighborhd
            }));
          })
        });
      })
      
      $('#location_neighborhood_id').on('change', function(event) {
        let neighborhoodSlug = event.target.value
        let url = neighborhoodSlug ? `/business/get_sub_neighborhoods_by_neighborhood?neighborhood_slug=${neighborhoodSlug}` : `/business/get_sub_neighborhoods_by_neighborhood`
        if(!neighborhoodSlug){
          resetSubNeighborhood();
        }
        $.ajax({
          url: url,
          method: "GET",
          dataType: "json",
        }).done(function( response ) {
          resetSubNeighborhood();
          $.each(response, function(index, neighborhood) {
            $('#location_sub_neighborhood_id').append($('<option>', {
                value: neighborhood.id,
                text: neighborhood.neighborhd
            }));
          })
        });
      })

  })
  $(document).on("keydown",function(e){
    var keyCode = e.which || e.keyCode;
    if(keyCode == 13 && e.target.name === 'location[address]') {
      e.preventDefault();
    }
  });
  $(".control-group.status_update_latitude").css('margin-bottom', '0px');
  $(".control-group.status_update_longitude").css('margin-bottom', '0px');
  $("form.location_business").on('submit', function(e) {
    var valueSearch = $('#location_address').val().trim()
    var valueSearchResult = $("#value_address").val().trim()
    var inValidSearch = valueSearch.length === 0 || valueSearch !== valueSearchResult
    if (isBlankLatitude() || isBlankLongitude() || inValidSearch) {
      $("#location_latitude").val('')
      $("#location_longitude").val('')
      $('#location_address').val('')
    }
  })

  function initMap() {
    var options = { componentRestrictions: {country: 'ca'} }
    var autocomplete = new google.maps.places.Autocomplete(document.getElementById('location_address'), options);
    autocomplete.addListener('place_changed', function() {
      var place = autocomplete.getPlace();
      if (!place.geometry) {
        window.alert("Autocomplete's returned place contains no geometry");
        return;
      }
      var location = place.geometry.location
      $("#location_latitude").val(parseFloat(location.lat()))
      $("#location_longitude").val(parseFloat(location.lng()))
      $("#value_address").val($("#location_address").val())
    });
  }

  function isBlankLatitude() {
    return $("#location_latitude").val().trim().length === 0
  }

  function isBlankLongitude() {
    return $("#location_longitude").val().trim().length === 0
  }
  
  function resetProvince() {
    $('#location_province_id').find('option').remove();
    $('#location_province_id').append($('<option>', {
      text: ""
    }));
  }

  function resetMunicipality(){
    $('#location_municipality_id').find('option').remove();
    $('#location_municipality_id').append($('<option>', {
      text: ""
    }));
  }

  function resetCity(){
    $('#location_city_id').find('option').remove();
    $('#location_city_id').append($('<option>', {
      text: ""
    }));
  }

  function resetDistrict(){
    $('#location_district_id').find('option').remove();
    $('#location_district_id').append($('<option>', {
      text: ""
    }));
  }
  function resetNeighborhood(){
    $('#location_neighborhood_id').find('option').remove();
    $('#location_neighborhood_id').append($('<option>', {
      text: ""
    }));
  }
  function resetSubNeighborhood(){
    $('#location_sub_neighborhood_id').find('option').remove();
    $('#location_sub_neighborhood_id').append($('<option>', {
      text: ""
    }));
  }
</script>
