<div class="row-fluid media-attachment-area">
  <div class="span6">
    <%
      if @media_attachment.is_stream_video
        url = @media_attachment.videos.first&.video_url
      else
        url = "https://www.youtube.com/embed/#{@media_attachment.media_source_id}"
      end
    %>
    <iframe width='100%' height='480' src='<%= url %>' frameborder='0' allowfullscreen></iframe>
  </div>
  <div class="span6">
    <h1><%= @media_attachment.title %></h1>
    <div><%= @media_attachment.description %></div>
  </div>
</div>

<% if @other_media.size > 0 %>
  <h3>Additional Media</h3>
  <% @other_media.each_slice(6).to_a.each do |medias| %>
    <div class="row-fluid">
      <% medias.each do |media| %>
        <div class="span2">
          <div>
            <% if media.media_source_id.present? %>
              <%= link_to(image_tag("http://img.youtube.com/vi/#{media.media_source_id}/mqdefault.jpg"), [@location, media]) %>
            <% else %>
              <%= link_to(image_tag(media.thumbnail_url(:thumb)), [@location, media]) %>
            <% end %>
          </div>
          <div><%= link_to media.title, [@location, media] %></div>
        </div>
      <% end %>
    </div>
    <br>
  <% end -%>
<% end %>

<div id="subscriberContainer">
</div>

