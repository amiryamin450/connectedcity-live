<h1>Managing <%= @location.name %>'s Media </h1>
<% if @media_attachments.size > 0 %>
<table class="table table-bordered table-striped table-hover">
  <thead>
  <tr>
    <th>Title</th>
    <th>Description</th>
    <th>Thumbnail</th>
    <th></th>
  </tr>
  </thead>

  <tbody>

  <% @media_attachments.each do |media| %>
      <tr>
        <td><%= media.title %></td>
        <td><%= media.description %></td>
        <td><%= image_tag(media.thumbnail_url, style:
        "width: 120px;") %>
        <% if media.is_stream_video %>
          <label data-id="<%= media.videos.first&.id %>" class="btn btn-primary edit-thumbnail" style="margin: 0 20px;">
            <input type="file" style="display: none;" data-id="<%= media.videos.first&.id %>">
              Edit thumbnail
          </label>
        <% end %>
        </td>
        <td>
          <div class="btn-group">
            <%= link_to 'show', [@location, media], class: 'btn btn-mini' %>
            <%= link_to 'delete', [@location, media], method: :delete, data: {confirm: 'Are you sure?' }, class: 'btn btn-mini' %>
          </div>
        </td>
      </tr>
  <% end %>
  </tbody>
</table>
<%= paginate @media_attachments %>
<% else %>
<div class="alert notice">No Attachements found.</div>
<% end %>

<%= link_to 'New Media Attachment', new_location_media_attachment_path(@location), class: 'btn btn-primary' %>
<%= link_to "Back to #{@location.name}", @location, class: 'btn' %>

<script>
  document.querySelectorAll('.edit-thumbnail').forEach(item => {
    item.addEventListener('change', event => {
      var videoId = event.target.getAttribute("data-id")
      if (videoId) {
        // document.getElementById('thumbnail-loader').style.display = 'inline-block';
        var file = event.target.files[0];
        var data = new FormData();
        data.append('file', file);
        fetch(`/videos/${videoId}/upload_thumbnail.json`, {
          method: 'post',
          body: data,
        }).then(function(response) {
          if (response.ok) {
            location.reload();
            // remove spinner
            // document.getElementById('thumbnail-loader').style.display = 'none';
          }
        })
      }
    })
  })
</script>
