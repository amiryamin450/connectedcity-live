<script>
  $(document).ready(function() {
    $('#civic-news-disctrict-dropdown').on('change', function(event) {
      let districtId = event.target.value
      $.ajax({
        url: `/city_news_articles/get_neighborhoods?district_id=${districtId}`,
        method: "GET",
        dataType: "json",
      }).done(function( response ) {
        resetNeighborhood();
        resetSubNeighborhood();
        $.each(response, function(index, item) {
          $('#civic-news-neighborhoods-dropdown').append($('<option>', {
              value: item.slug,
              text: item.neighborhd
          }));
        })
      });
    })

    $('#civic-news-neighborhoods-dropdown').on('change', function(event) {
      let neighborhoodId = event.target.value
