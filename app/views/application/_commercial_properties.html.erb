<% styles.each_with_index do |style, r| %>
  <div class="category">
    <div class="heading index-<%= r %>">
      <h5><%= style.present? ? style : 'Misc.' %></h5>
      <%= link_to 'See More +', '#', class: 'see-more', data: { element: r } %>
    </div>

    <div class="location-holder" id="cat-<%= r %>">
      <div class="clearfix">
        <%= render 'commercial', style: style %>
      </div>
    </div>
  </div>
<% end %>
