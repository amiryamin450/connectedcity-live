<div class="row">
  <div class="inner-img col-md-3 col-4">
    <%= link_to (image_tag service.location.logo.url), service.location %></a>
  </div>
  <div class="col-md-9 col-8">
    <div class="row">
      <div class="inner-card-title col-md-7">
        <h5><%#= link_to(product.name, [product.location, product]) %>
          <%= link_to ("#{service.name}"), "#", class: "status-update-image" %>
        </h5>
      </div>
      <div class="inner-card-time col-md-5">
        <span><%= "#{time_ago_in_words(service.created_at)} ago" %></span>
      </div>
      <div class="inner-card-title col-md-12 inner-by">
        by <%= link_to service.location.name, service.location %>
      </div>
    </div>
    <div class="inner-card-description">
      <div class="content"> <%= sanitize(service.description) %> </div>
      <p><%= raw "<span class='price' >Price: $#{service.price}</span>" if service.price.present? %></p>
    </div>
  </div>
  <% if service.image? %>
    <div class="col-md-12">
      <div class="update-banner">
        <%= link_to (image_tag service.image.url), "#", class: "status-update-image" %>
      </div>
    </div>
  <% end %>
  <%#= render 'status_updates/modal_content_latest', status_update: status_update %>
</div>
<hr>
