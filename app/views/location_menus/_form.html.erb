
<%= simple_form_for(@location_menu, :html => { :multipart => true, class: 'form-horizontal', id: 'fileupload' }) do |f| %>
	<%= f.error_notification %>
	<%= f.fields_for :location_menu, @location_menu do |builder| %>
	    <%= f.input :image, as: :file %>
	    <%= f.button :submit, "Update Menu", class: 'btn-primary' %>
	<% end %>    
<% end %>