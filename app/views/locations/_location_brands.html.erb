<div class="category">
  <div class="heading index-5">
    <h5>Brands</h5>    
  </div>
</div>

<% if @location.brands.size > 0 %>

<%  @location.brands.in_groups_of(4) do |group| %>
<div class="row-fluid product">
  <ul class="thumbnails">
    <% group.each do |brand| %>
    <% if brand %>
    <li class="span3">
      <div class="thumbnail">
        <%= link_to(image_tag( brand.logo.url(:list)), brand) %>
        <div class="caption">
          <h6><%= link_to brand.name, brand %></h6>

        </div>
      </div>
      <% end -%>
    </li>
    <% end -%>
  </ul>
</div>

<% end -%>   


<% else %>
<div class="alert">
  No Brands found.
</div>
<% end %>