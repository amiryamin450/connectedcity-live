<h2 class="add-new-media-attachment-title"><span class='location-name'><%= link_to @location.name, location_path(@location) %></span> Video Channel</h2>
<div class="row-fluid media-attachment-area">
  <div class="span6">
    <% if @media_attachment.is_stream_video %>
      <% if @media_attachment.videos&.first&.livestream %>
        <div id="streams"></div>
      <% else %>
        <iframe width='100%' height='480' src='<%= @media_attachment.videos.first&.video_url %>' frameborder='0' allowfullscreen></iframe>
      <% end %>
    <% else %>
      <iframe width='100%' height='480' src="https://www.youtube.com/embed/#{@media_attachment.media_source_id}" frameborder='0' allowfullscreen></iframe>
    <% end %>
  </div>
  <div class="span6">
    <h1><%= @media_attachment.title %></h1>
    <% video = @media_attachment.videos&.first %>
    <% if video && video.livestream && video.status == "started" %>
      <div class="col-md-12">
        <div id="live">LIVE</div>
      </div>
    <% end %>
    <div><%= @media_attachment.description %></div>
    <div class="uploaded-date">Uploaded date: <%= @media_attachment.created_at.strftime('%m/%d/%Y') %></div>
  </div>
</div>

<% if @other_media.size > 0 %>
  <div class="additional-videos">
  <h3>Additional Videos</h3>
  <% ([@media_attachment] + @other_media).each_slice(6).to_a.each do |medias| %>
    <div class="row-fluid">
      <% medias.each do |media| %>
        <% is_current_media = media.id == @media_attachment.id %>
        <div class="span2">
          <div class="media">
            <% if is_current_media %>
              <span class="now-playing">(Now Playing)</span>
            <% end %>
            <div class="<%= 'media-img' if is_current_media %>">
              <% if media.media_source_id.present? %>
                <%= link_to(image_tag("http://img.youtube.com/vi/#{media.media_source_id}/mqdefault.jpg"), [@location, media]) %>
              <% else %>
                <%= link_to(image_tag(media.thumbnail_url(:thumb)), [@location, media]) %>
              <% end %>
            </div>
          </div>
          <div><%= link_to media.title, [@location, media] %></div>
        </div>
      <% end %>
    </div>
    <br>
  <% end -%>
  </div>
<% end %>

<div id="subscriberContainer">
</div>

<script>
  $(document).ready(function() {
    // when the modal is opened autoplay it
    var streamVideo = <%= @media_attachment.is_stream_video %>
    var isLiveStream = <%= @media_attachment.videos&.first&.livestream %>
    // stop playing the youtube video when I close the modal
    $('#<%="video-#{@media_attachment.id}-model"%>').on('hide.bs.modal', function (e) {
      if (streamVideo) {
        $("#<%="video-#{@media_attachment.id}-vonage"%>").attr('src', "");
      } else {
        $('#<%="video-#{@media_attachment.media_source_id}-#{@media_attachment.id}-player"%>').attr("src", "");
      }
    });
    var sessionId = "<%= @media_attachment.videos&.first&.session_id %>";
    if (sessionId && isLiveStream) {
      var locationSlug = "<%= @media_attachment.location.slug %>";
      var apiKey = "<%= ENV['VONAGE_API_KEY'] %>";
      var broadcastId;

      async function fetchToken() {
        var token;
        token = await fetch(`/media_attachments/get_livestream_token.json?session_id=${sessionId}`, {
          method: 'get',
          }).then(function(response) {
          if (response.ok) {
            return response.json();
          }
          return Promise.reject(response);
          }).then(function (data) {
          return data.token
        })
        return token;
      }

      fetchToken().then(token => {
        var session = OT.initSession(apiKey, sessionId);
        var publisher;
        var container = $('<div id = "publisher"></div>');
        $('#streams').append(container);
        // publisher = OT.initPublisher('publisher', {
        //   insertMode: 'append',
        //   width: '100%',
        //   height: '100%',
        //   resolution: '1280x720'
        // });

        session.connect(token, function (err) {
          if (err) {
            alert(err.message || err);
          }

          // session.publish(publisher);
        });

        session.on('streamCreated', function (event) {
          console.log(event);
          var streamId = event.stream.id;
          container = document.createElement('div');
          container.id = streamId;
          $('#streams').append(container);
          session.subscribe(event.stream, streamId, {
            insertMode: 'append',
            width: '100%',
            height: '480px'
          });
          // if (streamId === focusStreamId) {
            // focusStream(streamId);
          // }
          // positionStreams();
        });
      })
    }
  });
</script>
