<%

meta title: @employment_listing.title,
     description: "",
     canonical: url_for(Rails.application.routes.recognize_path(request.path).merge({only_path: false, protocol: 'https'}))

%>

<div class="px-3 pb-3 px-md-5 pb-md-5">
  <h2 class="my-4"> <%= @employment_listing.title %></h2>

  <h6>Cover Photo</h6>
  <%= image_tag @employment_listing.cover_photo.url, class: 'thumbnail' %>

  <h6>Description</h6>
  <p>
    <%= @employment_listing.description.html_safe %>
  </p>

  <h6>Advantages:</h6>
  <p>
    <%= @employment_listing.advantages.html_safe %>
  </p>

  <h6>Qualifications:</h6>
  <p>
    <%= @employment_listing.qualifications.html_safe %>
  </p>

  <div class="mb-3">
    <h6 class="d-inline">Job Number:</h6>
    <%= @employment_listing.number %>
  </div>

  <div class="mb-3">
    <h6 class="d-inline">Locations:</h6>
    <%= @employment_listing.locations %>
  </div>

  <div class="mb-3">
    <h6 class="d-inline">Number of Positions:</h6>
    <%= @employment_listing.number_of_positions %>
  </div>

  <div class="mb-3">
    <h6 class="d-inline">Application Deadline:</h6>
    <%= @employment_listing.application_deadline&.strftime("%b %d, %Y") %>
  </div>

  <div>
    <% if (user_signed_in? and current_user.can_manage_location? @location) %>
      <%= link_to "Edit", edit_location_employment_listing_path(@location, @employment_listing),class: 'btn btn-primary' %>
      <%= link_to "Back to Manage #{@location.name}'s Employment Listings", location_employment_listings_path(@location), class: 'btn m-4' %>
    <% end %>
  </div>
</div>
