<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!--[if lt IE 9]>
  <script src="http://html5shim.googlecode.com/svn/trunk/html5.js"></script>
  <![endif]-->
  <%= stylesheet_link_tag "application", :media => "all" %>
  <%= javascript_include_tag "application" %>
  <%= csrf_meta_tags %>
  <%= render 'application/head' %>
</head>
<body class="static">
  <div class="wrapper">
    <nav>
      <div class="row-fluid" id="header">
          <div class="row-fluid">
            <div class="logo span6">
              <a href="/" title="ConnectedCity"><%= image_tag 'logo.png', width: 524 %></a>
            </div>
            <div class="span6">
              <div class="location-chooser">
                <%= render 'application/location_chooser' %>
              </div>
            </div>
          </div>
          <%= render 'application/main_menu' %>
      </div>
    </nav>
    <div id="sidebar" class="<%= @sidebar_class %>">
      <%= render 'application/user_sidebar' %>
    </div>
    <div id="main-content">
      <div class="container-fluid content-holder">
      <div class="row-fluid">
        <%= yield %>
      </div>
      <div style="margin-bottom: 1.5em;"></div>
      </div>
    </div>
    <%= render 'application/footer' %>
  </div>
  <script type="text/javascript" src="http://s7.addthis.com/js/300/addthis_widget.js#pubid=ra-5088b5ab602f3daf"></script>
  <%= render 'application/google_analytics' %>
</body>
</html>
