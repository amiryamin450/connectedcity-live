<%= simple_form_for [@location, @real_estate_listing] do |f| %>
<%= f.error_notification %>

<div class="form-inputs">
  <%= f.input :listing_source, as: :hidden %>
  <%= f.input :regional_mls_number, label: "MLS Number" %>
  <%= f.input :regional_mls_number_visible %>
  <%= f.input :status, collection: ["For Sale", "For Rent", "Sale Pending", "Sold", "Rented"], prompt: 'Please Select' %>
  <%= f.input :title %>

  <%= f.input :property_type, collection: ["Residential", "Farm and Ranch", "Commercial", "Condominium", "Multifamily", "Recreational", "Lots and Land", "Other"], prompt: "Select Property Type" %>
  <%= f.input :description, as: :text, input_html: { class: 'input-block-level wysihtml5' } %>


  <%= f.input :list_price, as: :string, wrapper: :prepend do  %>
  <span class="add-on"><i class="icon-dollar"></i></span><%= f.input_field :list_price %>
  <% end %>

  <%= f.input :tax_amount, as: :string, wrapper: :prepend do %>
  <span class="add-on"><i class="icon-dollar"></i></span><%= f.input_field :tax_amount %>
  <% end %>

  <%= f.input :detail_view_url, as: :url, label: "Offsite Detail Page" %>

  <%= f.association :country, prompt: '-- Select Contry --' %>
  <%= f.association :province, prompt: '-- Select Province --'  %>
  <%= f.association :city, prompt: '-- Select City --'  %>

  <%= f.input :address %>
  <%= f.input :address_suite %>

  <%= f.input :postal_code %>
  <%= f.input :address_visible %>


  <%= f.input :style %>
  <%= f.input :lot_comment, as: :text, input_html: { class: 'input-block-level wysihtml5' } %>
  <%= f.input :lot_legal, as: :text, input_html: { class: 'input-block-level wysihtml5' } %>


  <%= f.input :rental_price, as: :string, wrapper: :prepend do %>
  <span class="add-on"><i class="icon-dollar"></i></span><%= f.input_field :rental_price %>
  <% end %>

  <%= f.input :rental_period, collection: ['Daily', 'Weekly', 'Monthly', 'Six Months', 'One Year', 'Two Year', 'Three Year', 'Five Year', 'Negotiable'], prompt: 'Please Select' %>

  <%= f.input :bedrooms, collection: [0,1,2,3,4,5,6], prompt: 'Please Select' %>
  <%= f.input :bedroom_comment, as: :text, input_html: { class: 'input-block-level wysihtml5' } %>

  <%= f.input :bathrooms, collection: [0,1,2,3,4], prompt: 'Please Select' %>
  <%= f.input :bathroom_comment, as: :text, input_html: { class: 'input-block-level wysihtml5' } %>
  <%= f.input :garage_stalls, collection: [0,1,2,3,4,5], prompt: 'Number of Stalls' %>
  <%= f.input :garage_style, collection: ['Detached', 'Attached', 'Barn', 'Garage', 'Guest House', '[ Not Specified ]', 'Other', 'Pool House / Cabana', 'Quonset', 'Shed', 'Workshop', 'Yard', 'Carport', 'Built-In', 'One Car', 'Two Car', 'Three Car', 'Street', 'Parking Pad'], prompt: 'Select Garage Type' %>
  <%= f.input :garage_comment, as: :text, input_html: { class: 'input-block-level wysihtml5' } %>

  <%= f.input :living_area, as: :string, hint: 'total sq footage', wrapper: :append do %>
  <%= f.input_field :living_area %><span class="add-on"><i class="icon-superscript"></i></span>
  <% end %>
  <%= f.input :year_built, as: :string, placeholder: '2013' %>



  <div class="control-group string optional real_estate_listing_list_date">
    <label class="string optional control-label" for="list_date_dtp">List date</label>
    <div class="controls">
      <div id="list_date_dtp" class="input-append">
        <input class="string optional" id="real_estate_listing_list_date" name="real_estate_listing[list_date]" size="50" type="text">
        <span class="add-on">
          <i data-time-icon="icon-time" data-date-icon="icon-calendar">
          </i>
        </span>
      </div>
    </div>
  </div>

  <%= f.input :virtual_tour_url, as: :url %>
  <%= f.input :association_fee, as: :string, wrapper: :prepend do %>
  <span class="add-on"><i class="icon-dollar"></i></span><%= f.input_field :association_fee %>
  <% end %>
  <%= f.input :association_fee_period, collection: ['Daily', 'Weekly', 'Monthly', 'Six Months', 'One Year', 'Two Year', 'Three Year', 'Five Year', 'Negotiable'], prompt: 'Please Select' %>
  <%= f.input :main_image %>
</div>

<div class="form-actions">
  <%= f.button :submit, class: 'btn btn-primary', value: 'Create Listing' %>
  <%= link_to 'Cancel', location_real_estate_listings_path(@location), class: 'btn'  %>
</div>
<% end %>
