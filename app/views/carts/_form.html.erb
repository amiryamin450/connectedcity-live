<%= form_for(cart, local: true, id: "cart_form") do |form| %>
  <% if cart.errors.any? %>
    <div id="error_explanation">
        <h2><%= pluralize(cart.errors.count, "error") %> prohibited this cart from being saved:</h2>
        <ul>
            <% cart.errors.full_messages.each do |message| %>
            <li><%= message %></li>
            <% end %>
        </ul>
    </div>
  <% end %>


  <div class="row cart-shopping-table">
    <div class="col-md-10">
      <% shops = @line_items.map { |item| item[0].location_name } %>
      <% shops.each_with_index do |item, index| %>
        <div class="shop-item">
          <div class="table cart-shopping">
            <div class="shop-name"><%= item %></div>
            <div class="table-responsive">
              <table class="table">
                <thead>
                  <tr>
                    <th scope="col">
                      <div class="pb-3 px-3">Product</div>
                    </th>
                    <th scope="col" style="padding: 0px;">
                      <div class="pb-3">Quantity</div>
                    </th>
                    <th scope="col" style="padding: 0px;">
                      <div class="pb-3">Unit price</div>
                    </th>
                    <th scope="col" style="padding: 0px;">
                      <div class="pb-3">Discount</div>
                    </th>
                    <th scope="col" style="padding: 0px;">
                      <div class="pb-3">Subtotal</div>
                    </th>

                    <th scope="col" style="padding: 0px;">
                      <div class="pb-3">Removed?</div>
                    </th>
                  </tr>
                </thead>
                <tbody>

                  <% @line_items[index].each do |line_item| %>
                    <% product = line_item.product %>
                    <% location = product.location %>
                    <tr>
                      <td class="align-middle py-0">
                        <div class="cart-table-img-row">
                          <div class="cart-table-img">
                            <% if line_item.product.image.present? %>
                              <%= image_tag line_item.product.image.url(:list), alt: line_item.product.name %>
                            <% end %>
                          </div>
                          <div class="ml-3 d-inline-block align-middle">
                            <h5 class="mb-0">
                              <a href="<%= location_product_path(location, product)%>" class="text-dark d-inline-block" ><%= line_item.product.name %></a>
                            </h5>
                          </div>
                        </div>
                      </td>
                      <td class="align-middle" style="padding: 0px;">
                        <div class="quanitity-counter d-flex" style="justify-content: center;">
                          <input type='button' value='-' class='qtyminus' />
                          <div class="mx-2" style="width: 20px;"><%= line_item.quantity %></div>
                          <input type='button' value='+' class='qtyplus' />
                        </div>
                      </td>
                      <td class="align-middle" style="padding: 0px;"><%= number_to_currency(product.price, unit: '$') %></td>
                      <td class="align-middle" style="padding: 0px;"><%= number_to_currency(product.discount, unit: '$') %></td>
                      <td class="align-middle" style="padding: 0px;"><%= number_to_currency(line_item.total_price, unit: '$') %></td>
                      <td class="align-middle" style="padding: 0px;">
                        <a href="<%= line_item_path(line_item)%>" method= "delete" class="text-dark" style="padding: 15px;"><i class="far fa-trash-alt" style="font-size: 25px"></i></a>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
            <button type="submit" id="submit" class="btn btn-primary checkout-only">Checkout for only this shop ></button>
          </div>
        </div>
      <% end %>
    </div>
    <div class="col-md-2 tax-container" style="padding: 0px">
      <div class="tax-view">
        <div class="row" style="margin: 0px">
          <div class="col-md-8" style="padding-right: 0px">
            <div class="title-tax">Sub-Total:</div>
            <div class="title-tax">Tax 1:</div>
            <div class="title-tax">Tax 2:</div>
            <div class="line"></div>
            <div class="title-tax">Total:</div>
          </div>
          <div class="col-md-4" style="padding-left: 0px">
            <% total = 100.00 %>
            <div class="title-price"><%= "$#{total}" %></div>
            <div class="title-price"><%= "$#{total}" %></div>
            <div class="title-price"><%= "$#{total}" %></div>
            <div class="line"></div>
            <div class="title-price"><%= "$#{total}" %></div>
          </div>
        </div>
        <button class="checkout-button">Checkout</button>
      </div>
      <div class="coupon-view">
        <div class="title">Enter a coupon code</div>
        <div class="coupon-code">
          <input type="text" />
          <button class="apply-button">Apply</button>
        </div>
      </div>
    </div>
  </div>


