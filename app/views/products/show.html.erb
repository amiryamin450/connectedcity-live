<h1><%= @product.name %></h1>

<div><%= image_tag @product.image.url :thumb %></div>
<div><%= @product.sku %></div>
<div><%= number_to_currency @product.price %></div>
<div><%= @product.description.html_safe %></div>

<% if (user_signed_in? and current_user.has_role? :admin) or (user_signed_in? and current_user.can_manage_location? @location) %>
<div style="margin-top: 1.5em">
  <%= link_to "Edit", edit_location_product_path(@location, @product), class: 'btn btn-primary' %>
  <%= link_to "Create New Product", new_location_product_path(@location), class: 'btn' %>
</div>
<% end %>