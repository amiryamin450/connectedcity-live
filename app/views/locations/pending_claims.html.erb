<h1>Pending Location Claims</h1>

<table class="table table-striped table-compact table-bordered">
  <tr>
    <th>User Info</th>
    <th>Name</th>
    <th>Address</th>
    <th>City</th>
    <th>State</th>
    <th>Country</th>
    <th>Actions</th>
  </tr>

  <% @locations.each do |location| %>
      <tr>
        <td><%= mail_to location.super_admin&.email, location.super_admin&.name %></td>
        <td><%= location.name %></td>
        <td><%= location.address %></td>
        <td><%= location.city.name if location.city.present? %></td>
        <td><%= location.province.abbr %></td>
        <td><%= location.country.country_code %></td>
        <td>
          <div class="btn-group">
            <%= link_to 'Approve', approve_claim_location_path(location), :class => 'btn btn-mini', data: {confirm: 'Are you sure?'} %>
            <%= link_to 'Reject', reject_claim_location_path(location), :class => 'btn btn-mini', data: {confirm: 'Are you sure?'} %>
          </div>
        </td>
      </tr>
  <% end %>
</table>
