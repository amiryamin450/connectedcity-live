<%
  if @business_improvement_area
    @district = District.find(@business_improvement_area.district_id)
    @district_name = @district.slug
    @slug = @business_improvement_area.slug
    @slug = "kitsilano" if @business_improvement_area.slug.include? "kitsilano"
    @neighbourhood = Neighborhood.where('slug LIKE ?', @slug)
  end
%>
<%
  @neighbourhood_param = params[:neighborhood] || params[:neighborhood_slug]
  @neighbourhood_slug = params[:neighborhood]  || params[:neighborhood_slug]
  if @neighbourhood_param
    @neighbourhood_slug = "kitsilano" if @neighbourhood_param.include? "kitsilano"
    @neighbourhood = Neighborhood.where('slug LIKE ?', @neighbourhood_slug).first
  end
%>
<div class="nav-bar">
  <div class="container-fluid p-0">
    <nav role="navigation" id="nav-main">
      <ul id="main">
        <% klass = request.path == @base_path ? "selected" : ""%>
        <li class="selected"> <%= link_to "Home", root_path%></li>
        <% @vertical_markets_all.each_with_index do |vm, index| %>
          <% if vm.has_children? || ['culture', 'trending'].include?(vm.slug) %>
            <li>
              <% if params[:sub_neighborhood_slug] %>
                <a href="<%=city_district_nbh_sub_guide_path(params[:city_slug], params[:district_slug], params[:neighborhood_slug], params[:sub_neighborhood_slug], vm.slug)%>"><%=vm.name%></a>
              <% elsif params[:neighborhood_slug] %>
                <a href="<%=city_district_neighborhood_guide_path(params[:city_slug], params[:district_slug], params[:neighborhood_slug], vm.slug)%>"><%=vm.name%></a>
              <% elsif params[:district_route] %>
                <a href="<%=city_district_guide_path(params[:city_slug], params[:district_route], vm.slug)%>"><%=vm.name%></a>
              <% elsif params[:city_slug] %>
                <a href="<%=city_guide_path(params[:city_slug], vm.slug)%>"><%=vm.name%></a>
              <%else%>
                <%if @location&.city%>
                  <a href=<%="/#{@location.city.slug}/guide/#{vm.slug}"%>><%=vm.name%></a>
                <%else%>
                  <a href=<%="#{@base_path}guide/#{vm.slug}"%>><%=vm.name%></a>
                <%end%>
              <% end %>
              <ul>
                <% vm.children.sort_by(&:name).each do |child| %>
                  <% if params[:sub_neighborhood_slug] %>
                    <li><%= link_to child.name, city_district_nbh_sub_sub_market_guide_path(params[:city_slug], params[:district_slug], params[:neighborhood_slug], params[:sub_neighborhood_slug], vm.slug, child.slug), class: "dropdown-item nv-mn-lnk" %></li>
                  <% elsif params[:neighborhood_slug]%>
                    <li><%= link_to child.name, city_district_neighborhood_sub_market_guide_path(params[:city_slug], params[:district_slug], params[:neighborhood_slug], vm.slug,child.slug), class: "dropdown-item nv-mn-lnk" %></li>
                  <% else %>
                    <% if @neighbourhood %>
                      <li><%= link_to child.name, city_district_neighborhood_sub_market_guide_path(params[:city_slug], params[:district_slug], @neighbourhood.slug, vm.slug, child.slug), class: "dropdown-item nv-mn-lnk" %></li>
                    <% else %>
                      <% if params[:district_route] || params[:district_slug] %>
                        <% district_name = params[:district_route] || params[:district_slug] %>
                        <li><%= link_to child.name, city_district_sub_market_guide_path(params[:city_slug], district_name, vm.slug, child.slug), class: "dropdown-item nv-mn-lnk" %></li>
                      <% elsif params[:city_slug] %>
                        <li><%= link_to child.name, city_sub_market_guide_path(params[:city_slug], vm.slug, child.slug), class: "dropdown-item nv-mn-lnk" %></li>
                      <% else %>
                        <%if @location&.city%>
                          <a href=<%="/#{@location.city.slug}/guide/#{vm.slug}"%>><%=child.name%></a>
                        <%else%>
                          <a href=<%="#{@base_path}guide/#{vm.slug}"%>><%=child.name%></a>
                        <%end%>
                      <% end %>
                    <% end %>
                  <% end %>
                <% end %>
              </ul>
            </li>
          <% end %>
        <% end %>
        <li class="more" data-width="70">
            <a href="#">More</a>
            <ul></ul>
        </li>
      </ul>
    </nav>
    <div class="menu-nav-right" style="display: flex;">
      <%# if @city.present? || params[:district_route].present? %>
        <nav role="navigation" id="nav-main" style="padding: 0px; background-color: transparent;">
          <ul>
            <% if @vertical_market_news&.has_children? %>
              <li>
                <% if params[:sub_neighborhood_slug] %>
                  <a style="padding: 0px;" href="<%=city_district_nbh_sub_guide_path(params[:city_slug], params[:district_slug], params[:neighborhood_slug], params[:sub_neighborhood_slug], @vertical_market_news.slug)%>"><%=@vertical_market_news.name%></a>
                <% elsif @business_improvement_area %>
                  <a style="padding: 0px;" href="<%=city_district_neighborhood_guide_path(params[:city_slug], @district_name, @slug, @vertical_market_news.slug)%>"><%=@vertical_market_news.name%></a>
                <% elsif @district && @neighbourhood_slug %>
                  <a style="padding: 0px;" href="<%=district_neighborhood_guide_path(@district.slug, @neighbourhood_slug, @vertical_market_news.slug)%>"><%=@vertical_market_news.name%></a>
                <% else %>
                  <a style="padding: 0px;" href="<%= region_market_guide_path('news') %>"><%=@vertical_market_news.name%></a>
                <% end %>
                <ul>
                  <% @vertical_market_news.children.sort_by(&:name).each do |child| %>
                    <% if @business_improvement_area %>
                      <li><%= link_to child.name, city_district_neighborhood_guide_path(params[:city_slug], @district_name, @slug, child.slug), class: "dropdown-item nv-mn-lnk" %></li>
                    <% else %>
                      <% if @neighbourhood %>
                        <li><%= link_to child.name, district_neighborhood_guide_path(@district, @neighbourhood.slug, child.slug), class: "dropdown-item nv-mn-lnk" %></li>
                      <% else %>
                        <%if @location&.city%>
                          <a href=<%="/#{@location.city.slug}/guide/#{vm.slug}"%>><%=vm.name%></a>
                        <%else%>
                          <a href=<%="#{@base_path}guide/#{vm.slug}"%>><%=vm.name%></a>
                        <%end%>
                      <% end %>
                    <% end %>
                  <% end %>
                </ul>
              </li>
            <% end %>
          </ul>
        </nav>
      <%# end %>
      <a href="/classifieds">Classfieds</a>
      <a href="/employment-opportunities">Jobs</a>
    </div>
  </div>
</div>
<script>

  function calcWidth() {
    var navwidth = 0;
    var morewidth = $('#main .more').outerWidth(true);
    $('#main > li:not(.more)').each(function() {
      navwidth += $(this).outerWidth( true );
    });

    //var availablespace = $('nav').outerWidth(true) - morewidth;
    var availablespace = $('#nav-main').width() - morewidth;

    if (navwidth > availablespace) {
      var lastItem = $('#main > li:not(.more)').last();
      lastItem.attr('data-width', lastItem.outerWidth(true));
      lastItem.prependTo($('#main .more ul'));
      calcWidth();
    } else {
      var firstMoreElement = $('#main li.more li').first();
      if (navwidth + firstMoreElement.data('width') < availablespace) {
        firstMoreElement.insertBefore($('#main .more'));
      }
    }
    if ($('.more li').length > 0) {
      $('.more').css('display','block');
    } else {
      $('.more').css('display','none');
    }

    $('.more > ul > li > ul > li').each(function( index ) {
      if ($(this).attr('data-width') > 0 ){
        $(this).remove();
      }
    });
  }

  $(document).ready(function(){
    calcWidth();
  });

  $(window).on('resize load',function(){
    calcWidth();
  });

</script>
