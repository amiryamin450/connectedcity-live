<%

meta title: @city_news_article.title,
     description: "",
     canonical: url_for(Rails.application.routes.recognize_path(request.path).merge({only_path: false, protocol: 'https'}))

%>

<h1><%= @city_news_article.title %></h1>
<div class="row-fluid">
  <div class="span12">
   <span style="font-size: 11px;"> Posted <%= "#{@city_news_article.created_at.strftime('%b %e, %Y at %l:%M %p')}" %></span style="font-size: 10px;">
  </div>
</div>
<div class="row-fluid">
  <div class="span12">
    <%= image_tag @city_news_article.image.url( :display), id: 'main-image', class: 'thumbnail' %>
  </div>
</div>

<div class="row-fluid" style="margin-top: 15px;">
  <div class="span12">
    <%= @city_news_article.content.html_safe %>
  </div>
</div>
