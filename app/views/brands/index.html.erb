<h1>Listing brands</h1>
<%= search_form_for @search, class: 'form-search' do |f| %>
  <div class="input-append">
      <%= f.text_field :name_cont, class: 'search-query' %>
      <%= f.submit "Search", class: 'btn' %>
  </div>

<% end -%>

<table class="table table-bordered table-striped table-hover">
  <tr>
    <th>logo</th>
    <th>Name</th>
    <th></th>
  </tr>

<% @brands.each do |brand| %>
  <tr>
    <td><%= image_tag brand.logo.url :thumb if brand.logo.present? %></td>
    <td><%= brand.name %></td>
    <td>
      <div class='btn-group'>    
        <%= link_to 'Show', brand, class: 'btn btn-mini' %>
        <%= link_to 'Edit', edit_brand_path(brand), class: 'btn btn-mini' %>
        <%= link_to 'Destroy', brand, method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-mini' %>
      </div>
    </td>
  </tr>
<% end %>
</table>
<%= paginate @brands %>
<br />

<%= link_to 'New Brand', new_brand_path, class: 'btn btn-primary' %>
