<div id="show_video_modal">
  <div class="modal fade" id="modal-video-call-request" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" style="max-width: 40%;">
      <div class="modal-content">
        <div class="modal-body">
          <div class="row">
            <div class="col-md-12">
              <div class="cover-modal d-flex flex-column justify-content-center">
                <h4 id="modal-call-title" class="modal-call-title d-flex align-items-center justify-content-center"></h4>
                <div id ="show-call" class ="d-flex justify-content-center align-items-center"><i class="fas fa-phone-square-alt"></i></div>
                <div id="option_call" class="d-flex justify-content-between align-items-center">
                  <i id="accept-call" class="fas fa-phone-alt"></i> 
                  <i id="reject-call" class="fas fa-phone-slash" data-dismiss="modal" aria-label="Close"></i> 
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>