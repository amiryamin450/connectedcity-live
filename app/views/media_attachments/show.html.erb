
<h1><%= @media_attachment.media_title %></h1>
<div class="row-fluid">
  <div class="span12">
    <%
      if @media_attachment.is_stream_video
        url = @media_attachment.stream_video_url
      else
        url = "https://www.youtube.com/embed/#{@media_attachment.media_source_id}"
      end
    %>
    <iframe width='853' height='480' src='<%= url %>' frameborder='0' allowfullscreen></iframe>
  </div>
</div>

<% if @other_media.size > 0 %>
<h3>Additional Media</h3>
<div class="row-fluid">
    <% @other_media.each do |media| %>
      <div class="span2">
        <div>
          <% if media.media_source_id.present? %>
            <%= link_to(image_tag("http://img.youtube.com/vi/#{media.media_source_id}/mqdefault.jpg"), [@location, media]) %>
          <% else %>
            <%= link_to(image_tag(media.thumbnail_url, style: "height: 110px; width: 195px;"), [@location, media]) %>
          <% end %>
        </div>
        <div><%= link_to media.media_title, [@location, media] %></div>
      </div>
    <% end -%>
  </div>
  <% end %>

<div id="subscriberContainer">
</div>

