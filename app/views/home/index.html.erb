<%= render "/layouts/application_v_3/global_header" %>
<!-- Main Section -->
<div class="container-fluid">
  <div class="row">
    <div class="col-md-12 column landing-page-slider">
      <div id="slides">
        <a class="slide" href="#link01">
          <% url_first = "https://#{ENV['S3_BUCKET_NAME']}.s3.#{ENV['AWS_REGION']}.amazonaws.com/global_homepage_slider/third_slide.png" %>
          <span class="animate in" style="background-image: url(<%= url_first %>)"></span>
          <div class="static-content">
            <div class="slider-advance-searchbox">
              <div class="heading">
                <h1>Connect to your city</h1>
                <h5>Find news, thing to do</h5>
                <h5>and shop for everything local.</h5>
              </div>
            </div>
          </div>
        </a>
        <a class="slide" href="#link02">
          <% url_second = "https://#{ENV['S3_BUCKET_NAME']}.s3.#{ENV['AWS_REGION']}.amazonaws.com/global_homepage_slider/second_slider.png" %>
          <span class="animate in" style="background-image: url(<%= url_second %>)"></span>
          <div class="static-content">
            <div class="slider-advance-searchbox">
              <div class="heading">
                <h1>Broadcast your brand</h1>
                <h5>Build lasting connections to local</h5>
                <h5>customers that buy faster and easier.</h5>
              </div>
            </div>
          </div>
        </a>
        <a class="slide" href="#link03">
          <% url_third = "https://#{ENV['S3_BUCKET_NAME']}.s3.#{ENV['AWS_REGION']}.amazonaws.com/global_homepage_slider/first_slider.png" %>
          <span class="animate in" style="background-image: url(<%= url_third %>)"></span>
          <div class="static-content">
            <div class="slider-advance-searchbox">
              <div class="heading">
                <h1>Grow vibrant communities</h1>
                <h5>Cultivate local talents and businesses</h5>
                <h5>to bloom sustainably.</h5>
              </div>
            </div>
          </div>
        </a>
      </div>
      <!-- Slider Advance SearchBox -->

    </div>
  </div>
</div>
<!-- End -->
<%= render "/layouts/application_v_3/neighbourhoods_and_shopping"%>
<%= render "/layouts/application_v_3/communities_gird_view"%>
<!-- End -->
<%= render "/layouts/application_v_2/global_footer" %>
<!-- End -->
