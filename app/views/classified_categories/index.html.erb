<h1>Classified Categories</h1>

<table class="table table-bordered table-striped table-hover">
  <tr>
    <th>Name</th>
    <th></th>
  </tr>

<% @classified_categories.each do |classified_category| %>
  <tr>
    <td><%= classified_category.name %></td>

    <td>
      <div class='btn-group'>    
        <%= link_to 'Show', classified_category, class: 'btn btn-mini' %>
        <%= link_to 'Edit', edit_classified_category_path(classified_category), class: 'btn btn-mini' %>
        <%= link_to 'Destroy', classified_category, method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-mini' %>
      </div>
    </td>
  </tr>
<% end %>
</table>

<br />

<%= link_to 'New Classified category', new_classified_category_path, class: 'btn btn-primary' %>
