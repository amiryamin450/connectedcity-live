<div class="communities-section">
  <div class="container-fluid">
    <div class="row" style="margin: 20px 0px;">
      <div class="col-md-12">
        <div class="heading" style="display: flex; justify-content: center;">
          <h3 style=" font-weight: bold; font-size: 34px;">We connect local partners to communities</h3>
        </div>
      </div>
    </div>
    <div class="tab-content py-3 px-3 px-sm-0" id="nav-tabContent">
      <% @districts.each_with_index do |district, index| %>
        <div class="tab-pane fade show <%= index == 0 ? 'active' : ''%>" id="<%=district.name.parameterize%>" role="tabpanel" aria-labelledby="<%=district.name.parameterize%>-tab">
          <div class="row">
            <% arr = district.business_improvement_areas + district.business_improvement_areas + district.business_improvement_areas + district.business_improvement_areas + district.business_improvement_areas.limit(4)  %>
            <% arr.each do |bia| %>
            <div class="col-md-3" style="padding-left: 0px; padding-right: 0px;">
              <div class="tab-inner-card" style="position: relative; margin: 15px;">
                <div class="tab-inner-card-img" style="width: 100%; height: 100%;">
                  <%= link_to(image_tag(bia.logo.url(:list), :width => '100%', :height => '100%'), "#") %>
                </div>
                <div class="tab-inner-card-heading" style=" position: absolute; bottom: 0px; width: 100%; background: linear-gradient(to top, rgba(47, 47, 47, 0.5), rgba(255, 122, 89,0)); display: table; min-height: 45px;">
                  <h5 style="max-width: 100px; font-weight: bold; color: white; padding-left: 15px; display: table-cell; vertical-align: middle;"><%= bia.name %></h5>
                </div>
              </div>
            </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
