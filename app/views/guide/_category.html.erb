<% if locations.any? %>
<% @business_improvement_area_id %>
  <% locations.each do |location| %>
    <% if !location.business_improvement_area_id.nil? && @business_improvement_area_id.nil? %>
      <% @business_improvement_area_id = location.business_improvement_area_id %>
    <% end %>
  <% end %>
<% end %>
<% @district_slug = params[:district_slug] || params[:district_route]%>
<% @url %>
<% if params[:sub_neighborhood_slug]%>
  <% @url = city_district_neighborhood_sub_category_show_path(params[:city_slug], @district_slug, params[:neighborhood_slug], params[:sub_neighborhood_slug], category.slug)%>
<% elsif params[:neighborhood_slug]%>
  <% @url = city_district_neighborhood_category_show_path(params[:city_slug], @district_slug, params[:neighborhood_slug], category.slug)%>
<% elsif @district_slug %>
  <% @url = city_district_category_show_path(params[:city_slug], @district_slug, category.slug)%>
<% elsif params[:city_slug] %>
  <% @url = city_category_show_path(params[:city_slug], category.slug)%>
<% elsif params[:municipality_slug] %>
  <% @url = municipality_category_show_path(params[:municipality_slug], category.slug)%>
<%else%>
  <% @url = category_show_path()%>
<% end %>
<div class="card-label-one">
  <div class="title">
    <h4>&nbsp;<%= category.name %>&nbsp;</h4>
    <%= link_to 'See More +', '#', class: 'see-more', data: { element: category.id } %>
    <%= link_to ' See All', @url, class: 'see-all' %>
    <% if user_signed_in? && current_user.has_role?(:admin) %>
      &nbsp;&nbsp;&nbsp;
      <%= link_to 'Edit', edit_vertical_market_category_path(category), class: 'badge badge-dark' %>
    <% end %>
  </div>
</div>

<div class="row card-row location-row-holder" id="cat-<%= category.id %>">
  <% locations.each do |location| %>
    <% cache "#{user_signed_in? ? "in" : "out"}_location_#{location.id}_#{location.updated_at}" do %>
      <%#= render 'guide/location', location: location %>
      <div class="col-md-2">
        <div class="category-body-card">
          <div class="img">
              <%= link_to image_tag(get_location_image_url(location)), location %>
          </div>
          <div class="title">
              <h4><%= link_to location.name, location %></h4>
          </div>
          <hr>
          <div class="contact-details">
              <span><i class="fal fa-map-marker-alt"></i>
                <%= "#{location.address}".html_safe %>
                <%= "#{location.city.name if location.city.present? } B.C. #{location.postal_code}".html_safe %>
              </span>
              <br>
              <span><i class="far fa-phone-alt"></i><%= location.phone %></span>
          </div>
          <div class="button favorite"  id="favorite-<%= location.id %>">
            <% if show_save_button?(user_signed_in?, location.vertical_markets.present?) %>
              <%= render 'favorites/like_button_v2', :location_id => location.id, :vertical_market_slug => location.vertical_markets.first.slug if user_signed_in? and location.vertical_markets.present? %>
            <% end %>
            <% if !user_signed_in? %>
              <%= link_to "Follow", "#", class: "btn btn-primary", role: "button", data: { toggle: "modal", target: "#login_for_save" } %>
            <% end %>
            <%# <button class="btn btn-primary">Follow</button> %>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
