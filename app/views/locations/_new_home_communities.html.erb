<div class="card-label-one">
  <div class="title"><h4>New Home Communities</h4>
   <% if (user_signed_in? and current_user.has_role? :admin) or (user_signed_in? and current_user.can_manage_location? @location) %>
 <small><%= link_to "add", new_location_new_home_community_path(@location), class: 'small' %> | <%= link_to 'manage', location_new_home_communities_path(@location) %></small>
 <% end %>
</div>
</div>
<% if @new_home_communities.size > 0 %>
  <div class="row card-row">
    <% @new_home_communities.in_groups_of(4) do |group| %>
      <% group.each do |community| %>
        <% if community %>
          <div class="col-md-2">
            <div class="business-body-card">
              <div class="img"><%= link_to(image_tag(community.cover_photo.url), [@location, community]) %></div>
              <div class="title">
                <h3><%= link_to community.name, [@location, community] %></h3>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
  <%= paginate @new_home_communities, param_name: 'communities_page' %>
<% else %>
<div class="alert alert-dark" role="alert">
  No Communities found.
</div>
<% end %>
