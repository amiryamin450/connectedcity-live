<div class="card-label-four">
  <div class="title">
      <h4>Products</h4>
      <%= link_to raw("<h4 class='secondary'>Add</h4>"), new_location_product_path(@location) %>
  </div>
</div>
<div>
  <%= link_to 'See More +', '#', class: 'see-more', data: { element: "products-#{@location.id}" } %>
&nbsp;&nbsp;&nbsp;
  <%= link_to ' See All', location_automotive_listings_path(@location), class: 'see-all' %>
</div>
<% if @products.size > 0 %>
  <div class="row card-row media-row-holder" id="cat-products-<%= @location.id %>">
    <% @products.each do |product| %>
      <% if product %>
        <div class="col-md-2">
          <div class="business-body-card">
            <div class="img">
              <%= link_to(image_tag(product.image.url(:list)), [@location, product]) %>
            </div>
            <div class="title">
              <h3><%= link_to product.name, [@location, product] %></h3>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="alert alert-dark" role="alert">
    No products found.
  </div>
<% end %>