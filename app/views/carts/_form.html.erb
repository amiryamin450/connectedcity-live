<%= form_for(cart, local: true, id: "cart_form") do |form| %>
  <% if cart.errors.any? %>
    <div id="error_explanation">
        <h2><%= pluralize(cart.errors.count, "error") %> prohibited this cart from being saved:</h2>
        <ul>
            <% cart.errors.full_messages.each do |message| %>
            <li><%= message %></li>
            <% end %>
        </ul>
    </div>
  <% end %>
  <!--  Cart Table -->
  <div class="table-responsive cart-table-body">
    <table class="table">
      <thead>
        <tr>
          <th scope="col">
            <div class="p-2 px-3">Product</div>
          </th>
          <th scope="col">
            <div class="py-2">Quantity</div>
          </th>
          <th scope="col">
            <div class="py-2">Unit price</div>
          </th>
          <th scope="col">
            <div class="py-2">Discount</div>
          </th>
          <th scope="col">
            <div class="py-2">Subtotal</div>
          </th>

          <th scope="col">
            <div class="py-2">Action</div>
          </th>
        </tr>
      </thead>
      <tbody>
        <%= form.fields_for :line_items do |line_item| %>
          <% product = line_item.object.product %>
          <% location = product.location %>
          <tr>
            <td class="align-middle">
              <div class="p-2 cart-table-img-row">
                <div class="cart-table-img">
                  <% if line_item.object.product.image.present? %>
                    <%= image_tag line_item.object.product.image.url(:thumb), alt: line_item.object.product.name %>
                  <% end %>
                </div>
                <div class="ml-3 d-inline-block align-middle">
                  <h5 class="mb-0">
                    <a href="<%= location_product_path(location, product)%>" class="text-dark d-inline-block" ><%= line_item.object.product.name %></a>
                  </h5>
                </div>
              </div>
            </td>
            <td class="align-middle">
              <div class="quanitity-counter">
                <input type='button' value='-' class='qtyminus' />
                <%= line_item.number_field :quantity, step: "1", min: "1", max: "", title: "Qty", class: "qty", size: "4", pattern: "", inputmode: ""  %>
                <input type='button' value='+' class='qtyplus' />
              </div>
            </td>
            <td class="align-middle"><%= number_to_currency(product.price, unit: '$') %></td>
            <td class="align-middle"><%= number_to_currency(product.discount, unit: '$') %></td>
            <td class="align-middle"><%= number_to_currency(line_item.object.total_price, unit: '$') %></td>
            <td class="align-middle">
              <a href="<%= line_item_path(line_item.object)%>" method= "delete" class="text-dark"><i class="far fa-trash-alt"></i></a>
            </td>
          </tr>
        <% end %>  
      </tbody>
    </table>
  </div>
<% end %>


<div class="cart-table-btn-row">
  <div class="row">
    <div class="col-md-3">
      <a href="<%= root_path%>" class="btn btn-outline-primary btn-shopping">Go Back to Shopping</a>
    </div>
    <div class="col-md-2">
      <form action="<%= clear_cart_path(@cart)%>" method="POST">
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <button type="submit" class="btn btn-outline-primary btn-clear-cart">Clear Cart</button>
      </form>
    </div>
    <div class="col-md-3">
    </div>
    <div class="col-md-2">
      <button type="button" id="submitEditCart" class="btn btn-outline-primary btn-clear-cart">Update Cart</button>
    </div>
    <div class="col-md-2">
      <div class="btn-checkout-row">
        <form action="https://connected-checkout-staging.herokuapp.com/create-checkout-session" method="POST">
          <input type="hidden" name="success_url" value="<%=edit_cart_path(@cart)%>"/>
          <input type="hidden" name="cancel_url" value="<%=edit_cart_path(@cart)%>"/>
          <% @cart.line_items.each do |item| %>
            <input type="hidden" name="line_items[][name]" value="<%=item.product.name%>"/>
            <input type="hidden" name="line_items[][amount]" value="<%=item.product.price%>"/>
            <input type="hidden" name="line_items[][quantity]" value="<%=item.quantity%>"/>
          <% end %>
          <button type="submit" id="submit" class="btn btn-primary btn-checkout">Checkout</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  $(document).on("click", ".qtyplus", function() {
    var oldValue = $(this).prev().val();
    var newVal = parseFloat(oldValue) + 1;
    $(this).prev().val(newVal);
  });

  $(document).on("click", ".qtyminus", function() {
    var oldValue = $(this).next().val();
    if (oldValue > 1) {
      var newVal = parseFloat(oldValue) - 1;
    } else {
      newVal = 1;
    }
    $(this).next().val(newVal);
  });

  $(document).on("click", "#submitEditCart", function() {
    $(".edit_cart").submit();
  });
</script>