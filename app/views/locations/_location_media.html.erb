<div class="card-label-two">
  <div class="title">
    <h4>Video</h4>
    <%= link_to raw("<h4 class='secondary'>Record Video</h4>"), new_location_media_attachment_path(@location) %>
    <%= link_to raw("<h4 class='secondary'>Record Live Video</h4>"), new_location_media_attachment_path(@location, {livestream: true}) %>
    <h4 class="secondary">Upload Video</h4>
    <h4 class="secondary">Youtube</h4>
  </div>
</div>
<div>
  <%= link_to 'See More +', '#', class: 'see-more', data: { element: "media-#{@location.id}" } %>
&nbsp;&nbsp;&nbsp;
  <%= link_to ' See All', location_media_attachments_path(@location), class: 'see-all' %>
</div>
<% if @media_attachments.size > 0 %>
  <div class="row card-row media-row-holder" id="cat-media-<%= @location.id %>">
    <% @media_attachments.each do |media| %>
      <div class="col-md-2">
        <div class="business-body-card">
          <% video = media.videos&.first
             is_process_video = video && video.broadcast_id.present? && !video.video_url.present?
          %>
          <% if video && video.livestream && video.status == "started" %>
            <div id="live">LIVE</div>
          <% end %>
          <div class="img">
            <% if media.media_source_id.present? %>
              <%= link_to(image_tag("http://img.youtube.com/vi/#{media.media_source_id}/mqdefault.jpg"), [@location, media]) %>
            <% else %>
              <% if is_process_video %>
                <img src="/assets/placeholder_stream_video.png" />
              <% else %>
                <%= link_to(image_tag(media.thumbnail_url), [@location, media]) %>
              <% end %>
            <% end %>
          </div>
          <% unless is_process_video %>
            <div class="video-btn">
              <%= link_to [@location, media] do %>
                <i class="far fa-play-circle" data-toggle="modal" data-target="#video-modal"></i>
              <% end %>
            </div>
          <% end %>
          <div class="title">
            <% if is_process_video %>
              <h3><%= media.title&.truncate(25) %></h3>
             <% else %>
              <h3><%= link_to media.title&.truncate(25), [@location, media] %></h3>
             <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  <%#= paginate @products, param_name: 'product_page' %>
<% else %>
  <div class="alert alert-dark" role="alert">
    Nothing Found
  </div>
<% end %>