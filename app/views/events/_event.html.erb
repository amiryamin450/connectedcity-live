<div class="row-fluid">
  <div class="span2">
    <%= link_to(image_tag(event.image.url), [event.location, event]) %>
  </div>


  <div class="span10">
    <div class="name"><strong><%= link_to event.name, [event.location, event] %></strong></div>

    <div class="dates">
      <%= raw "<strong>Starts:</strong> #{event.starts_at.strftime('%m/%d/%Y %l:%M %p')}" if event.starts_at.present? %>
      <%= raw " | <strong>Ends:</strong> #{event.ends_at.strftime('%m/%d/%Y %l:%M %p')}" if event.ends_at.present? %>
    </div>
    <div class="event-info">
      <%= link_to "Event Website", event.url if event.url? %>
      <%= raw " | #{mail_to event.email}" if event.email.present? %>
    </div>
    <div><%= truncate_html(event.description, length: 150) %></div>
    <div class="row-fluid">
      <div><small style="font-size: 10px;">by <%= link_to event.location.name, event.location %></small></div>
    </div>
  </div>
</div>