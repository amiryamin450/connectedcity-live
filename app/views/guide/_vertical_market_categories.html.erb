<%

# Dynamically constructed title for guide/vertical market pages can consist of
# one of more of these 4 different pieces of information depending on what is
# available:
#
# - vertical market
# - neighborhood
# - district
# - city

guide = @vertical_market ? "#{@vertical_market.name} In #{@neighborhood.try(:name) || @district.try(:name) || @city.try(:name)}" : nil
metamagic title: "#{guide}".strip,
          description: "",
          canonical: url_for(Rails.application.routes.recognize_path(request.path).merge({only_path: false, protocol: 'https'}))

%>
<%

markers = []

content_for :title do [@page_title_part, @vertical_market.name, (@vertical_market.parent.name if @vertical_market.parent), 'Guide'].reject(&:blank?).join ' ' end
%>

<%#

NOTE Rental (rental)
     Resale (resale)
     New Home (newhome)
     Commercial (commercial)

%>
<% if [17, 18, 19, 20].include?(@vertical_market.id) %>
  <%# TODO Optimize %>
  <% case @vertical_market.id %>
  <% when 17 %>
    <%= render 'rental_properties', rental_properties: @rental_properties, styles: @rental_styles %>
    <% markers = @rental_properties %>
  <% when 18 %>
    <%= render 'residential', residential_units: @listings, styles: @residential_styles %>
    <% markers = @listings %>
  <% when 19 %>
    <%= render 'new_home_communities', new_home_communities: @new_home_communities, new_home_community_styles: @new_home_community_styles %>
    <% markers = @new_home_communities %>
  <% when 20 %>
    <%= render 'commercial_properties', commercial_units: @commercial_listings, styles: @commercial_styles %>
    <% markers = @commercial_listings %>
  <% end %>
<% else %>
  <%# NOTE Automotive (automotive) %>

  <% if @vertical_market.id == 1 %>
    <div class="card-label-one">
      <div class="title heading index-11">
        <h4>Automotive Listings</h4>
        &nbsp;&nbsp;
        <%= link_to 'More + ', '#', class: 'see-more', data: { element: 'auto-listings' } %>
        &nbsp;&nbsp;
        <%= link_to ' See All', "#{@base_path}guide/auto-listings", class: 'see-all' %>
      </div>
    </div>
    <div class="row card-row location-row-holder" id="cat-auto-listings">
      <% @auto_listings.each do |listing| %>
        <%# FIXME Move inline styles to a stylesheet %>
        <div class="col-md-2">
          <div class="category-body-card">
            <div class="img">
              <%= link_to image_tag(listing.main_image.url(:hp_list)), [listing.location, listing] %>
            </div>
            <div class="title">
              <h4><%= link_to [listing.year, listing.make, listing.model].reject(&:blank?).join(' '), [listing.location, listing] %></h4>
            </div>
            <hr>
            <div class="contact-details">
                <%= humanized_money_with_symbol listing.price %>
              </span>
              <br>
              <span><%= link_to listing.location.name, listing.location %></span>
            </div><br>
            <div class="button">
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
  <% if @vertical_market.name.include?("Auto Listing") %>
    <%= render 'automotive_listings', auto_listings: @auto_listings, auto_makes: @auto_makes %>
    <% markers = @markers %>
  <% end %>
  <% @vertical_market.categories_new(@city, @district, @neighborhood).each_with_index do |category, r| %>
    <%

    locations = category.locations[0..19]
    markers |= category.locations

    %>

    <% if locations.any? && !@categories_without_municipality_ids.include?(category.id) %>
      <%= render 'guide/category', category: category, r: r, locations: locations %>
    <% end %>
  <% end %>
<% end %>

<%= javascript_tag do %>
  window.locations = <%= raw markers.collect { |m|
    u = if m.respond_to?(:location)
      url_for([m.location, m])
    else
      url_for(m)
    end

    {:name => m.name, :url => u, :latitude => m.latitude, :longitude => m.longitude, :thumb => m.logo.file? ? m.logo.url(:bia_display) : nil}
  }.to_json %>;
<% end %>


<%= render 'status_updates/show_image' %>

<div class="modal fade" id="login_for_save" tabindex="-1" aria-labelledby="login_for_saveLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <p>
          Please <%= link_to "sign-up", new_user_registration_path %> and/or <%= link_to "log-in", new_user_session_path %> to save a business to your account.
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

