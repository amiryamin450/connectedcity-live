<%
  meta title: @location.name
%>
<%######## view content ########%>
<div class="span6">
  <div class="profile">

    <div class="pad10 holder clearfix">
      <% if @location_carousel_images.count > 1 || @location_carousel_images.any? %>
        <div class="row-fluid">
          <div class="span12">
            <% if @location_carousel_images.count > 1 %>
              <div id="locationCarousel" class="carousel slide">
                <ol class="carousel-indicators">
                  <% @location_carousel_images.each_with_index do |image, index| %>
                    <li data-target="#locationCarousel" data-slide-to="<%= index %>" class="<%= index == 0 ? 'active' : ''  %>"></li>
                  <% end %>
                </ol>
                <div class="carousel-inner">
                  <% @location_carousel_images.each_with_index do |image, index| %>
                    <div class="item <%= index == 0 ? 'active' : '' %>">
                      <%= image_tag image.url %>
                    </div>
                  <% end %>
                </div>
                <a class="carousel-control left" href="#locationCarousel" data-slide="prev">&lsaquo;</a>
                <a class="carousel-control right" href="#locationCarousel" data-slide="next">&rsaquo;</a>
              </div>
            <% elsif @location_carousel_images.any? %>
              <%= image_tag @location_carousel_images.first.url %>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="row-fluid" style="margin-top: 5px;">
        <div class="span3">
          <div class="thumbnail logo">
            <%= image_tag get_location_image_url @location %>
          </div>

        </div>
        <div class="span9">
          <h1><%= @location.name %></h1>
          <div class="address-line">
           <%= @location.address %> &middot; <%= "#{@location.city.name} #{@location.province.preabbr}, #{@location.postal_code}" %>
           <%= display_phone 'show_phone', 'phone', 'Phone' %>
           <%= display_phone 'show_toll_free', 'toll_free', 'Toll Free' %>
            <%= raw "<div><strong>Fax:</strong> #{@location.fax}</div>" if @location.fax.present? %>
            <div>
              <%= mail_to @location.email if @location.email.present? %>
              <%= "|" if @location.email.present? and @location.website_url.present? %>
              <%= link_to('Visit us online!', @location.website_url, target: :_blank) if @location.website_url.present? %>
              <%= "| Broker: " if @location.vertical_market_category_ids.include?(99)%>
              <%= link_to("#{@location.broker.name}", @location.broker) if @location.vertical_market_categories.exists?(99) %>


           </div>

            <%= render 'operating_hours' %>
         </div>
         <div id="favorite-<%= @location.id %>" class="favorite">
              <% if show_save_button?(user_signed_in?, @location.vertical_markets.present?) %>
                <%= render 'favorites/like_button', :location_id => @location.id, :vertical_market_slug => @location.vertical_markets.first.slug if user_signed_in? and @location.vertical_markets.present? %>
              <% end %>
              <% if !user_signed_in? %>
                  <%= render_login_popup %>
              <% end %>
         </div>

          <% if show_edit_button?(user_signed_in?, current_user, @location) %>
            <%= link_to "Edit", edit_location_path(@location), class: 'btn btn-mini btn-primary' %>
          <% end %>

          <%= render_message_button(user_signed_in?) %>

          <% if show_claim_button?(user_signed_in?, @location) %>
            <%= link_to "Claim Business", claim_location_path(@location), class: 'btn btn-mini btn-success' %>
          <% elsif !user_signed_in? || @location.user_ids.empty? || !@location.user_ids.include?(current_user.id) %>
            <%= render_claim_button_for_modal %>
          <% end %>

          <% if show_release_business_button?(user_signed_in?, current_user, @location) %>
            <%= link_to "Release Business", release_location_path(@location), class: 'btn btn-mini btn-danger' %>
          <% end %>

          <% if show_claim_pending?(user_signed_in?, current_user, @location) %>
            <span class="btn btn-mini btn-info">Claim Pending</span>
            <div class="processing-claim">
              We have recieved your claim and are processing it.
            </div>
          <% end %>
        </div>
      </div>

      <% if @location.content.present? %>
      <div class="row-fluid" style="margin-top: 1em;">
        <div class="span12 description">
          <h5>Description</h5>
           <%= @location.content.html_safe %>
        </div>
      </div>
      <% end %>

      <% if @location.business_improvement_area.present? %>
      <div class="row-fluid" style="margin-top: 1em;">
        <div class="span12">
          <div class="row-fluid">
            <h5>Shopping District</h5>
          </div>
          <div class="row-fluid">
            <div class="span3">
              <%= image_tag @location.business_improvement_area.logo.url %>
            </div>
            <div class="span9">
              <div><h4><%= @location.business_improvement_area.name %></h4></div>
              <div class="description">
                <p><%= truncate_html(@location.business_improvement_area.description, length: 400) %></p>
                <p><%= link_to 'Learn More', @location.business_improvement_area, class: 'btn btn-small' %></p>
              </div>
            </div>
          </div>

        </div>
      </div>
      <% end -%>


    </div>

    <div class="pad10 holder clearfix">
      <div class="row-fluid">
        <div class="span12">
          <div class="status-tabs clearfix">
            <ul class="clearfix">
              <li><a href="#status_updates">Status Updates</a></li>
              <% @location.social_profiles.each do |social_profile| %>
                <li><%= link_to social_profile.social_network.to_s.humanize, "##{social_profile.social_network}" %></li>
              <% end %>
              <li><a href="#news_articles">News Articles</a></li>
              <li><a href="#blog_entries">Blog Entries</a></li>
            </ul>
          </div>

          <div id="status_updates">
            <%= render 'status_updates' %>
          </div>

          <div id="news_articles">
            <%= render 'news_articles' %>
          </div>
          <div id="blog_entries">
            <%= render 'blog_entry' %>
          </div>

          <% @location.social_profiles.each do |social_profile| %>
            <div id="<%= social_profile.social_network %>" class="social-profile social-profile--<%= social_profile.social_network %>">
              <h4><%= social_profile.social_network.to_s.humanize %></h4>
              <div></div>
              <script>
                $('.social-profile--<%= social_profile.social_network %> div').load('<%= polymorphic_path([@location, social_profile]) %>?_=<%= Time.now.to_i %>');
              </script>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>





<%######## page title content ########%>

<% content_for :page_title do %>
    <div class="page=header">
        <h3><%= @location.name %></h3>
    </div>
<% end %>


<%####### column right #######%>
<div class="span6">
    <div class="row-fluid">
      <div class="span12">
        <div class="pad10 holder">
           <div id="profile-map" class="clearfix"></div>
        </div>
      </div>
    </div>

    <!--MENU-->
    <% if @location_menu_images.any? %>
      <% if is_food_and_dining(@location) %>
        <div class="category">
          <div class="heading index-1">
            <h5>Menu</h5>
              <% if (user_signed_in? and current_user.has_role? :admin) or (user_signed_in? and current_user.can_manage_location? @location) %>
                <small><%= link_to "add", new_location_location_menu_path(@location.id), class: 'small' %> | <%= link_to 'manage', location_location_menus_path(@location) %></small>
              <% end %>
          </div>
        </div>
        <div class="row-fluid">
          <div class="span12">
            <div class="">
              <div class="row-fluid">
                <div class="span12">
                  <% if @location_menu_images.any? %>
                    <div id="locationMenuCarousel" class="carousel slide">
                      <ol class="carousel-indicators">
                        <% @location_menu_images.each_with_index do |image, index| %>
                            <li data-target="#locationMenuCarousel" data-slide-to="<%= index %>" class="<%= index == 0 ? 'active' : ''  %>"></li>
                        <% end %>
                      </ol>
                      <div class="carousel-inner">
                        <% @location_menu_images.each_with_index do |menu_image, index| %>
                          <div class="item <%= index == 0 ? 'active' : '' %>">
                            <%= link_to(image_tag(menu_image.url), location_location_menu_path(@location, menu_image.instance)) %>
                            <p class="flex-caption">Click image to view larger</p>
                          </div>
                        <% end %>
                      </div>
                      <a class="carousel-control left" href="#locationMenuCarousel" data-slide="prev">&lsaquo;</a>
                      <a class="carousel-control right" href="#locationMenuCarousel" data-slide="next">&rsaquo;</a>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
    <div class="row-fluid">
      <div class="span12">
        <div class="">
           <%= render 'location_media' %>
        </div>
      </div>
    </div>
    <% if @location.vertical_market_category_ids.include?(40) %>
      <div class="row-fluid">
        <div class="span12">
          <div class="">
            <%= render 'location_automotive' %>
          </div>
        </div>
      </div>
    <% end %>
    <% if @location.vertical_market_category_ids.include?(99) %>
    <div class="row-fluid">
      <div class="span12">
        <div class="">
          <%= render 'location_listings' %>
        </div>
      </div>
    </div>
    <% elsif @location.vertical_market_category_ids.include?(100) %>
        <div class="row-fluid">
      <div class="span12">
        <div class="">
          <%= render 'agents' %>
        </div>
      </div>
    </div>
    <% elsif @location.vertical_market_category_ids.include?(101) %>
    <div class="row-fluid">
      <div class="span12">
        <div class="">
          <%= render 'rental_properties' %>
        </div>
      </div>
    </div>
    <% elsif @location.vertical_market_category_ids.include?(102) %>
    <div class="row-fluid">
      <div class="span12">
        <div class="">
          <%= render 'new_home_communities' %>
        </div>
      </div>
    </div>
    <% else %>
    <div class="row-fluid">
      <div class="span12">
        <div class="">
           <%= render 'location_products' %>
        </div>
      </div>
    </div>

    <% end %>

    <div class="row-fluid">
      <div class="span12">
        <div class="">
           <%= render 'location_coupons' %>
        </div>
      </div>
    </div>


    <div class="row-fluid">
      <div class="span12">
        <div class="">
           <%= render 'location_services' %>
        </div>
      </div>
    </div>

    <div class="row-fluid">
      <div class="span12">
        <div class="">
           <%= render 'location_events' %>
        </div>
      </div>
    </div>

<div class="row-fluid">
      <div class="span12">
        <div class="">
           <%= render 'location_trade_associations' %>
        </div>
      </div>
    </div>

   <div class="row-fluid">
      <div class="span12">
        <div class="">
           <%= render 'location_brands' %>
        </div>
      </div>
    </div>


    <div class="row-fluid">
      <div class="span12">
        <div class="">
           <%= render 'location_employment' %>
        </div>
      </div>
    </div>

</div>

<!--- Modals -->
<%= render 'locations/modal_show' %>

<%= render 'locations/modal_claim_login' %>

<%= render 'messages/modal_new' %>

<%= render 'status_updates/show_image' %>

<% if (user_signed_in? and current_user.has_role? :admin) or (user_signed_in? and current_user.can_manage_location? @location) %>


<%############# status update ###############%>

<%= render 'status_update_form' %>


<%#render 'new_realestate_listing_form' %>

<% end %>
<%= javascript_tag do %>

    <% ## TODO Limit the number of locations returned  %>

    Window.profile_marker = <%= raw @location.geo_location.to_json() %>
<% end %>
