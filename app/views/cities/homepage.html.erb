
<div class="row-fluid">
  <div class="span8">
    <h1><%= @city.name %>
      <small>
        <% if user_signed_in? && current_user.has_role?(:admin) %>
          <%= link_to 'edit carousel', polymorphic_path([@city, :carousel_images])  %>
        <% end %>
      </small>
    </h1>
  </div>

</div>

<div class="row-fluid">
  <div class="span8">
    <div class="row-fluid">
      <% if @city.present? && @city.carousel_images.present? %>

      <div id="carousel" class="carousel slide" data-interval="8000">
        <ol class="carousel-indicators">
          <% @carousel_images.each_with_index do |img, i| %>
            <li data-target="#carousel" data-slide-to="<%= i%>"></li>
          <% end %>
        </ol>
        <div class="carousel-inner">
          <% @carousel_images.each_with_index do |img, i|  %>
            <a href="<%=img.url%>" class="item <%= "active" if i == 0 %>">
              <%= image_tag img.image.url(:default), alt: img.caption %>
            </a>
          <% end %>
        </div>
        <!-- Carousel nav -->
        <a class="carousel-control left" href="#carousel" data-slide="prev">&lsaquo;</a>
        <a class="carousel-control right" href="#carousel" data-slide="next">&rsaquo;</a>

      </div>
    </div>
    <% end %>
    <div class="row-fluid">
      <div class="span12">
        <div class="holder pad10">
          <h5>Featured Neighbourhood Shopping Districts</h5>
          <div class="row-fluid">
            <% @city.business_improvement_areas.unscoped.order("RAND()").limit(6).each do |bia| %>
            <div class="span2">
              <div class="thumbnail">

                <div style="min-height: 100px; text-align: center;">
                  <%= link_to(image_tag(bia.logo.url(:list)), bia) %>
                  </div>
                <div style="font-size: 11px; font-weight: bold; text-align: center;"><%= link_to bia.name, bia %></div>

              </div>
            </div>
            <% end %>

          </div>

        </div>
      </div>
    </div>
    <div class="row-fluid">
      <div class="span4">
        <div class="holder pad10">
          <h5>Market Updates</h5>
          <% if @status_updates.size > 0 %>
            <div class="market-updates"> 
              <%= render 'status_updates/market_updates', status_updates: @status_updates %>
            </div>
          <% else %>
            <div class="alert">No Market Updates found.</div>
          <% end %>
        </div>
      </div>
      <div class="span4">
        <div class="holder pad10">
          <h5>Events</h5>
          <% if @events.any? %>  
            <div class="events-list">
              <%= render 'events/events_list', events: @events %>
            </div>
          <% else %>
            <div class="alert">No Events found.</div>
          <% end %>
        </div>
      </div>
      <div class="span4">
        <div class="holder pad10">
          <h5>Videos</h5>
          <% if @media_attachments.size > 0 %>
            <div class="videos-list">  
              <%= render 'media_attachments/videos_list', media_attachments: @media_attachments %>
            </div>
          <% else %>
            <div class="alert">No Videos found.</div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  <div class="span4">
    <div class="row-fluid">
    <%= render 'search_form', { locals: {css_class: 'hidden-mobile'} } %>
    </div>
  </div>

  <div class="span4">
    <%= render 'application/join_now' %>

    <div class="row-fluid">
      <div class="holder pad10">
        <h5>Communities in <%= @city.name %></h5>
        <ul class="list-none">
          <% @districts.each do |district| %>
          <li><%= link_to district.name, district_guide_path(district) %></li>
          <% end %>
        </ul>
      </div>
    </div>

    <div class="row-fluid">
      <div class="holder pad10">
        <h5>Shopping Districts</h5>
        <ul class="list-none">
          <% @city.business_improvement_areas.each do |bia| %>
          <li><%= link_to bia.name, bia %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>

<% content_for :js_loaded do %>
  <script type="text/javascript">
    $(document).ready(function(){
      setInterval("$('#carousel').carousel('next');", 8000);
      Window.helpers.initJScroll('.market-updates');
      Window.helpers.initJScroll('.events-list');
      Window.helpers.initJScroll('.videos-list');
    });
  </script>
<% end %>

<!--- Modals -->
<%= render 'status_updates/show_image' %>
<%= render 'messages/modal_new' %>
<%= render 'locations/modal_claim_login' %>
