<div class="modal fade" id="modal-user-video-call" data-backdrop="static" data-keyboard="false">
  <div class="modal-dialog modal-dialog-centered modal-xl" style="max-width: 80%;">
    <div class="modal-content">
      <div class="modal-body">
        <div class="row">
          <div class="col-md-12">
            <div class="cover-videos" style="height: 650px">
              <div id="videos">
                <div id="user-subscriber"></div>
                <div id="user-publisher"></div>
                <div id="user-timer-count"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <div class="d-flex align-items-center justify-content-center" style="width: 100%">
          <i id ="user-turn-off-audio" class="fas fa-microphone "></i>
          <i id ="user-turn-on-audio" class="fas fa-microphone-slash d-none"></i>
          <i id ="user-turn-off-camera" class="fas fa-video "></i>
          <i id ="user-turn-on-camera" class="fas fa-video-slash d-none"></i>
          <i class="close fa fa-times" type="button" data-dismiss="modal" aria-label="Close" id="user-close-video"></i>
        </div>
      </div>
    </div>
  </div>
</div>
