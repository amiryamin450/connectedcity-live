<div class="card-label-three">
  <div class="title">
    <h4>Trade Associations</h4>    
  </div>
</div>

<% if @location.trade_associations.size > 0 %>
  <div class="row card-row">
    <%  @location.trade_associations.in_groups_of(4) do |group| %>
      <% group.each do |association| %>
        <% if association %>
          <div class="col-md-3">
            <div class="business-body-card">
              <div class="img">
                <%= link_to(image_tag(association.logo.url(:list)), association) %>
              </div>
              <div class="title">
                <h3><%= link_to association.name, association %></h3>
              </div>
            </div>
          </div>
        <% end -%>
      <% end -%>
    <% end -%>
  </div>  
<% else %>
  <div class="alert alert-dark" role="alert">
    No Trade Associations found.
  </div>
<% end %>