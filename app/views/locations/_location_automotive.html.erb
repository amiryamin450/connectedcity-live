<div class="card-label-three">
  <div class="title">
    <h4>Automotive Listings</h4>
    <% if (user_signed_in? and current_user.has_role? :admin) or (user_signed_in? and current_user.can_manage_location? @location) %>
      <small><%= link_to "add", new_location_automotive_listing_path(@location), class: 'small' %> | <%= link_to 'manage', location_automotive_listings_path(@location) %></small>
    <% end %>
  </div>
</div>
<% if @auto_listings.size > 0 %>
  <div class="row card-row">
    <% @auto_listings.in_groups_of(4) do |group| %>
      <% group.each do |listing| %>
        <% if listing %>
          <div class="col-md-3">
            <div class="business-body-card">
              <div class="img mx-auto my-3">
                <% if listing.main_image.present? %>
                  <%= link_to(image_tag(listing.main_image.url(:list)), [listing.location, listing])%>
                <% else %>
                  <%= image_tag "http://placehold.it/320x320" %>
                <% end -%>
              </div>
              <div class="title">
                  <h3><%= link_to listing.title, [@location, listing] %></h3>
              </div>
              <div class="price">
                <p><%= humanized_money_with_symbol listing.price %></p>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="alert alert-dark" role="alert">
    No Auto Listings found.
  </div>
<% end %>