<!-- Breadcrumb -->
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="<%=root_path%>">Home</a></li>
      <% if @product.location.district %>
        <li class="breadcrumb-item"><a href="<%=district_guide_path(@product.location.district)%>"><%=@product.location.district.name%></a></li>
      <% end %>
      <% if @product.location.neighborhood %>
        <li class="breadcrumb-item"><%=@product.location.neighborhood.name%></li>
      <% end %>
      <% if @product.location.broker.present? %>
        <li class="breadcrumb-item"><a href=<%= "#{@base_path}business/#{@product.location.broker.slug}"%>><%=@product.location.broker.name%></a></li>
      <% end %>
      <li class="breadcrumb-item"><a href=<%="#{@base_path}business/#{@product.location.slug}"%>><%= @product.location.name %></a></li>
      <li class="breadcrumb-item active" aria-current="page"><a href="#"><%= @product.name %></a></li>
    </ol>
</nav>
<!-- Breadcrumb End -->
<div class="container-fluid">
  <div class="row">
    <div class="col-md-12">
      <div class="product-view-section">
        <div class="row">
          <div class="col-md-6">
            <%= render "product_images_swiper" %>
          </div>
          <div class="col-md-6">
            <div class="product-title">
              <h4><%= @product.name %></h4>
            </div>
            <div class="product-description">
              <p><%= @product.description.html_safe %></p>
            </div>
            <div class="divider"></div>
            <div class="product-price">
              <h6>Price:</h6>
              <h5><%= display_pricing @product %></h5>
              <% if @product.discount > 0 %>
                <h4><s><%= number_to_currency @product.price %></s></h4>
              <% end %>
            </div>
            <div class="divider"></div>
            <div class="product-quanitity">
              <h6>Quantity</h6>
              <div class="quanitity-counter">
                <input type='button' value='-' class='qtyminus' field='quantity' />
                <input type="number" name="quantity" id="quantity" step="1" min="1" max=<%= @product.disabled ? 1 : @product.quantity %>  value="1" title="Qty" class="input-text qty text" size="4" pattern="" inputmode="" <%= @product.disabled ? 'disabled' : nil %>>
                <input type='button' value='+' class='qtyplus' field='quantity' <%= @product.disabled ? 'disabled' : nil %>/>
              </div>
            </div>
            <div class="divider"></div>
            <div class="product-cart-btn">
              <%= form_tag line_items_path(product_id: @product), class: 'form-add-to-card', method: :post do %>
                <input type="hidden" name="quantity" id="line_item_quantity" value="1"/>
                <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                <% if user_signed_in? %>
                  <button type="submit" class="btn btn-primary add-to-cart" <%= @product.disabled || @cart.full ? 'disabled' : nil %>><img src="/cc_2.0/icon/shopping-cart.svg">Add to Cart</button>
                <% else %>
                  <a href="<%= new_user_session_path %>" class="btn btn-primary"><img src="/cc_2.0/icon/shopping-cart.svg">Add to Cart</a>
                <% end %>
              <% end %>
            </div>
            <div class="notice-success mt-2" style="width: 55%"></div>
            <% if (user_signed_in? && current_user.has_role?(:admin)) or (user_signed_in? && current_user.can_manage_location?(@location)) %>
              <div class="divider"></div>
              <div style="margin-top: 1.5em">
                <%= link_to "Edit", edit_location_product_path(@location, @product), class: 'btn btn-primary' %>
                <%= link_to "Create New Product", new_location_product_path(@location), class: 'btn btn-secondary' %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
      <!-- End -->
    </div>
  </div>
</div>

<br>
<script type="text/javascript">
  // newHref = "<%= line_items_path(product_id: @product)%>";
  var newQuantity = 1;
  var maxQuantity = 50;
  var currentQuantity = <%= @cart.present? ? @cart.total_quantity : 1 %>
  var productId = <%= @product.id %>

  $(".qtyplus").on("click", function() {
    var maxqty = <%= @product.disabled ? 1 : @product.quantity %>
    var $button = $(this);
    var oldValue = $("#quantity").val();
    var newVal = parseInt(oldValue) + 1;
    if ((newVal <= maxqty) && ((newVal + currentQuantity) <= maxQuantity)) {
      newQuantity = newVal
      $("#quantity").val(newQuantity);
    }
    $('#line_item_quantity').val(newQuantity);
  });

  $(".qtyminus").on("click", function() {
    var $button = $(this);
    var oldValue = $("#quantity").val();
    if (oldValue > 1) {
      newQuantity = parseFloat(oldValue) - 1;
    } else {
      newQuantity = 1;
    }
    $("#quantity").val(newQuantity);
    $('#line_item_quantity').val(newQuantity);
  });


  $('.form-add-to-card').submit(function(e) {
    e.preventDefault()
    var disabled = <%= @product.disabled || @cart.full %>
    if (disabled || currentQuantity >= 50) {
      return false;
    }

    $.ajax({
      url: `/line_items`,
      data: JSON.stringify({ product_id: productId, quantity: newQuantity }),
      method: "POST",
      dataType: "json",
      headers: {
        Accept: 'application/json',
        'Content-Type': 'application/json',
        'X-CSRF-Token': $('input[name=authenticity_token]').val(),
      },
    }).done(function (response) {
      const { line_item } = response;
      // $('.header-shopping-cart .cart-counter').load(" span.total-number");
      $('.header-cart-view').load(' .header-shopping-cart');
      $('.notice-success').html('<div class="alert alert-success">Product added to cart successfully</div>').fadeOut(3000)
      setTimeout(function() { $('.notice-success').html('').fadeIn(0) }, 3000);
      currentQuantity = currentQuantity + newQuantity
      newQuantity = 1;
      $("#quantity").val(1);
      $("#line_item_quantity").val(1);
      if (currentQuantity >= 50) $('.add-to-cart').attr('disabled', true);
    })
  })

  $('.qty').on({
    change: function(e) {
      clicked = true
      firstStep = true
      var maxQuantityProduct = <%= @product.disabled ? 1 : @product.quantity %>
      var current = +$(this).val();
      if (current <= maxQuantityProduct) {
        current = current === 0 ? 1 : current
        $(this).val(current)
        $('#line_item_quantity').val(current)
        newQuantity = current;
      } else {
        $(this).val(maxQuantityProduct)
        $('#line_item_quantity').val(maxQuantityProduct)
        newQuantity = maxQuantityProduct
      }
    },
    keydown: function(e) {
      var ch = String.fromCharCode(e.which)
      if (/E/.test(ch) || e.keyCode == 189 || e.keyCode == 187) {
        e.preventDefault();
        return false;
      }
      if (/[0-9]/.test(ch) || e.key === 'Backspace' || e.keyCode == 8) {
        if (/^0/.test(ch) && $(this).val().length === 0) {
          e.preventDefault();
          return false
        }

        if (e.key === 'Enter' || e.keyCode === 13) {
          e.preventDefault();
          return false;
        }
      }
    }
  })
</script>
