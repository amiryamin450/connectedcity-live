
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="<%= root_path %>">Home</a></li>
      <%if @district %>
        <li class="breadcrumb-item active" aria-current="page"><a href="#" style="margin-left: 10px;"><%=@district.name%></a></li>
      <% else %>
        <li class="breadcrumb-item"><a href="<%= root_path %>" style="margin-left: 10px;">Vancouver</a></li>
      <% end %>
      <li class="breadcrumb-item" aria-current="page"><a href="#" style="margin-left: 10px;"><%= "#{ @vertical_market_news.name}" %></a></li>
    </ol>
</nav>
<div class="category-body-section">
  <div class="container-fluid">
    <h1>Browse <%= @vertical_market_news.present? ? @vertical_market_news.name : 'Civic News' %> in Vancouver</h1>
    <row>
      <div class="col-md-12">
        <div class="map-section">
          <div id="map"></div>
        </div>
      </div>
    </row>
  </div>
</div>
