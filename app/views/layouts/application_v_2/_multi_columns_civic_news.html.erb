<div class="landing-page-three-column-section">
  <div class="multi" id="multiple_items_civic_news">
    <div class="colla">
      <h3 class="sticky-heading">Updates</h3>
      <div class="input-group-prepend search-box d-block">
        <%= select_tag 'civic-news-status-update-dropdown', options_from_collection_for_select(@categories_news, 'id', 'name'), prompt: 'All', class: 'form-control mb-3', remote: true %>
        <div class="status-updates-data">
          <% if @status_updates.size > 0 %>
            <% @status_updates.each do |status_update| %>
              <%= render 'layouts/application_v_2/status_update', status_update: status_update %>
            <% end %>
          <% else %>
            <div class="alert">No Market Updates found.</div>
          <% end %>
        </div>
      </div>
    </div>
    <div class="colla">
      <h3 class="sticky-heading">Videos</h3>
      <div class="input-group-prepend search-box d-block">
        <%= select_tag 'civic-news-media-attachment-dropdown', options_from_collection_for_select(@categories_news, 'id', 'name'), prompt: 'All', class: 'form-control mb-3' %>
        <div class="media-attachments-data">
          <% if @media_attachments.size > 0 %>
            <% @media_attachments.each do |media_attachment| %>
              <%= render 'layouts/application_v_2/media_attachment', media_attachment: media_attachment %>
            <% end %>
          <% else %>
            <div class="alert">No videos found.</div>
          <% end %>
        </div>
      </div>
    </div>
    <div class="colla">
      <h3 class="sticky-heading">News</h3>
      <div class="input-group-prepend search-box d-block">
        <%= select_tag 'civic-news-news-article-dropdown', options_from_collection_for_select(@categories_news, 'id', 'name'), prompt: 'All', class: 'form-control mb-3' %>
        <div class="news-articles-data">
          <% if @news_articles.size > 0 %>
            <% @news_articles.each do |news_article| %>
              <%= render 'layouts/application_v_2/news_article', news_article: news_article %>
            <% end %>
          <% else %>
            <div class="alert">No news article found.</div>
          <% end %>
        </div>
      </div>
    </div>
    <div class="colla">
      <h3 class="sticky-heading">Events</h3>
      <div class="input-group-prepend search-box d-block">
        <%= select_tag 'civic-news-event-dropdown', options_from_collection_for_select(@categories_news, 'id', 'name'), prompt: 'All', class: 'form-control mb-3' %>
        <div class="events-data">
          <% if @events.size > 0 %>
            <% @events.each do |event| %>
              <%= render 'layouts/application_v_2/event', event: event %>
            <% end %>
          <% else %>
            <div class="alert">No Events found.</div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<%= javascript_include_tag "application_v_2" %>
<!-- Add the slick-theme.css if you want default styling -->
<link rel="stylesheet" type="text/css" href="//cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"/>
<!-- Add the slick-theme.css if you want default styling -->
<link rel="stylesheet" type="text/css" href="//cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css"/>
<script type="text/javascript" src="//cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>

<% if @status_updates.size > 0 %>
<div class="status-updates-modal">
  <% @status_updates.each do |status_update| %>
    <%= render 'status_updates/modal_content_latest', status_update: status_update %>
  <% end %>
</div>
<% end %>

<% if @media_attachments.size > 0 %>
<div class="media-attachments-modal">
  <% @media_attachments.each do |media_attachment| %>
    <%= render 'status_updates/modal_video_latest', media_attachment: media_attachment %>
  <% end %>
</div>
<% end %>

<% if @events.size > 0 %>
<div class="events-modal">
  <% @events.each do |event| %>
    <%= render 'status_updates/modal_event_latest', event: event %>
  <% end %>
</div>
<% end %>
<% if @news_articles.size > 0 %>
<div class="news-articles-modal">
  <% @news_articles.each do |news_article| %>
    <%= render 'news_articles/modal_news_latest', news: news_article %>
  <% end %>
</div>
<% end %>

<script type="text/javascript">
  $(document).ready(function(){
    $('#multiple_items_civic_news.multi').slick({
      infinite: true,
      slidesToShow: 4,
      slidesToScroll: 1,
      arrows: false,
      speed: 300,
      responsive: [
        {
          breakpoint: 1024,
          settings: {
            slidesToShow: 3,
            slidesToScroll: 1,
            infinite: true
          }
        },
        {
          breakpoint: 600,
          settings: {
            slidesToShow: 2,
            slidesToScroll: 1,
            infinite: true
          }
        },
        {
          breakpoint: 480,
          settings: {
            slidesToShow: 1,
            slidesToScroll: 1,
            infinite: true
          }
        }
      ]
    });

    const $class1 = $('.video-attachment-event');
    const $class2 = $('.view-more-attachment-event');
    const $class3 = $('.title-attachment-event');

    $class1.add($class2).add($class3).on('click', function() {
      var modal = $(this);
      var valueId = modal.attr('data-target');
      var v = $(valueId).contents().find("iframe");
      var url = v.attr('data-src');
      v.attr('allow','autoplay')
      v.attr('src', url + '?autoplay=1&amp;modestbranding=1&amp;showinfo=0')
    })

    $('.close.media-attachment').on('click', function() {
      var modal = $(this);
      var valueId = modal.attr('data-id');
      var v = $('#'+valueId).contents().find("iframe");
      var url = v.attr('src');
      v.attr('src', '')
      v.removeAttr('allow')
    })
    var subNeighborhoodId = '<%= params[:sub_neighborhood_slug] %>'
    var neighborhoodId = '<%= params[:neighborhood_slug] %>'
    var disctrictId = '<%= params[:district_slug] %>' || '<%= params[:district_route] %>'
    var cityId = '<%= params[:city_slug] %>'
    $('#civic-news-status-update-dropdown').on('change', function(event) {
      let categoryId = event.target.value
      $.ajax({
        url: `/city_news_articles/filter_updates?category_id=${categoryId}`,
        method: "GET",
        data:{
          sub_neighborhood_slug: subNeighborhoodId,
          neighborhood_slug: neighborhoodId,
          disctrict_slug: disctrictId,
          city_slug: cityId
        },
        dataType: "script",
      })
    })

    $('#civic-news-media-attachment-dropdown').on('change', function(event) {
      let categoryId = event.target.value
      $.ajax({
        url: `/city_news_articles/filter_media_attachments?category_id=${categoryId}`,
        method: "GET",
        data:{
          sub_neighborhood_slug: subNeighborhoodId,
          neighborhood_slug: neighborhoodId,
          disctrict_slug: disctrictId,
          city_slug: cityId
        },
        dataType: "script",
      })
    })

    $('#civic-news-news-article-dropdown').on('change', function(event) {
      let categoryId = event.target.value
      $.ajax({
        url: `/city_news_articles/filter_news_articles?category_id=${categoryId}`,
        method: "GET",
        data:{
          sub_neighborhood_slug: subNeighborhoodId,
          neighborhood_slug: neighborhoodId,
          disctrict_slug: disctrictId,
          city_slug: cityId
        },
        dataType: "script",
      })
    })

    $('#civic-news-event-dropdown').on('change', function(event) {
      let categoryId = event.target.value
      $.ajax({
        url: `/city_news_articles/filter_events?category_id=${categoryId}`,
        method: "GET",
        data:{
          sub_neighborhood_slug: subNeighborhoodId,
          neighborhood_slug: neighborhoodId,
          disctrict_slug: disctrictId,
          city_slug: cityId
        },
        dataType: "script",
      })
    })

    // $(".modal").on('show.bs.modal', function(){
    //   setTimeout(function() { $('.modal-backdrop.in').remove(); }, 500)
    // })

    $(".modal .close").click(function(){
      $('.modal-backdrop.in').remove();
    })
