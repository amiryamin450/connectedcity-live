<%= simple_form_for [@location, @news_article] do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.input :user_id, as: :hidden %>
    <%= f.input :title, input_html: { class: 'input-xxlarge' } %>
    <% if @is_municipality || [174, 164].include?(@vertical_market.id) %>
      <% hidden = [174, 164].include?(@vertical_market.id) ? 'display: none' : 'display: block' %>
      <div class="control-group string required category" style="<%= hidden %>">
        <%= f.label :category %>
        <div class="input-group-prepend search-box">
          <%= select_tag 'news_article[category_id]', options_from_collection_for_select(@categories_news, 'id', 'name'), prompt: 'All Categories', class: 'form-control' %>
        </div>
      </div>
    <% end %>
    <%= f.input :content, input_html: { class: 'input-block-level' } %>
    <%= f.input :image, as: :logo_preview %>
  </div>

  <div class="form-actions">
    <%= f.button :submit, class: 'btn btn-primary' %>
  </div>
<% end %>

<script type="text/javascript">
  $(document).ready(function() {
    var need_category = "<%= [174, 164].include?(@vertical_market.id) %>"
    if (need_category === "true") {
      var value = <%= @categories_news[0].id %>
      $("form#new_news_article select").val(value);
    }
  })
</script>
