<%
  metamagic site: "ConnectedCity",
            title: ["#{@location.name} in #{@location.business_improvement_area.try(:name) || @neighborhood.try(:name) || @location.district.try(:name)}, #{@city.try(:name)}", :site],
            separator: " — ",
            og: {
              title: @location.name + " - ConnectedCity",
              description: strip_tags(@location.try(:content).to_s),
              image: @location_carousel_images.first.try(:url),
              url: location_url(@location)
            }
%>
<!-- Breadcrumb -->
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="<%=root_path%>">Home</a></li>
      <% if @location.municipality %>
        <% region = @location.municipality.region %>
        <% url = "/#{@location.province.slug}/#{region.slug}/#{@location.municipality.slug}" %>
        <li class="breadcrumb-item"><a href="<%= url %>"><%= @location.municipality.name%></a></li>
      <% end %>
      <% if @location.city %>
        <% municipality = @location.city.municipality %>
        <% region = municipality.region %>
        <% url = "/#{@location.province.slug}/#{region.slug}/#{municipality.slug}/#{@location.city.slug}" %>
        <li class="breadcrumb-item"><a href="<%= url %>"><%= @location.city.name%></a></li>
      <% end %>
      <% if @location.district && @location.city%>
        <% municipality = @location.city.municipality %>
        <% region = municipality.region %>
        <% province = region.province%>
        <li class="breadcrumb-item">
          <a href="<%="/#{province.slug}/#{region.slug}/#{municipality.slug}/#{@location.city.slug}/#{@location.district.slug}"%>">
            <%= @location.district.name%>
          </a>
        </li>
      <% end %>
      <% if @location.neighborhood && @location.district && @location.city%>
        <li class="breadcrumb-item">
          <a href="<%="/#{province.slug}/#{region.slug}/#{municipality.slug}/#{@location.city.slug}/#{@location.district.slug}/#{@location.neighborhood.slug}"%>">
            <%= @location.neighborhood.name %>
          </a>
        </li>
      <% end %>
      <% if @location.sub_neighborhood && @location.neighborhood && @location.district && @location.city%>
        <li class="breadcrumb-item">
          <a href="<%="/#{province.slug}/#{region.slug}/#{municipality.slug}/#{@location.city.slug}/#{@location.district.slug}/#{@location.neighborhood.slug}/#{@location.sub_neighborhood.slug}"%>">
            <%= @location.sub_neighborhood.name %>
          </a>
        </li>
      <% end %>
      <% @vertical_market.ancestors.each do |ancestor| %>
        <% if @location&.sub_neighborhood%>
          <li class="breadcrumb-item"><a href="<%=city_district_nbh_sub_guide_path(@location&.city&.slug, @location&.district&.slug, @location&.neighborhood&.slug, @location&.sub_neighborhood&.slug, ancestor.slug)%>"><%=ancestor.name%></a></li>
        <% elsif @location&.neighborhood%>
          <li class="breadcrumb-item"><a href="<%=city_district_neighborhood_guide_path(@location&.city&.slug, @location&.district&.slug, @location&.neighborhood&.slug, ancestor.slug)%>"><%=ancestor.name%></a></li>
        <% elsif @location&.district%>
          <li class="breadcrumb-item"><a href="<%=city_district_guide_path(@location&.city&.slug, @location&.district&.slug, ancestor.slug)%>"><%=ancestor.name%></a></li>
        <% elsif @location&.city%>
          <li class="breadcrumb-item"><a href="<%=city_guide_path(@location&.city&.slug, ancestor.slug)%>"><%=ancestor.name%></a></li>
        <% elsif @location&.municipality%>
          <li class="breadcrumb-item"><a href="<%=municipality_guide_path(@location&.municipality&.slug, ancestor.slug)%>"><%=ancestor.name%></a></li>
        <%else%>
          <li class="breadcrumb-item"><a href=<%="#"%>><%=ancestor.name%></a></li>
        <% end %>
      <% end %>
      <% if @location&.sub_neighborhood%>
        <li class="breadcrumb-item"><a href="<%=city_district_nbh_sub_sub_market_guide_path(@location&.city&.slug, @location&.district&.slug, @location&.neighborhood&.slug, @location&.sub_neighborhood&.slug, @vertical_market.parent&.slug, @vertical_market.slug)%>"><%=@vertical_market.name%></a></li>
      <% elsif @location&.neighborhood%>
        <li class="breadcrumb-item"><a href="<%=city_district_neighborhood_sub_market_guide_path(@location&.city&.slug, @location&.district&.slug, @location&.neighborhood&.slug, @vertical_market.parent&.slug, @vertical_market.slug)%>"><%=@vertical_market.name%></a></li>
      <% elsif @location&.district%>
        <li class="breadcrumb-item"><a href="<%=city_district_sub_market_guide_path(@location&.city&.slug, @location&.district&.slug, @vertical_market.parent&.slug, @vertical_market.slug)%>"><%=@vertical_market.name%></a></li>
      <% elsif @location&.city%>
        <li class="breadcrumb-item"><a href="<%=city_sub_market_guide_path(@location&.city&.slug, @vertical_market.parent&.slug, @vertical_market.slug)%>"><%=@vertical_market.name%></a></li>
      <% elsif @location&.municipality%>
        <li class="breadcrumb-item"><a href="<%=municipality_sub_market_guide_path(@location&.municipality&.slug, @vertical_market.parent&.slug, @vertical_market.slug)%>"><%=@vertical_market.name%></a></li>
      <%else%>
        <li class="breadcrumb-item"><a href=<%="#"%>><%=''%></a></li>
      <% end %>
      <% if  @location.broker.present? %>
        <li class="breadcrumb-item"><a href=<%="/business/#{@location.broker.slug}" %>><%= @location.broker.name %></a></li>
      <% end %>
      <li class="breadcrumb-item active" aria-current="page"><%=@location.name%></li>
    </ol>
</nav>
<!-- Breadcrumb End -->
<!-- Main Section -->
<div class="business-body-section">
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-6">
        <div class="business-info">
            <div class="business-card">
              <div class="banner-img">
                <% if @location_carousel_images.any? %>
                  <%= image_tag @location_carousel_images.first.url %>
                <% end %>
              </div>
              <!--  -->
              <div class="brand-contact-details">
                  <div class="row row-card-details d-flex" style="display:flex !important">
                    <div class="col-2" style="flex:unset !important">
                        <div class="brand-icon">
                          <%= image_tag @location.logo.url %>
                        </div>
                    </div>
                    <div class="col-10">
                      <div class="row details-row">
                        <div class="col-12">
                            <div class="title">
                              <h3><%= @location.name %></h3>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="d-flex">
                              <i class="far fa-map-marker-alt"></i>
                              <p class="mb-0"><%= @location.address %> &middot; <%= "#{@location&.city&.name} #{@location&.province&.abbr}, #{@location.postal_code}" %></p>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="d-flex">
                              <i class="far fa-globe"></i>
                              <p><%= link_to('Visit us online!', @location.website_url, target: :_blank) if @location.website_url.present? %></p>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="d-flex">
                              <i class="far fa-envelope"></i>
                              <p><%= mail_to @location.email if @location.email.present? %></p>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="d-flex">
                              <i class="far fa-phone-alt"></i>
                              <p><%= display_phone 'show_phone', 'phone', 'Phone', @location %></p>
                            </div>
                        </div>
                        <% if user_signed_in? && @location.users.pluck(:id).include?(current_user&.id)%>
                          <div class="col-12 d-flex align-items-center" style="height: 40px; margin-top: 5px">
                              <% if @location.available_call == true%>
                                <%checked = "checked"%>
                              <%else%>
                                <%checked = ""%>
                              <%end%>
                              <label class="switch">
                                <input id="toggle-available-call" type="checkbox" <%=checked%>>
                                <span class="slider round"></span>
                              </label>
                              <div style="margin-left: 5px">Turn on to Receive a Video Call</div>
                          </div>
                        <%end%>
                      </div>
                    </div>
                  </div>
              </div>
              <hr>
              <% if @location.operating_hours.where("starts_at IS NOT NULL OR closed = 1").exists? %>
                <div class="operating-hours">
                  <div class="title">
                    <h3>Operating Hours</h3>
                  </div>
                  <div class="timing">
                    <ul class="w-auto ps-3">
                      <% @location.operating_hours.where("starts_at IS NOT NULL OR closed = 1").each do |operating_hour| %>
                        <li class="my-0"><%= operating_hour.day.to_s.humanize %>
                        <span>
                          <% if operating_hour.open? %>
                            <%= operating_hour.starts_at.strftime("%-I:%M %p") %> &ndash; <%= operating_hour.ends_at.strftime("%-I:%M %p") %>
                          <% else %>
                            Closed
                          <% end %>
                        <span>
                        </li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              <% end %>

              <div class="operating-hours">
                  <div class="btn" style="cursor: unset;">
                    <div class="row justify-content-end">
                        <% if (user_signed_in? and current_user.has_role? :admin) or (user_signed_in? and current_user.can_manage_location? @location)  %>
                          <div class="col-2" style="padding-left: 0px;">
                            <a class="btn btn-primary-outline" style="background-color: #10375C; color: #fff; display: flex; justify-content: center;" href=<%="/business/#{@location.slug}/edit" %>>Edit</a>
                          </div>
                        <% end %>
                        <% if @location.business_owner.blank? %>
                          <div class="col-4" style="padding-right: 0px; padding-left: 0px;">
                            <%= link_to "Claim Business", claim_location_path, class: "btn btn-primary-outline" %>
                          </div>
                        <% end %>
                        <div class="col-2" style="padding-right: 0px; padding-left: 0px; margin-left: 15px; text-align: center;" id="favorite-<%= @location.id %>">
                          <%= render 'favorites/like_button_v2', location_id: @location.id, vertical_market_slug: @location.vertical_markets.first.slug if user_signed_in? and @location.vertical_markets.present? %>
                        </div>
                        <% if user_signed_in? && !@location.users.pluck(:id).include?(current_user&.id)%>
                          <div class="col-3" style="padding-right: 0px;" id="call-video">
                              <% if @location.available_call == true%>
                                <button class="btn btn-primary-color" data-toggle="modal">Video Call</button>
                              <%else%>
                                <button class='btn btn-secondary' disabled aria-disabled='true'>Video Call</button>
                              <%end%>
                          </div>
                        <%end%>
                    </div>
                  </div>
              </div>
              <hr>
              <div class="description">
                  <h4>Description</h4>
                  <p class="short-description mt-0"><%= truncate_html(strip_tags(@location.content&.html_safe), length: 50) %></p>
                  <div class="collapse" id="textCollapse1">
                    <%= strip_tags(@location.content&.html_safe) %>
                  </div>
                  <a class="text-dark small expand-text" data-bs-toggle="collapse" href="#textCollapse1" role="button" aria-expanded="false" aria-controls="textCollapse" onclick="hideShortDescription('.description')">
                      View more
                  </a>
              </div>
              <hr>
              <% if @location.business_improvement_area.present? %>
                <div class="shopping-district">
                    <h4>Shopping District</h4>
                    <div class="row">
                      <div class="col-md-3">
                          <div class="img">
                            <%= image_tag @location.business_improvement_area.logo.url %>
                          </div>
                      </div>
                      <div class="col-md-9">
                          <h4><%= @location.business_improvement_area.name %></h4>
                          <p class="short-description"><%= truncate_html(strip_tags(@location.business_improvement_area.description), length: 50) %></p>
                          <p class="collapse" id="textCollapse2">
                            <%= strip_tags(@location.business_improvement_area.description.html_safe) %>
                          </p>
                          <a class="text-dark small expand-text" data-bs-toggle="collapse" href="#textCollapse2" role="button" aria-expanded="false" aria-controls="textCollapse" onclick="hideShortDescription('.shopping-district')">
                              View more
                          </a>
                          <div class="shopping-district-btn">
                            <%= link_to 'Learn More', @location.business_improvement_area, class: 'btn btn-primary' %>
                          </div>
                      </div>
                    </div>
                </div>
              <% end %>
            </div>

            <div class="map-section my-5 d-block d-md-none">
              <div id="map-mobile" class="clearfix location-profile-map" style="height: 240px;" data-coordinates=<%= raw @location.geo_location.to_json() %>></div>
            </div>
            <!-- Tab Start -->
            <div class="SideBar-tabs">
              <ul class="nav nav-tabs" role="tablist">
                  <li class="nav-item active">
                    <a class="nav-link" data-toggle="tab" href="#Update">Updates</a>
                  </li>
                  <% if !@location.is_profile %>
                    <li class="nav-item">
                      <a class="nav-link" data-toggle="tab" href="#Articles">News</a>
                    </li>
                  <% end %>
                <% if (![174, 164, 114].include?(@vertical_market.id) && @is_location_normal && request.path != '/business/city-of-vancouver') %>
                  <li class="nav-item">
                    <a class="nav-link" data-toggle="tab" href="#Entries">Blog</a>
                  </li>
                <% end %>
              </ul>
              <!-- Tab panes -->
              <div class="tab-content">
                  <div id="Update" class="container tab-pane active">
                    <%= render 'status_updates' %>
                    <div class="divider mt-5"></div>
                  </div>
                  <div id="Articles" class="container tab-pane">
                    <%= render 'news_articles' %>
                    <div class="divider mt-5"></div>
                  </div>
                <% if (![174, 164, 114].include?(@vertical_market.id) && @is_location_normal && request.path != '/business/city-of-vancouver') %>
                  <div id="Entries" class="container tab-pane">
                    <%= render 'blog_entry' %>
                    <div class="divider mt-5"></div>
                  </div>
                <% end %>
              </div>
            </div>

            <!-- END -->
        </div>
      </div>
      <!-- SideBar End -->
      <div class="col-md-6 mt-5">
        <div class="business-product-body">
            <div class="map-section my-5 d-none d-md-block">
              <div id="map" class="clearfix location-profile-map" style="height: 240px;" data-coordinates=<%= raw @location.geo_location.to_json() %>></div>
            </div>

            <% if ![174, 164].include?(@vertical_market.id) && @is_location_normal %>
              <% vertical_market_category_id = VerticalMarketCategory.find_by_slug("municipal-government-and-agencies").id%>
              <% if @location.is_profile %>
                <%= render 'location_media' %>
                <div class="products-content">
                  <%= render 'location_products' %>
                </div>
                <%= render 'location_services' %>
                <%= render 'location_events' %>
                <%= render 'location_listings' %>
              <% elsif @location.vertical_market_categories.pluck(:id).include?(vertical_market_category_id) %>
                <%= render 'location_media' %>
                <%= render 'location_events' %>
                <%= render 'location_city_hall' %>
                <%= render 'location_city_councillors' %>
                <%= render 'location_parks_recreation_commissioners' %>
              <% else %>
                <%= render 'location_menu_flayers' %>
                <!-- Card Row END -->
                <%= render 'location_media' %>
                <% if @location.vertical_market_category_ids.include?(40) %>
                  <%= render 'location_automotive' %>
                <% end %>
                <% if @location.vertical_market_category_ids.include?(99) %>
                  <%= render 'location_listings' %>
                <% elsif @location.vertical_market_category_ids.include?(100) %>
                  <%= render 'agents' %>
                <% elsif @location.vertical_market_category_ids.include?(101) %>
                  <%= render 'rental_properties' %>
                <% elsif @location.vertical_market_category_ids.include?(102) %>
                  <%= render 'new_home_communities' %>
                <% else %>
                  <div class="products-content">
                    <%= render 'location_products' %>
                  </div>
                <% end %>
                <%= render 'location_coupons' %>
                <%= render 'location_services' %>
                <%= render 'location_events' %>
                <%= render 'location_trade_associations' %>
                <%= render 'location_brands' %>
                <%= render 'location_employment' %>
              <% end %>
            <% else %>
                <%= render 'location_media' %>
                <%= render 'location_events' %>
            <% end %>
        </div>
      </div>
      <%= render 'modal_call/modal_call'%>
      <!--Body End -->
    </div>
  </div>
</div>
<br>

<script type="text/javascript">
  $(document).ready(function() {
    $("#toggle-available-call").on("click", function(){
      let location_id = '<%= @location.id%>'
      $.ajax({
        url: `/video_calls/get_available_call_location?location_id=${location_id}`,
        method: "GET",
        dataType: "json"
      }).done(function(response){
        $.ajax({
          url: `/video_calls/set_available_call_location`,
          method: "PUT",
          data: {
            location_id: location_id,
            status_available: !response.available_call
          }
        })
      })
    })

    if('<%= user_signed_in?%>' == "true" && $("#call-video").length > 0){
      // setInterval(()=>{
      //   let location_id = '<%= @location.id%>'
      //   $.ajax({
      //     url: `/video_calls/get_status_from_location?location_id=${location_id}`,
      //     method: "GET",
      //     dataType: "json"
      //     }).done(function( response) {
      //       if(response.user_available_call == true && response.location_available_call == true){
      //         $("#call-video").html("<button class='btn btn-primary-color' data-toggle='modal'>Video Call</button>")
      //       }else{
      //         $("#call-video").html("<button class='btn btn-secondary' disabled aria-disabled='true'>Video Call</button>")
      //       }
      //     })
      //   }, 5000)
    }
    $("#call-video").on("click",function(){
      $("#modal-video-call").modal("show");

      var apiKey;
      var sessionId;
      var token;
      var session_call
      var seconds = 0
      var timerUser
      function upTimer() {
        ++seconds;
        var hour = Math.floor(seconds / 3600);
        if(hour < 10) hour = "0"+hour
        var minute = Math.floor((seconds - hour * 3600) / 60);
        if(minute < 10) minute = "0"+minute
        var updSecond = seconds - (hour * 3600 + minute * 60);
        if(updSecond < 10) updSecond = "0"+updSecond
        $("#timer-count").html(hour + ":" + minute + ":" + updSecond)
      }

      function handleError(error) {
        if (error) {
          console.error(error);
        }
      }

      function initializeSession(apiKey,sessionId ) {
        session_call = OT.initSession(apiKey, sessionId);
        // Subscribe to a newly created stream
        session_call.on('streamCreated', function streamCreated(event) {
          var subscriberOptions = {
            insertMode: 'append',
            width: '100%',
            height: '100%'
          };
          if($("#subscriber").children().length>0){
            clearInterval(timerUser)
          }
          $("#subscriber").html("")
          var subscriber = session_call.subscribe(event.stream, 'subscriber', subscriberOptions, handleError);
          timerUser = setInterval(upTimer, 1000);
        });

        session_call.on('sessionDisconnected', function sessionDisconnected(event) {
          console.log('You were disconnected from the session.', event.reason);
          userPublisher.destroy()
        });

        // initialize the publisher
        var publisherOptions = {
          insertMode: 'append',
          width: '100%',
          height: '100%'
        };
         $("#publisher").html("")
        var userPublisher = OT.initPublisher('publisher', publisherOptions, handleError);

        // Connect to the session
        session_call.connect(token, function callback(error) {
          if (error) {
            handleError(error);
          } else {
            // If the connection is successful, publish the publisher to the session
            session_call.publish(userPublisher, handleError);
          }
        });

        session_call.on('streamDestroyed', function sessionDisconnected(event) {
          // console.log('You were disconnected from the session .', event.reason);
          $("#modal-video-call").modal("hide");
          $("#modal-end-video-call").modal("show")
          session_call.disconnect()
          clearInterval(timerUser)
          $("#timer-count").html("")
          $("#publisher").html("")
          $("#subscriber").html("")
          $("#turn-on-camera").addClass("d-none")
          $("#turn-off-camera").removeClass("d-none")
          $("#turn-on-audio").addClass("d-none")
          $("#turn-off-audio").removeClass("d-none")
          $.ajax({
            url: `/video_calls/set_status_call`,
            method: "PUT",
            data: {
              session_id: sessionId,
              status: "available"
            }
            }).done(function( response) {

            })

        });

        $("#turn-off-camera").on("click",function(){
          userPublisher.publishVideo(false);
          $("#turn-off-camera").addClass("d-none")
          $("#turn-on-camera").removeClass("d-none")
        })

        $("#turn-on-camera").on("click",function(){
          userPublisher.publishVideo(true);
          $("#turn-on-camera").addClass("d-none")
          $("#turn-off-camera").removeClass("d-none")
        })

        $("#turn-off-audio").on("click",function(){
          userPublisher.publishAudio(false);
          $("#turn-off-audio").addClass("d-none")
          $("#turn-on-audio").removeClass("d-none")
        })

        $("#turn-on-audio").on("click",function(){
          userPublisher.publishAudio(true);
          $("#turn-on-audio").addClass("d-none")
          $("#turn-off-audio").removeClass("d-none")
        })

        $("#close-video").on("click",function(){
          userPublisher.destroy()
          session_call.disconnect()
          clearInterval(timerUser)
          $("#timer-count").html("")
          $("#publisher").html("")
          $("#subscriber").html("")
          $("#turn-on-camera").addClass("d-none")
          $("#turn-off-camera").removeClass("d-none")
          $("#turn-on-audio").addClass("d-none")
          $("#turn-off-audio").removeClass("d-none")
          $.ajax({
            url: `/video_calls/set_status_call`,
            method: "PUT",
            data: {
              session_id: sessionId,
              status: "available"
            }
            }).done(function( response) {

            })
        })
      }
        // console.log(start())
        apiKey = "<%= ENV['VONAGE_API_KEY'] %>";
        async function fetchToken() {
          location_id = '<%= @location.id%>'
          let vonageData = {};
          vonageData = await fetch(`/video_calls/get_vonage_token?location_id=${location_id}`, {
            method: 'get',
            }).then(function(response) {
            if (response.ok) {
              return response.json();
            }
            return Promise.reject(response);
            }).then(function (data) {
            return {sessionId: data.session_id, token: data.token}
          })
          return vonageData;
        }

        fetchToken().then(vonageData =>{
          sessionId = vonageData.sessionId,
          token = vonageData.token
          initializeSession(apiKey, sessionId)
          var timeCall = setTimeout(()=>{
            $.ajax({
            url: `/video_calls/get_status_from_session?session_id=${sessionId}`,
            method: "GET",
            dataType: "json",
            }).done(function( response) {

              if($("#subscriber").children().length == 0 && response.status.filter(status => (status == "accept_call")).length == 0){
                clearInterval(timerUser)
                $("#timer-count").html("00:00:00")
                $("#modal-video-call").modal("hide");
                $("#modal-message-call-reject").modal("show")
                session_call.disconnect()
                $("#publisher").html("")
                $("#subscriber").html("")
                clearInterval(timeCall)
                $.ajax({
                url: `/video_calls/set_status_call`,
                method: "PUT",
                data: {
                  session_id: sessionId,
                  status: "available"
                }
                }).done(function( response) {

                })
              }
            })
          },60000)
          var getStatusSession = setInterval(()=>{
            $.ajax({
                url: `/video_calls/get_status_from_session?session_id=${sessionId}`,
                method: "GET",
                dataType: "json",
                }).done(function( response) {
                    if(response.status.filter(status => status != "reject").length == 0){
                      $("#modal-video-call").modal("hide");
                      $("#modal-message-call-reject").modal("show")
                      clearInterval(getStatusSession)
                      clearTimeout(timeCall)
                      clearInterval(timerUser)
                      $("#timer-count").html("00:00:00")
                      userPublisher.destroy()
                      session_call.disconnect()
                      $("#publisher").html("")
                      $("#subscriber").html("")
                    }
                    if(response.status.filter(status => status != "available").length == 0){
                      clearInterval(getStatusSession)
                      clearTimeout(timeCall)
                    }
                    if(response.status.filter(status => status == "accept_call").length > 0){
                      clearTimeout(timeCall)
                    }

                })

          }, 5000)
        })
    })
  })

  $(".modal .close").click(function(){
    $('.modal-backdrop.in').remove();
  })

  function hideShortDescription(container) {
    $(container + ' .short-description').css('display', $(container + ' .short-description').css('display') === 'none' ? 'block' : 'none');
    $(container + ' .expand-text').text($(container + ' .short-description').css('display') === 'none' ? 'View less' : 'View more');
  }

  window.locations = <%= raw map_locations_data([@location]) %>;
</script>
