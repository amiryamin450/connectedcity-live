<div class="landing-page-three-column-section">
  <div class="multi" id="multiple_items">
    <div class="colla">
      <h3 class="sticky-heading">Market Updates</h3><br>
      <% if @status_updates.size > 0 %>
          <% @status_updates.each do |status_update| %>
            <%= render 'layouts/application_v_2/status_update', status_update: status_update %>
          <% end %>
      <% else %>
        <div class="alert">No Market Updates found.</div>
      <% end %>
    </div>
    <div class="colla">
      <h3 class="sticky-heading">Videos</h3><br>
      <% if @media_attachments.size > 0 %>
          <% @media_attachments.each do |media_attachment| %>
            <%= render 'layouts/application_v_2/media_attachment', media_attachment: media_attachment %>
          <% end %>
      <% else %>
        <div class="alert">No videos found.</div>
      <% end %>
    </div>
    <div class="colla">
      <h3 class="sticky-heading">News</h3><br>
      <% if @news.size > 0 %>
          <% @news.each do |news_article| %>
            <%= render 'layouts/application_v_2/news_article', news_article: news_article %>
          <% end %>
      <% else %>
        <div class="alert">No news article found.</div>
      <% end %>
    </div>
    <div class="colla">
      <h3 class="sticky-heading">Events</h3><br>
      <% if @events.size > 0 %>
          <% @events.each do |event| %>
            <%= render 'layouts/application_v_2/event', event: event %>
          <% end %>
      <% else %>
        <div class="alert">No Events found.</div>
      <% end %>
    </div>
    <div class="colla">
      <h3 class="sticky-heading">Services</h3><br>
      <% if @services && @services.size > 0 %>
          <% @services.each do |service| %>
            <%= render 'layouts/application_v_2/service', service: service %>
          <% end %>
      <% else %>
        <div class="alert">No Market Updates found.</div>
      <% end %>
    </div>
    <div class="colla">
      <h3 class="sticky-heading">Products</h3><br>
      <% if @products.size > 0 %>
          <% @products.each do |product| %>
            <%= render 'layouts/application_v_2/product', product: product %>
          <% end %>
      <% else %>
        <div class="alert">No Market Updates found.</div>
      <% end %>
    </div>
    <div class="colla">
      <h3 class="sticky-heading">Blogs</h3><br>
      <% if @blog_entries.size > 0 %>
          <% @blog_entries.each do |blog_entry| %>
            <%= render 'layouts/application_v_2/blog_entry', blog_entry: blog_entry %>
          <% end %>
      <% else %>
        <div class="alert">No news article found.</div>
      <% end %>
    </div>
    <div class="colla">
      <h3 class="sticky-heading">Deals</h3><br>
      <% if @coupons.size > 0 %>
          <% @coupons.each do |coupon| %>
            <%= render 'layouts/application_v_2/coupon', coupon: coupon %>
          <% end %>
      <% else %>
        <div class="alert">No Market Updates found.</div>
      <% end %>
    </div>
  </div>
</div>

<% if @status_updates.size > 0 %>
  <% @status_updates.each do |status_update| %>
    <%= render 'status_updates/modal_content_latest', status_update: status_update %>
  <% end %>
<% end %>
<% if @media_attachments.size > 0 %>
  <% @media_attachments.each do |media_attachment| %>
    <%= render 'status_updates/modal_video_latest', media_attachment: media_attachment %>
  <% end %>
<% end %>
<% if @news.size > 0 %>
  <% @news.each do |news_article| %>
    <%= render 'news_articles/modal_news_latest', news: news_article %>
  <% end %>
<% end %>
<% if @events.size > 0 %>
  <% @events.each do |event| %>
    <%= render 'status_updates/modal_event_latest', event: event %>
  <% end %>
<% end %>
<% if @services.present? %>
  <% @services.each do |service| %>
    <%= render 'services/modal_content', service: service %>
  <% end %>
<% end %>
<% if @products.size > 0 %>
  <% @products.each do |product| %>
    <%= render 'products/modal_content', product: product %>
  <% end %>
<% end %>
<% if @blog_entries.size > 0 %>
  <% @blog_entries.each do |blog| %>
    <%= render 'blog_entries/modal_content', blog: blog %>
  <% end %>
<% end %>
<% if @coupons.size > 0 %>
  <% @coupons.each do |coupon| %>
    <%= render 'coupons/modal_content', coupon: coupon %>
  <% end %>
<% end %>
<!-- Add the slick-theme.css if you want default styling -->
<link rel="stylesheet" type="text/css" href="//cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"/>
<!-- Add the slick-theme.css if you want default styling -->
<link rel="stylesheet" type="text/css" href="//cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css"/>
<script type="text/javascript" src="//cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>

<script type="text/javascript">
  $(document).ready(function(){
    $('.multi').slick({
      infinite: true,
      slidesToShow: 4,
      slidesToScroll: 1,
      arrows: true,
      speed: 300,
      responsive: [
        {
          breakpoint: 1024,
          settings: {
            slidesToShow: 3,
            slidesToScroll: 1,
            infinite: true
          }
        },
        {
          breakpoint: 600,
          settings: {
            slidesToShow: 2,
            slidesToScroll: 1,
            infinite: true
          }
        },
        {
          breakpoint: 480,
          settings: {
            slidesToShow: 1,
            slidesToScroll: 1,
            infinite: true
          }
        }
      ]
    });
  });
</script>

<script>
  $(document).ready(function() {
    $('.video-attachment-event').on('click', function() {
      var modal = $(this);
      var valueId = modal.attr('data-target');
      var v = $(valueId).contents().find("iframe");
      var url = v.attr('data-src');
      v.attr('allow','autoplay')
      v.attr('src', url + '?autoplay=1&amp;modestbranding=1&amp;showinfo=0')
    })

    $('.title-attachment-event').on('click', function() {
      var modal = $(this);
      var valueId = modal.attr('data-id');
      var v = $('#' + valueId).contents().find("iframe");
      var url = v.attr('data-src');
      v.attr('allow','autoplay')
      v.attr('src', url + '?autoplay=1&amp;modestbranding=1&amp;showinfo=0')
    })

    $('.close.media-attachment').on('click', function() {
      var modal = $(this);
      var valueId = modal.attr('data-id');
      var v = $('#'+valueId).contents().find("iframe");
      var url = v.attr('src');
      v.attr('src', '')
      v.removeAttr('allow')
    })

    $(".modal").on('show.bs.modal', function(){
      setTimeout(function() { $('.modal-backdrop.in').remove(); }, 500)
    })

    $(".modal").on('hide.bs.modal', function(){
      $('.modal-backdrop').remove();
    })
  });
</script>
