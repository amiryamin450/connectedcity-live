<div class="row-fluid status-update">
  <div class="span2">
      <%= image_tag status_update.statusable.logo.url %>
  </div>
  <div class="span10">
    <div class="name"><%= link_to status_update.statusable.name, statusable_path(status_update.statusable) %> <span class="time-ago"> <%= "#{time_ago_in_words(status_update.created_at)} ago" %></span></div>
    <div><%= status_update.content %>
    <% if status_update.image? %>
      <%= link_to(content_tag(:span, "View Image", class: "status-update-image", data: { location: status_update.statusable.name}), '#status_update_image', data: {toggle: 'modal'}) %>
      <div class='modal-content hidden' id="modal-content">
        <div class="row-fluid">
          <div class="span6">
            <div class="row-fluid">
              <div class="span12">
                <%= image_tag status_update.image.url %>
              </div>
            </div>
          </div>
          <div class="span6">
            <div class="row-fluid" style="margin-top: 5px;">
              <%= render 'locations/location_information', location: status_update.statusable, content: status_update.content %>

              <div class="row-fluid">
                <div class="span12">
                  <div class="pad10 holder">
                     <div id="profile-map" class="clearfix"></div>
                  </div>
                </div>
              </div>

              <div class="row-fluid">
                <div class="span12">
                  <%= image_tag status_update.statusable.business_improvement_area.logo.url if status_update.statusable.business_improvement_area %>
                </div>
              </div>
            </div>

          </div>
        </div>
        <%= javascript_tag do %>
            <% ## TODO Limit the number of locations returned  %>
            Window.profile_marker = <%= raw status_update.statusable.geo_location.to_json() %>
        <% end %>
      </div>
    <% end %>
    </div>
    <% status_update_hash = {url: location_url(status_update.statusable), title: status_update.statusable.name, content: status_update.content, image: status_update.image.url} %>
    <%= render_social_media_buttons(status_update_hash) %>
  </div>
</div>
