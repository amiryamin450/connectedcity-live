<div class="card-label-three">
  <div class="title">
    <h4><%= @location.vertical_market_category_ids.include?(99) ? "Open Houses" : "Events" %></h4>
    <% if (user_signed_in? and current_user.has_role? :admin) or (user_signed_in? and current_user.can_manage_location? @location) %>
    <small><%= link_to "add", @location.is_profile ? new_location_citizen_event_path(@location) : new_location_event_path(@location) %> | <%= link_to 'manage', @location.is_profile ? location_citizen_events_path(@location) : location_events_path(@location) %></small>
    <% end %>
  </div>
</div>
<div>
  <%= link_to 'See More +', '#', class: 'see-more', data: { element: "event-#{@location.id}" } %>
&nbsp;&nbsp;&nbsp;
  <%= link_to ' See All', @location.is_profile ? location_citizen_events_path(@location) : location_events_path(@location), class: 'see-all' %>
</div>
<% if @events.size > 0 %>
  <div class="row card-row media-row-holder" id="cat-event-<%= @location.id %>">
    <% @events.in_groups_of(4) do |group| %>
      <% group.each do |event| %>
        <% if event %>
          <div class="col-md-3">
            <div class="business-body-card">
              <div class="img">
                <%= link_to(image_tag(event.image.url(:list)), [@location, event]) if event.image.present? %>
              </div>
              <div class="title">
                <h3><%= link_to event.name, [@location, event] %></h3>
              </div>
            </div>
          </div>
        <% end -%>
      <% end -%>
    <% end %>
  </div>
  <%#= paginate @events, param_name: 'event_page' %>
<% else %>
  <div class="alert alert-dark" role="alert">No Events found.</div>
<% end %>
