<h1>Preview Video</h1>
<%= form_for @video do |f| %>
  <div class="row-fluid new-media-attachment">
    <div class="span8">
      <iframe width='100%' height='480' src='<%= @video.video_url %>' frameborder='0' allowfullscreen id="preview-video-iframe"></iframe>
    </div>
    <div class="span4">
      <%
        media_attachment = @video.media_attachment
        location = media_attachment.location
      %>
      <div class="row buttons-group">
        <div class="span4 offset2">
          <%= link_to "Discard video", video_path(@video), method: :delete, data: { confirm: 'Are you certain you want to delete this video?' }, class: "btn btn-danger redirect-btn" %>
        </div>
        <div class="span4">
          <%= f.submit "Upload video", class: "btn btn-primary redirect-btn" %>
        </div>
      </div>

      <div class="edit-media-attachment">
        <%= f.fields_for :media_attachment do |ff| %>
          <div class="title-field">
            <label for="video_media_attachment_attributes_title">Title</label>
            <%= ff.text_field :title, required: true %>
            <span id="title-count">0/100</span>
          </div>
          <div class="description-field">
            <label for="video_media_attachment_attributes_description">Description</label>
            <%= ff.text_area :description, cols: 80, rows: 7 %>
            <span id="description-count"><%= "#{media_attachment.description.length}/100" %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<script>
  var titleCounter = document.getElementById('video_media_attachment_attributes_title').value.length;
  document.getElementById('title-count').innerHTML = `${titleCounter}/100`
  document.getElementById('video_media_attachment_attributes_title').addEventListener('keypress', function (e) {
    if (titleCounter > 100) {
      e.preventDefault();
    }
    titleCounter++;
    document.getElementById('title-count').innerHTML = `${titleCounter}/100`
  })

  var descriptionCounter = document.getElementById('video_media_attachment_attributes_description').value.length;
  document.getElementById('description-count').innerHTML = `${descriptionCounter}/1500`;
  document.getElementById('video_media_attachment_attributes_description').addEventListener('keypress', function (e) {
    if (descriptionCounter > 1500) {
      e.preventDefault();
    }
    descriptionCounter++;
    document.getElementById('description-count').innerHTML = `${descriptionCounter}/1500`;
  })

