<div class="category">
  <div class="heading index-1">
  <h5>Products</h5>
   <% if (user_signed_in? and current_user.has_role? :admin) or (user_signed_in? and current_user.can_manage_location? @location) %>
 <small><%= link_to "add", new_location_product_path(@location), class: 'small' %> | <%= link_to 'manage', location_products_path(@location) %></small>
 <% end %>
</div>
</div>

<% if @products.size > 0 %>

<% @products.in_groups_of(4) do |group| %>
<div class="row-fluid product">
    <ul class="thumbnails">
    <% group.each do |product| %>
      <% if product %>
      <li class="span3">
        <div class="thumbnail">
          <%= link_to(image_tag(product.image.url(:list)), [@location, product]) %>
          <div class="caption">
            <h6><%= link_to(product.name, [@location, product]) %></h6>
            
          </div>
        </div>
        <% end -%>
      </li>
    <% end -%>
  </ul>
</div>

<% end -%>   

  <%= paginate @products, param_name: 'product_page' %>
<% else %>
<div class="alert">
  No Products found.
</div>
<% end %>