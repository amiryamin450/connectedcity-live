<h1>Manage <%= @location.name %>'s Status Updates</h1>

<table class="table table-bordered table-striped table-hover">
  <tr>
    <th>Content</th>
  </tr>

<% @status_updates.each do |status_update| %>
  <tr>
    <td><%= status_update.content %></td>
  </tr>
<% end %>
</table>

<br />

<%= link_to 'New Status Update', new_location_status_update_path(@location), class: 'btn btn-primary' %>
<%= link_to "Back to #{@location.name}", @location, class: 'btn'  %>
