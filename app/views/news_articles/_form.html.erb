<%= simple_form_for [@location, @news_article] do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.input :user_id, as: :hidden %>
    <%= f.input :title, input_html: { class: 'input-xxlarge' } %>
    <% if @is_municipality || [174, 164, 114].include?(@vertical_market.id) %>
      <% hidden = [174, 164].include?(@vertical_market.id) ? 'display: none' : 'display: block' %>
      <div class="control-group string required category" style="<%= hidden %>">
        <label class="string required optional control-label">Category</label>
        <div class="input-group-prepend search-box">
          <%= select_tag 'news_article[category_id]', options_from_collection_for_select(@categories_news, 'id', 'name', @news_article.try(:category_id)), prompt: 'All Categories', class: 'form-control' %>
        </div>
      </div>
    <% end %>
    <% if [174, 164, 114].include?(@vertical_market.id) %>
      <div class="auto-search-wrapper control-group required" style="margin-bottom: 20px; display: block;">
        <label class="string required optional control-label">Location</label>
        <div class="controls">
          <input style="border-radius: 0.25rem; width: 530px; box-sizing: unset; padding: 4px 6px; font-size: 14px;" type="text" id="news_article_location_search" autocomplete="off" placeholder="Enter Address" />
          <label style="display: none;" id="location-error" class="error">This field is required.</label>
        </div>
      </div>
      <%= f.input :latitude, as: :hidden %>
      <%= f.input :longitude, as: :hidden %>
      <div id="value_address" class="hidden" ></div>
    <% end %>
    <%= f.input :content, as: :text, input_html: { class: 'input-block-level wysihtml5' } %>
    <%= f.input :image, as: :logo_preview %>
  </div>

  <div class="form-actions">
    <%= f.button :submit, class: 'btn btn-primary' %>
  </div>
<% end %>

<script src="https://maps.googleapis.com/maps/api/js?key=<%= ENV['GOOGLE_API_MAP_KEY'] %>&libraries=places&callback=initMap&sensor=false" async defer></script>

<script type="text/javascript">
  $(document).ready(function() {
    var municipality = "<%= @vertical_market.id === 114 %>";;
    var need_category = "<%= [174, 164].include?(@vertical_market.id) %>"
    if (need_category === "true") {
      var value = <%= @categories_news[0].id %>
      $("form#new_news_article select").val(value);
    }
    var valid = "<%= [174, 164, 114].include?(@vertical_market.id) %>"
    $("#new_news_article").validate({
      rules: {
        'news_article[title]': {
          required: true,
          maxlength: 100,
        },
        'news_article[content]': {
          required: true,
          maxlength: 1500,
        },
        'news_article[image]': {
          required: true,
        },
        'news_article[category_id]': {
          required: function(){ return municipality == "true" },
        },
        'news_article[latitude]': {
          required: function(){ return valid === "true" && isBlankLatitude() },
        },
        'news_article[longitude]': {
          required: function(){ return valid === "true" && isBlankLongitude() },
        }
      }
    });
    $("form#new_news_article").on('submit', function(e) {
      if (valid === "true") {
        var valueSearch = $('#news_article_location_search').val().trim()
        var valueSearchResult = $("#value_address").val().trim()
        var inValidSearch = valueSearch.length === 0 || valueSearch !== valueSearchResult
        if (isBlankLatitude() || isBlankLongitude() || inValidSearch) {
          $("#news_article_latitude").val('')
          $("#news_article_longitude").val('')
          $('.auto-search-wrapper.control-group').css('margin-bottom', '40px')
          $('#location-error').css({'display': 'block', 'height': '0px'});
          $('#location-error').text('This is required field')
          e.preventDefault()
        } else {
          $('.auto-search-wrapper.control-group').css('margin-bottom', '20px')
          $('#location-error').css('display', 'none');
          $('#location-error').text('')
        }
      }
    })
  })

  function isBlankLatitude() {
    return $("#news_article_latitude").val().trim().length === 0
  }

  function isBlankLongitude() {
    return $("#news_article_longitude").val().trim().length === 0
  }

  function initMap() {
    var input = document.getElementById('news_article_location_search');
    var autocomplete = new google.maps.places.Autocomplete(input);
    autocomplete.addListener('place_changed', function() {
      var place = autocomplete.getPlace();
      if (!place.geometry) {
        window.alert("Autocomplete's returned place contains no geometry");
        return;
      }
      var location = place.geometry.location
      $("#news_article_latitude").val(parseFloat(location.lat()))
      $("#news_article_longitude").val(parseFloat(location.lng()))
      $("#value_address").val($("#news_article_location_search").val())
    });
  }
</script>

