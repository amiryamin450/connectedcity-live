<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="<%= root_path %>">Home</a></li>
    <% if @municipality %>
      <%
        @region =  @municipality&.region
        @province = @region&.province
        city_url = "/#{@province.slug}/#{@region.slug}/#{@municipality.slug}"
      %>
      <li class="breadcrumb-item active" aria-current="page"><a href="<%=city_url%>" style="margin-left: 10px;"><%=@municipality.name%></a></li>
    <% end %>
    <% if @city %>
      <%city_url = "/#{@province_of_city.slug}/#{@region_of_city.slug}/#{@municipality_of_city.slug}/#{@city&.slug}"%>
      <li class="breadcrumb-item active" aria-current="page"><a href="<%=city_url%>" style="margin-left: 10px;"><%=@city.name%></a></li>
    <% end %>
    <% if @district %>
      <% district_url = "/#{@province_of_city.slug}/#{@region_of_city.slug}/#{@municipality_of_city.slug}/#{@city&.slug}/#{@district&.slug}"%>
      <li class="breadcrumb-item active" aria-current="page"><a href="<%=district_url%>" style="margin-left: 10px;"><%=@district.name%></a></li>
    <% end %>
    <% if @neighborhood %>
      <%neighborhood_url = "/#{@province_of_city.slug}/#{@region_of_city.slug}/#{@municipality_of_city.slug}/#{@city&.slug}/#{@district&.slug}/#{@neighborhood&.slug}"%>
      <li class="breadcrumb-item active" aria-current="page"><a href="<%=neighborhood_url%>" style="margin-left: 10px;"><%=@neighborhood.name%></a></li>
    <% end %>
    
    <% if @sub_neighborhood %>
      <%sub_neighborhood_url = "/#{@province_of_city.slug}/#{@region_of_city.slug}/#{@municipality_of_city.slug}/#{@city&.slug}/#{@district&.slug}/#{@neighborhood&.slug}/#{@sub_neighborhood&.slug}"%>
      <li class="breadcrumb-item active" aria-current="page"><a href="<%=sub_neighborhood_url%>" style="margin-left: 10px;"><%=@sub_neighborhood.name%></a></li>
    <% end %>
    <li class="breadcrumb-item" aria-current="page"><a href="#" style="margin-left: 10px;"><%= "#{ @vertical_market.name}" %></a></li>
  </ol>
</nav>

<h1 style="margin-left: 50px; margin-bottom: 20px; font-weight: bold;">Browse <%= @vertical_market.present? ? @vertical_market.name : 'Civic News' %> in <%= @municipality&.name || @sub_neighborhood&.neighborhd || @neighborhood&.neighborhd || @district&.name || @city&.csdname%></h1>
<div class="map-section">
  <div id="map" style="height: 60vh;"></div>
</div>
<div class="civic-news-body-section">
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-7 col-lg-7 landing-page-heading-filter communities-page">
        <div class="row filter">
          <div class="col-11">
            <div class="row">
              <div class="col-3 container-box">
                <%= select_tag 'civic-news-city-dropdown', options_for_select(@cities.collect{ |city| [city.name, city.slug]}, :selected => @city&.slug), prompt: 'City', class: 'form-control search-column input-group-prepend search-box' %>
              </div>
              <div class="col-3 container-box">
                <%= select_tag 'civic-news-districts-dropdown', options_for_select(@districts.collect{ |district| [district.name, district.slug]}, :selected => @district&.slug), prompt: 'District', class: 'form-control search-column input-group-prepend search-box' %>
              </div>
              <div class="col-3 container-box">
                <%= select_tag 'civic-news-neighborhoods-dropdown', options_for_select(@neighborhoods.collect{ |nei| [nei.neighborhd, nei.slug]}, :selected => @neighborhood&.slug), prompt: 'Neighbourhood', class: 'form-control search-column input-group-prepend search-box' %>
              </div>
              <div class="col-3 container-box">
                <%= select_tag 'civic-news-sub-neighborhoods-dropdown', options_for_select(@sub_neighborhoods.collect{ |sub_nei| [sub_nei.neighborhd, sub_nei.slug]}, :selected => @sub_neighborhood&.slug), prompt: 'Sub-Neighbourhood', class: 'form-control search-column input-group-prepend search-box' %>
              </div>
            </div>
          </div>
          <div class="col-1 btn-search d-flex justify-content-center">
            <a href="#" id="city-landing-paths">
              <button type="button" class="btn-primary btn w-auto">Go</button>
            </a>
          </div>
        </div>
      </div>
      <div class="col-md-5 col-lg-5">
        <%= render 'share/search_box', url: '', opts: options_from_collection_for_select(@categories_news, 'id', 'name', params[:market_id]), all_promt: 'All' %>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript">jQuery.noConflict();</script>
<%= render "/layouts/application_v_2/multi_columns_civic_news" %>

<script>
  $(document).ready(function() {
    $('#civic-news-city-dropdown').on('change', function(event) {
      let cityId = event.target.value
      if (cityId){
        $.ajax({
        url: `/city_news_articles/get_districts?city_slug=${cityId}`,
        method: "GET",
        dataType: "json",
        }).done(function( response ) {
          resetDistrict();
          resetNeighborhood();
          resetSubNeighborhood();
          $('#city-landing-paths').attr("href", `${response.route}`)
          $.each(response.districts, function(index, item) {
            $('#civic-news-districts-dropdown').append($('<option>', {
                value: item.slug,
                text: item.name
            }));
          })
        });
      }else{
        resetDistrict();
        resetNeighborhood();
        resetSubNeighborhood();
         $('#city-landing-paths').attr("href", "#")
      }
      
    })

    $('#civic-news-districts-dropdown').on('change', function(event) {
      let districtId = event.target.value
      let cityId = '<%=params[:city_slug]%>'
      let url = districtId ? `/city_news_articles/get_neighborhoods?district_slug=${districtId}` : `/city_news_articles/get_neighborhoods?city_slug=${cityId}`
      $.ajax({
        url: url,
        method: "GET",
        dataType: "json",
      }).done(function( response ) {
        resetNeighborhood();
        resetSubNeighborhood();
        $('#city-landing-paths').attr("href", `${response.route}`)
        $.each(response.neighborhoods, function(index, item) {
          $('#civic-news-neighborhoods-dropdown').append($('<option>', {
              value: item.slug,
              text: item.neighborhd
          }));
        })
      });
    })

    $('#civic-news-neighborhoods-dropdown').on('change', function(event) {
      let neighborhoodId = event.target.value
      let districtId = $('#civic-news-districts-dropdown').val()
      let url = neighborhoodId ? `/city_news_articles/get_sub_neighborhoods?neighborhood_slug=${neighborhoodId}` : `/city_news_articles/get_sub_neighborhoods?district_slug=${districtId}`
      $.ajax({
        url: url,
        method: "GET",
        dataType: "json",
      }).done(function( response ) {
        resetSubNeighborhood();
        $('#city-landing-paths').attr("href", `${response.route}`)
        $.each(response.sub_neighborhoods, function(index, item) {
          $('#civic-news-sub-neighborhoods-dropdown').append($('<option>', {
              value: item.slug,
              text: item.neighborhd
          }));
        })
      });
    })
    
    $("#civic-news-sub-neighborhoods-dropdown").on('change', function(event){
      let subNeighborhoodId = event.target.value
      let neighborhoodId = $('#civic-news-neighborhoods-dropdown').val()
      let url = subNeighborhoodId ? `/city_news_articles/get_route_sub_neighborhoods?sub_neighborhood_slug=${subNeighborhoodId}` : `/city_news_articles/get_route_sub_neighborhoods?neighborhood_slug=${neighborhoodId}`
      $.ajax({
        url: url,
        method: "GET",
        dataType: "json",
      }).done(function( response ) {
        $('#city-landing-paths').attr("href", `${response.route}`)
      });
    })

    function resetNeighborhood() {
      $('#civic-news-neighborhoods-dropdown').find('option').remove();
      $('#civic-news-neighborhoods-dropdown').append($('<option>', {
        text: "Neighbourhood",
        value: ""
      }));
    }

    function resetSubNeighborhood() {
      $('#civic-news-sub-neighborhoods-dropdown').find('option').remove();
      $('#civic-news-sub-neighborhoods-dropdown').append($('<option>', {
        text: "Sub-Neighbourhood",
        value: ""
      }));
    }

    function resetDistrict() {
      $('#civic-news-districts-dropdown').find('option').remove();
      $('#civic-news-districts-dropdown').append($('<option>', {
        text: "District",
        value: ""
      }));
    }

  })
</script>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.0.3/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.0.3/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet.markercluster@1.3.0/dist/leaflet.markercluster.js"></script>
<% @markers_lo = @vertical_market.locations_of_civic_news(params[:municipality_slug], params[:city_slug], (params[:district_slug]|| params[:district_route]), params[:neighborhood_slug], params[:sub_neighborhood_slug] ) %>

<%= javascript_tag do %>
  window.locations = <%= raw @markers_lo.collect { |m|
    not_bus = true
    type = 'location'
    u = if m.respond_to?(:statusable)
      type = 'status_update'
      nil
    elsif m.respond_to?(:newsable)
      type = 'news_article'
      url_for([m.newsable, m])
    elsif m.respond_to?(:attachable)
      type = 'media_attachment'
      url_for([m.attachable, m])
    elsif m.respond_to?(:location)
      type = 'event'
      url_for([m.location, m])
    else
      not_bus = false
      url_for(m)
    end
    n = if m.respond_to?(:statusable)
      'Status Update of ' + m.statusable.name
    else
      defined?(m.name) ? m.name : m.title
    end

    img = if not_bus
      defined?(m.image) && m.image.present? ? m.image.url : nil
    else
      defined?(m.logo) && m.logo.file? ? m.logo.url(:original) : nil
    end

    {:not_business => not_bus, :name => n, :url => u, :latitude => m.latitude, :longitude => m.longitude, :thumb => img, :type => type, id: m.id}
  }.to_json %>;
<% end %>

