<br><h4>News Articles 
<% if (user_signed_in? and current_user.has_role? :admin) or (user_signed_in? and current_user.can_manage_location? @location) %>
 <small><%= link_to "add", new_location_news_article_path(@location) %> | <%= link_to "manage", location_news_articles_path(@location)  %></small>
 <% end %>
</h4>
<% if @articles.size > 0 %>
  <% @articles.each do |article| %>
      <article class="teaser">
        <div class="article-title"><%=  link_to article.title, [@location, article] %></div>
        <div class="article-published"><%= "#{time_ago_in_words(article.created_at)} ago" %></div>
        <div class="article-content"><%= raw(truncate article.content, seperator: ' ', :length => 200, :omission => "... #{link_to('[more]', [@location,article])}") %></div>
      </article>
  <% end %>
  <%= paginate @articles, param_name: 'article_page' %>
<% else %>
  <div class="alert">No News Articles found.</div>
<% end %> 
