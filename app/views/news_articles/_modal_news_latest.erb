<div class="modal fade" id=<%="news-#{news.id}-model"%>>
  <div class="modal-dialog modal-xl" style="max-width: 80%;">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="newsModalLongTitle"><%= news.newsable.name%></h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <div class="row">
          <div class="col-md-6">
            <div class="cover">
              <%= image_tag news.image.url %>
            </div>
          </div>
          <div class="col-md-6 ">
            <div class="location-info-popup" style="margin-top: 5px;">
              <%= render 'locations/location_information', location: news.newsable, content: news.content, claim_business: false, show_neighborhood: true %>
              <div class="row-fluid">
                <div class="span12">
                  <div class="pad10 holder" style="margin-top: 1.5em;">
                    <div class="clearfix profile-map" data-coordinates=<%= raw news.newsable.geo_location.to_json() %> ></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
