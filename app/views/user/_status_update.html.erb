<div class="row-fluid status-update">
  <div class="span1">
    <% unless status_update.statusable_v2.logo.blank? %>
      <%= image_tag status_update.statusable_v2.logo.url(:thumb) if status_update.statusable_v2.logo? %>
    <% end %>

  </div>
  <div class="span11">
    <div class="name"><%= link_to status_update.statusable_v2.name, status_update.statusable_v2 %> <span class="time-ago"> <%= "#{time_ago_in_words(status_update.created_at)} ago" %></span></div>
    <div><%= status_update.content %></div>
  </div>
</div>
