<div class='modal hide fade' id="blog_entry" tabindex="-1" role="dialog" aria-labelledby="blog_entry_label" aria-hidden="true">
  <%= simple_form_for @location, :html => {:style => 'margin-bottom: 0;'} do |f| %>
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
        <h3 id="blog_entry_label">Create New Blog Entry</h3>
      </div>
      <div class="modal-body">
        <%= f.fields_for :blog_entries, @location.blog_entries.build() do |b| %>
            <%= b.hidden_field :user_id, value: current_user.id %>
            <div>
              <%= b.label :title %>
              <%= b.text_field :title, style: 'width: 515px' %>
            </div>

            <div>
              <%= b.label 'Update Text' %>
              <%= b.text_area :content, :rows => 3, style: 'width: 515px', class: 'wysihtml5' %>
            </div>
        <% end %>
      </div>
      <div class="modal-footer">

        <input type="button" class="btn" data-dismiss="modal" aria-hidden="true" value="Cancel" />
        <%= f.button :submit, "Submit", :class => 'btn btn-primary' %>

      </div>
  <% end %>
</div>