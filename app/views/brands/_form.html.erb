<%= simple_form_for(@brand) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.input :name %>
    <%= f.input :website_url %>
    <%= f.input :description, input_html: { class: 'input-block-level wysihtml5' }  %>   
    <%= f.input :logo, as: :logo_preview %>
    <%= f.input :home_page_image, as: :logo_preview %>
  </div>

  <div class="form-actions">
    <%= f.button :submit, class: 'btn btn-primary' %>
    <%= link_to 'Back', :back, class: 'btn' %>
  </div>
<% end %>
