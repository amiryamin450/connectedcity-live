<% flash.each do |name, msg| %>
  <div class="alert alert-<%= alert_color(name) %> alert-dismissible position-absolute fade show w-100" role="alert" style="z-index:1000">
    <%= msg %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>
