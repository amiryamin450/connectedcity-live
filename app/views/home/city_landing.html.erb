<%= render 'images_slider' %>

<div class="landing-page-heading-filter communities-page" style="text-align: -webkit-center">
  <div class="row no-gutters container-fluid filter">
    <div class="col-md-7 col-lg-7">
      <div class="row px-3 px-md-0 w-100">
        <div class="col-12 col-md-11">
          <div class="row">
            <div class="col-12 col-md-3">
              <%= select_tag 'city-dropdown', options_for_select(@cities.collect{ |city| [city.name, city.slug] }, :selected => @city.slug), {prompt: 'City', class: 'form-control search-column input-group-prepend search-box'} %>
            </div>
            <div class="col-12 col-md-3 mt-2 mt-md-0">
              <%= select_tag 'district-dropdown', options_for_select(@districts.collect{ |district| [district.name, district.slug]}), prompt: 'District', class: 'form-control search-column input-group-prepend search-box' %>
            </div>
            <div class="col-12 col-md-3 mt-2 mt-md-0">
              <%= select_tag 'neighbourhood-dropdown', raw("<option>Neighbourhood</option>"), prompt: 'Neighbourhood', class: 'form-control search-column input-group-prepend search-box' %>
            </div>
            <div class="col-12 col-md-3 mt-2 mt-md-0">
              <%= select_tag 'shopping-district-dropdown', raw("<option>Sub Neighbourhood</option>"), prompt: 'Sub Neighbourhood', class: 'form-control search-column input-group-prepend search-box' %>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-1 my-md-0 my-2 btn-search d-flex justify-content-center">
          <a href="javascript:void(0)" id="district-path">
            <button type="button" class="btn-primary btn w-auto">Go</button>
          </a>
        </div>
      </div>
    </div>
    <div class="col-md-5 col-lg-5">
      <%= render 'share/search_box', url: '', opts: options_from_collection_for_select(@vertical_markets_all, 'id', 'name', params[:market_id]), all_promt: 'All' %>
    </div>
  </div>
</div>

<div class="container-fluid">
  <div class="row">
    <div class="col-md-12">
      <!-- Shopping District Slider -->
      <div class="district-slider">
        <div class="slider-heading">
          <h3><%= @city.name %> City</h3>
        </div>
        <div class="inner-slider">
          <div class="items">
            <% @city.neighborhoods.each do |bia| %>
              <div>
                <%# <img data-lazy="/cc_2.0/icon/slider-icon-1.jpg"> %>
                <div class="district-slider-img">
                  <% if  bia.logo_image.present?%>
                    <%= link_to(image_tag(bia.logo_image), "/#{@city.municipality.region.province.slug}/#{@city.municipality.region.slug}/#{@city.municipality.slug}/#{@city.slug}/#{bia.district.slug}/#{bia.slug}") %>
                  <%else%>
                    <%= link_to(image_tag('/assets/home_page_image/neighborhood_default.png'), "/#{@city.municipality.region.province.slug}/#{@city.municipality.region.slug}/#{@city.municipality.slug}/#{@city.slug}/#{bia.district.slug}/#{bia.slug}") %>
                  <%end%>
                </div>
                <p><%= link_to bia.name, "/#{@city.municipality.region.province.slug}/#{@city.municipality.region.slug}/#{@city.municipality.slug}/#{@city.slug}/#{bia.district.slug}/#{bia.slug}" %></p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
      <!-- End -->
    </div>
  </div>
</div>

<!-- Main Section Card -->
<%= render "/layouts/application_v_2/multi_columns" %>
<br>
