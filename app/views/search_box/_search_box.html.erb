<div class="search-box advance-search-box">
  <%= form_tag url, class: 'search-form', method: :get do %>
    <div class="input-group">
      <%= search_field_tag :search, params[:search], placeholder: "What are you looking for?", class: "form-control search-column" %>
      <div class="input-group-prepend search-box ">
        <%= select_tag 'market', opts, prompt: all_promt, class: 'form-control' %>
      </div>
      <div class="input-group-append">
        <button class="btn search-box-btn" type="submit"><img src="/cc_2.0/icon/search-icon.svg"></button>
      </div>
    </div>
  <% end %>
</div>
