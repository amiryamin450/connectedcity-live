<script type="text/javascript">
  $(document).ready(function(){
    $('.multi').slick({
      infinite: true,
      slidesToShow: 4,
      slidesToScroll: 1,
      arrows: true,
      speed: 300,
      responsive: [
        {
          breakpoint: 1024,
          settings: {
            slidesToShow: 3,
            slidesToScroll: 1,
            infinite: true
          }
        },
        {
          breakpoint: 600,
          settings: {
            slidesToShow: 2,
            slidesToScroll: 1,
            infinite: true
          }
        },
        {
          breakpoint: 480,
          settings: {
            slidesToShow: 1,
            slidesToScroll: 1,
            infinite: true
          }
        }
      ]
    });
  });
</script>

<script>
  $(document).ready(function() {
    $('.video-attachment-event').on('click', function() {
      var modal = $(this);
      // var valueId = modal.attr('data-target');
      // var v = $(valueId).contents().find("iframe");
      var valueId = modal.attr('data-id');
      var v = $('#' + valueId).contents().find("iframe");
      var url = v.attr('data-src');
      v.attr('allow','autoplay')
      v.attr('src', url + '?autoplay=1&amp;modestbranding=1&amp;showinfo=0')
    })

    $('.title-attachment-event').on('click', function() {
      var modal = $(this);
      var valueId = modal.attr('data-id');
      var v = $('#' + valueId).contents().find("iframe");
      var url = v.attr('data-src');
      v.attr('allow','autoplay')
      v.attr('src', url + '?autoplay=1&amp;modestbranding=1&amp;showinfo=0')
    })

    $('.close.media-attachment').on('click', function() {
      var modal = $(this);
      var valueId = modal.attr('data-id');
      var v = $('#'+valueId).contents().find("iframe");
      var url = v.attr('src');
      v.attr('src', '')
      v.removeAttr('allow')
    })

    // $(".modal").on('show.bs.modal', function(){
    //   setTimeout(function() { $('.modal-backdrop.in').remove(); }, 500)
    // })

    $(".modal .close").click(function(){
      $('.modal-backdrop.in').remove();
    })
  });
</script>
