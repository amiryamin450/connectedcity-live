<% auto_makes.sort.each_with_index do |make, r| %>
  <div class="category">
    <div class="heading index-<%= r %>">
      <h5><%= make %></h5>
      <%= link_to 'See More +', '#', class: 'see-more', data: { element: "auto-listings-#{r}" } %>
      <%= link_to 'See All', auto_make_show_path(make), class: 'see-all' %>
    </div>
    <div class="location-holder" id="cat-auto-listings-<%= r %>">
      <div class="clearfix">
        <% auto_listings[make].each do |listing| %>
          <%= render 'automotive', listing: listing, make: make %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>