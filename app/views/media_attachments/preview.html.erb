<h1>Preview Video</h1>
<div class="row-fluid media-attachment-area">
  <div class="span6">
    <%
       url = "https://www.youtube.com/embed/#{@media_attachment.media_source_id}"
    %>
    <iframe width='100%' height='480' src='<%= url %>' frameborder='0' allowfullscreen></iframe>
  </div>
  <div class="span6">
    <%= simple_form_for [@location, @media_attachment] do |f| %>
      <div class="button-group">
        <%= link_to "Discard video", [@location, @media_attachment], method: :delete, data: { confirm: 'Are you certain you want to delete this video?' }, class: "btn btn-danger redirect-btn" %>
        <%= f.submit "Upload video", class: "btn btn-primary redirect-btn" %>
      </div>

      <label for="video_media_attachment_attributes_title">Title</label>
      <%= f.input :title, label: false, placeholder: "Title", require: true %>
      <label for="video_media_attachment_attributes_description">Description</label>
      <%= f.text_area :description, size: '110x3', label: false, placeholder: "Description" %>
    <% end %>
</div>
