<div class="row-fluid">
  <div class="span8">
    <div class="row-fluid">
      <div class="span12">
        <%= image_tag status_update.image.url %>
      </div>
    </div>
  </div>
  <div class="span4">
    <div class="row-fluid" style="margin-top: 5px;">
      <%= render 'locations/location_information', location: status_update.statusable_v2, content: status_update.content, claim_business: false, show_neighborhood: true %>

      <div class="row-fluid">
        <div class="span12">
          <div class="pad10 holder" style="margin-top: 1.5em;">
             <div class="clearfix profile-map" data-coordinates=<%= raw status_update.statusable_v2.geo_location.to_json() %> ></div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>