<%
  metamagic site: "ConnectedCity",
            title: ["#{@location.name} in #{@location.business_improvement_area.try(:name) || @neighborhood.try(:name) || @location.district.try(:name)}, #{@city.try(:name)}", :site],
            separator: " — ",
            og: {
              title: @location.name + " - ConnectedCity",
              description: strip_tags(@location.try(:content).to_s),
              image: @location_carousel_images.first.try(:url),
              url: location_url(@location)
            }
%>
<!-- Breadcrumb -->
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="<%=root_path%>">Home</a></li>
      <% if @location.district %>
        <li class="breadcrumb-item"><a href="<%=district_guide_path(@location.district.name)%>"><%= @location.district.name%></a></li>
      <% end %>
      <% if @location.neighborhood %>
        <li class="breadcrumb-item"><%= @location.neighborhood.name %></li>
      <% end %>
      <% @vertical_market.ancestors.each do |ancestor| %>
        <li class="breadcrumb-item"><a href="<%="#{@base_path}guide/#{ancestor.slug}"%>"><%= ancestor.name%></a></li>
      <% end %>
      <% if @location.district %>
        <li class="breadcrumb-item"><a href="#{@base_path}guide/#{@vertical_market.slug}"><%= @vertical_market.name %></a></li>
      <% end %>
      <% if  @location.broker.present? %>
        <li class="breadcrumb-item"><a href= "#{@base_path}business/#{@location.broker.slug}"><%= @location.broker.name %></a></li>
      <% end %>
      <li class="breadcrumb-item active" aria-current="page"><%=@location.name%></li>
    </ol>
</nav>
<!-- Breadcrumb End -->
<!-- Main Section -->
<div class="business-body-section">
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-6">
        <div class="business-info">
            <div class="business-card">
              <div class="banner-img">
                <% if @location_carousel_images.any? %>
                  <%= image_tag @location_carousel_images.first.url %>
                <% end %>
              </div>
              <!--  -->
              <div class="brand-contact-details">
                  <div class="row row-card-details">
                    <div class="col-2">
                        <div class="brand-icon">
                          <%= image_tag @location.logo.url %>
                        </div>
                    </div>
                    <div class="col-10">
                      <div class="row details-row">
                        <div class="col-12">
                            <div class="title">
                              <h3><%= @location.name %></h3>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="d-flex">
                              <i class="far fa-map-marker-alt"></i>
                              <p><%= @location.address %> &middot; <%= "#{@location.city.name} #{@location&.province&.abbr}, #{@location.postal_code}" %></p>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="d-flex">
                              <i class="far fa-globe"></i>  
                              <p><%= link_to('Visit us online!', @location.website_url, target: :_blank) if @location.website_url.present? %></p>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="d-flex">
                              <i class="far fa-envelope"></i> 
                              <p><%= mail_to @location.email if @location.email.present? %></p>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="d-flex">
                              <i class="far fa-phone-alt"></i> 
                              <p><%= display_phone 'show_phone', 'phone', 'Phone', @location %></p>
                            </div>
                        </div>
                      </div>
                    </div>
                  </div>
              </div>
              <hr>
              <% if @location.operating_hours.where("starts_at IS NOT NULL OR closed = 1").exists? %>
                <div class="operating-hours">
                  <div class="title">
                    <h3>Operating Hours</h3>
                  </div>
                  <div class="timing">
                    <ul>
                    <% @location.operating_hours.where("starts_at IS NOT NULL OR closed = 1").each do |operating_hour| %>
                      <li><%= operating_hour.day.to_s.humanize %>
                      <span>
                        <% if operating_hour.open? %>
                          <%= operating_hour.starts_at.strftime("%-I:%M %p") %> &ndash; <%= operating_hour.ends_at.strftime("%-I:%M %p") %>
                        <% else %>
                          Closed
                        <% end %>
                      <span>
                      </li>
                    <% end %>
                    </ul>
                  </div>
                </div>
              <% end %>
              <div class="operating-hours">
                  <div class="btn">
                    <div class="row justify-content-end">
                        <div class="col-4">
                          <button class="btn btn-primary-outline">Claim Business</button>
                        </div>
                        <div class="col-4">
                          <button class="btn btn-primary-color">Follow</button>
                        </div>
                    </div>
                  </div>
              </div>
              <hr>
              <div class="description">
                  <h4>Description</h4>
                  <p><%= @location.content.html_safe %></p>
              </div>
              <hr>
              <% if @location.business_improvement_area.present? %>
                <div class="shopping-district">
                    <h4>Shopping District</h4>
                    <div class="row">
                      <div class="col-md-3">
                          <div class="img">
                            <%= image_tag @location.business_improvement_area.logo.url %>
                          </div>
                      </div>
                      <div class="col-md-9">
                          <h4><%= @location.business_improvement_area.name %></h4>
                          <p><%= truncate_html(@location.business_improvement_area.description, length: 400) %></p>
                          <div class="shopping-district-btn">
                            <%= link_to 'Learn More', @location.business_improvement_area, class: 'btn btn-primary' %>
                          </div>
                      </div>
                    </div>
                </div>
              <% end %>
            </div>
            <!-- Tab Start -->
            <div class="SideBar-tabs">
              <ul class="nav nav-tabs" role="tablist">
                  <li class="nav-item">
                    <a class="nav-link active" data-toggle="tab" href="#Update">Status Updates</a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link" data-toggle="tab" href="#Articles">News Articles</a>
                  </li>
                  <li class="nav-item">
                    <a class="nav-link" data-toggle="tab" href="#Entries">Blog Entries</a>
                  </li>
              </ul>
              <!-- Tab panes -->
              <div class="tab-content">
                  <div id="Update" class="container tab-pane active">
                    <%= render 'status_updates' %>
                    <div class="divider mt-5"></div>
                  </div>
                  <div id="Articles" class="container tab-pane fade">
                    <%= render 'news_articles' %>
                    <div class="divider mt-5"></div>
                  </div>
                  <div id="Entries" class="container tab-pane fade">
                    <%= render 'blog_entry' %>
                    <div class="divider mt-5"></div>
                  </div>
              </div>
            </div>
            <!-- END -->
        </div>
      </div>
      <!-- SideBar End -->
      <div class="col-md-6">
        <div class="business-product-body">
            <div class="map-section">
              <div id="map" style="height: 240px;"></div>
            </div>
            <% if request.path === '/business/city-of-vancouver' %>
              <div class="card-label-one">
                <div class="title">
                  <h4>&nbsp;<%= "City Hall" %>&nbsp;</h4>
                  <%= link_to 'More + ', '#', class: 'see-more' %>

                  <% #if @business_improvement_area_id %>
                    &nbsp;&nbsp;&nbsp;
                    <%= link_to ' See All', "#", class: 'see-all' %>
                  <%# end %>
                </div>
              </div>
              <div class="alert alert-dark" role="alert">
                No City Hall Members found.
              </div>
              <div class="card-label-one">
                <div class="title">
                  <h4>&nbsp;<%= "City Councillors." %>&nbsp;</h4>
                  <%= link_to 'More + ', '#', class: 'see-more' %>

                  <% #if @business_improvement_area_id %>
                    &nbsp;&nbsp;&nbsp;
                    <%= link_to ' See All', "#", class: 'see-all' %>
                  <%# end %>
                </div>
              </div>
              <div class="alert alert-dark" role="alert">
                No City Hall Members found.
              </div>
              <div class="card-label-one">
                <div class="title">
                  <h4>&nbsp;<%= "Parks & Recreation Commissioners" %>&nbsp;</h4>
                  <%= link_to 'More + ', '#', class: 'see-more' %>

                  <% #if @business_improvement_area_id %>
                    &nbsp;&nbsp;&nbsp;
                    <%= link_to ' See All', "#", class: 'see-all' %>
                  <%# end %>
                </div>
              </div>
              <div class="alert alert-dark" role="alert">
                No Parks & Recreation Commissioners found.
              </div>
            <% else %>
              <%= render 'location_menu_flayers' %>
              <!-- Card Row END -->
              <%= render 'location_media' %>
              <% if @location.vertical_market_category_ids.include?(40) %>
                <%= render 'location_automotive' %>
              <% end %>
              <% if @location.vertical_market_category_ids.include?(99) %>
                <%= render 'location_listings' %>
              <% elsif @location.vertical_market_category_ids.include?(100) %>
                <%= render 'agents' %>
              <% elsif @location.vertical_market_category_ids.include?(101) %>
                <%= render 'rental_properties' %>
              <% elsif @location.vertical_market_category_ids.include?(102) %>
                <%= render 'new_home_communities' %>
              <% else %>
                <%= render 'location_products' %>
              <% end %>
              <%= render 'location_coupons' %>
              <%= render 'location_services' %>
              <%= render 'location_events' %>
              <%= render 'location_trade_associations' %>
              <%= render 'location_brands' %>
              <%= render 'location_employment' %>
            <% end %>
        </div>
      </div>
      <!--Body End -->
    </div>
  </div>
</div>
<br>
