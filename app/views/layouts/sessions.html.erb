<!DOCTYPE html>
<html lang="en">
<%= render 'head' %>

<div id="wrapper">
  <header id="header">
    <div class="header-top">
      <div class="logo-block">
        <div class="logo">
          <a href="#">
            <a href="/" title="ConnectedCity"><%= image_tag 'logo.svg', width: 524 %></a>
          </a>
        </div>
        <span class="tagline">for everything local</span>
      </div>
    </div>
     <%= render 'main_menu' %>
  </header>
  <main id="main" role="main">
    <div class="container-fluid content-holder">
      <%= render 'messages' %>
      <div class="row-fluid">
        <%= yield %>
      </div>
    </div>
  </main>
</div>
<%= render 'footer' %>
<%= render 'js_footer_includes' %>
</body>
</html>
