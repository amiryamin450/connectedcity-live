<div class="users-page">
  <h1>Users</h1>

  <%= form_tag bulk_delete_user_index_path do %>
    <div class="delete-users-button">
      <%= submit_tag "Delete selected users", class: 'btn btn-danger' %>
    </div>

    <span class="table-notice">(Scroll to the right if you're not seeing full content)</span>
    <div class='users-page-table'>
      <table class="table table-bordered table-striped table-hover">
      <thead>
        <tr>
          <th>
            <%= check_box_tag :selecte_all, false, false %>
          </th>
          <th>Username</th>
          <th>Email</th>
          <th>Registered</th>
          <th>Provider</th>
          <th></th>
        </tr>
        </thead>   
        <tbody>
          <% @users.each do |user| %>
          <tr>
            <td>
              <%= check_box_tag "user_ids[]", user.id, false %>
            </td>
            <td class='user-name'>
              <p>
                <%= user.name %>
              </p>
            </td>
            <td><%= user.email %></td>
            <td><%= user.created_at.to_date %></td>
            <td><%= user.provider.nil? ? "connectedcity.com" : user.provider %></td>
            <td>
              <div class="btn-group">
                <%= link_to 'Show', user_path(user), :class => 'btn btn-mini' %>
                <%= link_to 'Edit', edit_user_path(user), :class => 'btn btn-mini' %>
                <%= link_to("Delete user", user_path(user), :data => { :confirm => "Are you sure?" }, :method => :delete, :class => 'btn btn-mini') unless user == current_user %>
                <%= link_to ' Make Site Admin'.html_safe, make_admin_user_path(user), class: 'btn btn-mini' if current_user.has_role? :admin and !user.has_role? :admin %>
                <%= link_to ' Remove Site Admin'.html_safe, remove_admin_user_path(user), class: 'btn btn-mini' if current_user.has_role? :admin and user.has_role? :admin %>
              </div>
            </td>                                         
          </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <div class="users-page-pagination d-flex justify-content-center">
    <%= paginate @users %>
  </div>

  <%= link_to 'Create New User', new_user_path, class: 'btn btn-primary' %>
</div>

<script>
  $(document).ready(function() {
    $('#selecte_all').on('change', function(){
      current_users =  $('input[name="user_ids[]"]')
      if (current_users.length < 1) return

      if (this.checked) {        
        current_users.prop('checked', true);
      } else {
        current_users.prop('checked', false);
      }
    })
  })
</script>