<h1>Vertical Markets</h1>

<table class="table table-bordered table-striped table-condensed">
  <thead>
  <tr>
    <th>Name</th>
    <th>Slug</th>
    <th>Actions</th>
  </tr>
  </thead>
  <tbody>
<% @vertical_markets.each do |vertical_market| %>

  <tr>
    <td><%= vertical_market.name %></td>
    <td><%= vertical_market.slug %></td>
    <td>
     <div class="btn-group">
    <%= link_to 'Edit', edit_vertical_market_path(vertical_market), :class => 'btn btn-mini' %>
    <%= link_to 'Destroy', vertical_market_path(vertical_market), :class => 'btn btn-mini', method: :delete, data: { confirm: 'Are you sure?' } %>
     </div>
    </td>
  </tr>

  <% if vertical_market.has_children? %>
    <% vertical_market.children.each do |child| %>
      <tr>
        <td style="padding-left:10px;"> <i class='icon-chevron-right'></i> <%= child.name %></td>
        <td><%= child.slug %></td>
        <td>
         <div class="btn-group">
        <%= link_to 'Edit', edit_vertical_market_path(child), :class => 'btn btn-mini' %>
        <%= link_to 'Destroy', vertical_market_path(child), :class => 'btn btn-mini', method: :delete, data: { confirm: 'Are you sure?' } %>
         </div>
        </td>
      </tr>
    <% end -%>
  <% end -%>

<% end %>
</tbody>
</table>

<br />


<%= link_to 'New Vertical market', new_vertical_market_path, :class => 'btn btn-primary' %>
