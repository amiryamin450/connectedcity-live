<div class="landing-page-heading-filter">
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-6">
        <div class="heading">
          <h3>Neighbourhoods and Shopping Districts</h3>
        </div>
      </div>
      <!--  -->
      <div class="col-md-6">
        <div class="row justify-content-center">
          <div class="col-md-5">
            <div class="filter">
              <label>Country</label>
              <div class="input-group-prepend search-box ">
                <button class="btn dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">Canada <i class="far fa-chevron-down"></i></button>
                <div class="dropdown-menu">
                  <a class="dropdown-item" href="#">Category One</a>
                  <a class="dropdown-item" href="#">Category Two</a>
                  <a class="dropdown-item" href="#">Category Three</a>
                  <div role="separator" class="dropdown-divider"></div>
                  <a class="dropdown-item" href="#">Separated Category</a>
                </div>
              </div>
            </div>
          </div>
          <!--  -->
          <div class="col-md-5">
            <div class="filter">
              <label>City</label>
              <div class="input-group-prepend search-box ">
                <button class="btn dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">Vancouver <i class="far fa-chevron-down"></i></button>
                <div class="dropdown-menu">
                  <a class="dropdown-item" href="#">Category One</a>
                  <a class="dropdown-item" href="#">Category Two</a>
                  <a class="dropdown-item" href="#">Category Three</a>
                  <div role="separator" class="dropdown-divider"></div>
                  <a class="dropdown-item" href="#">Separated Category</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!--  -->
    </div>
  </div>
</div>
<div class="landing-page-tab-section">
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-12">
        <div class="tab-row">
          <nav>
            <div class="nav nav-tabs" id="nav-tab" role="tablist">
              <% @districts.each_with_index do |district, index| %>
                <a class="nav-item <%= index == 0 ? 'active' : ''%>" id="<%=district.name.parameterize%>-tab" data-toggle="tab" href="#<%=district.name.parameterize%>" role="tab" aria-controls="<%=district.name.parameterize%>" aria-selected="true"><%=district.name%></a>
              <% end %>
            </div>
          </nav>
        </div>
        <div class="tab-content py-3 px-3 px-sm-0" id="nav-tabContent">
          <% @districts.each_with_index do |district, index| %>
            <div class="tab-pane fade show <%= index == 0 ? 'active' : ''%>" id="<%=district.name.parameterize%>" role="tabpanel" aria-labelledby="<%=district.name.parameterize%>-tab">
              <div class="row">
                <% district.business_improvement_areas.each do |bia| %>
                <div class="col-md-3">
                  <div class="tab-inner-card">
                    <div class="tab-inner-card-img">
                      <%= link_to(image_tag(bia.logo.url(:list)), "/vancouver/#{bia.district.slug}/neighbourhoods/#{bia.slug}") %>
                    </div>
                    <div class="tab-inner-card-heading">
                      <h4><%=bia.name %></h4>
                    </div>
                  </div>
                </div>
                <% end %>
              </div>
            </div>
          <% end %>  

        </div>
      </div>
    </div>
  </div>
</div>