<h1><%= @location.name %>'s Rental Properties</h1>

<table class="table table-bordered table-striped table-hover">
  <tr>
    <th>Name</th>
    <th>Address 1</th>
    <th>City</th>
    <th>Postal code</th>
    <th></th>
  </tr>

<% @rental_properties.each do |rental_property| %>
  <tr>
    <td><%= rental_property.name %></td>
    <td><%= rental_property.address_1 %></td>
    <td><%= rental_property.city.name %></td>
    <td><%= rental_property.postal_code %></td>
    <td>
      <div class="btn-group">
            <%= link_to 'show', [@location, rental_property], class: 'btn btn-mini' %>
            <%= link_to 'edit', edit_location_rental_property_path(@location, rental_property), class: 'btn btn-mini' %>
            <%= link_to 'delete', [@location, rental_property], method: :delete, data: {confirm: 'Are you sure?' }, class: 'btn btn-mini' %>
      </div>
    </td>
  </tr>
<% end %>
</table>

<br />

<%= link_to 'New Rental property', new_location_rental_property_path(@location), class: 'btn btn-primary' %>
<%= link_to @location.name, @location, class: 'btn' %>