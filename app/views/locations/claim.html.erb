<%= render 'messages' %>
<div class="row px-md-5 py-md-3 p-2 claim-business-form">
  <div class="col-12">
    <div class="row-fluid">
      <h2>For Business Owners & Managers</h2>
    </div>  
    <div class="row row-fluid">
      <div class="col-12 col-md-6">
        <!--<p>Claim your <b>ConnectedMerchant&trade;</b> Media Channel</p>
        <ul>
          <li>Promote your business to reach local shoppers.</li>
          <li>Add your logo, photos, videos, email &amp; website address</li>
          <li>Add your products, services, events and jobs</li>
          <li>Promote special offers, deals and coupons</li>
          <li>Promote the brands you sell.</li>
        </ul>-->
        <%= image_tag "claim-image.png", size: "629x241", class: "mw-100 h-auto" %>

        <div class="row-fluid">
          <div class="col-11">
            <hr>
            <h3 style="color: #1c3656;">Your business:</h3>
          
            <address style="color: #1c3656;">
              <b><%= @location.name %></b><br>
              <%= @location.address %><br>
              <%= @location.city.name %>, <%= @location.province.abbr %>, <%= @location.postal_code %><br>
              <%= @location.phone %><br>
            </address>
            <hr>
          </div>
        </div>
        
        <%= simple_form_for @location, url: claim_location_path(@location), html: { class: 'edit_location form-horizontal' } do |f| %>
          <div class="payment-errors alert alert-error"></div>

          <%= f.input :stripe_plan_id, as: :radio_buttons, collection: [['Monthly ($49.95/month)', 'monthly'], ['Yearly ($499.40/year)', 'yearly']],
          required: true, label: "Payment Plan Options:", label_html: {class: ""}, wrapper_html: {class: "d-inline mb-3"}, item_wrapper_class: "d-block", input_html: {class: "me-2"} %>

          <div class="card-input p-3 text-start" style="background-color: #c7ccd3">
            <div class="control-group string required mb-3">
              <label class="string required control-label d-inline-block text-start" for="stripe_number"><abbr title="required">*</abbr> Card Number</label>
              <div class="d-inline-block float-end">
                <input class="string required" style="width: 300px;" id="stripe_number" data-stripe="number" maxlength="16">
              </div>
            </div>
            <div class="control-group string required mb-3">
              <label class="string required control-label d-inline-block text-start w-25" for="stripe_cvc"><abbr title="required">*</abbr> CVV</label>
              <div class="d-inline-block float-end">
                <input class="string required" style="width: 300px;" id="stripe_cvc" data-stripe="cvc" maxlength="4">
              </div>
            </div>
            <div class="control-group select required mb-3">
              <label class="string required control-label d-inline-block text-start" for="stripe_exp_month"><abbr title="required">*</abbr> Expiry Date</label>
              <div class="d-inline-block float-end">
                <select class="select required" style="width: 148.5px;" id="stripe_exp_month" data-stripe="exp-month">
                  <option value="0">Month</option>
                  <% (1..12).each do |i| %>
                    <option value="<%= i %>"><%= i %></option>
                  <% end %>
                </select>
                <select class="select required" style="width: 148.5px;" id="stripe_exp_year" data-stripe="exp-year">
                  <option value="0">Year</option>
                  <% (Date.today.year..Date.today.year+10).each do |i| %>
                    <option value="<%= i %>"><%= i %></option>
                  <% end %>
                </select>
              </div>
            </div>
            <div class="control-group buttons-line ms-auto d-flex">
              <%= f.submit 'Purchase', class: "text-white me-2" %>
              <%= link_to 'Cancel', @location, class: "text-center" %>
            </div>
          </div>
        <% end %>
      </div>
      <div class="col-12 col-md-6">
        <%= image_tag "connected_advertiser.png", class: "mw-100 h-auto" %>
      </div>
    </div>
  </div>
</div>
