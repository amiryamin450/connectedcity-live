<% if locations.any? %>
<% @business_improvement_area_id %>
  <% locations.each do |location| %>
    <% if !location.business_improvement_area_id.nil? && @business_improvement_area_id.nil? %>
      <% @business_improvement_area_id = location.business_improvement_area_id %>
    <% end %>
  <% end %>
<% end %>
<div class="category">
    <div class="heading index-<%= r %>">
    <h5><%= category.name %></h5>
    <%= link_to 'More +', '#', class: 'see-more', data: { element: category.id } %>
    <% if @business_improvement_area_id %>
      <%= link_to 'See All', "#{@base_path}category/#{category.slug}", class: 'see-all' %>
    <% end %>
    
    <% if user_signed_in? && current_user.has_role?(:admin) %>
      <%= link_to 'Edit', edit_vertical_market_category_path(category), class: 'admin-link' %>
    <% end %>
  </div>

  <div class="location-holder" id="cat-<%= category.id %>">
    <div class="clearfix">
      <% locations.each do |location| %>
        <% cache "#{user_signed_in? ? "in" : "out"}_location_#{location.id}_#{location.updated_at}" do %>
          <%= render 'guide/location', location: location %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
