<h3>Search Results <em><%= "for #{params[:search].present? ? params[:search] : 'All Records'}"  %></em></h3>

<div class="result-numbers">Showing <%= "#{params[:page].present? ? @results.count * params[:page].to_i : '1'} to #{ params[:page].present? ? (@results.count * params[:page].to_i) + @results.count : @results.count }"  %> of <%= @results.total_entries %> results</div>

<div class="pagination-holder top">
  <%= paginate @results  %>
</div>

<div class="location-holder">
  <div class="clearfix">
    <% @results.each do |location| %>

      <div class="location-teaser clearfix">
        <div style="min-height: 80px; text-align: center;">
          <%= link_to(image_tag(get_location_image_url(location)), location)%>
        </div>
        <div style="width: 168px; margin-top: 5px; margin-bottom: 5px; font-size: 12px; min-height:24px;"><strong><%= link_to location.name, location %></strong></div>
        <div style="width: 168px;"><%= "#{location.address}".html_safe %></div>
        <div style="width: 168px;"><%= "#{location.city.name if location.city.present? } #{location.province.abbr} #{location.postal_code}".html_safe %></div>
        <div style="width: 168px; color: #1c3656;"><%= location.phone %></div>
        <div id="favorite-<%= location.id %>" class="favorite" style="margin-top: 5px;">
              <%= render 'favorites/like_button', :location_id => location.id, :vertical_market_slug => location.vertical_markets.first.try(:slug) if user_signed_in? %>
        </div>
      </div>

    <% end %>
  </div>
</div>

<div class="pagination-holder bottom">
  <%= paginate @results %>
</div>

<%= javascript_tag do %>
window.locations = <%= raw @results.collect { |m| {:name => m.name, :latitude => m.latitude, :longitude => m.longitude, :thumb => m.logo.url(:thumb)}}.to_json %>;
<% end %>

