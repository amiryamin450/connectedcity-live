<div class="input-group-prepend user-dropdown dropleft dropdown-submenu">
  <button class="btn dropdown-toggle" id="dropdownMenuButton" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"><img src="/cc_2.0/icon/landing-page-user-icon.svg"> <i class="far fa-chevron-down"></i></button>
    <ul class="dropdown-menu multi-level" role="menu" aria-labelledby="dropdownMenuButton">
      <li class="dropdown-submenu">
        <div  class="dropdown-item title" tabindex="-1">Account</div>
        <ul class="dropdown-menu">
          <li class="dropdown-item"><%= link_to 'Edit Account', edit_user_registration_path %></li>
          <li class="dropdown-item"><%= link_to 'My Classifieds', classified_listings_path %></li>
          <li class="dropdown-item"><%= link_to 'My Coupons', coupons_user_path(current_user) %></li>
          <li class="dropdown-item"><%= link_to 'My Cart', cart_path(@cart) %></li>
        </ul>
      </li>
      <li class="dropdown-submenu">
        <div  class="dropdown-item title" tabindex="-1" href="#">Favorites</div>
        <ul class="dropdown-menu">
        <% @vertical_markets_all.each do |item| %>
          <li class="dropdown-item"><a tabindex="-1" href=<%= fav_link item %>><%= "#{item.name} #{fav_count item}" %></a></li>
        <% end %>
        </ul>
      </li>
      <li class="dropdown-submenu">
        <div  class="dropdown-item title" tabindex="-1" href="#">Massaging</div>
        <ul class="dropdown-menu">
          <li class="dropdown-item"><%= link_to 'Inbox', messages_path %></li>
          <li class="dropdown-item"><%= link_to 'Send items', messages_path(folder: 'sent') %></li>
          <li class="dropdown-item"><%= link_to 'Trash', messages_path(folder: 'trash') %></li>
        </ul>
      </li>
      <% if user_signed_in? and current_user.has_role? :admin %>
        <% admin_list = [
          { href: "/vertical_markets", name: "Vertical Markets" },
          { href: "/vertical_markets_categories", name: "Vertical Markets Categories" },
          { href: "/city_news_categories", name: "City News Categories" },
          { href: "/city-news", name: "Manage City News" },
          { href: "/classified_categories", name: "Classified Categories" },
          { href: "/employment_categories", name: "Employment Categories" },
          { href: "/brands", name: "Brand Management" },
          { href: "/districts", name: "Districts" },
          { href: "/neighbourhoods", name: "BIA Management" },
          { href: "/trade_associations", name: "Trade Associations" },
          { href: "/business", name: "Businesses" },
          { href: "/business/new", name: "Add Business" },
          { href: "/user", name: "Users" }
        ] %>
        <li class="dropdown-submenu">
          <div  class="dropdown-item title" tabindex="-1" href="#">Admin</div>
          <ul class="dropdown-menu">
          <% admin_list.each do |item| %>
            <li class="dropdown-item"><a tabindex="-1" href=<%="#{item[:href]}"%>><%=item[:name]%></a></li>
          <% end %>
          </ul>
        </li>
      <% end %>
      <% if user_signed_in? and current_user.has_locations? %>
        <li class="dropdown-submenu">
          <div  class="dropdown-item title" tabindex="-1" href="#">My Locations</div>
          <ul class="dropdown-menu">
          <% current_user.locations.each do |location| %>
            <li class="dropdown-item">
              <%= link_to location.name, connected_advertiser_location_path(location) %>
            </li>
            <% end %>
          </ul>
        </li>
      <% end %>

      <div role="separator" class="dropdown-divider"></div>
      <%= link_to 'Logout', destroy_user_session_path, class: "dropdown-item", method: :delete %>
    </ul>
</div>
