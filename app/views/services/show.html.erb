<div class="px-3 pb-3 px-md-5 pb-md-5">
  <h2 class="my-4"><%= @service.name %></h2>
  <h6>Image</h6>
  <div><%= image_tag @service.image.url %></div>
  <% if user_signed_in? && current_user.can_manage_location?(@location) %>
    <div><strong>SKU:</strong> <%= @service.sku %></div>
  <% end %>
  <h6>Price</h6>
  <div><%= number_to_currency @service.price %></div>
  <h6>Description</h6>
  <div><%= @service.description.html_safe %></div>
  <% if (user_signed_in? && current_user.has_role?(:admin)) || (user_signed_in? && current_user.can_manage_location?(@location)) %>
  <div style="margin-top: 1.5em">
    <%= link_to "Edit Service", edit_location_service_path(@location, @service), class: 'btn btn-primary' %>
    <%= link_to "Back to Manage #{@location.name}'s Services", location_services_path(@location), class: 'btn mx-4' %>
  </div>
  <% end %>
</div>
