<div class="holder pad10">
  <div class="status-tabs clearfix">
    <ul class="clearfix">
      <li class="first"><a href="#market-updates">Updates</a></li>
      <li><a href="#listings">New Listings</a></li>
      <li><a href="#events">Events</a></li>
      <li><a href="#news">News</a></li>
      <li><a href="#blogs">Blogs</a></li>
      <li><a href="#followings">Followings</a></li>
      <li class="last"><a href="#coupons">Coupons</a></li>
    </ul>
  </div>

  <div id="market-updates">
    <h4>Market Updates</h4>
    <div class="primary-content">
      <% current_user.favorites.map { |f| f.location_status_updates.includes(:statusable).first if f.location_status_updates.size > 0 }&.flatten&.compact&.sort_by(&:created_at)&.reverse&.each do |status_update| %>
        <%= render 'status_update', status_update: status_update %>
      <% end -%>
    </div>
  </div>

  <div id="listings">
    <h4>Products</h4>
    <%# render @vertical_market.get_products(@city, @district) %>
  </div>

  <div id="events">
    <h4>Events</h4>

  </div>
  <div id="news">
    <h4>News Articles</h4>

  </div>
  <div id="blogs">
    <h4>Blog Entries</h4>

  </div>

  <div id="followings">
    <h4>Followings</h4>
    <div class="primary-content">
      <% current_user.favorites.where(category: nil).map { |f| Location.unscoped.find(f.location_id).status_updates.includes(:statusable).first }&.flatten&.compact&.sort_by(&:created_at)&.reverse&.each do |status_update| %>
        <%= render 'status_update', status_update: status_update %>
      <% end -%>
    </div>
  </div>

  <div id="coupons">
    <h4>Coupons</h4>
  </div>



</div>
