<div class="px-3 pb-3 px-md-5 pb-md-5">
  <h2 class="my-4">Status Update</h2>
  <h6>Content</h6>
  <p>
    <%= @status_update.content.html_safe %>
  </p>
  <% if @status_update.image.present? %>
    <div class="py-3">
      <h6>Image</h6>
      <%= image_tag @status_update.image.url, class: 'thumbnail' %>
    </div>
  <% end %>
  <div class="py-3">
    <%= link_to 'Edit Status Update', edit_location_status_update_path(@location, @status_update), class: 'btn btn-primary' %>
    <%= link_to "Back to Manage #{@location.name}'s Status Updates", location_status_updates_path(@location), class: 'btn mx-4' %>
  </div>
</div>
