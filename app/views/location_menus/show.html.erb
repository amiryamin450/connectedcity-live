<p id="notice"><%= notice %></p>

<h1><%= @location.name %></h1>
<%= link_to("Back to #{@location.name}", location_path(@location)) %>

<div>
	<%= image_tag "#{@base_url}/assets/location_menu/#{@location_menu.id}/original/#{@location_menu.image_file_name}" %>
</div>

<% if (user_signed_in? and current_user.has_role? :admin) or (user_signed_in? and current_user.can_manage_location? @location) %>
	<%= link_to 'Edit', edit_location_location_menu_path(@location, @location_menu) %> |
	<%= link_to 'Back', location_location_menus_path %>
<% end %>