<%= simple_form_for(@state_or_province) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.input :name %>
    <%= f.input :abbr %>
    <%= f.association :country, :prompt => 'Select a Country' %>
  </div>

  <div class="form-actions">
    <%= f.button :submit %>
  </div>
<% end %>
