<%= simple_form_for([@location, @rental_property]) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.input :name %>
    <%= f.input :style do %>
      <select id="rental_unit_style", name="rental_property[style]">
        <%= options_for_select(@rental_property_styles, @selected_rental_property_styles) %>
      </select>
    <% end %>
    <%= f.input :tag_line %>
    <%= f.input :active %>
    <%= f.input :address_1 %>
    <%= f.input :address_2 %>
    <%= f.association :province %>
    <%= f.association :city %>
    <%= f.input :postal_code %>
    <%= f.association :district %>
    <%= f.input :phone %>
    <%= f.input :fax %>
    <%= f.input :email %>
    <%= f.input :website_url %>
    <%= f.input :facebook_url %>
    <%= f.input :cover_photo, as: :logo_preview %>

    <%= f.input :neighborhood_description, as: :text, input_html: { class: 'input-block-level wysihtml5' } %>


    <%= f.input :description, as: :text, input_html: { class: 'input-block-level wysihtml5' } %>
    <%= f.input :neighborhood_highlights, as: :text, input_html: { rows: 5, class: 'input-xxlarge' }, hint: 'One item per line.' %>
    <%= f.input :property_features, as: :text, input_html: { rows: 5, class: 'input-xxlarge' }, hint: 'One item per line.' %>
    <%= f.input :garage_types, as: :text, input_html: { rows: 5, class: 'input-xxlarge' }, hint: 'One item per line.' %>
    <%= f.input :included_utilities, as: :text, input_html: { rows: 5, class: 'input-xxlarge' }, hint: 'One item per line.' %>
    <%= f.input :restrictions, as: :text, input_html: { rows: 5, class: 'input-xxlarge' }, hint: 'One item per line.' %>
  </div>

  <div class="form-actions">
    <%= f.button :submit, class: 'btn btn-primary' %>
  </div>
<% end %>
