<div class="modal fade" id=<%="event-#{event.id}-model"%>>
  <div class="modal-dialog modal-xl" style="max-width: 80%;">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="statusModalLongTitle"><%= event.location.name%></h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <div class="row">
          <div class="col-md-6">
            <div class="cover">
              <%= image_tag event.image.url %>
            </div>
          </div>
          <div class="col-md-6 ">
            <div class="location-info-popup" style="margin-top: 5px;">
              <%= render 'locations/location_information', location: event.location, content: event.description, claim_business: false, show_neighborhood: true %>

              <div class="row-fluid">
                <div class="span12">
                  <div class="pad10 holder" style="margin-top: 1.5em;">
                    <div class="clearfix profile-map" data-coordinates=<%= raw event.location.geo_location.to_json() %> ></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript" src="/cc_2.0/js/map.js"></script>
