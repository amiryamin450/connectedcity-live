<%= metamagic site: "ConnectedCity" , title: ["Find Businesses in #{@business_improvement_area.name}, #{@city.name}",
                                              :site], separator: " — " , charset: "utf-8" , viewport: "width=device-width, initial-scale=1.0" %>

<div class="container-fluid">
  <div class="row">
    <div class="col-md-12 column">
      <div id="carouselExampleIndicators" class="carousel slide" data-ride="carousel">
        <ol class="carousel-indicators">
          <li data-target="#carouselExampleIndicators" data-slide-to="0" class="active"></li>
          <li data-target="#carouselExampleIndicators" data-slide-to="1"></li>
          <li data-target="#carouselExampleIndicators" data-slide-to="2"></li>
        </ol>
        <div class="carousel-inner">
          <div class="carousel-item active">
            <img class="d-block w-100" src="/cc_2.0/images/banner01.jpg" alt="First slide">
          </div>
          <div class="carousel-item">
            <img class="d-block w-100" src="/cc_2.0/images/banner02.jpg" alt="Second slide">
          </div>
          <div class="carousel-item">
            <img class="d-block w-100" src="/cc_2.0/images/banner01.jpg" alt="Third slide">
          </div>
        </div>
        <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-slide="prev">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          <span class="sr-only">Previous</span>
        </a>
        <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-slide="next">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
          <span class="sr-only">Next</span>
        </a>
      </div>
    </div>
  </div>
</div><br>

<div class="landing-page-heading-filter">
  <div class="row filter">
    <div class="col-11">
      <div class="row">
        <div class="col-3">
          <%= select_tag 'city-dropdown', options_for_select(@cities.collect{ |u| [u.name, u.slug] }, :selected => @city.slug), prompt: 'City', class: 'form-control search-column input-group-prepend search-box' %>
        </div>
        <div class="col-3">
          <%= select_tag 'district-dropdown', options_for_select(@districts.collect{ |district| [district.name, district.slug]}, :selected => @district.slug), prompt: 'District', class: 'form-control search-column input-group-prepend search-box' %>
        </div>
        <div class="col-3">
          <%= select_tag 'neighbourhood-dropdown', options_for_select(@neighborhoods.collect{ |neighborhood| [neighborhood.name, neighborhood.slug]}, :selected => @neighborhood.slug), prompt: 'Neighborhood', class: 'form-control search-column input-group-prepend search-box' %>
        </div>
        <div class="col-3">
          <%= select_tag 'shopping-district-dropdown', options_for_select(@sub_neighborhoods.collect{ |subn| [subn.name, subn.slug]}), prompt: 'Sub Neighbourhood', class: 'form-control search-column input-group-prepend search-box' %>
        </div>
      </div>
    </div>
    <div class="col-1">
      <a href="javascript:void(0)" id="district-path">
        <button type="button" class="btn-primary btn">Go<i class="far fa-chevron-right"></i></button>
      </a>
    </div>
  </div>
</div>


<div class="container-fluid">
  <div class="row">
    <div class="col-md-12">
      <!-- Shopping District Slider -->
      <div class="district-slider">
        <div class="slider-heading">
          <h3><%= @business_improvement_area.name %> Neighbourhoods</h3>
        </div>
        <div class="inner-slider">
          <div class="items">
            <% @business_improvement_area.locations.order("RAND()").each do |location| %>
              <div>
                <div class="district-slider-img">
                  <%= link_to(image_tag(get_location_image_url location), location) %>
                </div>
                <p>
                  <%= link_to location.name, location %>
                </p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
      <!-- End -->
    </div>
  </div>
</div>

<br>
<%= render "/layouts/application_v_2/multi_columns" %>
<br>
