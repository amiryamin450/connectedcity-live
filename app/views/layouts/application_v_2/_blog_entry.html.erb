<div class="row">
  <div class="inner-img col-md-3 col-4">
    <%= link_to (image_tag blog_entry.bloggable.logo.url), [blog_entry.bloggable, blog_entry]%></a>
  </div>
  <div class="col-md-9 col-8">
    <div class="row">
      <div class="inner-card-title col-md-12">
        <h5><%#= link_to blog_entry.title, [blog_entry.bloggable, blog_entry] %>
           <%= link_to ("#{blog_entry.title}"), "#", class: "status-update-image", data: { 'bs-target': "#blog-#{blog_entry.id}-model", 'bs-toggle': 'modal'} %>
        </h5>
      </div>
      <div class="inner-card-title col-md-12 inner-by">
        by <%= link_to blog_entry.bloggable.name, [blog_entry.bloggable, blog_entry] %>
      </div>
      <div class="inner-card-time col-md-12">
        <span><%= "#{time_ago_in_words(blog_entry.created_at)} ago" %></span>
      </div>
    </div>
    <div class="inner-card-description">
      <div class="content"> <%= sanitize(blog_entry.content) %> </div>
    </div>
  </div>
</div>
<hr>
