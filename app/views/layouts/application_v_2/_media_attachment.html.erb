<div class="row">
  <div class="inner-img col-md-3 col-4">
    <%=link_to (image_tag media_attachment.attachable.logo.url), media_attachment.attachable %>
  </div>
  <div class="col-md-9 col-8">
    <div class="row">
      <div class="inner-card-title col-md-7 title-attachment-event" data-id="<%="video-#{media_attachment.id}-model"%>" data-bs-target=<%="#video-#{media_attachment.id}-model"%> data-bs-toggle="modal">
        <h5>
          <%= link_to ("#{media_attachment.title}"), "#", class: "status-update-image", data: { 'bs-target': "#video-#{media_attachment.id}-model", 'bs-toggle': 'modal'} %>
        </h5>
      </div>
      <div class="inner-card-time col-md-5">
        <span><%= "#{time_ago_in_words(media_attachment.created_at)} ago" %></span>
      </div>
      <div class="inner-card-title col-md-12 inner-by">
        by <%= link_to media_attachment.attachable&.name, media_attachment.attachable %>
      </div>
      <% video = media_attachment.videos&.first %>
      <% if video && video.livestream && video.status == "started" %>
        <div class="col-md-12">
          <div id="live">LIVE</div>
        </div>
      <% end %>
    </div>
    <div class="inner-card-description">
    <!-- <p><%#= media_attachment.description && sanitize(media_attachment.description).truncate(255) %></p> -->
      <div class="content"> <%= sanitize(media_attachment.description) %> </div>
      <%= link_to "View More", "#", class: "status-update-image view-more-attachment-event", data: { 'bs-target': "#video-#{media_attachment.id}-model", 'bs-toggle': 'modal'} if media_attachment.description.present? %>
      </div>
  </div>
  <div class="col-md-12">
    <div class="update-banner video-card">
      <%= image_tag(media_attachment.thumbnail_url) %>
      <div class="card-video-box">
        <i class="far fa-play-circle status-update-image video-attachment-event" data-bs-toggle="modal" data-bs-target=<%="#video-#{media_attachment.id}-model"%>></i>
      </div>
      <%#= render 'status_updates/modal_video_latest', media_attachment: media_attachment %>
    </div>
  </div>
</div>
<hr>
