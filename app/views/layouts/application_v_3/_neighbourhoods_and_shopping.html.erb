<div class="landing-page-heading-filter">
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-12">
        <div class="heading" style="display: flex; justify-content: center;">
          <h3>Find your city</h3>
        </div>
      </div>
    </div>
      <!--  -->
    <div class="row filter">
      <div class="col-11">
        <div class="row">
          <div class="col-3">
            <%= select_tag 'province-dropdown', options_from_collection_for_select(@provinces, 'slug', 'name'), prompt: 'Province/State', class: 'form-control search-column input-group-prepend search-box' %>
          </div>
          <div class="col-3">
            <%= select_tag 'region-dropdown', raw("<option>Region</option>"), prompt: 'Region', class: 'form-control search-column input-group-prepend search-box' %>
          </div>
          <div class="col-3">
            <%= select_tag 'municipality-dropdown', raw("<option>Municipality/County</option>"), prompt: 'Municipality/County', class: 'form-control search-column input-group-prepend search-box' %>
          </div>
          <div class="col-3">
            <%= select_tag 'city-dropdown', raw("<option>City/Town</option>"), prompt: 'City/Town', class: 'form-control search-column input-group-prepend search-box' %>
          </div>
        </div>
      </div>
      <div class="col-1">
        <a href="#" id="city-landing-path">
          <button type="button" class="btn-primary btn">Go<i class="far fa-chevron-right"></i></button>
        </a>
      </div>
    </div>
    </div>
  </div>
</div>
