<% if @district == nil
     current_district = @city
   else
     current_district = @district
   end
%>

<%

district_url_suffix = if params[:market].present?
                        "/guide/#{params[:market]}"
                      elsif params[:controller] == "vertical_market_categories" && params[:id]
                        "/category/#{params[:id]}"
                      else
                        ""
                      end

%>

<div class="location-block">
    <a class="open" href="#">Select Location</a>
    <div class="dropdown">
      <ul>
        <%= content_tag(:li, class: (current_district.name.eql?("Vancouver")) ? "active" : "") { link_to "Vancouver", root_path } %>
        <% District.all.each do |district|  %>
            <%= is_active = "" %>
            <% if current_district.name.eql?(district.name) %>
                <% is_active = "active" %>
            <% end %>
            <%= content_tag(:li, class: is_active) { link_to district.name, "/#{district.slug}#{district_url_suffix}" } %>
        <% end %>
      </ul>
      <ul>
        <% current_district.business_improvement_areas.each do |bia| %>
            <%

            bia_url = if params[:market].present?
                         (@district ? "/#{@district.slug}" : "") + "/#{bia.slug}/guide/#{params[:market]}"
                       elsif params[:controller] == "vertical_market_categories" && params[:id]
                         "/bia/#{bia.slug}/category/#{params[:id]}"
                       else
                         "/bia/#{bia.slug}"
                       end

            %>
            <li><%= link_to bia.name, bia_url %></li>
        <% end %>
      </ul>
    </div>
</div>
