<%= simple_form_for [@location, @product], :html => { :multipart => true, class: 'form-horizontal', id: 'fileupload' } do |f| %>
<%= f.error_notification %>

<div class="form-inputs category-form">
  <%= f.input :name %>
  <div class="control-group string required category">
    <%= f.label :category %>
    <a class="btn btn-primary controls category-select-btn" data-toggle="collapse" role="button" aria-expanded="false" data-target="#collapseCategoriesProduct" aria-controls="collapseCategories">Select product category</a>
    <div class="collapse controls hideCollapse" id="collapseCategoriesProduct">
      <div style="display: flex;">
        <div class="categories level-1-category">
          <%= render 'categories', categories: @categories, lv: 1 %>
        </div>
        <div class="categories level-2-category hidden"></div>
        <div class="categories level-3-category hidden"></div>
        <div class="categories level-4-category hidden"></div>
      </div>
    </div>
  </div>

  <%= f.hidden_field :category_id %>
  <%= f.input :description, input_html: { class: 'input-block-level wysihtml5'} %>
  <%= f.input :price, as: :string %>
  <%= f.input :discount, as: :string %>
  <%= f.input :custom_pricing, as: :boolean %>
  <%= f.input :sku %>
  <%= f.input :quantity %>
  <%= f.input :image, as: :logo_preview %>
  <%= render "product_images_fields", f: f %>
  <div class="form-actions">
    <%= f.button :submit,  class: 'btn btn-primary' %>
    <%= link_to 'Cancel', location_products_path(@location), class: 'btn'  %>
  </div>
<% end %>



