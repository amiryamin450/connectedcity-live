<div class="row">
  <div class="col-12 col-md-7 col-lg-8 video-session">
    <div id="live-now">LIVE</div>
    <div id="streams">
      <div id="publisher" class="focus"></div>
    </div>
  </div>
  <div class="col-12 col-md-5 col-lg-4">
    <div class="row buttons-group">
      <div class="col-12 col-md-4 ps-0">
        <button class="btn btn-success start">Start broadcast</button>
      </div>
      <div class="col-12 col-md-4 ps-0">
        <button class="btn btn-danger stop">Stop broadcast</button>
      </div>
    </div>
    <div class="media-attachment-form">
      <%= simple_form_for [@location, @media_attachment] do |f| %>
        <div class="title-field">
          <label for="media_attachment_title">Title</label>
          <%= f.text_field :title, required: true, autofocus: true, maxlength: 100 %>
          <span id="title-count">0/100</span>
        </div>
        <div class="description-field">
          <label for="media_attachment_description">Description</label>
          <%= f.text_area :description, rows: 7, maxlength: 1500 %>
          <span id="description-count">0/1500</span>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div id="messageModal" class="media-modal">
  <div class="modal-content">
    <div class="modal-body">
      <p>You must enter video title before recording. Please try again.</p>
    </div>
    <div class="modal-footer">
      <button class="btn btn-danger" id="close-message-modal">Close</button>
    </div>
  </div>
</div>

<div id="notifyModal" class="media-modal">
  <div class="modal-content">
    <div class="modal-body">
      <p style="margin-bottom: 10px;">Please note: In addition to broadcasting your Livestream video to the <%= @location.name %> Business channel, your video will be broadcast live to the following Community and Shopping Category channels:</p>

      <% if @location.city %>
        <li><%= @location.city.name %></li>
      <% end %>
      <% if @location.district %>
        <li><%= @location.district.name %></li>
      <% end %>
      <% if @location.neighborhood %>
        <li><%= @location.neighborhood.neighborhd %></li>
      <% end %>
      <% if @location.sub_neighborhood %>
        <li><%= @location.sub_neighborhood.neighborhd %></li>
      <% end %>
      <% @vertical_market&.ancestors&.each do |ancestor| %>
        <li><%= ancestor.name %></li>
      <% end %>
      <li><%= @vertical_market&.name %></li>
    </div>
    <div class="modal-footer">
      <button class="btn" id="close-notify-modal">OK</button>
    </div>
  </div>
</div>

<div id="endModal" class="media-modal">
  <div class="modal-content">
    <div class="modal-body">
      <p>Your live broadcast has ended.</p>
    </div>
    <div class="modal-footer">
      <button class="btn btn-danger" id="close-end-modal">Close</button>
    </div>
  </div>
</div>

<script>
  $(document).ready(function() {
    var locationSlug = "<%= @location.slug %>";
    var apiKey = "<%= ENV['VONAGE_API_KEY'] %>";
    var broadcastId;
    var archiveId;

    var messageModal = $("#messageModal");
    var closeMessageModal = $("#close-message-modal");

    closeMessageModal.onclick = function() {
      messageModal.css("display", "none");
    }

    // window.onclick = function(event) {
    //   event.target.style.display = "none";
    // }

    var endModal = $("#endModal");

    async function fetchToken() {
      let vonageData = {};
      vonageData = await fetch(`/media_attachments/get_broadcast_token.json`, {
        method: 'get',
        }).then(function(response) {
        if (response.ok) {
          return response.json();
        }
        return Promise.reject(response);
        }).then(function (data) {
        return {sessionId: data.session_id, token: data.token}
      })
      return vonageData;
    }

    fetchToken().then(vonageData => {
      var session = OT.initSession(apiKey, vonageData.sessionId);
      var publisher = OT.initPublisher('publisher', {
        insertMode: 'append',
        width: '100%',
        height: '400px',
        resolution: '1920x1080'
      });

      session.connect(vonageData.token, function (err) {
        if (err) {
          alert(err.message || err);
        }
        session.publish(publisher);
      });

      session.on('streamCreated', function (event) {
        var subscriber;
        var streamId = event.stream.streamId;
        var $streamContainer = $('<div></div>');
        $streamContainer.attr('id', event.stream.id);
        $('#streams').append($streamContainer);

        // subscriber = session.subscribe(event.stream, streamId, {
        //   insertMode: 'append',
        //   width: '100%',
        //   height: '400px'
        // });

        // if (streamId === focusStreamId) {
          // setFocus(streamId);
        // }
        // createFocusClick(subscriber.id, streamId);
        // positionStreams();
      });

      session.on('streamDestroyed', function (event) {
        var $streamElem = $('#' + event.stream.id);
        $streamElem.remove();
      });

      $('.start').click(function () {
        if ($('#media_attachment_title').val() == '') {
          $('#messageModal').css('display', 'block');
          return;
        }

        $('#notifyModal').css('display', 'block');
      })

      $('#close-notify-modal').click(function () {
        $('.start').prop('disabled', true);
        $('.stop').prop('disabled',true);
        setTimeout(()=>{
          $('.stop').prop('disabled',false);
        },1500)
        $('#notifyModal').css('display', 'none');
        var options = {
          max_duration: 7200,
          resolution: '1920x1080',
          session_id: vonageData.sessionId,
          media_attachment: {
            title: $('#media_attachment_title').val(),
            description: $('#media_attachment_description').val()
          }
        };
        $.post(`/business/${locationSlug}/media_attachments/start_broadcast.json`, options)
          .done(function (response) {
            console.log('start success.');
            $('#live-now').css('display', 'block');
            broadcastId = response.broadcast_id;
            archiveId = response.archive_id;
          })
          .fail(function (jqXHR) {
            console.error(jqXHR.responseText);
          });
      })

      $('.stop').click(function () {
        $.get(`/business/${locationSlug}/media_attachments/stop_broadcast/${broadcastId}`)
          .done(function () {
            session.disconnect();
            console.log('stop success.');
            $('#endModal').css("display", "block");
            $('#live-now').css('display', 'none');
            broadcastId = null;
            var closeEndModal = $("#close-end-modal");
            closeEndModal.click(function () {
              window.location.href = `/business/${locationSlug}`;
            });
          })
          .fail(function (jqXHR) {
            console.error(jqXHR.responseText);
          });
      });

      $('.OT_mirrored.OT_root.OT_publisher.OT_fit-mode-cover').append("<button class='OT_edge-bar-item OT_mute OT_mode-auto' id='OT_flip' type='button'>Flip</button>");
      $('#OT_flip').click(function() {
        publisher.cycleVideo();
      })
    })
  });

  var titleCounter = document.getElementById('media_attachment_title').value.length;
  document.getElementById('title-count').innerHTML = `${titleCounter}/100`
  var descriptionCounter = document.getElementById('media_attachment_description').value.length;
  document.getElementById('description-count').innerHTML = `${descriptionCounter}/1500`;

  ['paste','keypress', 'change'].forEach( function(event) {
    document.getElementById('media_attachment_title').addEventListener(event, function (e) {
      setTimeout(function() {
        titleCounter = document.getElementById('media_attachment_title').value.length;
        if (titleCounter > 100) {
          e.preventDefault();
        }
        document.getElementById('title-count').innerHTML = `${titleCounter}/100`;
      }, 100);
    })

    document.getElementById('media_attachment_description').addEventListener(event, function (e) {
      setTimeout(function() {
        descriptionCounter = document.getElementById('media_attachment_description').value.length;
        if (descriptionCounter > 1500) {
          e.preventDefault();
        }
        document.getElementById('description-count').innerHTML = `${descriptionCounter}/1500`;
      }, 100);
    })
  })
</script>
