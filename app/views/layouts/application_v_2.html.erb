<!DOCTYPE html>
<html lang="en">
  <head>
    <%= metamagic site: "ConnectedCity",
                title: ["Vancouver's Local Online Shopping Community", :site],
                separator: " — ",
                charset: "utf-8",
                viewport: "width=device-width, initial-scale=1.0"
    %>
    <%= favicon_link_tag 'favicon.ico' %>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" type="text/css" href="/cc_2.0/css/bootstrap.css">
    <link rel="stylesheet" type="text/css" href="/cc_2.0/css/bootstrap.min.css">
    <!-- Slick Slider -->
    <link rel="stylesheet" type="text/css" href="/cc_2.0/css/slick-theme.css" />
    <link rel="stylesheet" type="text/css" href="/cc_2.0/css/slick.css" />
    <!-- Style -->
    <link rel="stylesheet" type="text/css" href="/cc_2.0/css/style.css">
    <%= stylesheet_link_tag "application_v_2", media: "all" %>
    <!-- Fonts -->
    <link rel="stylesheet" href="https://pro.fontawesome.com/releases/v5.10.0/css/all.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&display=swap">

    <script src="/cc_2.0/js/jquery-3.4.1.min.js"></script>
    <script src="/cc_2.0/js/rails.js"></script>
    <!--  <script src="/cc_2.0/js/slim.min.js"></script> %> -->
    <script src="/cc_2.0/js/popper.min.js"></script>
    <script type="text/javascript" src="/cc_2.0/js/bootstrap.js"></script>
    <script type="text/javascript" src="/cc_2.0/js/slick.min.js"></script>
    <%= javascript_include_tag "application_v_2" %>
    <script type="text/javascript" src="/cc_2.0/js/map.js"></script>
    <script src="https://static.opentok.com/v2/js/opentok.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.2.1.min.js"></script>
    <script type="text/javascript" src="/cc_2.0/js/jquery.subtle-slideshow.js"></script>
    <link rel="stylesheet" type="text/css" href="/cc_2.0/css/subtle-slideshow.css">
    <script>
      $(document).ready(function() {
        $('#city-dropdown').on('change', function(event) {
          let cityId = event.target.value
          $.ajax({
            url: `/home/get_districts?city_id=${cityId}`,
            method: "GET",
            dataType: "json",
          }).done(function( response ) {
            resetDistrict();
            $('#district-path').attr("href", `${response.route}/${cityId}`)
            $.each(response.districts, function(index, district) {
              $('#district-dropdown').append($('<option>', {
                  value: district.slug,
                  text: district.name
              }));
            })
          });
        })

        $('#district-dropdown').on('change', function(event) {
          let districtId = event.target.value
          $.ajax({
            url: `/home/get_neighborhoods?district_id=${districtId}`,
            method: "GET",
            dataType: "json",
          }).done(function( response ) {
            resetNeighbourhood();
            $('#district-path').attr("href", `${response.route}/${districtId}`)
            $.each(response.neighborhoods, function(index, neighborhood) {
              $('#neighbourhood-dropdown').append($('<option>', {
                  value: neighborhood.slug,
                  text: neighborhood.neighborhd
              }));
            })
          });
        })

        $('#neighbourhood-dropdown').on('change', function(event) {
          resetSubNeighbourhood();
          let neighborhoodId = event.target.value
          $.ajax({
            url: `/home/get_sub_neighborhoods?neighborhood_id=${neighborhoodId}`,
            method: "GET",
            dataType: "json",
          }).done(function( response ) {
            $('#district-path').attr("href", `${response.route}/${neighborhoodId}`)
            $.each(response.sub_neighborhoods, function(index, neighborhood) {
              $('#shopping-district-dropdown').append($('<option>', {
                  value: neighborhood.slug,
                  text: neighborhood.neighborhd
              }));
            })
          });
        })

        $('#shopping-district-dropdown').on('change', function(event) {
          let shoppingDistrictId = event.target.value

          $.ajax({
            url: `/home/get_sub_neighborhood?sub_neighborhood_id=${shoppingDistrictId}`,
            method: "GET",
            dataType: "json",
          }).done(function( response ) {
            $('#district-path').attr("href", `${response.route}/${shoppingDistrictId}`)
          });
        })

        function resetDistrict() {
          $('#district-dropdown').find('option').remove();
          $('#district-dropdown').append($('<option>', {
            text: "District"
          }));
        }

        function resetNeighbourhood() {
          $('#neighbourhood-dropdown').find('option').remove();
          $('#neighbourhood-dropdown').append($('<option>', {
            text: "Neighbourhood"
          }));
        }

        function resetSubNeighbourhood() {
          $('#shopping-district-dropdown').find('option').remove();
          $('#shopping-district-dropdown').append($('<option>', {
            text: "Sub Neighbourhood"
          }));
        }
      })
    </script>
  </head>
  <body>
    <!-- Header -->
    <!-- Top Bar Start -->
    <%= render '/layouts/application_v_2/top_bar' %>
    <!-- Top Bar End -->
    <!-- Nav Bar Start -->
    <%= render '/layouts/application_v_2/nav_bar' %>
    <!-- Nav Bar End -->
    <!-- Main Section -->
    <%= yield%>
    <!-- End -->
    <%= render '/layouts/application_v_2/global_footer' %>

    <!-- Carousel -->
    <script type="text/javascript">
      $(document).ready(function(){
        $('.items').slick({
          infinite: true,
          lazyLoad: 'ondemand',
          slidesToShow: 6,
          slidesToScroll: 2,
          responsive: [
            {
              breakpoint: 1024,
              settings: {
                slidesToShow: 5,
                slidesToScroll: 5,
              }
            }, {
              breakpoint: 600,
              settings: {
                slidesToShow: 3,
                slidesToScroll: 3
              }
            }, {
              breakpoint: 480,
              settings: {
                slidesToShow: 2,
                slidesToScroll: 2
              }
            }
          ]
        });

        function imgError(image) {
          image.onerror = "";
          image.src = "/images/noimage.gif";
          return true;
        }
      });
    </script>
  </body>
<html>
