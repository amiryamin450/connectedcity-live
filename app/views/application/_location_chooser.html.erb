<% current_district = get_current_district %>
<%

district_url_suffix = if params[:market].present?
                        "/guide/#{params[:market]}"
                      elsif params[:controller] == "vertical_market_categories" && params[:id]
                        "/category/#{params[:id]}"
                      else
                        ""
                      end

%>

<div class="location-block">
    <a class="open" href="#"><span>Select Location</span></a>
    <div class="dropdown">
      
      <ul>
        <%= content_tag(:li, class: (current_district.name.eql?("Vancouver")) ? "active" : "") { link_to "Vancouver", root_path } %>
        <% District.all.each do |district|  %>
            <%= is_active = "" %>
            <% if current_district.name.eql?(district.name) %>
                <% is_active = "active" %>
            <% end %>

            <%= content_tag(:li, class: is_active + " sub-district") do %>
                <%= link_to(district.name, "/#{district.slug}#{district_url_suffix}") %>
                <% if is_active == "active"%>
                    <%= content_tag(:span, ">", class: "location-dropdown-arrow") %>
                <% end %>
            <% end %>
        <% end %>
      </ul>
      <div class="location-chooser-scroll-container">
        <ul>
          <% current_district.business_improvement_areas.each do |bia| %>
            <%
                 bia_url = if params[:controller] == "vertical_market_categories" && params[:id]
                             "/neighbourhoods/#{bia.slug}/category/#{params[:id]}"
                           else
                              @district_link = District.find(bia.district_id)
                             if @vertical_market && !current_user.has_role?(:admin)
                               district_neighborhood_guide_path(@district_link.slug, bia.slug, @vertical_market.slug)
                             else
                               "/neighbourhoods/#{bia.slug}"
                             end
                           end
              %>
              <li><%= link_to bia.name, bia_url %></li>
          <% end %>
        </ul>
      </div>
    </div>
</div>
