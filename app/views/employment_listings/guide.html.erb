<%

meta title: "#{@neighborhood.try(:name) || @district.try(:name) || @city.try(:name)} Employment Opportunities".strip,
     description: "",
     canonical: url_for(Rails.application.routes.recognize_path(request.path).merge({only_path: false, protocol: 'https'}))

%>

<h1>Employment Opportunities</h1>

<% @employment_categories.each do |category| %>
<% if category.employment_listings.size > 0 %>
<div class="row-fluid classified-category">
  <div class="row-fluid classified-header" style="background-color: <%= "#{category.heading_color}" %>">

    <div class="span5 head-cell"><%= category.name %></div>
    <div class="span2 head-cell">Company</div>
    <div class="span1 head-cell">Job Number</div>
    <div class="span1 head-cell"># Available</div>
    <div class="span3 head-cell">Application Deadline</div>
  </div>

  <% category.employment_listings.first(4).each do |listing| %>
  <div class="row-fluid classified-detail-row" style="border-color: <%= category.heading_color %>">
    <div class="span5"><%= link_to listing.title, [listing.location, listing] %></div>
    <div class="span2" style="font-size: 10px;"><%= link_to listing.location.name, listing.location %></div>

    <div class="span1" ><%= listing.number %></div>
    <div class="span1"><%= listing.number_of_positions %></div>
    <div class="span3"><%= listing.application_deadline %></div>
  </div>
  <% end -%>
  <div class="row-fluid">
    <div class="pull-right">
      <%= link_to "View more #{category.name} listings.", category if category.employment_listings.size > 4 %>
    </div>
  </div>
</div>
<% end -%>

<% end -%>
