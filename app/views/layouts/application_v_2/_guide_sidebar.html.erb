<ul class="nav nav-tabs" role="tablist">
    <li class="nav-item">
      <a class="nav-link active" data-toggle="tab" href="#Update">Update</a>
    </li>
    <li class="nav-item">
      <a class="nav-link" data-toggle="tab" href="#Videos">Videos</a>
    </li>
    <li class="nav-item">
      <a class="nav-link" data-toggle="tab" href="#Featured">Featured</a>
    </li>
    <li class="nav-item">
      <a class="nav-link" data-toggle="tab" href="#Events">Events</a>
    </li>
    <li class="nav-item">
      <a class="nav-link" data-toggle="tab" href="#News">News</a>
    </li>
    <li class="nav-item">
      <a class="nav-link" data-toggle="tab" href="#Blogs">Blogs</a>
    </li>
    <li class="nav-item">
      <a class="nav-link" data-toggle="tab" href="#Offers">Offers</a>
    </li>
</ul>
<!-- Tab panes -->
<div class="tab-content">
    <div id="Update" class="container tab-pane active">
      <br>
      <h3>Updates</h3><br>
      <%= render @vertical_market.get_status_updates(@city, @district, @neighborhood) %>
    </div>
    <div id="Videos" class="container tab-pane fade">
      <br>
      <h3>Videos</h3><br>
      <%= render @vertical_market.get_media_attachments %>
    </div>
    <div id="Featured" class="container tab-pane fade">
      <br>
      <h3>Featured</h3>
      <%= render @vertical_market.get_products(@city, @district) %>
    </div>
    <!--  -->
    <div id="Events" class="container tab-pane">
      <br>
      <h3>Events</h3><br>
      <%= render @vertical_market.get_events(@city, @district) %>
    </div>
    <div id="News" class="container tab-pane fade">
      <br>
      <h3>News</h3><br>
      <%= render @vertical_market.get_news_articles(@city, @district) %>
    </div>
    <div id="Blogs" class="container tab-pane fade">
      <br>
      <h3>Blogs</h3><br>
      <%= render @vertical_market.get_blog_entries(@city, @district) %>
    </div>
    <div id="Offers" class="container tab-pane fade">
      <br>
      <h3>Offers</h3><br>
      <%= render @vertical_market.get_coupons %>
    </div>
</div>