<link rel="stylesheet" href="https://unpkg.com/leaflet@1.0.3/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.0.3/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet.markercluster@1.3.0/dist/leaflet.markercluster.js"></script>
<% @markers_lo = @vertical_market.locations_civic_news() %>

<%= javascript_tag do %>
  window.locations = <%= raw @markers_lo.collect { |m|
    not_bus = true
    type = 'location'
    u = if m.respond_to?(:statusable)
      type = 'status_update'
      nil
    elsif m.respond_to?(:newsable)
      type = 'news_article'
      url_for([m.newsable, m])
    elsif m.respond_to?(:attachable)
      type = 'media_attachment'
      url_for([m.attachable, m])
    elsif m.respond_to?(:location)
      type = 'event'
      url_for([m.location, m])
    else
      not_bus = false
      url_for(m)
    end
    n = if m.respond_to?(:statusable)
      'Status Update of ' + m.statusable.name
    else
      defined?(m.name) ? m.name : m.title
    end

    img = if not_bus
      defined?(m.image) && m.image.present? ? m.image.url : nil
    else
      defined?(m.logo) && m.logo.file? ? m.logo.url(:original) : nil
    end

    {:not_business => not_bus, :name => n, :url => u, :latitude => m.latitude, :longitude => m.longitude, :thumb => img, :type => type, id: m.id}
  }.to_json %>;
<% end %>

