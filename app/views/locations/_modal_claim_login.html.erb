<div class="modal fade hide" id="claim_login" tabindex="-1" role="dialog" aria-labelledby="claim_login" aria-hidden="true">
  <div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
  </div>
  <div class="modal-body">
      <p>
      Please <%= link_to "sign-up", business_sign_up_path %> and/or <%= link_to "log-in", login_path %> to claim your business profile.
      </p>
  </div>
  <div class="modal-footer">
    <button class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
  </div>
</div>
