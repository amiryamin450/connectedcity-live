<div class="communities-section">
  <div class="container-fluid">
    <div class="row title" style="margin: 20px 0px;">
      <div class="col-md-12">
        <div class="heading" style="display: flex; justify-content: center;">
          <h1 style=" font-weight: bold;">We're connecting local communities. Join the movement today.</h1>
        </div>
      </div>
    </div>
    <div class="tab-content pb-3 px-3 px-sm-0" id="nav-tabContent">
      <div class="tab-pane fade show active" id="" role="tabpanel">
        <div class="row">
          <% communities.each do |com| %>
          <div class="col-md-3" style="padding-left: 0px; padding-right: 0px;">
            <div class="tab-inner-card" style="position: relative; margin: 15px;">
              <div class="tab-inner-card-img" style="width: 100%; height: 100%;">
                <%= link_to(image_tag(com[:image_url], :width => '100%', :height => '100%'), "#") %>
              </div>
              <div class="tab-inner-card-heading" style=" position: absolute; bottom: 0px; width: 100%; background: linear-gradient(to top, rgba(47, 47, 47, 0.8), rgba(47, 47, 47, 0)); display: table; min-height: 45px;">
                <h5 style="max-width: 100px; font-weight: bold; color: white; padding-left: 15px; display: table-cell; vertical-align: middle;"><%= com[:name] %></h5>
              </div>
            </div>
          </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
