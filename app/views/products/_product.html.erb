<div class="row-fluid product">
  <div class="img-thumb span2">
    <%= link_to(image_tag(product.image.url), [product.location, product]) if product.image? %>
  </div>
  <div class="span10">
    <div><strong><%= link_to(product.name, [product.location, product]) %></strong> <%= raw " <span class='price' >$#{product.price}</span>" if product.price.present? %></div>
  </div>
</div>
