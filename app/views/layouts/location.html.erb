<!DOCTYPE html>
<html lang="en">
<%= render 'head' %>
<body>
<div id="wrapper">
  <header id="header">
    <div class="header-top">
      <%= render 'logo' %>
      <%= render 'welcome_message' %>
      <%= render 'location_chooser' %>
      <%= render 'search_form', { locals: {css_class: 'hidden-desktop'} } %>
    </div>
    <%= render 'main_menu' %>
  </header>
  <main id="main" role="main">
    <aside class="aside">
      <div id="sidebar" class="<%= @sidebar_class %>">
        <%= render 'user_sidebar' %>
      </div>
    </aside>
    <div id="content">
      <div class="gap">
        <div id="breadcrumbs">
          <div class="breadcrumb">
            <%= render_breadcrumbs(separator: "<span class='divider'><i class='icon-angle-right'></i></span>".html_safe).html_safe %>
            <%= render 'social_media' %>
          </div>
        </div>
      </div>
      <div class="container-fluid content-holder">
        <%= render 'messages' %>
        <div class="row-fluid">
          <%= yield %>
        </div>
      </div>
    </div>
  </main>
</div>
<%= render 'footer' %>
<%= render 'js_footer_includes' %>
</body>
</html>
