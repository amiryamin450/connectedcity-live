<%= simple_form_for([@location, @coupon]) do |f| %>
  <%= f.error_notification %>
  <div class="form-inputs">
    <%= f.input :name %>
    <%= f.input :code_prefix %>
    <%= f.input :howmany, as: :string, label: "How many?" %>
    <%= f.input :description, input_html: { class: 'input-block-level wysihtml5' }  %>

    <div class="string required coupon_expiration mb-4">
      <label for="coupon_expiration" class="string form-label required">
        Expiration
        <abbr title="required">*</abbr>
      </label>
      <div class="input-append" id="datepicker_starts" >
        <%= f.input_field :expiration, as: :string, data: { format: "yyyy-MM-dd" }, value: @coupon.expiration&.strftime("%Y-%m-%d ") %>
        <span class='add-on'>
          <i data-time-icon='icon-time' data-date-icon='icon-calendar'></i>
        </span>
      </div>
    </div>

    <%= f.input :image, as: :logo_preview %>
  </div>

  <div class="form-actions">
    <%= f.button :submit, "#{f.object.new_record? ? "Create" : "Update"} Deal", class: 'btn btn-primary' %>
    <%= link_to "Cancel", location_coupons_path, class: 'btn m-3' %>
  </div>
<% end %>
