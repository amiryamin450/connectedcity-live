    }).on('fileuploadcompleted', function (e, data) {
    }).on('fileuploadfailed', function (e, data) {
    }).on('fileuploadcompleted', function (e, data) {
    }).on('fileuploadsubmit', function (e, data) {
    }).on('fileuploadstarted', function (e) {
    }).on('fileuploadcompleted', function (e, data) {})
  });
</script>
