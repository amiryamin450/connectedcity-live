<div class="modal fade" id=<%="video-#{media_attachment.attachable.id}-model"%>>
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="statusModalLongTitle"><%= media_attachment.attachable.name%></h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <iframe width='100%' height='480' src='https://www.youtube.com/embed/<%= media_attachment.media_source_id %>' frameborder='0' allowfullscreen></iframe>
      </div>
    </div>
  </div>
</div>
