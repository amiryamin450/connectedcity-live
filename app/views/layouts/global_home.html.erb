<!DOCTYPE html>
  <head>
    <meta charset="utf-8">
    <%= metamagic site: "ConnectedCity",
                  title: ["Local Online Shopping Community", :site],
                  separator: " — ",
                  charset: "utf-8",
                  viewport: "width=device-width, initial-scale=1.0"
    %>
    <%= favicon_link_tag 'favicon.ico' %>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" type="text/css" href="/cc_2.0/css/bootstrap.css">
    <link rel="stylesheet" type="text/css" href="/cc_2.0/css/bootstrap.min.css">
    <!-- Slick Slider -->
    <link rel="stylesheet" type="text/css" href="/cc_2.0/css/slick-theme.css" />
    <link rel="stylesheet" type="text/css" href="/cc_2.0/css/slick.css" />
    <!-- Style -->
    <link rel="stylesheet" type="text/css" href="/cc_2.0/css/style.css">
    <%= stylesheet_link_tag "application_v_2", media: "all" %>
    <!-- Fonts -->
    <link rel="stylesheet" href="https://pro.fontawesome.com/releases/v5.10.0/css/all.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&display=swap">
    <!-- javascript -->
    <script type="text/javascript" src="/cc_2.0/js/jquery-3.4.1.min.js"></script>
    <script type="text/javascript" src="/cc_2.0/js/jquery-3.4.1.slim.min.js"></script>
    <script type="text/javascript" src="/cc_2.0/js/popper.min.js"></script>
    <script type="text/javascript" src="/cc_2.0/js/bootstrap.js"></script>
    <script type="text/javascript" src="/cc_2.0/js/bootstrap-min.js"></script>
    <script type="text/javascript" src="/cc_2.0/js/bootstrap.bundle.min.js"></script>
    <script type="text/javascript" src="/cc_2.0/js/slick.min.js"></script>
    <%= javascript_include_tag "application_v_2" %>
    <style>
      .row-fluid{
        white-space: nowrap;
      }
      .row-fluid .col-lg-3{
        display: inline-block;
        border: 1px solid #ccc;
        padding: 10px;
        margin-left: 5px;
        margin-bottom: 10px;
        max-height: 1000px;
        overflow-y: auto;
        overflow-x: hidden;
        padding-top: 0px;
      }
      .row-fluid .col-lg-3 h3{
        padding-top: 10px;
      }
      .row-fluid .col-lg-3::-webkit-scrollbar {
        width: 20px;
      }

      .row-fluid .col-lg-3::-webkit-scrollbar-track {
        background-color: transparent;
      }

      .row-fluid .col-lg-3::-webkit-scrollbar-thumb {
        background-color: #d6dee1;
        border-radius: 20px;
        border: 6px solid transparent;
        background-clip: content-box;
      }

      .row-fluid .col-lg-3::-webkit-scrollbar-thumb:hover {
        background-color: #a8bbbf;
      }
      
      .span11::-webkit-scrollbar {
        width: 20px;
      }

      .span11::-webkit-scrollbar-track {
        background-color: transparent;
      }

      .span11::-webkit-scrollbar-thumb {
        background-color: #d6dee1;
        border-radius: 20px;
        border: 6px solid transparent;
        background-clip: content-box;
      }

      .span11::-webkit-scrollbar-thumb:hover {
        background-color: #a8bbbf;
      }
    </style>
  </head>

  <%= yield%>
<html>





