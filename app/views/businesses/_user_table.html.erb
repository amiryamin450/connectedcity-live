<% form_for @business do |b_form| %>
<table class="table table-bordered table-striped">
  <thead>
  <tr>
    <th>UserName</th>
    <th>Email</th>
    <th>Last Sign In</th>
    <th>Actions</th>
  </tr>
  </thead>

  <%= b_form.fields_for :users do |b| %>
      <tr>
        <td><%= b.object.name %></td>
        <td><%= b.object.email %></td>
        <td><%= b.object.last_sign_in_at.nil? ? 'Never' : time_ago_in_words(b.object.last_sign_in_at) %></td>
        <td>
          <%= b.hidden_field :_destroy %>
          <a href="#" class="btn btn-mini remove_user"><i class="icon-remove"></i> delete</a>
        </td>
      </tr>
  <% end %>
</table>
<% end %>