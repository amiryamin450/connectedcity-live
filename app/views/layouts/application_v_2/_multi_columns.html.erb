<div class="landing-page-three-column-section d-md-block d-none">
  <div class="multi" id="multiple_items">
    <div class="colla">
      <h3 class="sticky-heading">Market Updates</h3><br>
      <% if @status_updates.size > 0 %>
          <% @status_updates.each do |status_update| %>
            <%= render 'layouts/application_v_2/status_update', status_update: status_update %>
          <% end %>
      <% else %>
        <div class="alert">No Market Updates found.</div>
      <% end %>
    </div>
    <div class="colla">
      <h3 class="sticky-heading">Videos</h3><br>
      <% if @media_attachments.size > 0 %>
          <% @media_attachments.each do |media_attachment| %>
            <%= render 'layouts/application_v_2/media_attachment', media_attachment: media_attachment %>
          <% end %>
      <% else %>
        <div class="alert">No videos found.</div>
      <% end %>
    </div>
    <div class="colla">
      <h3 class="sticky-heading">News</h3><br>
      <% if @news.size > 0 %>
          <% @news.each do |news_article| %>
            <%= render 'layouts/application_v_2/news_article', news_article: news_article %>
          <% end %>
      <% else %>
        <div class="alert">No news article found.</div>
      <% end %>
    </div>
    <div class="colla">
      <h3 class="sticky-heading">Events</h3><br>
      <% if @events.size > 0 %>
          <% @events.each do |event| %>
            <%= render 'layouts/application_v_2/event', event: event %>
          <% end %>
      <% else %>
        <div class="alert">No Events found.</div>
      <% end %>
    </div>
    <div class="colla">
      <h3 class="sticky-heading">Services</h3><br>
      <% if @services && @services.size > 0 %>
          <% @services.each do |service| %>
            <%= render 'layouts/application_v_2/service', service: service %>
          <% end %>
      <% else %>
        <div class="alert">No Market Updates found.</div>
      <% end %>
    </div>
    <div class="colla">
      <h3 class="sticky-heading">Products</h3><br>
      <% if @products.size > 0 %>
          <% @products.each do |product| %>
            <%= render 'layouts/application_v_2/product', product: product %>
          <% end %>
      <% else %>
        <div class="alert">No Market Updates found.</div>
      <% end %>
    </div>
    <div class="colla">
      <h3 class="sticky-heading">Blogs</h3><br>
      <% if @blog_entries.size > 0 %>
          <% @blog_entries.each do |blog_entry| %>
            <%= render 'layouts/application_v_2/blog_entry', blog_entry: blog_entry %>
          <% end %>
      <% else %>
        <div class="alert">No news article found.</div>
      <% end %>
    </div>
    <div class="colla">
      <h3 class="sticky-heading">Deals</h3><br>
      <% if @coupons.size > 0 %>
          <% @coupons.each do |coupon| %>
            <%= render 'layouts/application_v_2/coupon', coupon: coupon %>
          <% end %>
      <% else %>
        <div class="alert">No Market Updates found.</div>
      <% end %>
    </div>
  </div>
</div>

<div class="category-body-section p-2 pt-4 d-block d-md-none">
  <div class="category-sidebar"><div class="SideBar-tabs">
    <ul class="nav nav-tabs justify-content-start" role="tablist">
      <li class="nav-item">
        <a class="nav-link active" data-toggle="tab" href="#Update">Updates</a>
      </li>
      <li class="nav-item">
        <a class="nav-link" data-toggle="tab" href="#Videos">Videos</a>
      </li>
      <li class="nav-item">
        <a class="nav-link" data-toggle="tab" href="#News">News</a>
      </li>
      <li class="nav-item">
        <a class="nav-link" data-toggle="tab" href="#Events">Events</a>
      </li>
      <li class="nav-item">
        <a class="nav-link" data-toggle="tab" href="#Products">Products</a>
      </li>
      <li class="nav-item">
        <a class="nav-link" data-toggle="tab" href="#Services">Services</a>
      </li>
      <li class="nav-item">
        <a class="nav-link" data-toggle="tab" href="#Blogs">Blogs</a>
      </li>
      <li class="nav-item">
        <a class="nav-link" data-toggle="tab" href="#Deals">Deals</a>
      </li>
    </ul>
    <!-- Tab panes -->
    <div class="tab-content">
      <div id="Update" class="container tab-pane active">
        <br>
        <h3>Updates</h3><br>
        <% if @status_updates.size > 0 %>
            <% @status_updates.each do |status_update| %>
              <%= render 'layouts/application_v_2/status_update', status_update: status_update %>
            <% end %>
        <% else %>
          <div class="alert">No Market Updates found.</div>
        <% end %>
      </div>
      <div id="Videos" class="container tab-pane">
        <br>
        <h3>Videos</h3><br>
        <% if @media_attachments.size > 0 %>
            <% @media_attachments.each do |media_attachment| %>
              <%= render 'layouts/application_v_2/media_attachment_basic', media_attachment: media_attachment %>
            <% end %>
        <% else %>
