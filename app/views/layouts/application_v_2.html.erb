<!DOCTYPE html>
<html lang="en">
  <head>
    <%= metamagic site: "ConnectedCity",
                title: ["Vancouver's Local Online Shopping Community", :site],
                separator: " — ",
                charset: "utf-8",
                viewport: "width=device-width, initial-scale=1.0"
    %>
    <%= favicon_link_tag 'favicon.ico' %>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" type="text/css" href="/cc_2.0/css/bootstrap.css">
    <link rel="stylesheet" type="text/css" href="/cc_2.0/css/bootstrap.min.css">
    <!-- Slick Slider -->
    <link rel="stylesheet" type="text/css" href="/cc_2.0/css/slick-theme.css" />
    <link rel="stylesheet" type="text/css" href="/cc_2.0/css/slick.css" />
    <!-- Style -->
    <link rel="stylesheet" type="text/css" href="/cc_2.0/css/style.css">
    <%= stylesheet_link_tag "application_v_2", media: "all" %>
    <!-- Fonts -->
    <link rel="stylesheet" href="https://pro.fontawesome.com/releases/v5.10.0/css/all.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&display=swap">
    <link rel="stylesheet" type="text/css" href="/cc_2.0/css/front-awesome.min.css">
    <script src="/cc_2.0/js/jquery-3.4.1.min.js"></script>
    <script src="/cc_2.0/js/rails.js"></script>
    <!--  <script src="/cc_2.0/js/slim.min.js"></script> %> -->
    <script src="/cc_2.0/js/popper.min.js"></script>
    <script type="text/javascript" src="/cc_2.0/js/slick.min.js"></script>
    <%= javascript_include_tag "application_v_2" %>
    <script type="text/javascript" src="/cc_2.0/js/map.js"></script>
    <script src="https://static.opentok.com/v2/js/opentok.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.2.1.min.js"></script>
    <script src="/cc_2.0/js/bootstrap.js"></script>
    <!-- <script type="text/javascript" src="/cc_2.0/js/jquery.subtle-slideshow.js"></script>
    <link rel="stylesheet" type="text/css" href="/cc_2.0/css/subtle-slideshow.css"> -->
    <script>
      $(document).ready(function() {
        $('#city-dropdown').on('change', function(event) {
          let cityId = event.target.value
          if(cityId){
            $.ajax({
            url: `/home/get_districts?city_id=${cityId}`,
            method: "GET",
            dataType: "json",
            }).done(function( response ) {
              resetDistrict();
              resetNeighbourhood();
              resetSubNeighbourhood();  
              $('#district-path').attr("href", `${response.route}/${cityId}`)
              $.each(response.districts, function(index, district) {
                $('#district-dropdown').append($('<option>', {
                    value: district.slug,
                    text: district.name
                }));
              })
            });
          }else{
            $('#district-path').attr("href", '/')
            resetDistrict();
            resetNeighbourhood();
            resetSubNeighbourhood();  
          }
          
        })

        $('#district-dropdown').on('change', function(event) {
          let districtId = event.target.value
          let cityId = $('#city-dropdown').val()
          let url = districtId ? `/home/get_neighborhoods?district_id=${districtId}`:`/home/get_neighborhoods?city_id=${cityId}`
          $.ajax({
            url: url,
            method: "GET",
            dataType: "json",
          }).done(function( response ) {
            resetNeighbourhood();
            resetSubNeighbourhood();
            $('#district-path').attr("href", `${response.route}`)
            $.each(response.neighborhoods, function(index, neighborhood) {
              $('#neighbourhood-dropdown').append($('<option>', {
                  value: neighborhood.slug,
                  text: neighborhood.neighborhd
              }));
            })
          });
        })

        $('#neighbourhood-dropdown').on('change', function(event) {
          let neighborhoodId = event.target.value
          let districtID = $('#district-dropdown').val()
          let url = neighborhoodId ? `/home/get_sub_neighborhoods?neighborhood_id=${neighborhoodId}`: `/home/get_sub_neighborhoods?district_id=${districtID}`  
          $.ajax({
            url: url,
            method: "GET",
            dataType: "json",
          }).done(function( response ) {
            resetSubNeighbourhood();
            $('#district-path').attr("href", `${response.route}`)
            $.each(response.sub_neighborhoods, function(index, neighborhood) {
              $('#shopping-district-dropdown').append($('<option>', {
                  value: neighborhood.slug,
                  text: neighborhood.neighborhd
              }));
            })
          });
        })

        $('#shopping-district-dropdown').on('change', function(event) {
          let shoppingDistrictId = event.target.value
          let neighborhoodId = $('#neighbourhood-dropdown').val()
          let url = shoppingDistrictId ? `/home/get_sub_neighborhood?sub_neighborhood_id=${shoppingDistrictId}`: `/home/get_sub_neighborhood?neighborhood_id=${neighborhoodId}`
          $.ajax({
            url: url,
            method: "GET",
            dataType: "json",
          }).done(function( response ) {
            $('#district-path').attr("href", `${response.route}`)
          });
        })

        function resetDistrict() {
          $('#metro-district-dropdown').find('option').remove();
          $('#metro-district-dropdown').append($('<option>', {
            text: "District"
          }));

          $('#district-dropdown').find('option').remove();
          $('#district-dropdown').append($('<option>', {
            text: "District"
          }));
        }

        function resetNeighbourhood() {
          $('#neighbourhood-dropdown').find('option').remove();
          $('#neighbourhood-dropdown').append($('<option>', {
            text: "Neighbourhood"
          }));

          $('#metro-neighbourhood-dropdown').find('option').remove();
          $('#metro-neighbourhood-dropdown').append($('<option>', {
            text: "Neighbourhood"
          }));
        }

        function resetSubNeighbourhood() {
          $('#shopping-district-dropdown').find('option').remove();
          $('#shopping-district-dropdown').append($('<option>', {
            text: "Sub Neighbourhood"
          }));
        }
      })
    </script>
  </head>
  <body>
    <!-- Header -->
    <!-- Top Bar Start -->
    <%= render '/layouts/application_v_2/top_bar' %>
    <!-- Top Bar End -->
    <!-- Nav Bar Start -->
    <%= render '/layouts/application_v_2/nav_bar' %>
    <!-- Nav Bar End -->
    <!-- Main Section -->
    <%= yield%>
    <%= render 'modal_call/modal_call_request'%>
    <%= render 'modal_call/modal_user_call'%>
    <%= render 'modal_call/modal_message_reject'%>
    <%= render 'modal_call/modal_end_call'%>
    <!-- End -->
    <%= render '/layouts/application_v_2/global_footer' %>
    <!-- Carousel -->
    <script>
      $(document).ready(function(){
        var current_user_id
        var sessionId, token
        if('<%= user_signed_in?%>' == "true"){
            if(parseInt('<%= current_user&.locations&.count%>') >0){
              current_user_id = '<%= current_user&.id%>'
              var callInterval = setInterval(() => {
                $.ajax({
                url: `/video_calls/call_request?user_id=${current_user_id}`,
                method: "GET",
                dataType: "json",
                }).done(function(response) {  
                  if(response.list_user_call.length > 0 && response.list_user_call[0].status == "request_calling"){
                    var user_call = response.list_user_call[0]
                    if (!$('#modal-user-video-call').hasClass('show')){
                      $("#modal-video-call-request").modal('show')
                    }
                    $("#modal-call-title").html("Incomming Call From " + user_call.user_name);
                    $("#accept-call").on("click",function(){
                      $("#modal-video-call-request").modal('hide')
                      $("#modal-user-video-call").modal('show')
                      sessionId = user_call.session_id
                      token = user_call.token
                      var session_call
                      var seconds = 0
                      var apiKey = "<%= ENV['VONAGE_API_KEY'] %>";

                      function upTimer() {
                        ++seconds;
                        let hour = Math.floor(seconds / 3600);
                        if(hour < 10) hour = "0"+hour
                        let minute = Math.floor((seconds - hour * 3600) / 60);
                        if(minute < 10) minute = "0"+minute
                        let updSecond = seconds - (hour * 3600 + minute * 60);
                        if(updSecond < 10) updSecond = "0"+updSecond
                        $("#user-timer-count").html(hour + ":" + minute + ":" + updSecond)
                      }
                      var timer = setInterval(upTimer, 1000);
                      
                      function handleError(error) {
                        if (error) {
                          console.error(error);
                        }
                      }

                      function initializeSession(apiKey,sessionId ) {
                        session_call = OT.initSession(apiKey, sessionId);
                        session_call.on('streamCreated', function streamCreated(event) {
                          console.log("-------")
                          var subscriberOptions = {
                            insertMode: 'append',
                            width: '100%',
                            height: '100%',
                            // subscribeToAudio: false
                          };
                          $("#user-subscriber").html("")
                          var subscriber = session_call.subscribe(event.stream, 'user-subscriber', subscriberOptions, handleError);
                        });

                        session_call.on('sessionDisconnected', function sessionDisconnected(event) {
                          console.log('You were disconnected from the session.', event.reason);
                        });

                        // initialize the publisher
                        var publisherOptions = {
                          insertMode: 'append',
                          width: '100%',
                          height: '100%'
                        };
                        $("#user-publisher").html("")
                        var publisher =  OT.initPublisher('user-publisher', publisherOptions, handleError);
                        // Connect to the session
                        session_call.connect(token, function callback(error) {
                          if (error) {
                            handleError(error);
                          } else {
                            // If the connection is successful, publish the publisher to the session
                            session_call.publish(publisher, handleError);
                          }
                        });

                        session_call.on('streamDestroyed', function sessionDisconnected(event) {
                          $("#modal-user-video-call").modal("hide");
                          $("#modal-end-video-call").modal("show")
                          clearInterval(timer)
                          $("#user-publisher").html("")
                          $("#user-subscriber").html("")
                          publisher.destroy()
                          session_call.disconnect()
                          $("#user-timer-count").html("00:00:00")
                          $("#user-turn-on-camera").addClass("d-none")
                          $("#user-turn-off-camera").removeClass("d-none")
                          $("#user-turn-on-audio").addClass("d-none")
                          $("#user-turn-off-audio").removeClass("d-none") 
                          $.ajax({
                          url: `/video_calls/set_status_call`,
                          method: "PUT",
                          data: {
                            user_business_id: current_user_id,
                            user_call_id: user_call.user_call_id,
                            status: "available"
                          }
                          }).done(function( response) {

                          })                                              
                        })

                        $("#user-turn-off-camera").on("click",function(){
                          publisher.publishVideo(false);
                          $("#user-turn-off-camera").addClass("d-none")
                          $("#user-turn-on-camera").removeClass("d-none")
                        })

                        $("#user-turn-on-camera").on("click",function(){
                          publisher.publishVideo(true);
                          $("#user-turn-on-camera").addClass("d-none")
                          $("#user-turn-off-camera").removeClass("d-none")
                        })

                        $("#user-turn-off-audio").on("click",function(){
                          publisher.publishAudio(false);
                          $("#user-turn-off-audio").addClass("d-none")
                          $("#user-turn-on-audio").removeClass("d-none")
                        })

                        $("#user-turn-on-audio").on("click",function(){
                          publisher.publishAudio(true);
                          $("#user-turn-on-audio").addClass("d-none")
                          $("#user-turn-off-audio").removeClass("d-none")
                        }) 

                        $("#user-close-video").on("click",function(){ 
                          clearInterval(timer)
                          $("#user-publisher").html("")
                          $("#user-subscriber").html("")
                          publisher.destroy()
                          session_call.disconnect()
                          $("#user-timer-count").html("00:00:00")
                          $("#user-turn-on-camera").addClass("d-none")
                          $("#user-turn-off-camera").removeClass("d-none")
                          $("#user-turn-on-audio").addClass("d-none")
                          $("#user-turn-off-audio").removeClass("d-none") 
                          $.ajax({
                          url: `/video_calls/set_status_call`,
                          method: "PUT",
                          data: {
                            user_business_id: current_user_id,
                            user_call_id: user_call.user_call_id,
                            status: "available"
                          }
                          }).done(function( response) {

                          })                                              
                        })
                         
                      }
                      initializeSession(apiKey, sessionId)
                      $.ajax({
                        url: `/video_calls/set_status_call`,
                        method: "PUT",
                        data: {
                          user_business_id: current_user_id,
                          user_call_id: user_call.user_call_id,
                          accept: true,
                          status: "accept_call"
                        }
                      })
                      // clearInterval(callInterval)
                    })
                    $("#reject-call").on("click",function(){
                      $.ajax({
                        url: `/video_calls/set_status_call`,
                        method: "PUT",
                        data: {
                          user_business_id: current_user_id,
                          user_call_id: user_call.user_call_id,
                          status: "reject"
                        }
                      })
                    })
                  }
                  if(response.list_user_call.length == 0){
                    $("#modal-video-call-request").modal('hide')
                  }
                });
              }, 3000);
            }
          }
        
          $('.items').slick({
            infinite: true,
            lazyLoad: 'ondemand',
            slidesToShow: 6,
            slidesToScroll: 2,
            responsive: [
              {
                breakpoint: 1024,
                settings: {
                  slidesToShow: 5,
                  slidesToScroll: 5,
                }
              }, {
                breakpoint: 600,
                settings: {
                  slidesToShow: 3,
                  slidesToScroll: 3
                }
              }, {
                breakpoint: 480,
                settings: {
                  slidesToShow: 2,
                  slidesToScroll: 2
                }
              }
            ]
          });

          function imgError(image) {
            image.onerror = "";
            image.src = "/images/noimage.gif";
            return true;
          }
      });
    </script>
  </body>
<html>
