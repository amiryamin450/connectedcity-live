<!DOCTYPE html>
<html>
<%= render 'head' %>

<body>
<div id="wrapper">
  <header id="header">
    <div class="header-top">
      <%= render 'logo' %>
      <%= render 'welcome_message' %>
      <%= render 'location_chooser' %>
      <%= render 'search_form', { locals: {css_class: 'hidden-desktop'} } %>
    </div>
    <%= render 'main_menu' %>
  </header>
  <main id="main" role="main">
    <aside class="aside">
      <div id="sidebar" class="<%= @sidebar_class %>">
        <%= render 'user_sidebar' %>
      </div>
    </aside>
    <div id="content">
      <div class="gap">
        <div id="breadcrumbs">
          <div class="breadcrumb">
            <%= render_crumbs(separator: "<span class='divider'><i class='icon-angle-right'></i></span>".html_safe).html_safe %>
            <%= render 'social_media' %>
          </div>
        </div>
      </div>
      <div class="container-fluid content-holder">
        <div class="row-fluid">
          <div class="span12">
            <% @current_market = VerticalMarket.where(slug: params[:market]).first || @vertical_market %>
            <%
              @neighbourhood_param = params[:neighborhood]
              @neighbourhood_slug = params[:neighborhood]

              if @neighbourhood_param
                
                if @neighbourhood_param.include? "kitsilano"
                  @neighbourhood_slug = "kitsilano"
                end
                
                @neighbourhood = Neighborhood.where('slug LIKE ?', @neighbourhood_slug).first
              end

              @current_district = @district ? @district.name : "Vancouver" 
            %>
            <h1>Browse <%= @current_market.name %> in <%= @neighbourhood ? @neighbourhood.name : @current_district %></h1>
          </div>
        </div>
        <div class="row-fluid">
          <div class="span4">
            <div id="map-holder">
              <div id="map"></div>
            </div>
            <div id="status_updates"><%= render :partial => 'status_updates' %></div>
          </div>
          <div class="span8">
            <div class="row-fluid">
              <%= render 'search_form', { locals: {css_class: 'hidden-mobile'} } %>
            </div>
            <% if params[:district_route].present? and params[:market].present? and @district and @district.neighborhoods.size > 0 and ![17,18,19,20].include?(@vertical_market.id) %>
                <div class="row-fluid">
                  <div class="facets well" id="facet-block" style="margin-bottom: 1.5em;">

                    <div class="row-fluid">
                      <% count = (@district.neighborhoods.size / 5).ceil > 0 ? (@district.neighborhoods.size / 5).ceil : 1 %>
                      <% @district.neighborhoods.in_groups_of(count) do |group| %>

                          <div class="span2">
                            <ul class="unstyled">
                              <% group.each do |n| %>
                                  <% if n %>
                                      <% if n.slug == params[:neighborhood] %>
                                          <li><%= link_to "#{n.name}", district_neighborhood_guide_path(params[:district_route], n.slug, params[:market]), class: 'active' %></li>
                                      <% else %>
                                          <li><%= link_to "#{n.name}", district_neighborhood_guide_path(params[:district_route], n.slug, params[:market]) %></li>
                                      <% end -%>
                                  <% end %>
                              <% end %>
                            </ul>
                          </div>
                      <% end %>
                    </div>
                  </div>
                </div>
            <% end %>
            <div class="row-fluid">
              <%= yield %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
<%= render 'footer' %>
<%= render 'js_footer_includes' %>
</body>
</html>
