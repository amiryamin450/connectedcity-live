<div class="row">
  <div class="span8 video-session">
    <div class="stream-area">
      <div id="subscribers" style="display: none"></div>
    </div>
    <div id="default-video-img">
      <img id="placeholder-img" src="/assets/default_video_image.jpeg" alt="Video Placeholder Stock Image"/>
    </div>
  </div>
  <div class="span4">
    <div class="row buttons-group">
      <div class="span4">
        <button class="btn btn-success create-archive" id="start-archive">Start Recording</button>
      </div>
      <div class="span4">
        <button class="btn btn-danger" id="stop-archive" disabled>Stop Recording</button>
      </div>
      <div class="span4">
        <button class="btn btn-primary" id="preview-video" disabled>Preview Video</button>
      </div>
    </div>
    <div class="media-attachment-form">
      <%= simple_form_for [@location, @media_attachment] do |f| %>
        <div class="title-field" style="margin-bottom: 10px;">
          <label for="media_attachment_title">
            <abbr title="required">*</abbr>
            Title
          </label>
          <%= f.text_field :title, required: true, autofocus: true, maxlength: 100 %>
          <span id="title-count">0/100</span>
        </div>
        <% if @is_municipality || [174, 164, 114].include?(@vertical_market.id) %>
          <% hidden = [174, 164].include?(@vertical_market.id) ? 'display: none' : 'display: block' %>
          <div class="control-group string required category" style="<%= hidden %>">
            <%= f.label :category %>
            <div class="input-group-prepend search-box ">
              <%= select_tag 'category_id', options_from_collection_for_select(@categories_news, 'id', 'name'), prompt: 'All Categories', class: 'form-control', style: 'border-color: black;' %>
            </div>
          </div>
        <% end %>
        <% if [174, 164, 114].include?(@vertical_market.id) %>
          <div class="auto-search-wrapper control-group required" style="margin-bottom: 20px; display: block;">
            <label class="string required optional control-label">Location</label>
            <div class="controls">
              <input style="border-radius: 0.25rem; width: 530px; box-sizing: unset; padding: 4px 6px; font-size: 14px;" type="text" id="media_attachment_location_search" autocomplete="off" placeholder="Enter Address" />
            </div>
          </div>
          <%= f.input :latitude, as: :hidden %>
          <%= f.input :longitude, as: :hidden %>
          <div id="value_address" class="hidden" ></div>
        <% end %>
        <div class="description-field">
          <label for="media_attachment_description">Description</label>
          <%= f.text_area :description, rows: 7, maxlength: 1500 %>
          <span id="description-count">0/1500</span>
        </div>
      <% end %>
    </div>
    <div>
      <label class="btn btn-primary custom-file-input">
      <input type="file" id="thumbnail" name="thumbnail"
       accept="image/*" style="display:none;">
          Upload thumbnail
      </label>
      <span id="thumnail-filename">No file chosen</span>
    </div>
  </div>
</div>

<script src="https://maps.googleapis.com/maps/api/js?key=<%= ENV['GOOGLE_API_MAP_KEY'] %>&libraries=places&callback=initMap&sensor=false" async defer></script>

<script>
  function initMap() {
    var input = document.getElementById('media_attachment_location_search');
    var options = { componentRestrictions: {country: 'ca'} }
    var autocomplete = new google.maps.places.Autocomplete(input, options);
    autocomplete.addListener('place_changed', function() {
      var place = autocomplete.getPlace();
      if (!place.geometry) {
        window.alert("Autocomplete's returned place contains no geometry");
        return;
      }
      var location = place.geometry.location
      $("#media_attachment_latitude").val(parseFloat(location.lat()))
      $("#media_attachment_longitude").val(parseFloat(location.lng()))
      $("#value_address").val($("#media_attachment_location_search").val())
    });
  }

  function isBlankLatitude() {
    return $("#media_attachment_latitude").val().trim().length === 0
  }

  function isBlankLongitude() {
    return $("#media_attachment_longitude").val().trim().length === 0
  }

  document.getElementById('thumbnail').addEventListener('change', event => {
    var file = event.target.files[0];
    if (file.size >= 5242880) { // 5MB
      event.target.value = "";
      alert('Maximum file size is 5MB. Please try again.')
      return;
    }
    document.getElementById('thumnail-filename').innerHTML = file.name;
  })

  var titleCounter = document.getElementById('media_attachment_title').value.length;
  var descriptionCounter = document.getElementById('media_attachment_description').value.length;

  ['paste','keypress', 'change', 'keydown'].forEach( function(event) {
    document.getElementById('media_attachment_title').addEventListener(event, function (e) {
      setTimeout(function() {
        titleCounter = document.getElementById('media_attachment_title').value.length;
        if (titleCounter > 100) {
          e.preventDefault();
        }
        document.getElementById('title-count').innerHTML = `${titleCounter}/100`;
      }, 100);
    })

    document.getElementById('media_attachment_description').addEventListener(event, function (e) {
      setTimeout(function() {
        descriptionCounter = document.getElementById('media_attachment_description').value.length;
        if (descriptionCounter > 1500) {
          e.preventDefault();
        }

        if (descriptionCounter > 0 && e.keyCode == 46) {
          descriptionCounter += 1;
        }
        document.getElementById('description-count').innerHTML = `${descriptionCounter}/1500`;
      }, 100);
    })
  });

  var locationSlug = "<%= @location.slug %>";
  var session;
  var apiKey = "<%= ENV['VONAGE_API_KEY'] %>";
  var started = false;
  var connectionCount = 0;
  var publisherProperties = {width: '100%', height: '100%', resolution: '1280x720', insertMode: "append", usePreviousDeviceSelection: true};
  var targetElement = 'subscribers';
  let archiveID = null;
  let mediaAttachmentId = "";

  document.querySelectorAll('.create-archive').forEach(item => {
    item.addEventListener('click', event => {
      event.preventDefault();
      var mediaTitle = document.getElementById('media_attachment_title')
      if (mediaTitle.value == '') {
        document.getElementById("messageModal").style.display = "block";
        return;
      }

      var need_category = "<%= [174, 164, 114].include?(@vertical_market.id) %>"
      if (need_category === "true") {
        var categoryId = document.getElementById('category_id').value
        var municipality = "<%= @vertical_market.id === 114 %>"

        if (categoryId.length === 0 && municipality === "true" ) {
          document.getElementById("warningCateModal").style.display = "block";
          return
        }
        var valueSearch = $('#media_attachment_location_search').val().trim()
        var valueSearchResult = $("#value_address").val().trim()
        var inValidSearch = valueSearch.length === 0 || valueSearch !== valueSearchResult
        if (isBlankLatitude() || isBlankLongitude() || inValidSearch) {
          $("#media_attachment_latitude").val('')
          $("#media_attachment_longitude").val('')
          document.getElementById("warningLocationModal").style.display = "block";
          return
        }
      }

      if (started) {
        document.getElementById("confirmModal").style.display = "block";
        document.getElementById("confirm-modal").addEventListener('click', event => {
          document.getElementById("confirmModal").style.display = "none";
          document.getElementById("loadingModal").style.display = "block";
          start();
        })
        return;
      }

      if (!started) {
        document.getElementById("loadingModal").style.display = "block";
      }

      start();

      function start() {
        async function fetchToken() {
          let vonageData = {};
          vonageData = await fetch(`/media_attachments/get_vonage_token.json`, {
            method: 'get',
            }).then(function(response) {
            if (response.ok) {
              return response.json();
            }
            return Promise.reject(response);
            }).then(function (data) {
            return {sessionId: data.session_id, token: data.token}
          })
          return vonageData;
        }

        fetchToken().then(vonageData => {
          connect(vonageData);
          document.getElementById('stop-archive').addEventListener("click", function(event) {
            event.preventDefault();
            document.getElementById("loadingModal").style.display = "block";
            // event.target.textContent = "Stopping Recording ..."
            fetch(`/business/${locationSlug}/media_attachments/stop_archive/${archiveID}.json`, {
              method: 'get',
              headers: {
                'Accept': 'application/json',
                'X-CSRF-Token': $('meta[name="csrf-token"]').attr('content')
              }
            }).then(function(response) {
              console.log(response);
              if (response.ok) {
                return response.json();
              }
              return Promise.reject(response);
              }).then(function (data) {
                var videoId = data.video_id;
                disconnect();
                document.getElementById("loadingModal").style.display = "none";
                document.getElementById('stop-archive').disabled = false;
                document.getElementById('preview-video').disabled = false;
                document.getElementById('default-video-img').style.display = 'block';
                document.getElementById('subscribers').style.display = 'none';
                event.target.disabled = true;
                event.target.textContent = "Stop Recording";
                document.getElementById('start-archive').disabled = false;
                started = true;

                document.getElementById('placeholder-img').src = '/assets/default_video_image_2.jpeg';

                document.getElementById('preview-video').addEventListener("click", function(event) {

                  var need_category = "<%= [174, 164, 114].include?(@vertical_market.id) %>"
                  if (need_category === "true") {
                    var categoryId = document.getElementById('category_id').value
                    var municipality = "<%= @vertical_market.id === 114 %>"

                    if (categoryId.length === 0 && municipality === "true" ) {
                      document.getElementById("warningCateModal").style.display = "block";
                      return
                    }
                    var valueSearch = $('#media_attachment_location_search').val().trim()
                    var valueSearchResult = $("#value_address").val().trim()
                    var inValidSearch = valueSearch.length === 0 || valueSearch !== valueSearchResult
                    if (isBlankLatitude() || isBlankLongitude() || inValidSearch) {
                      $("#media_attachment_latitude").val('')
                      $("#media_attachment_longitude").val('')
                      document.getElementById("warningLocationModal").style.display = "block";
                      return
                    }
                  }

                  document.getElementById("loadingModal").style.display = "block";
                  var files = document.getElementById('thumbnail').files
                  if (files.length > 0) {
                    var data = new FormData();
                    data.append('file', files[0]);
                    fetch(`/videos/${videoId}/upload_thumbnail.json`, {
                      method: 'post',
                      body: data,
                      headers: {
                        'Accept': 'application/json',
                        'X-CSRF-Token': $('meta[name="csrf-token"]').attr('content')
                      }
                    })
                  }
                  updateMedia(videoId);
                  checkVideoUrl(videoId);
                })
              })
          })

        function updateMedia(videoId) {
          var title = document.getElementById('media_attachment_title').value;
          var description = document.getElementById('media_attachment_description').value;
          var municipality = "<%= @vertical_market.id === 114 %>"
          var need_category = "<%= [174, 164].include?(@vertical_market.id) %>"
          var cateId = municipality === "true" ? document.getElementById('category_id').value : null
          var lat = need_category === "true" || municipality === "true" ? $("#media_attachment_latitude").val() : null
          var lon = need_category === "true" || municipality === "true" ? $("#media_attachment_latitude").val() : null
          if (need_category === "true") {
            cateId = <%= @categories_news[0].id %>
          }
          var params = JSON.stringify({title: title, description: description, category_id: cateId, latitude: lat, longitude: lon})
          var data = new FormData();
          data.append('media_attachment', params);
          fetch(`/videos/${videoId}/update_media_attachment.json`, {
            method: 'post',
            body: data,
            headers: {
              'Accept': 'application/json',
              'X-CSRF-Token': $('meta[name="csrf-token"]').attr('content')
            }
          })
        }

        function checkVideoUrl(videoId) {
          setTimeout(function() {
            fetch(`/videos/${videoId}/check_video_url.json`, {
              method: 'get',
              headers: {
                'Accept': 'application/json',
                'X-CSRF-Token': $('meta[name="csrf-token"]').attr('content')
              }
            }).then(function(response) {
              if (response.ok) {
                return response.json();
              }
              return Promise.reject(response);
            }).then(function (data) {
              if (data.generated_url) {
                window.location.href = `/videos/${videoId}`;
              } else {
                checkVideoUrl(videoId);
                console.log('loading...');
              }
            });
          }, 2000);
        }
      })
      }

      function publish() {
        var publisher = OT.initPublisher(targetElement, publisherProperties, function (error) {
          if (error) {
            console.log(error);
          } else {
            session.publish(publisher, function(error) {
              if (error) {
                console.log(error);
              } else {
                console.log('Publishing a stream.');

                $('.OT_mirrored.OT_root.OT_publisher.OT_fit-mode-cover').append("<button class='OT_edge-bar-item OT_mute OT_mode-auto' id='OT_flip' type='button'>Flip</button>");
                $('#OT_flip').click(function() {
                  publisher.cycleVideo();
                })
              }
            });
          }
        });
        publisher.on({
          accessAllowed: function(event) {
            console.log("accessAllowed", event)
          },
          accessDenied: function(event) {
            console.log("accessDenied", event)
            alert('No camera found. Please try again.')
            publisher.destroy();
            document.getElementById('start-archive').style.display = 'inline-block;';
            document.getElementById('start-archive').disabled = false;
          },
          accessDialogOpened: function (event) {
          // Show allow camera message
            // pleaseAllowCamera.style.display = 'block';
          },
          accessDialogClosed: function (event) {
            // Hide allow camera message
            // pleaseAllowCamera.style.display = 'none';
          },
          streamCreated: function (event) {
            console.log("Publisher started streaming.");
          },
          streamDestroyed: function (event) {
            console.log("Publisher stopped streaming. Reason: "
              + event.reason);
          }
        });
      };

      function connect(vonageData) {
        let sessionId = vonageData.sessionId
        let token = vonageData.token
        session = OT.initSession(apiKey, sessionId);

        session.on({
          connectionCreated: function (event) {
            connectionCount++;
            console.log(connectionCount + ' connections.');
          },
          connectionDestroyed: function (event) {
            connectionCount--;
            console.log(connectionCount + ' connections.');
          },
          sessionDisconnected: function sessionDisconnectHandler(event) {
            // The event is defined by the SessionDisconnectEvent class
            console.log('Disconnected from the session.');
            if (event.reason == 'networkDisconnected') {
              alert('Your network connection terminated.')
            }
          },
          archiveStarted: function(event) {
            archiveID = event.id;
            console.log('ARCHIVE STARTED');
            // document.getElementById('start-archive').style.display = 'none';
            // document.getElementById('stop-archive').style.display = 'block';
            // disableForm();
          },
          archiveStopped: function(event) {
            archiveID = null;
            console.log('ARCHIVE STOPPED');
            // document.getElementById('start-archive').style.display = 'block';
            // document.getElementById('stop-archive').style.display = 'none';
            // enableForm();
          }
        });

        session.connect(token, function(error) {
          if (error) {
            console.log('Unable to connect: ', error.message);
          } else {
            console.log('Connected to the session.');
            connectionCount = 1;
            console.log(session.capabilities)
            if (session.capabilities.publish == 1) {
              document.getElementById("loadingModal").style.display = "none";
              document.getElementById('default-video-img').style.display = 'none';
              document.getElementById('subscribers').style.display = 'block';
              startRecord(vonageData);
              publish();
            } else {
              console.log("You cannot publish an audio-video stream.");
            }
          }
        });
      }

      function disconnect() {
        session.disconnect();
      }

      function disableForm() {
        document.getElementById('archive-options-fields').disabled = true;
      }

      function enableForm() {
        document.getElementById('archive-options-fields').disabled = false;
      }

      function startRecord(vonageData) {
        document.getElementById('preview-video').disabled = true;
        var data = new FormData(document.getElementById('new_media_attachment'));
        data.append('session_id', vonageData.sessionId);
        var files = document.getElementById('thumbnail').files
        if (files.length > 0) {
          data.append('thumbnail', files[0]);
        }
        event.preventDefault();
        fetch(`/business/${locationSlug}/media_attachments/start_archive.json`, {
          method: 'post',
          body: data,
          headers: {
            'Accept': 'application/json',
            'X-CSRF-Token': $('meta[name="csrf-token"]').attr('content')
          }
        }).then(function(response) {
          document.getElementById('start-archive').disabled = true;
          document.getElementById('stop-archive').disabled = false;
        })
      }
    })
  })
</script>
