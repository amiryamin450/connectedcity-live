<div class="card-label-five">
  <div class="title">
      <h4>Brands</h4>
  </div>
</div>
<% if @location.brands.size > 0  %>
  <div class="row card-row">
    <% @location.brands.in_groups_of(4) do |group| %>
      <% group.each do |brand| %>
        <% if brand %>
          <div class="col-md-3">
              <div class="business-body-card">
                <div class="img">
                  <%= link_to(image_tag(brand.logo.url), brand) %>
                </div>
                <div class="title">
                  <h3><%= link_to brand.name, brand %></h3>
                </div>
              </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="alert alert-dark" role="alert">
    No Brands found.
  </div>
<% end %>