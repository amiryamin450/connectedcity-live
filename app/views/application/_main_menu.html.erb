<%
  if @business_improvement_area
    @district = District.find(@business_improvement_area.district_id)
    @district_name = @district.slug

    @slug = @business_improvement_area.slug

    if @business_improvement_area.slug.include? "kitsilano"
      @slug = "kitsilano"
    end

    @neighbourhood = Neighborhood.where('slug LIKE ?', @slug)
  end
%>


<%
  @neighbourhood_param = params[:neighborhood]
  @neighbourhood_slug = params[:neighborhood]

  if @neighbourhood_param
    
    if @neighbourhood_param.include? "kitsilano"
      @neighbourhood_slug = "kitsilano"
    end
    
    @neighbourhood = Neighborhood.where('slug LIKE ?', @neighbourhood_slug).first
  end
%>
<nav id="nav">
  <a href="#" class="opener"><span></span></a>
  <div class="drop win-height">
    <div class="drop-holder">

      <ul class="main-nav">
        <li class="small active">
          <div>
            <a href="#"><i class="account"></i>account</a>
            <div class="sub-drop">
              <ul>
                <li>
                  <%= link_to "Login", new_user_session_path %>
                </li>
                <li>
                  <%= link_to "Sign Up", new_user_registration_path %>
                </li>
              </ul>
            </div>
          </div>
        </li>

        <li>
          <div><%= link_to @base_path, class: request.path == @base_path ? "active" : nil do %><i class="home"></i>Home<% end %></div>
        </li>

        <% @vertical_markets_all.each_with_index do |vm, index| %>
          <li>
            <div>
              <% if @business_improvement_area %>
                <%= link_to district_neighborhood_guide_path(@district_name, @slug, vm.slug) do %><i class="<%= vm.name.parameterize("_") %>"></i><%= vm.name %><% end %>
              <% elsif @district && @neighbourhood_slug %>
                <%= link_to district_neighborhood_guide_path(@district.slug, @neighbourhood_slug, vm.slug) do %><i class="<%= vm.name.parameterize("_") %>"></i><%= vm.name %><% end %>
              <% else %>
                <%= link_to "#{@base_path}guide/#{vm.slug}" do %><i class="<%= vm.name.parameterize("_") %>"></i><%= vm.name %><% end %>
              <% end %>

              <% if vm.has_children? %>
                <div class="sub-drop">
                  <ul>
                    <% vm.children.sort_by(&:name).each do |child| %>
                      <% if @business_improvement_area %>
                        <li><%= link_to child.name, district_neighborhood_guide_path(@district_name, @slug, child.slug) %></li>
                      <% else %>
                        <% if @neighbourhood %>
                          <li><%= link_to child.name, district_neighborhood_guide_path(@district, @neighbourhood.slug, child.slug) %></li>
                        <% else %>
                          <% if @district %>
                            <li><%= link_to child.name, top_district_guide_path(@district, child.slug) %></li>
                          <% else %>
                            <li><%= link_to child.name, "#{@base_path}guide/#{child.slug}" %></li>
                          <% end %>
                        <% end %>
                      <% end %>
                    <% end %>
                  </ul>
                </div>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>

      <div class="add-nav">
        <a href="#" class="add-opener">more</a>
        <div class="add-drop">
          <ul></ul>
        </div>
      </div>

      <ul class="side-nav">
        <li><div><a href="/employment-opportunities"><i class="jobs"></i>Jobs</a></div></li>
        <li class="right bottom"><div><a href="/classifieds"><i class="classified"></i>Classifieds</a></div></li>
        <li class="right"><div><a href="#{@base_path}news"><i class="city"></i>City News</a></div></li>
      </ul>
    </div>
  </div>
</nav>
