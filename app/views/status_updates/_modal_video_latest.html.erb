<div class="modal fade" data-id="<%= "video-#{media_attachment.id}-model" %>" id="<%="video-#{media_attachment.id}-model"%>">
  <div class="modal-dialog modal-xl" style="max-width: 80%;">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="statusModalLongTitle"><%= media_attachment.attachable.name%></h5>
        <button data-id="<%="video-#{media_attachment.id}-model"%>" type="button" class="close media-attachment" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <div class="row">
          <div class="col-md-6">
            <div class="cover">
              <% if media_attachment.is_stream_video %>
                <iframe width='100%' height='480' src="" data-src="<%= media_attachment.videos.first&.video_url %>" id="<%="video-#{media_attachment.id}-vonage"%>" frameborder='0' ></iframe>
              <% else %>
                <iframe width='100%' height='480' src="" data-src="https://www.youtube.com/embed/<%= media_attachment.media_source_id %>" id="<%="video-#{media_attachment.attachable.id}-player"%>" frameborder='0' ></iframe>
              <% end %>
            </div>
          </div>
          <div class="col-md-6">
            <div class="location-info-popup" style="margin-top: 5px;">
              <%= render 'locations/location_information', location: media_attachment.location, content: media_attachment.description, claim_business: false, show_neighborhood: true %>
              <div class="row-fluid">
                <div class="span12">
                  <div class="pad10 holder" style="margin-top: 1.5em;">
                    <div class="clearfix profile-map" data-coordinates=<%= raw media_attachment.location.geo_location.to_json() %> ></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  $(document).ready(function() {
    // when the modal is opened autoplay it
    var streamVideo = "<%= media_attachment.is_stream_video %>";
    // stop playing the youtube video when I close the modal
    $('#<%="video-#{media_attachment.id}-model"%>').on('hide.bs.modal', function (e) {
      if (streamVideo == "true") {
        $("#<%="video-#{media_attachment.id}-vonage"%>").attr('src', "");
      } else {
        $('#<%="video-#{media_attachment.attachable.id}-player"%>').attr("src", "");
      }
    });
  });

</script>
