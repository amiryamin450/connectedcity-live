<div class="card-label-three">
  <div class="title">
    <h4>Services</h4>
    <% if (user_signed_in? and current_user.has_role? :admin) or (user_signed_in? and current_user.can_manage_location? @location) %>
      <small><%= link_to "add", @location.is_profile ? new_location_citizen_service_path(@location) : new_location_service_path(@location), class: 'small' %> | <%= link_to 'manage', @location.is_profile ? location_citizen_services_path(@location) : location_services_path(@location) %></small>
    <% end %>
  </div>
</div>

<% if @services.size > 0 %>
  <div class="row card-row">
    <% @services.in_groups_of(4) do |group| %>
      <% group.each do |service| %>
        <% if service %>
          <div class="col-md-3">
            <div class="business-body-card">
              <div class="img">
                <%= link_to(image_tag(service.image.url(:list)), [@location, service]) %>
              </div>
              <div class="title">
                <h3><%= link_to service.name, [@location, service] %></h3>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
  <%= paginate @services, param_name: 'service_page' %>
<% else %>
  <div class="alert alert-dark" role="alert">
    No Services found.
  </div>
<% end %>
