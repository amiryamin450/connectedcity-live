<br><h4>Status Updates
 <% if (user_signed_in? and current_user.has_role? :admin) or (user_signed_in? and current_user.can_manage_location? @location) %>
  <small><%= link_to "add", "#", class: 'small status_update_new', role: :button, data: {toggle: 'modal', target: "#update-status-#{@location.id}-model"} %>

  <%#= link_to "add", new_location_status_update_path(@location), class: 'small', role: :button, data: {toggle: 'modal'} %>
 <!-- | -->
 <%#= link_to "manage social profiles", polymorphic_path([@location, :social_profiles]), class: 'small', role: :button %>
   <%= link_to "manage", location_status_updates_path(@location), class: 'small', role: :button  %>
 </small>
 <% end %>
</h4>

<div id="status_updates">
  <% if @location.status_updates.size > 0 %>
  <% @status_updates.each do |s| %>
    <div class="row">
        <div class="col-md-2">
          <div class="img">
              <%= link_to(image_tag(s.image.url, class: 'status-update-image', data: {"large-image" => s.image.url, "location-name" => @location.name}), '#status_update_image', data: {target: "#status-#{s.id}-model", toggle: 'modal'}) %>
          </div>
        </div>
        <div class="col-md-10">
          <p>
            <%= truncate(s.content, length: 200, seperator: ' ') %>
            <b><%= link_to "View More", "#", class: "status-update-image", data: { target: "#status-#{s.id}-model", toggle: 'modal'} %></b>
          </p>
          <span><%= "#{time_ago_in_words(s.created_at)} ago" %></span>
        </div>
    </div>
    <%= render 'status_updates/modal_content_latest', status_update: s %>
  <% end %>
  <%= paginate @status_updates, param_name: 'status_page' if (@is_location_normal && request.path != '/business/city-of-vancouver') %>

  <% else %>
  <div class="alert">No Status Updates found.</div>
  <% end %>
</div>
