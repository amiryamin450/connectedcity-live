<div class="card-label-three">
  <div class="title">
    <h4>Offers</h4>
    <% if (user_signed_in? and current_user.has_role? :admin) or (user_signed_in? and current_user.can_manage_location? @location) %>
      <small><%= link_to "add", new_location_coupon_path(@location), class: 'small' %> | <%= link_to 'manage', location_coupons_path(@location) %></small>
    <% end %>
  </div>
</div>

<% if @coupons.size > 0 %>
<div class="row card-row">
  <% @coupons.in_groups_of(4) do |group| %>
    <% group.each do |coupon| %>
      <% if coupon and coupon.how_many_left > 0 %>
      <div class="col-md-3">
        <div class="business-body-card">
          <div class="img">
            <%= link_to(image_tag(coupon.image.url(:large)), [@location, coupon]) %>
          </div>
          <div class="title">
            <h3><%= link_to coupon.name, [@location, coupon] %></h3>
          </div>
        </div>
        <% end -%>
      </div>
    <% end -%>


  <% end -%> 
</div>  

  <%= paginate @coupons, param_name: 'coupon_page' %>
<% else %>
<div class="alert alert-dark" role="alert">
  No Coupons found.
</div>
<% end %>