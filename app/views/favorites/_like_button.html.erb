<% if favorite = user_has_favorite?(location_id) %>
    <%= link_to  "<i class='icon-star'></i> Remove".html_safe, favorite_path(favorite), :method => :delete, :remote => true, :class => 'btn btn-mini btn-danger', :title => 'Remove from favorites.' %>
<% else %>
    <%= link_to "<i class='icon-star-empty'></i> Save".html_safe, favorites_path(current_user.favorites.build, :location_id => location_id, :user_id => current_user.id, :category => vertical_market_slug), :method => :post, :remote => true, :class => 'btn btn-mini btn-success', :title => 'Add to favorites.' %>
<% end %>
