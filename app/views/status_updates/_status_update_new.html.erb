<div class='modal fade' id="<%="update-status-#{@location.id}-model"%>" >
  <div class="modal-dialog modal-xl" style="max-width: 70%;">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">What's Happening?</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <%= simple_form_for :status_update, url: location_status_updates_path(@location), :html => { :method => :post, multipart: true, class: 'form-horizontal', id: 'new_status_update', } do |f| %>
          <%= f.error_notification %>
          <div class="form-inputs">
            <%= f.input :content, as: :text, input_html: { class: 'input-block-level wysihtml5', :rows => 3, style: 'width: 550px'} %>
            <% if @is_municipality || [174, 164].include?(@vertical_market.id) %>
              <% hidden = [174, 164].include?(@vertical_market.id) ? 'display: none' : 'display: flex' %>
              <div class="control-group string required category" style="<%= hidden %>">
                <%= f.label :category %>
                <div class="input-group-prepend search-box ">
                  <%= select_tag 'status_update[category_id]', options_from_collection_for_select(@categories_news, 'id', 'name'), prompt: 'All Categories', class: 'form-control', style: 'border-color: black;' %>
                </div>
              </div>
            <% end %>

            <div class="auto-search-wrapper control-group" style="margin-bottom: 20px; display: flex;">
              <%= f.label :location %>
              <div class="controls">
                <input class="p-2" style="border-color: black; border-radius: 0.25rem; min-width: 550px;" type="text" id="location_search" autocomplete="off" placeholder="Enter Address" />
                <label style="display: none;" id="location-error" class="error">This field is required.</label>
              </div>
            </div>
            <%= f.input :image, as: :file  %>
            <%= f.input :latitude, as: :hidden %>
            <%= f.input :longitude, as: :hidden %>
          </div>
        <div class="modal-footer form-actions">
          <input type="button" class="btn btn-secondary" data-dismiss="modal" aria-hidden="true" value="Cancel" />
          <%= f.button :submit, value: 'Create Status Update', :class => 'btn btn-primary', id: 'status-update-submit' %>
        </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript" src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.0/jquery.validate.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/tomik23/autocomplete@1.8.5/dist/css/autocomplete.min.css"/>
<script src="https://cdn.jsdelivr.net/gh/tomik23/autocomplete@1.8.5/dist/js/autocomplete.min.js"></script>
<script type="text/javascript">
  $(document).ready(function() {
    var municipality = "<%= @is_municipality %>";
    $("#new_status_update").validate({
      rules: {
        'status_update[content]': {
          required: true,
          maxlength: 1500,
        },
        'status_update[image]': {
          required: true,
        },
        'status_update[category_id]': {
          required: function(){ return municipality == "true" },
        },
        'status_update[latitude]': {
          required: function(){ return isBlankLatitude() },
        },
        'status_update[longitude]': {
          required: function(){ return isBlankLongitude() },
        }
      }
    });
    var need_category = "<%= [174, 164].include?(@vertical_market.id) %>"
    if (need_category === "true") {
      var value = <%= @categories_news[0].id %>
      $("form#new_status_update select").val(value);
    }
    $("form#new_status_update").on('submit', function(e) {
      if (isBlankLatitude() || isBlankLongitude()) {
        $('.auto-search-wrapper.control-group').css('margin-bottom', '40px')
        $('#location-error').css({'display': 'block', 'height': '0px'});
        $('#location-error').text('This is required field')
        e.preventDefault()
      } else {
        $('.auto-search-wrapper.control-group').css('margin-bottom', '20px')
        $('#location-error').css('display', 'none');
        $('#location-error').text('')
      }
    })
  });
  // https://tomik23.github.io/leaflet-examples/#21.geocoding-addresses-search-engine-outside-the-map
  // https://github.com/tomik23/autocomplete
  window.addEventListener("DOMContentLoaded", function () {
    new Autocomplete("location_search", {
      delay: 1000,
      selectFirst: true,
      howManyCharacters: 2,
      clearButton: false,
      onSearch: function ({ currentValue }) {
        $("#status_update_latitude").val('')
        $("#status_update_longitude").val('')
        $('.auto-clear').css({
          'height': '40px',
          'top': 'auto'
        })
        const api = `https://nominatim.openstreetmap.org/search?format=geojson&limit=5&q=${encodeURI(currentValue)}`;
        return new Promise((resolve) => {
          fetch(api)
            .then((response) => response.json())
            .then((data) => { resolve(data.features); })
            .catch((error) => { console.error(error); });
        });
      },
      onResults: ({ currentValue, matches, template }) => {
        const regex = new RegExp(currentValue, "i");
        // checking if we have results if we don't
        // take data from the noResults method
        return matches === 0
          ? template
          : matches
              .map((element) => {
                return `
                <li class="loupe" role="option">
                  ${element.properties.display_name.replace( regex, (str) => `<b>${str}</b>` )}
                </li> `;
              })
              .join("");
      },
      onSubmit: ({ object }) => {
        const { display_name } = object.properties;
        const cord = object.geometry.coordinates;
        $('#location_search').val(display_name)
        $("#status_update_latitude").val(parseFloat(cord[1]))
        $("#status_update_longitude").val(parseFloat(cord[0]))
        $('.auto-search-wrapper.control-group').css('margin-bottom', '20px')
        $('#location-error').css('display', 'none');
        $('#location-error').text('')
      },

      // get index and data from li element after
      // hovering over li with the mouse or using
      // arrow keys ↓ | ↑
      onSelectedItem: ({ index, element, object }) => {
        console.log("onSelectedItem:", index, element, object);
      },

      // the method presents no results
      noResults: ({ currentValue, template }) =>
        template(`<li>No results found: "${currentValue}"</li>`),
    });
    // })
  })

  function isBlankLatitude() {
    return $("#status_update_latitude").val().trim().length === 0
  }

  function isBlankLongitude() {
    return $("#status_update_longitude").val().trim().length === 0
  }
</script>
