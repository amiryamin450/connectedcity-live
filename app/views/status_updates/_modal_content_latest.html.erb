<div class="modal fade" id=<%="status-#{status_update.id}-model"%>>
  <div class="modal-dialog modal-xl" style="max-width: 80%;">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="statusModalLongTitle"><%= status_update.statusable.name%></h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <div class="row">
          <div class="col-md-6">
            <div class="row-fluid">
              <div class="span12">
                <%= image_tag status_update.image.url %>
              </div>
            </div>
          </div>
          <div class="col-md-6 ">
            <div class="row-fluid location-info-popup" style="margin-top: 5px;">
              <%= render 'locations/location_information', location: status_update.statusable, content: status_update.content, claim_business: false, show_neighborhood: true %>

              <div class="row-fluid">
                <div class="span12">
                  <div class="pad10 holder" style="margin-top: 1.5em;">
                    <div class="clearfix profile-map" data-coordinates=<%= raw status_update.statusable.geo_location.to_json() %> ></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
