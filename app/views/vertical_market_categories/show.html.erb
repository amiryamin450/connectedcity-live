<%

# Dynamically constructed title for guide/vertical market pages can consist of
# one of more of these 4 different pieces of information depending on what is
# available:
#
# - vertical market
# - neighborhood
# - district
# - city

guide = @vertical_market_category ? "#{@vertical_market_category.name} In #{@neighborhood.try(:name) || @district.try(:name) || @city.try(:name)}" : nil
metamagic title: "#{guide}".strip,
          description: "",
          canonical: ""#url_for(Rails.application.routes.recognize_path(request.path).merge({only_path: false, protocol: 'https'}))
%>
<%
  # categories = @facets['categories']
  # neighborhoods = @facets['neighborhoods']
  # brands = @facets['brands']
  markers = []
  locations = @vertical_market_category.get_locations_paged(@municipality, @city, @district, @neighborhood, @sub_neighborhood, params[:page], @bia).ransack(name_or_website_url_or_content_cont: params[:search]).result
  markers |= locations
  # has_filters = (request.parameters[:category].present? or request.parameters[:neighborhood].present? or request.parameters[:brand].present?) ? true : false
%>
<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="<%= root_path %>">Home</a></li>
    <!-- provincial-services: 164 , federal-services: 174 -->
    <% if [174, 164].include?(@vertical_market.id) %>
      <li class="breadcrumb-item" aria-current="page"><a style="margin-left: 10px;" href="#"><%= (@city&.name || 'Vancouver') %></a></li>
      <% @vertical_market.ancestors.each do |ancestor| %>
        <li class="breadcrumb-item active" aria-current="page"><a style="margin-left: 10px;" href="<%="#{@base_path}guide/#{ancestor.slug}"%>"><%=ancestor.name%></a></li>
      <% end %>
      <li class="breadcrumb-item" aria-current="page"><a style="margin-left: 10px;" href="<%="#{@base_path}guide/#{@vertical_market.slug}"%>"><%= " #{@vertical_market.name}" %></a></li>
    <% else %>
      <% if @municipality%>
         <% url = "/#{@municipality&.region&.province&.slug}/#{@municipality&.region&.slug}/#{@municipality&.slug}"%>
        <li class="breadcrumb-item" aria-current="page"><a style="margin-left: 10px;" href="<%= url %>"><%= (@municipality&.name || 'Vancouver') %></a></li>
      <%end%>
      <%if @city %>
        <% url = "/#{@city&.municipality&.region&.province&.slug}/#{@city&.municipality&.region&.slug}/#{@city&.municipality&.slug}/#{@city.slug}"%>
        <li class="breadcrumb-item" aria-current="page"><a style="margin-left: 10px;" href="<%= url %>"><%= (@city&.name || 'Vancouver') %></a></li>
      <%end%>
      <% if @district %>
        <% url = "/#{@district.city&.municipality&.region&.province&.slug}/#{@district.city&.municipality&.region&.slug}/#{@district.city&.municipality&.slug}/#{@district.city&.slug}/#{@district.slug}"%>
        <li class="breadcrumb-item active" aria-current="page"><a style="margin-left: 10px;" href="<%=url%>"><%=@district.name%></a></li>
      <% end %>
      <%if @neighborhood %>
        <% url = "/#{@neighborhood.district&.city&.municipality&.region&.province&.slug}/#{@neighborhood.district&.city&.municipality&.region&.slug}/#{@neighborhood.district&.city&.municipality&.slug}/#{@neighborhood.district&.city&.slug}/#{@neighborhood.district&.slug}/#{@neighborhood.slug}"%>
        <li class="breadcrumb-item" aria-current="page"><a style="margin-left: 10px;" href="<%= url%>"><%= @neighborhood.name%></a></li>
      <% end %>
      <% if @sub_neighborhood %>
        <% url = "/#{@sub_neighborhood.neighborhood&.district&.city&.municipality&.region&.province&.slug}/#{@sub_neighborhood.neighborhood&.district&.city&.municipality&.region&.slug}/#{@sub_neighborhood.neighborhood&.district&.city&.municipality&.slug}/#{@sub_neighborhood.neighborhood&.district&.city&.slug}/#{@sub_neighborhood.neighborhood&.district&.slug}/#{@sub_neighborhood.neighborhood&.slug}/#{@sub_neighborhood.slug}"%>
        <li class="breadcrumb-item" aria-current="page"><a style="margin-left: 10px;" href="<%=url%>"><%= @sub_neighborhood.name%></a></li>
      <% end %>
      <% @vertical_market.ancestors.each do |ancestor| %>
        <% if @sub_neighborhood %>
          <li class="breadcrumb-item"><a href="<%=city_district_nbh_sub_guide_path(@city&.slug, @district&.slug, @neighborhood&.slug, @sub_neighborhood&.slug, ancestor.slug)%>" style="margin-left: 10px;"><%=ancestor.name%></a></li>
        <% elsif @neighborhood %>
          <li class="breadcrumb-item"><a href="<%= city_district_neighborhood_guide_path(@city&.slug, @district&.slug, @neighborhood&.slug, ancestor.slug)%>" style="margin-left: 10px;"><%=ancestor.name%></a></li>
        <% elsif @district %>
          <li class="breadcrumb-item"><a href="<%= city_district_guide_path(@city&.slug, @district&.slug, ancestor.slug)%>" style="margin-left: 10px;"><%=ancestor.name%></a></li>
        <% elsif @city %>
          <li class="breadcrumb-item"><a href="<%=city_guide_path(@city&.slug, ancestor.slug)%>" style="margin-left: 10px;"><%=ancestor.name%></a></li>
        <% elsif @municipality %>
          <li class="breadcrumb-item"><a href="<%= municipality_guide_path(@municipality&.slug, ancestor.slug)%>" style="margin-left: 10px;"><%=ancestor.name%></a></li>
        <%else%>
          <li class="breadcrumb-item"><a href=<%="#"%> style="margin-left: 10px;"><%=ancestor.name%></a></li>
        <% end %>
      <% end %>
      <% if @sub_neighborhood %>
        <li class="breadcrumb-item"><a href="<%=city_district_nbh_sub_guide_path(@city&.slug, @district&.slug, @neighborhood&.slug, @sub_neighborhood&.slug,  @vertical_market.slug)%>" style="margin-left: 10px;"><%= @vertical_market.name%></a></li>
      <% elsif @neighborhood %>
        <li class="breadcrumb-item"><a href="<%= city_district_neighborhood_guide_path(@city&.slug, @district&.slug, @neighborhood&.slug,  @vertical_market.slug)%>" style="margin-left: 10px;"><%= @vertical_market.name%></a></li>
      <% elsif @district %>
        <li class="breadcrumb-item"><a href="<%= city_district_guide_path(@city&.slug, @district&.slug,  @vertical_market.slug)%>" style="margin-left: 10px;"><%= @vertical_market.name%></a></li>
      <% elsif @city %>
        <li class="breadcrumb-item"><a href="<%=city_guide_path(@city&.slug,  @vertical_market.slug)%>" style="margin-left: 10px;"><%= @vertical_market.name%></a></li>
      <% elsif @municipality %>
        <li class="breadcrumb-item"><a href="<%= municipality_guide_path(@municipality&.slug,  @vertical_market.slug)%>" style="margin-left: 10px;"><%= @vertical_market.name%></a></li>
      <%else%>
        <li class="breadcrumb-item"><a href=<%="#"%> style="margin-left: 10px;"><%=ancestor.name%></a></li>
      <% end %>
    <% end %>
  </ol>
</nav>
<!-- Breadcrumb End -->
<div class="category-body-section">
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-12">
        <!--  Category -->
        <div class="page-title">
          <% if [174, 164].include?(@vertical_market.id) %>
            <h3>Browse Members of <%= @vertical_market.id === 164 ? 'the Legislative Assembly in' : 'Parliament in' %> <%= @current_district %></h3>
          <% else %>
            <h3><%= @vertical_market.name %> in <%= @current_district %></h3>
          <% end %>
        </div>
        <!-- End -->
      </div>
    </div>
    <div class="row">
      <div class="col-md-4">
        <div class="category-sidebar">
          <div class="map-section">
            <div id="map"></div>
          </div>
          <div class="SideBar-tabs">
            <!-- municipal-services 114-->
            <% if [174, 164, 114].include?(@vertical_market.id) %>
              <%= render 'layouts/application_v_2/guide_sidebar_municipality' %>
            <% else %>
              <%= render 'layouts/application_v_2/guide_sidebar', locations: locations %>
            <% end %>
          </div>
        </div>
      </div>
      <!-- SideBar End -->
      <div class="col-md-8 d-none d-md-block">
        <div class="category-body">
          <br>
          <%= render 'share/search_box', url: '', opts: options_from_collection_for_select([@vertical_market], 'id', 'name', @vertical_market.try(:id)), all_promt: 'all categories' %>

          <div class="card-label-one">
            <div class="title">
              <h4>&nbsp;<%= @vertical_market_category.name %>&nbsp;</h4>
            </div>
          </div>

          <div class="location-holder row card-row">
            <% locations.each do |location| %>
              <% cache "#{user_signed_in? ? "in" : "out"}_location_#{location.id}_#{location.updated_at}" do %>
                <div class="col-md-2">
                  <div class="category-body-card">
                    <div class="img">
                        <%= link_to image_tag(get_location_image_url(location)), location %>
                    </div>
                    <div class="title">
                        <h4><%= link_to location.name, location %></h4>
                    </div>
                    <hr>
                    <div class="contact-details">
                      <span><i class="fal fa-map-marker-alt"></i>
                        <%= "#{location.address}".html_safe %>
                        <%= "#{location.city.name if location.city.present? } B.C. #{location.postal_code}".html_safe %>
                      </span>
                      <br>
                      <span><i class="far fa-phone-alt"></i><%= location.phone %></span>
                    </div>
                    <div class="button favorite" id="favorite-<%= location.id %>">
                      <% if show_save_button?(user_signed_in?, location.vertical_markets.present?) %>
                        <%= render 'favorites/like_button_v2', location_id: location.id, vertical_market_slug: location.vertical_markets.first.slug if user_signed_in? and location.vertical_markets.present? %>
                      <% end %>
                      <% if !user_signed_in? %>
                        <%= link_to "Follow", "#", class: "btn btn-primary", role: "button", data: { toggle: "modal", target: "#login_for_save" } %>
                      <% end %>
                      <%# <button class="btn btn-primary">Follow</button> %>
                    </div>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
          <div class="row-fluid">
            <%= paginate locations %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%= javascript_tag do %>
  window.locations = <%= raw map_locations_data(markers) %>;
<% end %>