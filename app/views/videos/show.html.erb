<h1>Preview Video</h1>
<%= form_for @video do |f| %>
  <div class="row-fluid media-attachment-area">
    <div class="span6">
      <iframe width='853' height='480' src='<%= @video.video_url %>' frameborder='0' allowfullscreen></iframe>
    </div>
    <div class="span6">
      <%= f.fields_for :media_attachment do |ff| %>
        <h1><%= ff.text_field :title %></h1>
        <div class="text-secondary py-2"><span class="px-2">100,123 views</span><span>&middot;</span><span class="px-2">2 months ago</span></div>
        <div><%= ff.text_field :description %></div>
      <% end %>
    </div>
    <%= f.submit "Save" %>
  </div>
<% end %>
<div>
<%= form_for @video, multipart: true do |f| %>
  <label for="thumbnail">Upload a thumbnail:</label>
  <%= f.file_field :thumbnail %>
  <%= f.submit "Save changes" %>
<% end %>
</div>
<br>
<div>
  <span>Audio: </span>
  <%= form_for @video, multipart: true do |f| %>
    <%= f.hidden_field 'remove_audio', value: true %>
    <%= f.submit "Mute Audio" %>
  <% end %>
  <%= form_for @video, multipart: true do |f| %>
    <label for="thumbnail">Upload new audio</label>
    <%= f.file_field :audio %>
    <%= f.submit "Save changes" %>
  <% end %>
</div>
