<h1>Select a Facebook Page</h1>

<% if @accounts.any? %>
  <table class="table table-bordered table-striped table-hover">
    <thead>
      <tr>
        <th>Page</th>
        <th>Id</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @accounts.each do |account| %>
        <tr>
          <td><%= account[:name] %></td>
          <td><%= account[:id] %></td>
          <td>
            <%= link_to "Select", polymorphic_url([@owner, :social_profiles], code: params[:code], uid: account[:id]), class: "btn btn-mini" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
