<div class="modal fade hide" id="login_for_save" tabindex="-1" role="dialog" aria-labelledby="login_for_save" aria-hidden="true">
  <div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
  </div>
  <div class="modal-body">
      <p>
      Please <%= link_to "sign-up", new_user_registration_path %> and/or <%= link_to "log-in", new_user_session_path %> to save a business to your account.
      </p>
  </div>
  <div class="modal-footer">
    <button class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
  </div>
</div>
