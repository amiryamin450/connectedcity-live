<% if favorite = user_has_favorite?(location_id) %>
  <%= link_to("Following", favorite_path(favorite), method: :delete, remote: true, class: "btn btn-danger") %>
<% else %>
  <%= link_to("Follow", user_follow_favorites_path(location_id: location_id, user_id: current_user.id), method: :post, remote: true, class: "btn btn-primary") %>
<% end %>
