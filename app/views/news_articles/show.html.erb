<%
meta title: @news_article.title.strip,
     description: "",
     canonical: url_for(Rails.application.routes.recognize_path(request.path).merge({only_path: false, protocol: 'https'}))

%>
<div class="px-3 pb-3 px-md-5 pb-md-5">
  <h2 class="my-4"><%= "#{@news_article.newsable.name}'s News Article" %></h2>
  <h6>Title</h6>
  <div><%= @news_article.title %></div>
  <h6>Content</h6>
  <div>
    <%= @news_article.content.html_safe %>
  </div>
  <% if @news_article.image.exists? %>
    <div class="thumbnail">
      <%= image_tag @news_article.image.url %>
    </div>
  <% end %>
  <% if (user_signed_in? and current_user.has_role? :admin) or (user_signed_in? and current_user.can_manage_location? @location) %>
    <div class="py-3">
      <%= link_to 'Edit News Article', edit_location_news_article_path(@location, @news_article), class: 'btn btn-primary'  %>
      <%= link_to "Back to Manage #{@location.name}'s News Article", location_news_articles_path(@location), class: 'btn mx-4' %>
    </div>
  <% end %>
</div>
