<div class="px-3 pb-3 px-md-5 pb-md-5">
  <h1 class="my-4">Manage <%= @location.name %>'s Status Updates</h1>

  <table class="table table-bordered table-striped table-hover">
    <tr>
      <th>Content</th>
      <th></th>
    </tr>

  <% @status_updates.each do |status_update| %>
    <tr>
      <td><%= status_update.content %></td>
      <td>
        <div class='btn-group'>
          <%= link_to 'Delete', location_status_update_path(@location, status_update), method: :delete, class: 'btn btn-mini' %>
        </div>
      </td>
    </tr>
  <% end %>
  </table>

  <br />

  <%#= link_to 'New Status Update', new_location_status_update_path(@location), class: 'btn btn-primary' %>
  <%= link_to "Back to #{@location.name}", @location, class: 'btn'  %>
</div>
