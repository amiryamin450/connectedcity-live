<h1>City News Categories</h1>

<table class="table table-bordered table-striped table-hover">
  <tr>
    <th>Name</th>
    <th></th>
  </tr>

<% @city_news_categories.each do |city_news_category| %>
  <tr>
    <td><%= city_news_category.name %></td>

    <td>
      <div class='btn-group'>    
        <%= link_to 'Show', city_news_category, class: 'btn btn-mini' %>
        <%= link_to 'Edit', edit_city_news_category_path(city_news_category), class: 'btn btn-mini' %>
        <%= link_to 'Destroy', city_news_category, method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-mini' %>
      </div>
    </td>
  </tr>
<% end %>
</table>

<br />

<%= link_to 'New City news category', new_city_news_category_path, class: 'btn btn-primary' %>
<%= link_to 'Back', :back, class: 'btn' %>
