<%= simple_form_for [@location, @media_attachment] do |f| %>
<div class="form-inputs">
  <%= f.input :attachment, as: :url, label: "URL (ex. https://www.youtube.com/watch?v=abcdefghijk)" %>
</div>

<div class="form-actions">
  <%= f.button :submit, class: 'btn btn-primary' %>
  <%= link_to 'Cancel', :back, class: 'btn'  %>
</div>

<% end %>
