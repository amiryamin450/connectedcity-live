<div class="container-fluid">
  <div class="row">
    <div class="col-md-12 column association-banner">
      <div class="image" style="background-image: url(<%= @trade_association.home_page_image.url %>)">
      </div>
    </div>
  </div>
</div><br>

<div class="container-fluid mb-4">
  <h1><%= @trade_association.name %>
    <% if user_signed_in? and current_user.has_role? :admin %>
    <small>
      <%= link_to 'edit', edit_trade_association_path(@trade_association) %>
    </small>
    <% end -%>
  </h1>
</div>

<div class="container-fluid">
  <div class="row">
    <div class="col-md-6 col-12">
      <div class="association-about-block">
        <div class="holder">
          <div class="d-flex flex-row">
            <div class="logo border border-dark rounded m-2">
              <%= image_tag(@trade_association.logo.url(:display), class: 'p-2') %>
            </div>
            <div class="ps-3">
              <div class="about d-flex flex-column">
                <h5>About <%= @trade_association.name %></h5>
                <div><%= @trade_association.description.html_safe %></div>
                <div class="mt-3">
                  <%= link_to "Visit us online!", @trade_association.website_url, class: 'btn btn-success' if @trade_association.website_url.present? %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-12">
      <div class="landing-page-heading-filter association-page my-3">
        <div class="row px-3">
          <div class="col-12">
            <%= render 'share/search_box', url: '', opts: options_from_collection_for_select(@vertical_markets_all, 'id', 'name', params[:market_id]), all_promt: 'All' %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="container-fluid">
  <div class="row">
    <div class="col-md-12">
      <!-- Shopping District Slider -->
      <div class="district-slider">
        <div class="slider-heading my-3">
          <h3> Featured Businesses </h3>
        </div>
        <div class="inner-slider">
          <div class="items">
            <% @trade_association.locations.business.order("RAND()").each do |location| %>
              <div>
                <div class="district-slider-img">
                  <%= link_to(image_tag(get_location_image_url location), location) %>
                </div>
                <p>
                  <%= link_to location.name, location %>
                </p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
      <!-- End -->
    </div>
  </div>
</div>

<%

%>
<br>
  <%= render "/layouts/application_v_2/multi_columns" %>
<br>
