<div class="row-fluid article">
  <div class="span2">
    <%= link_to(image_tag(service.image.url), [service.location, service]) if service.image? %>
  </div>
  <div class="span10">
    <div class="name"><%= link_to(service.name, [service.location, service]) %></div>
    <div style="margin-bottom: 5px;"><span class="time-ago">by <%= link_to service.location.name, service.location %></span></div>
    <div><%= raw " <span class='price' >$#{service.price}</span>" if service.price.present? %></div>
  </div>
</div>
