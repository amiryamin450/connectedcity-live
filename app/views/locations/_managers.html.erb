<table class="table table-striped table-compact table-bordered">
  <tr>
    <th>Name</th>
    <th>Email</th>
    <th>Actions</th>
  </tr>

  <% @managers.each do |manager| %>
      <tr>
        <td><%= manager.user.name %></td>
        <td><%= link_to manager.user.email, "mailto:".concat(manager.user.email) %></td>
        <td><%= link_to 'Remove', location_manager_path(@location, manager), method: :delete, data: { confirm: 'Are you sure you want to remove this manager?' }, class: 'btn btn-mini' %></td>
      </tr>
  <% end %>
</table>
<%= link_to 'Add Manager', new_location_manager_path(@location) %>


