
<div class="row-fluid article">
  <div class="span2">
    <%= image_tag news_article.newsable.logo.url if news_article.newsable.logo? %>
  </div>
  <div class="span10">
    <div class="name"><%= link_to news_article.title, [news_article.newsable, news_article] %> </div>
    <div style="margin-bottom: 5px;"><span class="time-ago"> <%= "#{time_ago_in_words(news_article.created_at)} ago" %>. by <%= link_to news_article.newsable.name, news_article.newsable %></span></div>
    <div><%= truncate_html( news_article.content, :length => 300 ) %></div>
  </div>                
</div>