<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!--[if lt IE 9]>
  <script src="http://html5shim.googlecode.com/svn/trunk/html5.js"></script>
  <![endif]-->

  <title><%= content_for?(:title) ? yield(:title) : "ConnectedCity" %></title>
  <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "ConnectedCity" %>">
  <%= stylesheet_link_tag "application", :media => "all" %>
  <%= javascript_include_tag "application" %>
  <%= csrf_meta_tags %>
  <%= yield(:head) %>
</head>
<body>
<div id="wrapper">
  <header id="header">
    <div class="header-top">
      <div class="logo-block">
        <div class="logo">
          <a href="#">
            <a href="/" title="ConnectedCity"><%= image_tag 'logo.svg', width: 524 %></a>
            <!--<img src="images/logo.svg" alt="Connectedcity" width="283" height="48">-->
          </a>
        </div>
        <span class="tagline">for everything local</span>
      </div>
      <%= render 'new_location_chooser' %>
    </div>
    <%= render 'new_main_menu' %>
  </header>
  <main id="main" role="main">
    <aside class="aside">
      <div id="sidebar" class="<%= @sidebar_class %>">
        <%= render 'user_sidebar' %>
      </div>
    </aside>
    <div id="content">
      <div class="gap">
        <div id="breadcrumbs">
          <div class="breadcrumb">
            <%= render_crumbs(separator: "<span class='divider'><i class='icon-angle-right'></i></span>".html_safe).html_safe %>
            <%= render 'social_media' %>
          </div>
        </div>
      </div>
      <div class="container-fluid content-holder">
        <%= render 'messages' %>
        <div class="row-fluid">
          <%= yield %>
        </div>
      </div>
    </div>
  </main>
</div>
<%= render 'footer' %>
<%= render 'js_footer_includes' %>
</body>
</html>
