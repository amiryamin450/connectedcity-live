<%

# Dynamically constructed title for guide/vertical market pages can consist of
# one of more of these 4 different pieces of information depending on what is
# available:
#
# - vertical market
# - neighborhood
# - district
# - city
guide = @vertical_market ? "#{@vertical_market.name} Guide" : nil
meta title: ["Search results for \"#{params[:search]}\"", "#{@neighborhood.try(:name) || @district.try(:name) || @city.try(:name)} #{guide}".strip],
     description: "",
     canonical: "",
     robots: "noindex, follow"

%>


<h3>Search Results <em><%= "for #{params[:search].present? ? params[:search] : 'All Records'}"  %></em></h3>

<div class="result-numbers">Showing <%= "#{params[:page].present? ? @results.count * params[:page].to_i : '1'} to #{ params[:page].present? ? (@results.count * params[:page].to_i) + @results.count : @results.count }"  %> of <%= @results.total_entries %> results</div>

<div class="pagination-holder top">
  <%= paginate @results  %>
</div>

<div class="category-body-section">
  <div class="category-body">
    <div class="location-holder row card-row">
      <% @results.each do |location| %>
        <% if location.is_a? Location %>
          <div class="col-md-2 col-6">
            <div class="category-body-card">
              <div class="img">
                <%= link_to image_tag(get_location_image_url(location)), location %>
              </div>
              <div class="title">
                <h4><%= link_to location.name, location %></h4>
              </div>
              <hr>
              <div class="contact-details">
                <span><i class="fal fa-map-marker-alt"></i>
                  <%= "#{location.address}".html_safe %>
                  <%= "#{location.city.name if location.city.present? } B.C. #{location.postal_code}".html_safe %>
                </span>
                <br>
                <span><i class="far fa-phone-alt"></i><%= location.phone %></span>
              </div>
              <div class="button favorite favorite-<%= location.id %>" id="favorite-<%= location.id %>">
                <% if show_save_button?(user_signed_in?, location.vertical_markets.present?) %>
                  <%= render 'favorites/like_button_v2', location_id: location.id, vertical_market_slug: location.vertical_markets.first.slug if user_signed_in? and location.vertical_markets.present? %>
                <% end %>
                <% if !user_signed_in? %>
                  <%= link_to "Follow", "#", class: "btn btn-primary", role: "button", data: { toggle: "modal", target: "#login_for_save" } %>
                <% end %>
              </div>
            </div>
          </div>
        <% else %>
          <div class="col-md-2 col-6">
            <div class="category-body-card">
              <div class="img">
                <%= link_to(image_tag(location.main_image.url(:display)), [location.location, location])%>
              </div>
              <div class="title">
                <h4><%= link_to location.title, [location.location, location] %></h4>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="pagination-holder bottom">
      <%= paginate @results %>
    </div>
  </div>
</div>

<%= javascript_tag do %>
window.locations = <%= raw @results.select { |m| m.is_a? Location }.collect { |m| {:name => m.name, :url => url_for(m), :latitude => m.latitude, :longitude => m.longitude, :thumb => m.logo.file? ? m.logo.url(:bia_display) : nil}}.to_json %>;
<% end %>

