<div class="form-holder">
  <%= form_tag "#{@base_path}search", class: 'search-form', method: :get do %>
    <fieldset>
      <div class="row">
        <%= search_field_tag :search, params[:search], placeholder: "Search in ... " %>
      </div>
      <div class="row">
        <%= select_tag 'market', options_from_collection_for_select(@vertical_markets_all, 'id', 'name'), prompt: 'all categories', class: 'category' %>
      </div>
      <div class="submit-wrap">
        <input type="submit" value="submit">
      </div>
    </fieldset>
  <% end %>
</div>