<%
  if @business_improvement_area
    @district = District.find(@business_improvement_area.district_id)
    @district_name = @district.slug
    @slug = @business_improvement_area.slug
    @slug = "kitsilano" if @business_improvement_area.slug.include? "kitsilano"
    @neighbourhood = Neighborhood.where('slug LIKE ?', @slug)
  end
%>
<%
  @neighbourhood_param = params[:neighborhood] || params[:neighborhood_slug]
  @neighbourhood_slug = params[:neighborhood]  || params[:neighborhood_slug]
  if @neighbourhood_param
    @neighbourhood_slug = "kitsilano" if @neighbourhood_param.include? "kitsilano"
    @neighbourhood = Neighborhood.where('slug LIKE ?', @neighbourhood_slug).first
  end
%>
<% @district_slug = params[:district_route] || params[:district_slug] %>

<div class="nav-bar">
  <div class="container-fluid p-0 d-flex align-items-center">
    <div id="main" class="main d-flex">
      <div>
        <%= link_to root_path, class: "selected" do %>
          Home
        <% end %>
      </div>
      <% @vertical_markets_all.each_with_index do |vm, index| %>
        <%= render 'layouts/application_v_2/nav_bar_item', c: vm %>
      <% end %>
      <div class="dropdown more" data-width="70">
        <%= link_to 'More', '#', class:"dropdown-toggle d-none d-md-block", data: { toggle: "dropdown" } %>
        <%= link_to '#', class: "opener d-block d-md-none pr-0 mr-2", data: {'bs-toggle': "offcanvas", 'bs-target': "#offcanvasWithBackdrop"} do %>
          <span></span>
        <% end %>
        <div class='dropdown-menu offcanvas offcanvas-start' id="offcanvasWithBackdrop">
          <%= render 'layouts/application_v_2/nav_bar_item', c: @vertical_market_news, only_mobile: true %>
          <%= link_to classifieds_path, class: 'd-block d-md-none' do %>
            Classfieds
          <% end %>
          <%= link_to employment_opportunity_path, class: 'd-block d-md-none' do %>
            Jobs
          <% end %>
          <%= render 'layouts/application_v_2/nav_bar_item', c: @vertical_market_members, only_mobile: true %>
        </div>
      </div>
    </div>

    <div class="menu-nav-right d-none d-md-flex">
      <%= render 'layouts/application_v_2/nav_bar_item', c: @vertical_market_news %>
      <%= link_to 'Classfieds', classifieds_path %>
      <%= link_to 'Jobs', employment_opportunity_path %>
      <%= render 'layouts/application_v_2/nav_bar_item', c: @vertical_market_members %>
    </div>
    <div class='d-block d-md-none w-100 p-1 d-flex flex-row-reverse align-items-center' id='search-bar'>
      <%= render 'location_chooser_v_2' %>
      <div id="mobile-search-box" class="d-none" style="width: 85%">
        <%= render 'share/search_box', url: search_url, opts: options_from_collection_for_select(@vertical_markets_all, 'id', 'name', @vertical_market.try(:id)), all_promt: 'All' %>
      </div>
    </div>
  </div>
</div>
<script>
  var isMobile = false;
  if ($('.more .opener').css('display')=='block') {
    isMobile = true;
  }

  function calcWidth() {
    var navwidth = 0;
    var morewidth = $('#main .more').outerWidth(true);
    var availablespace = $('.nav-bar').width() - $('.menu-nav-right').width() - $('#search-bar').width() - morewidth;
    $('#main > div:not(.more)').each(function() {
      navwidth += $(this).outerWidth( true );
    });

    // Move overflow navitems into dropdown
    $('#main > div:not(.more)').get().reverse().forEach(i => {
      if (navwidth > availablespace) {
        var item = $(i);
        navwidth = navwidth - item.outerWidth(true);
        item.prependTo($('#main .more > .dropdown-menu'));
      } else {
        return
      }
    })

    // Show more button if there is items in dropdown
    $('.more').css('display', $('.more > .dropdown-menu').children().length > 3 ? 'block' : 'none');
    // Set mobile fullscreen dropdown
    if ($('.opener').css('display') === 'block') {
      $('.more .dropdown-menu.offcanvas').addClass('offcanvas offcanvas-start')

      // Set height of mobile screen dropdown menu to fit menu
      var menuSizeHeight = `${(screen.height - 170) * <%= 100.0 / (@vertical_markets_all.size + 5) %> / 100}px`;
      $('#offcanvasWithBackdrop > *').outerHeight(menuSizeHeight);
      $('#offcanvasWithBackdrop > div > a').addClass('h-100');
    } else {
      $('.more .dropdown-menu.offcanvas').removeClass('offcanvas offcanvas-start')
    }
    // Set sub-dropdown open direction
    $('.more > .dropdown-menu > .dropdown').addClass('dropright');
    $('.more > .dropdown-menu > div > a, .more > .dropdown-menu > a').addClass('py-1');
  }

  function navHeadingDirect(e) {
    if (!isMobile) {
      window.location.href = $(e.target).attr("href");
    }
  }

  var clickedEl = null;
  $(".nav-bar .dropdown:not(.more)").on('click', function() {
    if (!isMobile) { window.location.href = $(this).children('a').attr('href') }

    if (clickedEl == $(this)[0]) {
      window.location.href = $(this).children('a').attr('href');
    } else {
      clickedEl = $(this)[0];
    }
  });

  $(document).ready(function(){
    calcWidth();
  });

  $(window).on('resize load',function(){
    calcWidth();
  });

</script>
