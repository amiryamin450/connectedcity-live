<div class="container-fluid">
  <div class="row">
    <div class="col-md-12 column association-banner">
      <div class="image" style="background-image: url(<%= @trade_association.home_page_image.url %>)">
      </div>
    </div>
  </div>
</div><br>

<div class="row-fluid">
  <h1><%= @trade_association.name %>
    <% if user_signed_in? and current_user.has_role? :admin %>
    <small>
      <%= link_to 'edit', edit_trade_association_path(@trade_association) %>
    </small>
    <% end -%>  
  </h1>
</div>

<div class="landing-page-heading-filter association-page mt-3 mb-5">
  <div class="row px-3">
    <div class="col-12">
      <%= render 'share/search_box', url: '', opts: options_from_collection_for_select(@vertical_markets_all, 'id', 'name', params[:market_id]), all_promt: 'All' %>
    </div>
  </div>
</div>

<div class="association-about-block mt-5 mb-3">
  <div class="row-fluid">
    <div class="holder px-3 ">
      <div class="row">
        <div class="col-md-6 col-12 logo border border-dark rounded">
          <%= image_tag(@trade_association.logo.url(:display), class: '') %>
        </div>
        <div class="col-md-6 col-12 al">
          <div class="about d-flex flex-column justify-content-between">
            <h5>About <%= @trade_association.name %> BIA</h5>
            <%= @trade_association.description.html_safe %>
            <div class="w-50">
              <%= link_to "Visit us online!", @trade_association.website_url, class: 'btn btn-success input-block-level' if @trade_association.website_url.present? %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="container-fluid">
  <div class="row">
    <div class="col-md-12">
      <!-- Shopping District Slider -->
      <div class="district-slider">
        <div class="slider-heading">
          <h3> Featured Businesses </h3>
        </div>
        <div class="inner-slider">
          <div class="items">
            <% @trade_association.locations.order("RAND()").each do |location| %>
              <div>
                <div class="district-slider-img">
                  <%= link_to(image_tag(get_location_image_url location), location) %>
                </div>
                <p>
                  <%= link_to location.name, location %>
                </p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
      <!-- End -->
    </div>
  </div>
</div>

<%

%>
<br>
 <%= render "multi_columns" %>
<br>
