<%= simple_form_for([@location, @automotive_listing],
  :html => { :multipart => true, class: 'form-horizontal automotive-listing-form'},
    wrapper: :horizontal_form,
) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.input :title %>
    <%= f.input :status, collection: [["New", "new"], ["Used", "used"]], prompt: 'Please Select', required: true, wrapper: :horizontal_select %>
    <%= f.input :vehicle_type %>
    <%= f.input :accident, label: "Has been in an accident?" %>
    <div id="accident-description" class="hidden">
      <%= f.input :accident_description %>
    </div>
    <%= f.input :price %>
    <%= f.input :year, collection: (1990..Time.current.year), prompt: 'Please Select', required: true, wrapper: :horizontal_select %>
    <%= f.input :make, collection: @auto_makers, prompt: 'Please Select', required: true, wrapper: :horizontal_select %>
    <%= f.input :model %>
    <%= f.input :trim_level %>
    <%= f.input :exterior_color %>
    <%= f.input :interior_color %>
    <%= f.input :enigine %>
    <%= f.input :drivetrain %>
    <%= f.input :transmission %>
    <%= f.input :body %>
    <%= f.input :mileage %>
    <%= f.input :stock_number %>
    <%= f.input :description, input_html: {class: '', style: 'height: 200px;', placeholder: 'Enter text ...'} %>
    <%= f.input :powertrain_specs %>
    <%= f.input :suspension_specs %>
    <%= f.input :specs %>
    <%= f.input :entertainment_features %>
    <%= f.input :seats_and_trim %>
    <%= f.input :convenience_features %>
    <%= f.input :body_exterior %>
    <%= f.input :lighting_visibility_instruments %>
    <%= f.input :saftey_and_security %>
    <% if @automotive_listing.main_image.exists? %>
      <div class="row preview-images">
        <div class="col-sm-9 offset-sm-3 row">
          <div class="preview-image col-sm-2 p-0">
            <%= link_to delete_main_image_location_automotive_listing_path(@location, @automotive_listing), class: "remove-image", data: { confirm: 'Are you sure?', disable_with: "", method: :delete, remote: true } do %>
              <i class="fa fa-times"></i>
            <% end %>
            <%= image_tag @automotive_listing.main_image.url(:thumb) %>
          </div>
        </div>
      </div>
    <% end %>
    <%= f.input :main_image, wrapper: :horizontal_file %>
    <% if @automotive_listing.sub_images.present? %>
      <div class="row preview-images">
        <div class="col-sm-9 offset-sm-3 row">
          <% @automotive_listing.sub_images.each do |image| %>
            <div class="preview-image col-sm-2 p-0">
              <%= link_to "/business/#{@location.slug}/automotive_listings/#{@automotive_listing.id}/delete_sub_image/#{image.id}", class: "remove-image", data: { confirm: 'Are you sure?', disable_with: "", method: :delete, remote: true } do %>
                <i class="fa fa-times"></i>
              <% end %>
              <%= image_tag image.image.url(:thumb) %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
    <%= f.fields_for :sub_images, @automotive_listing.sub_images.build do |builder| %>
      <div id="sub-images">
        <%= builder.input :image, wrapper: :horizontal_file, label: "Sub Images", input_html: {class: 'sub-image-input'} %>
      </div>
      <div class="row add-more-images">
        <div class="col-sm-9 offset-sm-3">
          <button class="btn btn-sm btn-outline-primary" id="add-sub-image">Add More Image</button>
        </div>
      </div>
    <% end %>
  </div>

  <div class="form-actions">
    <%= f.button :submit, class: 'btn btn-primary' %>
  </div>
<% end %>

<script type="text/javascript">
  $('#automotive_listing_description').wysihtml5({
    toolbar: {
      "fa": true,
    }
  })

  if ($("#automotive_listing_accident").is(':checked')) {
    $('#accident-description').removeClass('hidden')
  } else {
    $('#accident-description').addClass('hidden');
  }

  $('#automotive_listing_accident').click(function() {
    if ($(this).is(':checked')) {
      $('#accident-description').removeClass('hidden')
    } else {
      $('#accident-description').addClass('hidden');
      $('#automotive_listing_accident_description').val('');
    }
  })

  $('#add-sub-image').click(function(e) {
    e.preventDefault();
    var existsImageCount = <%= @automotive_listing.sub_images.count %>
    var count = $("#sub-images input").length;

    $('#sub-images > div').append(`<div class="col-sm-9 offset-sm-3"><input class="form-control file optional sub-image-input" type="file" name="automotive_listing[sub_images_attributes][${count}][image]" id="automotive_listing_sub_images_attributes_${count}_image"></div>`)

    if ((existsImageCount + count) > 18) {
      $('#add-sub-image').addClass('hidden')
    }
  })
</script>
