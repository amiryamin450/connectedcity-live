<%
  @status_updates = @vertical_market.get_status_updates(@municipality, @city, @district, @neighborhood, @sub_neighborhood, !@vertical_market_category.present?, @vertical_market_category)
  @media_attachments = @vertical_market.get_media_attachments(@municipality, @city, @district, @neighborhood, @sub_neighborhood)
  @products = @vertical_market.get_products(@municipality, @city, @district, @neighborhood, @sub_neighborhood)
  @services = @vertical_market.get_services(@municipality, @city, @district, @neighborhood, @sub_neighborhood)
  @events = @vertical_market.get_events(@municipality, @city, @district, @neighborhood, @sub_neighborhood)
  @news_articles = @vertical_market.get_news_articles(@municipality, @city, @district, @neighborhood, @sub_neighborhood)
  @blog_entries = @vertical_market.get_blog_entries(@municipality, @city, @district, @neighborhood, @sub_neighborhood)
  @coupons = @vertical_market.get_coupons(@municipality, @city, @district, @neighborhood, @sub_neighborhood)

  using_search ||= false
  if using_search && params[:search].present?
    @status_updates = @status_updates.ransack(title_or_content_cont: params[:search]).result if @status_updates.present?
    @news_articles = @news_articles.ransack(title_or_content_cont: params[:search]).result if @news_articles.present?
    @events = @events.ransack(name_or_description_cont: params[:search]).result if @events.present?
  end

%>
<ul class="nav nav-tabs justify-content-start" role="tablist">
  <li class="nav-item active">
    <a class="nav-link" data-toggle="tab" href="#Update">Update</a>
  </li>
  <li class="nav-item">
    <a class="nav-link" data-toggle="tab" href="#Videos">Videos</a>
  </li>
  <li class="nav-item">
    <a class="nav-link" data-toggle="tab" href="#Products">Products</a>
  </li>
  <li class="nav-item">
    <a class="nav-link" data-toggle="tab" href="#Services">Services</a>
  </li>
  <li class="nav-item">
    <a class="nav-link" data-toggle="tab" href="#Events">Events</a>
  </li>
  <li class="nav-item">
    <a class="nav-link" data-toggle="tab" href="#News">News</a>
  </li>
  <li class="nav-item">
    <a class="nav-link" data-toggle="tab" href="#Blogs">Blogs</a>
  </li>
  <li class="nav-item">
    <a class="nav-link" data-toggle="tab" href="#Offers">Deals</a>
  </li>
  <li class="nav-item d-md-none">
    <a class="nav-link" data-toggle="tab" href="#Business">Businesses</a>
  </li>
</ul>

<!-- Tab panes -->
<div class="tab-content">
  <div id="Update" class="container tab-pane active">
    <br>
    <h3>Updates</h3><br>
    <% if @status_updates.length > 0 %>
      <% @status_updates.each do |status_update| %>
        <%= render 'layouts/application_v_2/status_update', status_update: status_update %>
      <% end %>
    <% else %>
      <div class="alert">No Market Updates found.</div>
    <% end %>
  </div>

  <div id="Videos" class="container tab-pane">
    <br>
    <h3>Videos</h3><br>
    <% if @media_attachments.size > 0 %>
      <% @media_attachments.each do |media_attachment| %>
        <%= render 'layouts/application_v_2/media_attachment_basic', media_attachment: media_attachment %>
      <% end %>
    <% else %>
      <div class="alert">No Videos found.</div>
    <% end %>
  </div>

  <!--  -->
  <div id="Products" class="container tab-pane">
    <br>
    <h3>Products</h3>
    <% if @products.size > 0 %>
      <% @products.each do |product| %>
        <%= render 'layouts/application_v_2/product', product: product %>
      <% end %>
    <% else %>
      <div class="alert">No Products found.</div>
    <% end %>
  </div>

  <!--  -->
  <div id="Services" class="container tab-pane">
    <br>
    <h3>Services</h3>
    <% if @services.size > 0 %>
      <% @services.each do |service| %>
        <%= render 'layouts/application_v_2/product', product: service %>
      <% end %>
    <% else %>
      <div class="alert">No services found.</div>
    <% end %>
  </div>

  <!--  -->
  <div id="Events" class="container tab-pane">
    <br>
    <h3>Events</h3><br>
    <% if @events.size > 0 %>
      <% @events.each do |event| %>
        <%= render 'layouts/application_v_2/event', event: event %>
      <% end %>
    <% else %>
      <div class="alert">No Events found.</div>
    <% end %>
  </div>

  <div id="News" class="container tab-pane">
    <br>
    <h3>News</h3><br>
    <% if @news_articles.size > 0 %>
      <% @news_articles.each do |news_article| %>
        <%= render 'layouts/application_v_2/news_article', news_article: news_article %>
      <% end %>
    <% else %>
      <div class="alert">No News found.</div>
    <% end %>
  </div>

  <div id="Blogs" class="container tab-pane">
    <br>
    <h3>Blogs</h3><br>
    <% if @blog_entries.size > 0 %>
      <% @blog_entries.each do |blog_entry| %>
        <%= render 'layouts/application_v_2/blog_entry', blog_entry: blog_entry %>
      <% end %>
    <% else %>
      <div class="alert">No Blogs found.</div>
    <% end %>
  </div>

  <div id="Offers" class="container tab-pane">
    <br>
    <h3>Deals</h3><br>
    <%#= render @coupons %>
    <% if @coupons.size > 0 %>
      <% @coupons.each do |coupon| %>
        <%= render 'layouts/application_v_2/coupon', coupon: coupon %>
      <% end %>
    <% else %>
      <div class="alert">No Deals found.</div>
    <% end %>
  </div>
  <div id="Business" class="container-fluid tab-pane d-md-none">
    <% if @vertical_market_category.present? %>
      <div class="category-body">
        <br>
        <%= render 'share/search_box', url: '', opts: options_from_collection_for_select([@vertical_market], 'id', 'name', @vertical_market.try(:id)), all_promt: 'all categories' %>
        <div class="card-label-one">
          <div class="title">
            <h4>&nbsp;<%= @vertical_market_category.name %>&nbsp;</h4>
          </div>
        </div>
        <div class="location-holder row card-row">
          <% locations.each do |location| %>
            <% cache "#{user_signed_in? ? "in" : "out"}_location_#{location.id}_#{location.updated_at}" do %>
              <div class="col-md-2">
                <div class="category-body-card">
                  <div class="img">
                      <%= link_to image_tag(get_location_image_url(location)), location %>
                  </div>
                  <div class="title">
                      <h4><%= link_to location.name, location %></h4>
                  </div>
                  <hr>
                  <div class="contact-details">
                    <span><i class="fal fa-map-marker-alt"></i>
                      <%= "#{location.address}".html_safe %>
                      <%= "#{location.city.name if location.city.present? } B.C. #{location.postal_code}".html_safe %>
                    </span>
                    <br>
                    <span><i class="far fa-phone-alt"></i><%= location.phone %></span>
                  </div>
                  <div class="button favorite" id="favorite-<%= location.id %>">
                    <% if show_save_button?(user_signed_in?, location.vertical_markets.present?) %>
                      <%= render 'favorites/like_button_v2', location_id: location.id, vertical_market_slug: location.vertical_markets.first.slug if user_signed_in? and location.vertical_markets.present? %>
                    <% end %>
                    <% if !user_signed_in? %>
                      <%= link_to "Follow", "#", class: "btn btn-primary", role: "button", data: { toggle: "modal", target: "#login_for_save" } %>
                    <% end %>
                    <%# <button class="btn btn-primary">Follow</button> %>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
        <div class="row-fluid">
          <%= paginate locations %>
        </div>
      </div>
    <% else %>
      <div class="category-body">
        <br>
        <%= render 'share/search_box', url: '', opts: options_from_collection_for_select(@vertical_markets_all, 'id', 'name', @vertical_market.try(:id)), all_promt: 'all categories' %>
        <div class="vertical-market-categories">
          <%= render 'guide/vertical_market_categories', :type_arg => 'country' %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<% if @media_attachments.size > 0 %>
  <% @media_attachments.each do |media_attachment| %>
    <%= render 'layouts/application_v_2/video_popup_basic_version', media_attachment: media_attachment %>
  <% end %>
<% end %>

<% if @status_updates.size > 0 %>
  <% @status_updates.each do |status_update| %>
    <%= render 'status_updates/modal_content_latest', status_update: status_update %>
  <% end %>
<% end %>

<% if @news_articles.size > 0 %>
  <% @news_articles.each do |news_article| %>
    <%= render 'news_articles/modal_news_latest', news: news_article %>
  <% end %>
<% end %>

<% if @events.size > 0 %>
  <% @events.each do |event| %>
    <%= render 'status_updates/modal_event_latest', event: event %>
  <% end %>
<% end %>

<% if @products.size > 0 %>
  <% @products.each do |product| %>
    <%= render 'products/modal_content', product: product %>
  <% end %>
<% end %>

<% if @blog_entries.size > 0 %>
  <% @blog_entries.each do |blog| %>
    <%= render 'blog_entries/modal_content', blog: blog %>
  <% end %>
<% end %>

<% if @coupons.size > 0 %>
  <% @coupons.each do |coupon| %>
    <%= render 'coupons/modal_content', coupon: coupon %>
  <% end %>
<% end %>

<script type="text/javascript">
  $('.video-attachment-event-category').on('click', function() {
    var modal = $(this);
    var valueId = modal.attr('data-target');
    var v = $(valueId).contents().find("iframe");
    var url = v.attr('data-src');
    v.attr('src', url)
  })

  $('.title-attachment-event-category').on('click', function() {
    var modal = $(this);
    var valueId = modal.attr('data-id');
    var v = $('#' + valueId).contents().find("iframe");
    var url = v.attr('data-src');
    v.attr('src', url)
  })

  $('.close.media-attachment-category').on('click', function() {
    var modal = $(this);
    var valueId = modal.attr('data-id');
    var v = $('#'+valueId).contents().find("iframe");
    var url = v.attr('src');
    v.attr('src', '')
  })

  $(".modal .close").click(function() {
    $('.modal-backdrop.in').remove();
  })
</script>
