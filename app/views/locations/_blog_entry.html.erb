<br><h4>Blog Entries
 <% if (user_signed_in? and current_user.has_role? :admin) or (user_signed_in? and current_user.can_manage_location? @location) %>
 <small><%= link_to "add", @location.is_profile ? new_location_citizen_blog_path(@location) : new_location_blog_entry_path(@location) %> | <%= link_to "manage", @location.is_profile ? location_citizen_blog_index_path(@location) : location_blog_entries_path(@location) %></small>
 <% end %>
</h4>
<% if @blog_entries.size > 0 %>
  <% @blog_entries.each do |blog| %>
      <article class="teaser">
        <!-- <div class="article-title"><%#= link_to blog.title, [@location, blog] %></div> -->
        <div class="article-title"><%= link_to ("#{blog.title}"), "#", class: "status-update-image", data: { 'bs-target': "#blog-#{blog.id}-model", 'bs-toggle': 'modal'} %></div>
        <div class="row">
          <div class="col-md-2">
            <div class="img">
              <%= link_to(image_tag(blog.image.url, class: 'blog-image', data: {"large-image" => blog.image.url, "location-name" => @location.name}), '#blog_image', data: { 'bs-target': "#blog-#{blog.id}-model", 'bs-toggle': 'modal'}) %>
            </div>
          </div>
          <div class="col-md-10">
            <p>
            <div class="article-content"><%= truncate_html blog.content, length: 350, omission: "#{link_to(' [read more]', [@location, blog]).html_safe}" %></div>
            </p>
            <span class="article-published"><%= "#{time_ago_in_words(blog.created_at)} ago" %></span>
          </div>
        </div>
      </article>
    <%= render 'blog_entries/modal_content', blog: blog %>
  <% end %>
  <%= paginate @blog_entries, param_name: 'blog_page' %>
<% else %>
  <div class="alert">No Blog Entries found.</div>
<% end %>
