<% if categories.present? %>
  <% categories.each do |cat| %>
    <%= link_to deeper_categories_path(id: cat.id, lv: lv), remote: true do %>
      <% active = category_id.present? && category_id === cat.id %>
      <div class="title item-category <%= 'active' if active%>"  data-level="<%= lv %>" data-id="<%= cat.id %>">
        <span><%= cat.name %></span>
        <% if (cat.children.present?) %>
          <span class="arrow">></span>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
