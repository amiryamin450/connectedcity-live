<%= simple_form_for(@community) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.input :name %>
    <%= f.input :description %>
    <%= f.association :region, :prompt => 'Select a Region' %>
  </div>

  <div class="form-actions">
    <%= f.button :submit %>
  </div>
<% end %>
