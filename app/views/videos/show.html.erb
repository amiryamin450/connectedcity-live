<%= form_for @video do |f| %>
  <div class="row-fluid media-attachment-area">
    <div class="span6">
      <h1>Preview Video</h1>
      <iframe width='100%' height='480' src='<%= @video.video_url %>' frameborder='0' allowfullscreen></iframe>
    </div>
    <div class="span6">
      <%
        media_attachment = @video.media_attachment
        location = media_attachment.location
      %>
      <div class="button-group">
        <%= link_to "Discard video", video_path(@video), method: :delete, data: { confirm: 'Are you certain you want to delete this video?' }, class: "btn btn-danger redirect-btn" %>
        <%= f.submit "Upload video", class: "btn btn-primary redirect-btn" %>
      </div>

      <%= f.fields_for :media_attachment do |ff| %>
        <label for="video_media_attachment_attributes_title">Title</label>
        <%= ff.text_field :title %>
        <label for="video_media_attachment_attributes_description">Description</label>
        <%= ff.text_area :description, cols: 80, rows: 3 %>
      <% end %>
      <br>
      <label>Advanced</label>
      <div>
        <label class="btn btn-primary custom-file-input">
          <%= f.file_field :thumbnail, style: "display: none;"%>
            Upload thumbnail
        </label>
        <div class="loader" id="thumbnail-loader"></div>
      </div>
      <div>
        <button id="mute-audio" class="btn btn-primary">Mute recorded audio</button>
        <%= f.hidden_field 'remove_audio', value: false %>
        <div class="loader" id="mute-audio-loader"></div>
      </div>
      <div>
        <label class="btn btn-primary custom-file-input">
          <%= f.file_field :audio, style: "display: none;"%>
            Upload new audio
        </label>
        <div class="loader" id="upload-audio-loader"></div>
      </div>
    </div>
  </div>
<% end %>

<script>
  var videoId = "<%= @video.id %>"
  document.getElementById('mute-audio').addEventListener('click', event => {
    event.preventDefault();
    // add spinner
    document.getElementById('mute-audio-loader').style.display = 'inline-block';
    fetch(`/videos/${videoId}/mute_video_audio.json`, {
      method: 'get',
    }).then(function(response) {
      if (response.ok) {
        // remove spinner
        document.getElementById('mute-audio-loader').style.display = 'none';
      }
    })
  })

  document.getElementById('video_audio').addEventListener('change', event => {
    // add spinner
    document.getElementById('upload-audio-loader').style.display = 'inline-block';
    var file = event.target.files[0];
    var data = new FormData()
    data.append('file', file);
    fetch(`/videos/${videoId}/upload_audio.json`, {
      method: 'post',
      body: data,
    }).then(function(response) {
      if (response.ok) {
        console.log(response)
        // remove spinner
        document.getElementById('upload-audio-loader').style.display = 'none';
      }
    })
  })

  document.getElementById('video_thumbnail').addEventListener('change', event => {
    // add spinner
    document.getElementById('thumbnail-loader').style.display = 'inline-block';
    var file = event.target.files[0];
    var data = new FormData();
    data.append('file', file);
    fetch(`/videos/${videoId}/upload_thumbnail.json`, {
      method: 'post',
      body: data,
    }).then(function(response) {
      if (response.ok) {
        console.log(response)
        // remove spinner
        document.getElementById('thumbnail-loader').style.display = 'none';
      }
    })
  })
</script>
