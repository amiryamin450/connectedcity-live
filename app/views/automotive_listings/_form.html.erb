<%= simple_form_for([@location, @automotive_listing],
  :html => { :multipart => true, class: 'form-horizontal'},
    wrapper: :horizontal_form,
) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.input :title %>
    <%= f.input :status, collection: [["New", "new"], ["Used", "used"]], prompt: 'Please Select', required: true, wrapper: :horizontal_select %>
    <%= f.input :vehicle_type %>
    <%= f.input :accident, label: "Has been in an accident?" %>
    <div id="accident-description" class="hidden">
      <%= f.input :accident_description %>
    </div>
    <%= f.input :price %>
    <%= f.input :year, collection: (1990..Time.current.year), prompt: 'Please Select', required: true, wrapper: :horizontal_select %>
    <%= f.input :make, collection: @auto_makers, prompt: 'Please Select', required: true, wrapper: :horizontal_select %>
    <%= f.input :model %>
    <%= f.input :trim_level %>
    <%= f.input :exterior_color %>
    <%= f.input :interior_color %>
    <%= f.input :enigine %>
    <%= f.input :drivetrain %>
    <%= f.input :transmission %>
    <%= f.input :body %>
    <%= f.input :mileage %>
    <%= f.input :stock_number %>
    <%= f.input :description, input_html: {class: '', style: 'height: 200px;', placeholder: 'Enter text ...'} %>
    <%= f.input :powertrain_specs %>
    <%= f.input :suspension_specs %>
    <%= f.input :specs %>
    <%= f.input :entertainment_features %>
    <%= f.input :seats_and_trim %>
    <%= f.input :convenience_features %>
    <%= f.input :body_exterior %>
    <%= f.input :lighting_visibility_instruments %>
    <%= f.input :saftey_and_security %>
    <%= f.input :main_image, as: :logo_preview, input_html: {class: 'form-control file'} %>
    <%= f.input :sub_image, as: :logo_preview, input_html: {class: 'form-control file'} %>
  </div>

  <div class="form-actions">
    <%= f.button :submit, class: 'btn btn-primary' %>
  </div>
<% end %>

<script type="text/javascript">
  $('#automotive_listing_description').wysihtml5({
    toolbar: {
      "fa": true,
    }
  })

  if ($("#automotive_listing_accident").is(':checked')) {
    $('#accident-description').removeClass('hidden')
  } else {
    $('#accident-description').addClass('hidden');
  }

  $('#automotive_listing_accident').click(function() {
    if ($(this).is(':checked')) {
      $('#accident-description').removeClass('hidden')
    } else {
      $('#accident-description').addClass('hidden');
      $('#automotive_listing_accident_description').val('');
    }
  })
</script>
