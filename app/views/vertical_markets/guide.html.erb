<% @current_market =
    if @sub_market
      @sub_market.name
    elsif @vertical_market.respond_to?(:name)
      @vertical_market.name
    else
      @vertical_market
    end
%>
<%
  @neighbourhood_param = params[:neighborhood] || params[:neighborhood_slug]
  @neighbourhood_slug = params[:neighborhood]  || params[:neighborhood_slug]
  if @neighbourhood_param
    @neighbourhood_slug = "kitsilano"  if @neighbourhood_param.include? "kitsilano"
    @neighbourhood = Neighborhood.where('slug LIKE ?', @neighbourhood_slug).first
  end

  @current_district = (@municipality&.name || @sub_neighborhood&.name || @neighborhood&.name || @district&.name || @city&.name || 'Vancouver')
%>
<% @district_slug = params[:district_slug] || params[:district_route]%>
<% @url %>
<% if params[:sub_neighborhood_slug]%>
  <% @url = city_district_nbh_sub_search_path(params[:city_slug], @district_slug, params[:neighborhood_slug], params[:sub_neighborhood_slug])%>
<% elsif params[:neighborhood_slug]%>
  <% @url = city_district_nbh_search_path(params[:city_slug], @district_slug, params[:neighborhood_slug])%>
<% elsif @district_slug %>
  <% @url = city_district_search_path(params[:city_slug], @district_slug)%>
<% elsif params[:city_slug] %>
  <% @url = city_search_path(params[:city_slug])%>
<% elsif params[:municipality_slug] %>
  <% @url = municipality_search_path(params[:municipality_slug])%>
<%else%>
  <% @url = "#{@base_path}search"%>
<% end %>

<% if params[:market] == 'news' %>
<%= render 'news'%>
<% else %>
<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="<%= root_path %>">Home</a></li>
    <!-- provincial-services: 164 , federal-services: 174 -->
    <% if [174, 164].include?(@vertical_market.id) %>
      <li class="breadcrumb-item" aria-current="page"><a style="margin-left: 10px;" href="#"><%= (@city&.name || 'Vancouver') %></a></li>
      <% @vertical_market.ancestors.each do |ancestor| %>
        <li class="breadcrumb-item active" aria-current="page"><a style="margin-left: 10px;" href="<%="#{@base_path}guide/#{ancestor.slug}"%>"><%=ancestor.name%></a></li>
      <% end %>
      <li class="breadcrumb-item" aria-current="page"><a style="margin-left: 10px;" href="<%="#{@base_path}guide/#{@vertical_market.slug}"%>"><%= " #{@vertical_market.name}" %></a></li>
    <% else %>
      <% if @municipality%>
         <% url = "/#{@municipality&.region&.province&.slug}/#{@municipality&.region&.slug}/#{@municipality&.slug}"%>
        <li class="breadcrumb-item" aria-current="page"><a style="margin-left: 10px;" href="<%= url %>"><%= (@municipality&.name || 'Vancouver') %></a></li>
      <%end%>
      <%if @city %>
        <% url = "/#{@city&.municipality&.region&.province&.slug}/#{@city&.municipality&.region&.slug}/#{@city&.municipality&.slug}/#{@city.slug}"%>
        <li class="breadcrumb-item" aria-current="page"><a style="margin-left: 10px;" href="<%= url %>"><%= (@city&.name || 'Vancouver') %></a></li>
      <%end%>
      <% if @district %>
        <% url = "/#{@district.city&.municipality&.region&.province&.slug}/#{@district.city&.municipality&.region&.slug}/#{@district.city&.municipality&.slug}/#{@district.city&.slug}/#{@district.slug}"%>
        <li class="breadcrumb-item active" aria-current="page"><a style="margin-left: 10px;" href="<%=url%>"><%=@district.name%></a></li>
      <% end %>
      <%if @neighborhood %>
        <% url = "/#{@neighborhood.district&.city&.municipality&.region&.province&.slug}/#{@neighborhood.district&.city&.municipality&.region&.slug}/#{@neighborhood.district&.city&.municipality&.slug}/#{@neighborhood.district&.city&.slug}/#{@neighborhood.district&.slug}/#{@neighborhood.slug}"%>
        <li class="breadcrumb-item" aria-current="page"><a style="margin-left: 10px;" href="<%= url%>"><%= @neighborhood.name%></a></li>
      <% end %> 
      <% if @sub_neighborhood %>
        <% url = "/#{@sub_neighborhood.neighborhood&.district&.city&.municipality&.region&.province&.slug}/#{@sub_neighborhood.neighborhood&.district&.city&.municipality&.region&.slug}/#{@sub_neighborhood.neighborhood&.district&.city&.municipality&.slug}/#{@sub_neighborhood.neighborhood&.district&.city&.slug}/#{@sub_neighborhood.neighborhood&.district&.slug}/#{@sub_neighborhood.neighborhood&.slug}/#{@sub_neighborhood.slug}"%>
        <li class="breadcrumb-item" aria-current="page"><a style="margin-left: 10px;" href="<%=url%>"><%= @sub_neighborhood.name%></a></li>
      <% end %>
      <% @vertical_market.ancestors.each do |ancestor| %>
        <li class="breadcrumb-item active" aria-current="page"><a style="margin-left: 10px;" href="<%="#{@base_path}guide/#{ancestor.slug}"%>"><%=ancestor.name%></a></li>
      <% end %>
      <% if @sub_market %>
        <li class="breadcrumb-item" aria-current="page"><a style="margin-left: 10px;" href="#"><%= " #{@vertical_market.name}" %></a></li>
        <li class="breadcrumb-item" aria-current="page"><a style="margin-left: 10px;" href="#"><%= " #{@sub_market.name} Guide" %></a></li>
      <% else %>
        <li class="breadcrumb-item" aria-current="page"><a style="margin-left: 10px;" href="#"><%= " #{@vertical_market.name} Guide" %></a></li>
      <% end %>
    <% end %>
  </ol>
</nav>
<!-- Breadcrumb End -->
<div class="category-body-section">
    <div class="container-fluid">
      <div class="row">
          <div class="col-md-12">
            <!--  Category -->
            <div class="page-title">
              <% if [174, 164].include?(@vertical_market.id) %>
                <h3>Browse Members of <%= @vertical_market.id === 164 ? 'the Legislative Assembly in' : 'Parliament in' %> <%= @current_district %></h3>
              <% else %>
                <h3><%= @current_market %> in <%= @current_district %></h3>
              <% end %>
            </div>
            <!-- End -->
          </div>
      </div>
      <div class="row">
          <div class="col-md-4">
            <div class="category-sidebar">
                <div class="map-section">
                  <div id="map"></div>
                </div>
                <div class="SideBar-tabs">
                  <!-- municipal-services 114-->
                  <% if [174, 164, 114].include?(@vertical_market.id) %>
                    <%= render 'layouts/application_v_2/guide_sidebar_municipality' %>
                  <% else %>
                    <%= render 'layouts/application_v_2/guide_sidebar' %>
                  <% end %>
                </div>
            </div>
          </div>
          <!-- SideBar End -->
          <div class="col-md-8">
            <div class="category-body">
              <br>
              <%= render 'search_box/search_box', url: @url, opts: options_from_collection_for_select(@vertical_markets_all, 'id', 'name', @vertical_market.try(:id)), all_promt: 'all categories' %>
              <div class="vertical-market-categories">
                <%= render 'guide/vertical_market_categories', :type_arg => 'country' %>
              </div>
            </div>
          </div>
      </div>
    </div>
</div>
<br>
<% end %>
