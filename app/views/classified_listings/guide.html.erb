<%

meta title: "#{@neighborhood.try(:name) || @district.try(:name) || @city.try(:name)} Classifieds".strip,
     description: "",
     canonical: url_for(Rails.application.routes.recognize_path(request.path).merge({only_path: false, protocol: 'https'}))

%>

<h1>Classifieds</h1>

<% @classified_categories.each do |category| %>
<% if category.classified_listings.size > 0 %>
<div class="row-fluid classified-category">
  <div class="row-fluid classified-header" style="background-color: <%= "#{category.heading_color}" %>">

    <div class="span7 head-cell"><%= category.name %></div>
    <div class="span1 head-cell">Price</div>
    <div class="span1 head-cell">Photos?</div>
    <div class="span3 head-cell">Condition</div>
  </div>

  <% category.classified_listings.first(4).each do |listing| %>
  <div class="row-fluid classified-detail-row" style="border-color: <%= category.heading_color %>">
    <div class="span7"><%= link_to listing.title, listing %></div>
    <div class="span1"><%= humanized_money_with_symbol listing.price %></div>
    <div class="span1"><%= image_size_words listing  %></div>
    <div class="span3"><%= classified_condition listing %></div>
  </div>
  <% end -%>
  <div class="row-fluid">
    <div class="pull-right">
      <%= link_to "View more #{category.name} listings.", category if category.classified_listings.size > 4 %>
    </div>
  </div>
</div>
<% end -%>

<% end -%>
