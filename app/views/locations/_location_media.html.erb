<div class="card-label-two">
  <div class="title">
    <h4>Video</h4>
    <%= link_to raw("<h4 class='secondary'>Record Video</h4>"), @location.is_profile ? new_location_citizen_media_attachment_path(@location) : new_location_media_attachment_path(@location) %>
    <%= link_to raw("<h4 class='secondary'>Record Live Video</h4>"), @location.is_profile ? new_location_citizen_media_attachment_path(@location, {livestream: true}) : new_location_media_attachment_path(@location, {livestream: true}) %>
    <h4 class="secondary">Upload Video</h4>
    <%= link_to raw("<h4 class='secondary'>Youtube</h4>"), @location.is_profile ? new_youtube_video_location_citizen_media_attachments_path(@location) : new_youtube_video_location_media_attachments_path(@location) %>
  </div>
</div>
<div>
  <%= link_to 'See More +', '#', class: 'see-more', data: { element: "media-#{@location.id}" } %>
&nbsp;&nbsp;&nbsp;
  <%= link_to ' See All', @location.is_profile ? location_citizen_media_attachments_path(@location) : location_media_attachments_path(@location), class: 'see-all' %>
</div>
<% if @media_attachments.size > 0 %>
  <div class="row card-row media-row-holder" id="cat-media-<%= @location.id %>">
    <% @media_attachments.each do |media| %>
      <div class="col-md-2">
        <%= link_to [@location, media] do %>
          <div class="business-body-card">
            <%
              video = media.videos&.first
              is_livestream = video && video.livestream && video.status == "started"
              is_processing_video = video && video.broadcast_id.present? && !video.video_url.present?
            %>

            <% if video && video.livestream && video.status == "started" %>
              <div id="live">LIVE</div>
            <% end %>

            <div class="img">
              <% if media.media_source_id.present? %>
                <%= image_tag("http://img.youtube.com/vi/#{media.media_source_id}/mqdefault.jpg") %>
              <% else %>
                <% if is_processing_video && !is_livestream %>
                  <img src="/assets/placeholder_stream_video.png" />
                <% else %>
                  <%= image_tag(media.thumbnail_url) %>
                <% end %>
              <% end %>
            </div>

            <% unless is_processing_video && !is_livestream %>
              <div class="video-btn">
                <i class="far fa-play-circle"></i>
              </div>
            <% end %>

            <div class="title">
              <% if is_processing_video && !is_livestream %>
                <h3><%= media.title&.truncate(25) %></h3>
              <% else %>
                <h3><%= media.title&.truncate(25) %></h3>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
  <%#= paginate @products, param_name: 'product_page' %>
<% else %>
  <div class="alert alert-dark" role="alert">
    Nothing Found
  </div>
<% end %>