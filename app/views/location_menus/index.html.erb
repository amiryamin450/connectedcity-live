<% if is_food_and_dining(@location) %>
  <h1>Menus</h1>
<% else %>
  <h1>Flyers</h1>
<% end %>
<br />
<br />
<% if is_food_and_dining(@location) %>
  <%= link_to 'New Menu Image', new_location_location_menu_path, class: 'btn btn-primary' %>
<% else %>
  <%= link_to 'New Flyer Image', new_location_location_menu_path, class: 'btn btn-primary' %>
<% end %>
<br />
<br />
<table>
  <tr>
    <th></th>
    <th></th>
    <th></th>
  </tr>

<% @location_menus.each do |location_menu| %>
  <tr>
    <td><%= link_to(image_tag("#{@base_url}/system/location_menu/#{location_menu.id}/display/#{location_menu.image_file_name}"), location_location_menu_path(@location, location_menu)) %></td>
    <td><%= link_to 'Edit', edit_location_location_menu_path(@location, location_menu), class: 'btn btn-primary' %></td>
    <td><%= link_to 'Delete', location_location_menu_path(@location, location_menu), class: 'btn btn-danger', method: :delete, data: { confirm: 'Are you sure?' } %></td>
  </tr>
  <tr>
    <td>&nbsp;</td>
  </tr>
<% end %>
</table>
<br />
<br />
<br />
