<div class="span6">
  <div class="pad10 holder clearfix">
    <div class="row-fluid">
      <div class="span12">

        <%= image_tag @new_home.cover_photo.url %>
      </div>
     
    </div>
    <div class="row-fluid" style="margin-top:5px;">

      <div class="span3">
        <div class="thumbnail logo" style="margin-top: 10px;">
          <%= image_tag @new_home.new_home_community.location.logo.url %>
        </div>
      </div>

      <div class="span9">
        <h1><%= @new_home.title %></h1>
        <h3><%= number_to_currency(@new_home.list_price) %></h3>
        
        <div class="address-line">
          <div style="margin-bottom: 10px;">
             <%= "#{@new_home.address} &middot;".html_safe %> <%= "#{@new_home.address_suite} &middot;".html_safe if @new_home.address_suite.present? %> <%= "#{@new_home.city.name} #{@new_home.province.preabbr}, #{@new_home.postal_code}" %>
          </div>
          <div>
            <% if @new_home.year_built %>
              Built in: <%= @new_home.year_built %>
            <% end -%>

          </div>
          <div>
            <%= @new_home.style %> &middot; 
            <%= "#{pluralize(@new_home.bedrooms, 'Bedroom')}" %> &middot; <%= "#{pluralize(@new_home.bathrooms, 'Bathroom')}" %> &middot; <%= @new_home.living_area %> Sq Ft &middot;  
          
            <%= link_to("More Info", @new_home.detail_view_url, target: :_blank) if @new_home.detail_view_url.present? %>
            <%= " &middot; ".html_safe if @new_home.detail_view_url.present?  %>
            <%= link_to("Virtual Tour", @new_home.virtual_tour_url, target: :_blank) if @new_home.virtual_tour_url.present? %>
          </div>
          <div>
            <% if @new_home.association_fee.present? %>
              Association Fee: <%= number_to_currency(@new_home.association_fee) %>  <%= "/ #{@new_home.association_fee_period}" if @new_home.association_fee_period.present? %>
              <% end -%>
          </div>
          
        </div>


        <% if (user_signed_in? and current_user.has_role? :admin) or (user_signed_in? and current_user.can_manage_location? @location) %>
          <div class="btn-group">
             <%# link_to "Edit", edit_location_new_home_path(@location, @new_home), class: 'btn btn-mini btn-primary' %>
          </div>
        <% end %>

      </div>
    </div>
  </div>

  <div class="pad10 holder">
    <div class="row-fluid">
      <div class="span12">
        <h4>Comments</h4>
        <%= @new_home.description.html_safe %>
      </div>
    </div>
    <% if @new_home.bedroom_comment.present? %>
    <div class="row-fluid">
      <div class="span12">
        <h4>Bedroom Comments</h4>
        <%= @new_home.bedroom_comment.html_safe %>
      </div>
    </div>
    <% end -%>
    <% if @new_home.bathroom_comment.present? %>
    <div class="row-fluid">
      <div class="span12">
        <h4>Bathroom Comments</h4>
        <%= @new_home.bathroom_comment.html_safe %>
      </div>
    </div>
    <% end -%>

    
  </div>

</div>
<div class="span6">
    <div class="row-fluid">
      <div class="span12">
        <div class="pad10 holder">
           <div id="profile-map" class="clearfix"></div>
        </div>
      </div>
    </div>
</div>


<%= javascript_tag do %>

    <% ## TODO Limit the number of locations returned  %>

    Window.profile_marker = <%#raw @new_home.geo_location.to_json() %>
<% end %>

