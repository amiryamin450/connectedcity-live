<div class="p-5">
  <h2>Resend confirmation instructions</h2>

  <%= simple_form_for(resource, :as => resource_name, :url => confirmation_path(resource_name), :html => { :method => :post }) do |f| %>
    <%= f.input :email, required: true, input_html: { class: "form-control w-100 w-md-25" }, wrapper_html: { class: "col-12 col-md-6" }, label_html: { class: 'fw-bold mt-2' } %>
    <%= f.button :submit, "Resend confirmation instructions", class: 'btn-primary my-3' %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
