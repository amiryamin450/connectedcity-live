<!DOCTYPE html>
<html lang="en">
<%= render 'head' %>

<div id="wrapper">
  <header id="header">
    <div class="header-top">
      <%= render 'logo' %>
    </div>
     <%= render 'main_menu' %>
  </header>
  <main id="main" role="main">
    <div class="container-fluid content-holder">
      <%= render 'messages' %>
      <div class="row-fluid">
        <%= yield %>
      </div>
    </div>
  </main>
</div>
<%= render 'footer' %>
<%= render 'js_footer_includes' %>
</body>
</html>
