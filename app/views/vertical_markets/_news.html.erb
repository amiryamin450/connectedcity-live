<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="<%= root_path %>">Home</a></li>
    <%if @district %>
      <li class="breadcrumb-item active" aria-current="page"><a href="#" style="margin-left: 10px;"><%=@district.name%></a></li>
    <% else %>
      <li class="breadcrumb-item"><a href="<%= root_path %>" style="margin-left: 10px;"><% @city.name %></a></li>
    <% end %>
    <li class="breadcrumb-item" aria-current="page"><a href="#" style="margin-left: 10px;"><%= "#{ @vertical_market.name}" %></a></li>
  </ol>
</nav>

<h1 style="margin-left: 50px; margin-bottom: 20px; font-weight: bold;">Browse <%= @vertical_market.present? ? @vertical_market.name : 'Civic News' %> in <% @city.name %></h1>
    <div class="map-section">
      <div id="map" style="height: 60vh;"></div>
    </div>
  </div>
</row>
<div class="civic-news-body-section">
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-6 col-lg-6 landing-page-heading-filter communities-page">
        <div class="row filter">
          <div class="col-11">
            <div class="row">
              <div class="col-3 container-box">
                <%= select_tag 'civic-news-disctrict-dropdown', options_from_collection_for_select(@districts, 'id', 'name'), prompt: 'District', class: 'form-control search-column input-group-prepend search-box' %>
              </div>
              <div class="col-4 container-box">
                <%= select_tag 'civic-news-neighborhoods-dropdown', raw("<option>Neighbourhood</option>"), prompt: 'Neighbourhood', class: 'form-control search-column input-group-prepend search-box' %>
              </div>
              <div class="col-5 container-box">
                <%= select_tag 'civic-news-sub-neighborhoods-dropdown', raw("<option>Sub-Neighbourhood</option>"), prompt: 'Sub-Neighbourhood', class: 'form-control search-column input-group-prepend search-box' %>
              </div>
            </div>
          </div>
          <div class="col-1 btn-search">
            <a href="#" id="city-landing-paths">
              <button type="button" class="btn-primary btn">Go</button>
            </a>
          </div>
        </div>
      </div>
      <div class="col-md-6 col-lg-6">
        <div class="search-box advance-search-box">
          <%= form_tag "#", class: 'search-form', method: :get do %>
            <div class="input-group">
              <%# <input type="text" class="form-control search-input" placeholder="What are you looking for?" aria-label="Search input with dropdown button"> %>
              <%= search_field_tag :search, params[:search], placeholder: "What are you looking for?", class: "form-control search-column" %>
              <div class="input-group-prepend search-box ">
                <%= select_tag 'market', options_from_collection_for_select(@categories_news, 'id', 'name'), prompt: 'All', class: 'form-control' %>
              </div>
              <div class="input-group-append">
                <button class="btn search-box-btn" type="submit"><img src="/cc_2.0/icon/search-icon.svg"></button>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

