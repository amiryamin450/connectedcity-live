<%=
metamagic site: "ConnectedCity",
title: ["Find Businesses in #{@district.name}, #{@city.name}", :site],
separator: " — ",
charset: "utf-8",
viewport: "width=device-width, initial-scale=1.0"

%>

<div class="row-fluid">
  <div class="span8">
    <h1><%= @district.name %>
      <% if user_signed_in? and current_user.has_role? :admin %>
      <small><%= link_to 'edit', edit_district_path(@district) %>
        <% if @district.use_carousel %>
        | <%= link_to 'edit carousel', polymorphic_path([@district, :carousel_images]) %>
        <% end %>
      </small>
      <% end %>
    </h1>
  </div>
</div>



<div class="row-fluid">
  <div class="span8">
    <div class="row-fluid">
      <% if @district.use_carousel and @district.carousel_images.present? and @district.carousel_images.size > 0 %>
      <div id="carousel" class="carousel slide" data-interval="8000">
        <ol class="carousel-indicators">
          <% @district.carousel_images.each_with_index do |img, i|  %>
          <li data-target="#carousel" data-slide-to="<%= i %>"></li>
          <% end %>
        </ol>
        <div class="carousel-inner">
          <% @district.carousel_images.each_with_index do |img, i|  %>
          <div class="item <%= "active" if i == 0 %>">
            <%=  image_tag img.image.url(:default) %>
            <% if !img.caption.blank? %>
            <div class="carousel-caption">
              <h4><%= img.title %></h4>
              <p><%= img.caption.html_safe %></p>
            </div>
            <% end %>
          </div>
          <% end %>
        </div>
        <!-- Carousel nav -->
        <a class="carousel-control left" href="#carousel" data-slide="prev">&lsaquo;</a>
        <a class="carousel-control right" href="#carousel" data-slide="next">&rsaquo;</a>

      </div>

      <% else %>
      <div class="span12 metro-img">
        <%= image_tag(@district.home_page_image.url :cover) %>
      </div>
      <% end %>





    </div>

    <div class="row-fluid">
      <div class="span12">
        <div class="holder pad10">
          <h5>Featured Neighbourhood Shopping Districts</h5>
          <div class="row-fluid">
            <% @district.business_improvement_areas.order("RAND()").limit(6).each do |bia| %>
            <div class="span2">
              <div class="thumbnail">
                <div style="min-height: 100px; text-align: center;"><%= link_to(image_tag(bia.logo.url(:list)), bia) %></div>
                <div style="font-size: 11px; font-weight: bold; text-align: center;"><%= link_to bia.name, bia %></div>
              </div>
            </div>
            <% end %>

          </div>
        </div>
      </div>
    </div>
    <div class="row-fluid">
      <div class="span6">
        <div class="market-updates holder pad10">
          <h5>Market Updates</h5>
          <% if @status_updates.size > 0 %>  
            <%= render 'status_updates/market_updates', status_updates: @status_updates %>
          <% else %>
            <div class="alert">No Market Updates found.</div>
          <% end %>
        </div>
      </div>
      <div class="span6">
        <div class="events-list holder pad10">
          <h5>Events</h5>
          <% if @events.any? %>  
            <%= render 'events/events_list', events: @events %>
          <% else %>
            <div class="alert">No Events found.</div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="span4">
    <%= render 'search_form', { locals: {css_class: 'hidden-mobile'} } %>
  </div>
  <div class="span4">
    <%= render 'application/join_now' %>
    <div class="row-fluid">
      <div class="holder pad10">
        <h5>Shopping Districts</h5>
        <% if @district.business_improvement_areas.size > 0 %>
        <ul class="unstyled">
          <% @district.business_improvement_areas.each do |bia| %>
          <li><%= link_to bia.name, bia %></li>
          <% end -%>
        </ul>

        <% else %>
        <% end -%>
      </div>
    </div>
  </div>
</div>

<% content_for :js_loaded do %>
  <script type="text/javascript">
    $(document).ready(function(){
      Window.helpers.initJScroll('.market-updates');
      Window.helpers.initJScroll('.events-list');
    });
  </script>
<% end %>

<!--- Modals -->
<%= render 'status_updates/show_image' %>
<%= render 'messages/modal_new' %>
<%= render 'locations/modal_claim_login' %>