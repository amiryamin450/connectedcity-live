
<div class="row-fluid">
  <div class="span8">
    <h3><%= @city.name %></h3>
  </div>
  <div class="span4">
    <%= render 'search_form', { locals: {css_class: 'hidden-mobile'} } %>
  </div>
</div>

<div class="row-fluid">
  <div class="span8">
    <div class="row-fluid">

      <div id="carousel" class="carousel slide" data-interval="8000">
        <ol class="carousel-indicators">

            <li data-target="#carousel" data-slide-to="0"></li>
            <li data-target="#carousel" data-slide-to="1"></li>
            <li data-target="#carousel" data-slide-to="2"></li>
            <li data-target="#carousel" data-slide-to="3"></li>
            <li data-target="#carousel" data-slide-to="4"></li>
        </ol>
        <div class="carousel-inner">

          <div class="item active">
            <%= image_tag "1.jpg", alt: "ConnectedCity - Find Everything You Crave" %>
          </div>
          <div class="item">
            <%= image_tag "2.jpg", alt: "ConnectedCity - Browse Big Or Small" %>
          </div>
          <div class="item">
            <%= image_tag "3.jpg", alt: "ConnectedCity - ConnectedShoppers" %>
          </div>
          <div class="item">
            <%= image_tag "4.jpg", alt: "ConnectedCity - Promote Your Products" %>
          </div>
        </div>
        <!-- Carousel nav -->
        <a class="carousel-control left" href="#carousel" data-slide="prev">&lsaquo;</a>
        <a class="carousel-control right" href="#carousel" data-slide="next">&rsaquo;</a>

      </div>
    </div>

    <div class="row-fluid">
      <div class="span12">
        <div class="holder pad10">
          <h5>Featured Neighbourhood Shopping Districts</h5>
          <div class="row-fluid">
            <% @city.business_improvement_areas.unscoped.order("RAND()").limit(6).each do |bia| %>
            <div class="span2">
              <div class="thumbnail">

                <div style="min-height: 100px; text-align: center;">
                  <%= link_to(image_tag(bia.logo.url(:list)), bia) %>
                  </div>
                <div style="font-size: 11px; font-weight: bold; text-align: center;"><%= link_to bia.name, bia %></div>

              </div>
            </div>
            <% end %>

          </div>

        </div>
      </div>
    </div>
    <div class="row-fluid">
      <%= render 'status_updates/homepage_list', zone: @city %>
      <div class="span6">
        <div class="holder pad10">
          <h5>Offers &amp; Coupons</h5>
          <% if @city.coupons.any? %>
            <%= render @city.coupons.limit(3).order(:created_at) %>
            <div class="row-fluid article">
              <p class="text-right"><%= link_to "See all", "#" %></p>
            </div>
          <% else %>
            <div class="alert">No Offers &amp; Coupons found.</div>
          <% end %>
        </div>
        <div class="holder pad10">
          <h5>Events</h5>
          <% if @city.events.any? %>
            <%= render @city.events.limit(3).order(:created_at) %>
            <div class="row-fluid article">
              <p class="text-right"><%= link_to "See all", "#" %></p>
            </div>
          <% else %>
            <div class="alert">No Events found.</div>
          <% end %>
        </div>
        <div class="holder pad10">
          <h5>Videos</h5>
          <% if @city.media_attachments.any? %>
            <%= render @city.media_attachments.limit(3).order(:created_at) %>
            <div class="row-fluid article">
              <p class="text-right"><%= link_to "See all", "#" %></p>
            </div>
          <% else %>
            <div class="alert">No Videos found.</div>
          <% end %>
        </div>
        <div class="holder pad10">
          <h5>News</h5>
          <% if @city.news_articles.any? %>
            <%= render @city.news_articles.limit(3).order(:created_at) %>
            <div class="row-fluid article">
              <p class="text-right"><%= link_to "See all", "#" %></p>
            </div>
          <% else %>
            <div class="alert">No News Articles found.</div>
          <% end %>
        </div>
        <div class="holder pad10">
          <h5>Featured Products &amp; Services</h5>
          <% if @city.products.any? || @city.services.any? %>
            <%= render (@city.products.limit(3).order(:created_at) + @city.services.limit(3).order(:created_at)).sort_by(&:created_at).take(3) %>
            <div class="row-fluid article">
              <p class="text-right"><%= link_to "See all", "#" %></p>
            </div>
          <% else %>
            <div class="alert">No Featured Products &amp; Services found.</div>
          <% end %>
        </div>
      </div>
    </div>
  </div>


  <div class="span4">
    <%= render 'application/join_now' %>

    <div class="row-fluid">
      <div class="holder pad10">
        <h5>Communities in <%= @city.name %></h5>
        <ul class="list-none">
          <% @districts.each do |district| %>
          <li><%= link_to district.name, district_guide_path(district) %></li>
          <% end %>
        </ul>
      </div>
    </div>

    <div class="row-fluid">
      <div class="holder pad10">
        <h5>Shopping Districts</h5>
        <ul class="list-none">
          <% @city.business_improvement_areas.each do |bia| %>
          <li><%= link_to bia.name, bia %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>
