<div class="card-label-one">
  <div class="title"><h4>Agents</h4></div>
</div>
<div>
  <%= link_to 'See More +', '#', class: 'see-more', data: { element: "agents-#{@location.id}" } %>
<!-- &nbsp;&nbsp;&nbsp; -->
  <%#= link_to ' See All', location_automotive_listings_path(@location), class: 'see-all' %>
</div>
<% if @location.agents.size > 0 %>
  <div class="row card-row media-row-holder" id="cat-agents-<%= @location.id %>">
    <% @location.agents.in_groups_of(4) do |group| %>
      <% group.each do |item| %>
        <% if item %>
          <div class="col-md-2">
            <div class="business-body-card">
              <div class="img"><%= link_to(image_tag(item.logo.url), item) %></div>
              <div class="title"><h3><%= link_to item.name, item %></h3></div>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="alert alert-dark" role="alert">No Agents found.</div>
<% end %>
