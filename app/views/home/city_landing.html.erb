<div class="container-fluid">
  <div class="row">
    <div class="col-md-9 column">
      <div id="carouselExampleIndicators" class="carousel slide" data-ride="carousel">
        <ol class="carousel-indicators">
          <li data-target="#carouselExampleIndicators" data-slide-to="0" class="active"></li>
          <li data-target="#carouselExampleIndicators" data-slide-to="1"></li>
          <li data-target="#carouselExampleIndicators" data-slide-to="2"></li>
        </ol>
        <div class="carousel-inner">
          <div class="carousel-item active">
            <img class="d-block w-100" src="/cc_2.0/images/banner01.jpg" alt="First slide">
          </div>
          <div class="carousel-item">
            <img class="d-block w-100" src="/cc_2.0/images/banner02.jpg" alt="Second slide">
          </div>
          <div class="carousel-item">
            <img class="d-block w-100" src="/cc_2.0/images/banner01.jpg" alt="Third slide">
          </div>
        </div>
        <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-slide="prev">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          <span class="sr-only">Previous</span>
        </a>
        <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-slide="next">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
          <span class="sr-only">Next</span>
        </a>
      </div>
    </div>
    <div class="col-md-3 sidebar-column">
      <div class="sidebar">
        <div class="shopping-business-btn">
          <div class="group-btn">
            <a href="<%= new_user_registration_path%>" class="btn"><img src="/cc_2.0/images/Shopper-btn.svg"></a>
            <a href="<%= business_sign_up_path%>" class="btn"><img src="/cc_2.0/images/Business-btn.svg"></a>
          </div>
        </div>
        <!--  -->
        <div class="communities">
          <div class="dropdown">
            <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
              Select Community
            </button>
            <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
              <% @districts.each do |district| %>
                <%= link_to district.name, district_guide_path(district), class: "dropdown-item" %>
              <% end %>
            </div>
          </div><br>
          <div class="dropdown">
            <button class="btn btn-secondary dropdown-toggle" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
              Select Neighbourhood
            </button>
            <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
              <% @districts.each do |district| %>
                <% district.business_improvement_areas.each do |bia| %>
                  <%= link_to bia.name, "/vancouver/#{district.slug}/neighbourhoods/#{bia.slug}", class: "dropdown-item" %>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div><br>
<div class="container-fluid">
  <div class="row">
    <div class="col-md-12">
      <!-- Shopping District Slider -->
      <div class="district-slider">
        <div class="slider-heading">
          <h3>Vancouver Neighbourhoods</h3>
        </div>
        <div class="inner-slider">
          <div class="items">
            <% @city.business_improvement_areas.unscoped.order("RAND()").each do |bia| %>
              <div>
                <%# <img data-lazy="/cc_2.0/icon/slider-icon-1.jpg"> %>
                <div class="district-slider-img">
                  <%= link_to(image_tag(bia.logo.url(:list)), "/vancouver/#{bia.district.slug}/neighbourhoods/#{bia.slug}") %>
                </div>
                <p><%= link_to bia.name, "/vancouver/#{bia.district.slug}/neighbourhoods/#{bia.slug}" %></p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
      <!-- End -->
    </div>
  </div>
</div>
<!-- Main Section Card -->
<div class="container-fluid mt-5">
  <br>
  <div class="row">
    <div class="col-md-3 scrollable">
      <div class="sticky-heading">
        <div class="update-heading">
          <h3>Updates</h3>
        </div>
      </div>
      <div class="update-card">
        <% if @status_updates.size > 0 %>
          <% @status_updates.each do |status_update|%>
            <div class="row">
              <div class="inner-img col-md-3 col-4">
                <%= link_to (image_tag status_update.statusable.logo.url), statusable_path(status_update.statusable)%></a>
              </div>
              <div class="col-md-9 col-8">
                <div class="row">
                  <div class="inner-card-title col-md-7">
                    <h5><%= link_to status_update.statusable.name, statusable_path(status_update.statusable) %></h5>
                  </div>
                  <div class="inner-card-time col-md-5">
                    <span><%= "#{time_ago_in_words(status_update.created_at)} ago" %></span>
                  </div>
                </div>
                <div class="inner-card-description">
                  <p><%= status_update.content.truncate(255) %>
                    <%= link_to "View More", "#", class: "status-update-image", data: { target: "#status-#{status_update.id}-model", toggle: 'modal'} %>
                  </p>
                </div>
              </div>
              <div class="col-md-12">
                <div class="update-banner">
                  <% if status_update.image? %>
                    <%= link_to (image_tag status_update.image.url), "#", class: "status-update-image", data: { target: "#status-#{status_update.id}-model", toggle: 'modal'} %>
                    <%= render 'status_updates/modal_content_latest', status_update: status_update %>
                  <% end %>
                </div>
              </div>
            </div>
            <hr>
          <% end %>
        <% else %>
          <div class="alert">No Market Updates found.</div>
        <% end %>
      </div>
    </div>

    <div class="col-md-3 scrollable">
      <div class="sticky-heading">
        <div class="update-heading">
          <h3>Events</h3>
        </div>
      </div>
      <div class="event-card">
        <% if @events.any? %>
          <% @events.each do |event|%>
            <div class="row">
              <div class="inner-img col-md-3 col-4">
                <%= link_to image_tag(event.location.logo.url), event.location %></a>
              </div>
              <div class="col-md-9 col-8">
                <div class="row">
                  <div class="inner-card-title col-md-7">
                    <h5><%= link_to event.name, [event.location, event] %></h5>
                  </div>
                  <div class="inner-card-time col-md-5">
                    <% if event.starts_at.present? %><span class="time-ago">in <%= "#{time_ago_in_words(event.starts_at)}" %><% end %></span>
                  </div>
                </div>
                <div class="inner-card-description">
                  <p><%= truncate_html( event.description, :length => 255 ) %>
                    <%= link_to "View More", "#", class: "status-update-image", data: { target: "#event-#{event.id}-model", toggle: 'modal'} %>
                  </p>
                </div>
              </div>
              <div class="col-md-12">
                <div class="update-banner">
                  <% if event.image? %>
                    <%= link_to (image_tag event.image.url), "#", class: "status-update-image", data: { target: "#event-#{event.id}-model", toggle: 'modal'} %>
                    <%= render 'status_updates/modal_event_latest', event: event %>
                  <% end %>
                </div>
              </div>
            </div>
            <hr>
          <% end %>
        <% else %>
          <div class="alert">No Events found.</div>
        <% end %>
      </div>
    </div>

    <div class="col-md-3 scrollable">
      <div class="sticky-heading">
        <div class="update-heading">
          <h3>Videos</h3>
        </div>
      </div>
      <div class="update-card">
        <% if @media_attachments.size > 0 %>
          <% @media_attachments.each do |media_attachment| %>
            <div class="row">
              <div class="inner-img col-md-3 col-4">
                <%=link_to (image_tag media_attachment.attachable.logo.url), media_attachment.attachable %>
              </div>
              <div class="col-md-9 col-8">
                <div class="row">
                  <div class="inner-card-title col-md-7">
                    <h5><%= link_to media_attachment.title, [media_attachment.attachable, media_attachment] %></h5>
                  </div>
                  <div class="inner-card-time col-md-5">
                    <span><%= "#{time_ago_in_words(media_attachment.created_at)} ago" %></span>
                  </div>
                </div>
                <div class="inner-card-description">
                  <p>by <%= link_to media_attachment.attachable.name, media_attachment.attachable %></p>
                </div>
              </div>
              <div class="col-md-12">
                <div class="update-banner video-card">
                  <%= image_tag(media_attachment.thumb_url) %>
                  <div class="card-video-box">
                    <i class="far fa-play-circle" data-toggle="modal" data-target=<%="#video-#{media_attachment.attachable.id}-model"%>></i>
                  </div>
                  <%= render 'status_updates/modal_video_latest', media_attachment: media_attachment %>
                </div>
              </div>
            </div>
            <hr>
          <% end %>
        <% else %>
          <div class="alert">No Videos found.</div>
        <% end %>
      </div>
    </div>

    <div class="col-md-3 scrollable">
      <div class="sticky-heading">
        <div class="update-heading">
          <h3>News</h3>
        </div>
      </div>
      <div class="event-card">
        <% if @news.any? %>
          <% @news.each do |news|%>
            <div class="row">
              <div class="inner-img col-md-3 col-4">
                <%= link_to (image_tag news.newsable.logo.url), location_path(news.newsable)%></a>
              </div>
              <div class="col-md-9 col-8">
                <div class="row">
                  <div class="inner-card-title col-md-7">
                    <h5><%= link_to news.newsable.name, location_path(news.newsable) %></h5>
                  </div>
                  <div class="inner-card-time col-md-5">
                    <span><%= "#{time_ago_in_words(news.created_at)} ago" %></span>
                  </div>
                </div>
                <div class="inner-card-description">
                  <p><%= news.content.truncate(255) %>
                    <%= link_to "View More", "#", class: "news-update-image", data: { target: "#news-#{news.id}-model", toggle: 'modal'} %>
                  </p>
                </div>
              </div>
              <div class="col-md-12">
                <div class="update-banner">
                  <% if news.image? %>
                    <%= link_to (image_tag news.image.url), "#", class: "news-update-image", data: { target: "#news-#{news.id}-model", toggle: 'modal'} %>
                    <%= render 'news_articles/modal_news_latest', news: news %>
                  <% end %>
                </div>
              </div>
            </div>
            <hr>
          <% end %>
        <% else %>
          <div class="alert">No news found.</div>
        <% end %>
      </div>
    </div>
  </div>
</div>
<br>