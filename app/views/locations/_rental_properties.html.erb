<div class="card-label-one">
  <div class="title">
    <h4>Rental Properties</h4>
    <% if (user_signed_in? and current_user.has_role? :admin) or (user_signed_in? and current_user.can_manage_location? @location) %>
    <small><%= link_to "add", new_location_rental_property_path(@location), class: 'small' %> | <%= link_to 'manage', location_rental_properties_path(@location) %></small>
    <% end %>
  </div>
</div>
<div>
  <%= link_to 'See More +', '#', class: 'see-more', data: { element: "rental_properties-#{@location.id}" } %>
&nbsp;&nbsp;&nbsp;
  <%= link_to ' See All', location_rental_properties_path(@location), class: 'see-all' %>
</div>
<% if @rental_properties.size > 0 %>
  <div class="row card-row media-row-holder" id="cat-rental_properties-<%= @location.id %>">
    <% @rental_properties.in_groups_of(4) do |group| %>
      <% group.each do |property| %>
        <% if property %>
          <div class="col-md-2">
            <div class="business-body-card">
              <div class="img"><%= image_tag property.cover_photo.url %></div>
              <div class="title"><h3><%= link_to property.name, [@location, property] %></h3></div>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
  <%= paginate @listings, param_name: 'listing_page' %>

<% else %>
<div class="alert alert-dark" role="alert">
  No Listings found.
</div>
<% end %>
