<h4><%= @vertical_market_category.name %></h4>


<% 
  # categories = @facets['categories']
  # neighborhoods = @facets['neighborhoods']
  # brands = @facets['brands']
  markers = []
  locations = @vertical_market_category.get_locations_paged(@city, @district, @neighborhood, params[:page]) 
  markers |= locations
  # has_filters = (request.parameters[:category].present? or request.parameters[:neighborhood].present? or request.parameters[:brand].present?) ? true : false
%>

<div class="row-fluid">
  <%= paginate locations %>
  <div class="location-holder">
    <div class="clearfix">
      <% locations.each do |location| %>
      <div class="location-teaser clearfix">
        <div style="min-height: 80px; text-align: center;">
          <%= link_to(image_tag(get_location_image_url(location)), location)%>
        </div>
        <div style="width: 168px; margin-top: 5px; margin-bottom: 5px; font-size: 12px; min-height:24px;"><strong><%= link_to location.name, location %></strong></div>
        <div style="width: 168px;"><%= "#{location.address}".html_safe %></div>
        <div style="width: 168px;"><%= "#{location.city.name if location.city.present? } #{location.province.abbr} #{location.postal_code}".html_safe %></div>
        <div style="width: 168px; color: #1c3656;"><%= location.phone %></div>
        <div id="favorite-<%= location.id %>" class="favorite" style="margin-top: 5px;">
              <%= render 'favorites/like_button', :location_id => location.id, :vertical_market_slug => location.vertical_markets.first.slug if user_signed_in? %>
        </div>
      </div>
      <% end %>
    </div>
  </div>
</div>

<%= javascript_tag do %>
window.locations = <%= raw markers.collect { |m| {:name => m.name, :latitude => m.latitude, :longitude => m.longitude}}.to_json %>;
<% end %>
<%# render 'facets' %>