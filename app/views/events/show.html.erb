<div class="px-3 pb-3 px-md-5 pb-md-5">
  <h2 class="my-4"><%= @event.name %></h2>
  <div class="dates">
    <%= "<strong>Starts:</strong> #{@event.starts_at.strftime('%b. %d, %Y %l:%M %p')}".html_safe if @event.starts_at.present? %>
    <%= " | <strong>Ends:</strong> #{@event.ends_at.strftime('%b. %d, %Y %l:%M %p')}".html_safe if @event.ends_at.present? %>
  </div>
  <div class="my-4">
    <%= link_to "Event Website", @event.url, target: "_blank" if @event.url? %>
    <%= "#{@event.url? ? '|' : ''} #{mail_to(@event.email, 'Email Event Organizer')}".html_safe if @event.email.present? %>
    <% if user_signed_in? %>
      <%= link_to "| Send a message", "#", data: { toggle: "modal", target: "#new_message" } %>
    <% end %>
  </div>
  <% if @event.image.present? %>
    <div>
      <h6>Image</h6>
      <%= image_tag @event.image.url%>
    </div>
  <% end %>
  <div>
    <h6>Description</h6>
    <p>
      <%= @event.description.html_safe %>
    </p>
  </div>
  <% if (user_signed_in? and current_user.has_role? :admin) or (user_signed_in? and current_user.can_manage_location? @location) %>
    <div style="margin-top: 1.5em">
      <%= link_to "Edit Event", edit_location_event_path(@location, @event), class: 'btn btn-primary' %>
      <%= link_to "Back to Manage #{@location.name}'s Events", location_events_path(@location), class: 'btn mx-4' %>
    </div>
  <% end %>

  <%= render 'messages/modal_new' %>
</div>
