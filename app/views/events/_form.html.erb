<%= simple_form_for [@location, @event], :html => { :multipart => true, id: 'new_event' } do |f| %>
<div class="form-inputs">
  <%= f.input :name %>
  <%= f.input :email %>
  <%= f.input :url, label: 'Website URL', placeholder: 'http://www.example.com' %>

  <div class="control-group">
    <label for="event_starts_at" class="string optional control-label">Start Time</label>
    <div class="input-append" id="datepicker_starts" >
      <%= f.input_field :starts_at, as: :string,  data: { format: "yyyy-MM-dd HH:mm PP" }, value: @event.starts_at.strftime("%Y-%m-%d %I:%M %p")   %>
      <span class='add-on'>
        <i data-time-icon='icon-time' data-date-icon='icon-calendar'></i>
      </span>
    </div>
  </div>


  <div class="control-group">
    <label for="event_ends_at" class="string optional control-label">End Time</label>
    <div class="input-append" id="datepicker_ends" >
      <%= f.input_field :ends_at, as: :string,  data: { format: "yyyy-MM-dd HH:mm PP" }, value: @event.ends_at.strftime("%Y-%m-%d %I:%M %p")   %>
      <span class='add-on'>
        <i data-time-icon='icon-time' data-date-icon='icon-calendar'></i>
      </span>
    </div>
  </div>
  <% if @is_municipality || [174, 164, 114].include?(@vertical_market&.id) %>
    <% hidden = [174, 164].include?(@vertical_market&.id) ? 'display: none' : 'display: block' %>
    <div class="control-group string required category" style="<%= hidden %>">
      <%= f.label :category %>
      <div class="input-group-prepend search-box ">
        <%= select_tag 'event[category_id]', options_from_collection_for_select(@categories_news, 'id', 'name', @event.try(:category_id)), prompt: 'All Categories', class: 'form-control', style: 'border-color: black;' %>
      </div>
    </div>
  <% end %>

  <% if [174, 164, 114].include?(@vertical_market&.id) %>
    <div class="auto-search-wrapper control-group required" style="margin-bottom: 20px; display: block;">
      <label class="string required optional control-label">Location</label>
      <div class="controls">
        <input style="border-radius: 0.25rem; width: 530px; box-sizing: unset; padding: 4px 6px; font-size: 14px;" type="text" id="event_location_search" autocomplete="off" placeholder="Enter Address" />
        <label style="display: none;" id="location-error" class="error">This field is required.</label>
      </div>
    </div>

    <%= f.input :latitude, as: :hidden %>
    <%= f.input :longitude, as: :hidden %>
    <div id="value_address" class="hidden" ></div>
  <% end %>

  <%= f.input :description, input_html: { class: 'input-block-level wysihtml5'} %>
  <%= f.input :image, as: :logo_preview %>
</div>

<div class="form-actions">
  <%= f.button :submit, class: 'btn btn-primary' %>
  <%= link_to 'Cancel', location_events_path(@location), class: 'btn'  %>
</div>

<% end -%>

<script src="https://maps.googleapis.com/maps/api/js?key=<%= ENV['GOOGLE_API_MAP_KEY'] %>&libraries=places&callback=initMap&sensor=false" async defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.0/jquery.validate.js"></script>
<script type="text/javascript">
  $(document).ready(function() {
    var image_exist = <%= @event.image.blank? %>;
    var municipality = "<%= @vertical_market&.id === 114 %>";
    var valid = "<%= [174, 164, 114].include?(@vertical_market&.id) %>"
    $("#new_event").validate({
      rules: {
        'event[name]': {
          required: true,
          maxlength: 100,
        },
        'event[description]': {
          required: true,
          maxlength: 3000,
        },
        'event[url]': {
          maxlength: 300,
        },
        'event[email]': {
          required: true,
          maxlength: 300,
          email: true,
        },
        'event[starts_at]': {
          required: true,
        },
        'event[ends_at]': {
          required: true,
        },
        'event[category_id]': {
          required: function(){ return municipality == "true" },
        },
        'event[latitude]': {
          required: function(){ return valid === "true" && isBlankLatitude() },
        },
        'event[longitude]': {
          required: function(){ return valid === "true" && isBlankLongitude() },
        },
        'event[image]': {
          required: function(){ return image_exist },
        },
      }
    });
    $("form#new_event").on('submit', function(e) {
      var isvalid = $("form#new_event").valid();
      if (isvalid) {
          e.preventDefault();
      }
      if (valid === 'true') {
        var valueSearch = $('#event_location_search').val().trim()
        var valueSearchResult = $("#value_address").val().trim()
        var inValidSearch = valueSearch.length === 0 || valueSearch !== valueSearchResult
        if (isBlankLatitude() || isBlankLongitude() || inValidSearch) {
          $("#event_latitude").val('')
          $("#event_longitude").val('')
          $('.auto-search-wrapper.control-group').css('margin-bottom', '40px')
          $('#location-error').css({'display': 'block', 'height': '0px'});
          $('#location-error').text('This is required field')
          e.preventDefault()
        } else {
          $('.auto-search-wrapper.control-group').css('margin-bottom', '20px')
          $('#location-error').css('display', 'none');
          $('#location-error').text('')
        }
      }
    })
    var need_category = "<%= [174, 164].include?(@vertical_market&.id) %>"
    if (need_category === "true") {
      var value = <%= @categories_news[0].id %>
      $("form#new_event select").val(value);
    }
  })

  function isBlankLatitude() {
    return $("#event_latitude").val().trim().length === 0
  }

  function isBlankLongitude() {
    return $("#event_longitude").val().trim().length === 0
  }

  function initMap() {
    var input = document.getElementById('event_location_search');
    var options = { componentRestrictions: {country: 'ca'} }
    var autocomplete = new google.maps.places.Autocomplete(input, options);
    autocomplete.addListener('place_changed', function() {
      var place = autocomplete.getPlace();
      if (!place.geometry) {
        window.alert("Autocomplete's returned place contains no geometry");
        return;
      }
      var location = place.geometry.location
      $("#event_latitude").val(parseFloat(location.lat()))
      $("#event_longitude").val(parseFloat(location.lng()))
      $("#value_address").val($("#event_location_search").val())
    });
  }
</script>
