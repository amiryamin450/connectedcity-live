    <div class="span3">
      <a href="<%= location_status_updates_path(@location) %>">
        <div class="pad10 holder">
          <img src="/assets/cc-status-updater.png" />
        </div>
      </a>
    </div>
    <div class="span3">
      <a href="<%= location_blog_entries_path(@location) %>">
        <div class="pad10 holder">
          <img src="/assets/cc-expert-adviser.png" />
