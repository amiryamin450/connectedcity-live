<%
      metamagic site: "Connected City",
                title: ["User Login", :site],
                separator: " — "
%>

<div class="container-fluid content-holder p-5">
  <div class="row-fluid">
    <h2>Login</h2>
    <%= render "form" %>
    <%= render "devise/shared/links" %>
  </div>
</div>

<script>
  function formSubmit() {
    $("#new_user").submit();
  }

  $("#requestOTP").click(function() {
    sendAjaxRequest("<%= verify_two_factor_path %>")
  });
    
  function sendAjaxRequest(path) {
    var userEmail = $("#user_email").val();
    var userPassword = $("#user_password").val();
    $.ajax({
      url: path,
      method: "POST",
      dataType: "script",
      headers: { 'X-CSRF-Token': $('input[name=authenticity_token]').val() },
      data: {
        email: userEmail,
        password: userPassword
      }        
    })
  }
</script>
