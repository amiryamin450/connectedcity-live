
<%= render "/layouts/application_v_2/global_header" %>
<!-- Main Section -->
<div class="container-fluid">
  <div class="row">
    <div class="col-md-12 column landing-page-slider">
      <div id="carouselExampleIndicators" class="carousel slide" data-ride="carousel">
        <ol class="carousel-indicators">
          <li data-target="#carouselExampleIndicators" data-slide-to="0" class="active"></li>
          <li data-target="#carouselExampleIndicators" data-slide-to="1"></li>
          <li data-target="#carouselExampleIndicators" data-slide-to="2"></li>
        </ol>
        <div class="carousel-inner">
          <div class="carousel-item active">
            <img class="d-block w-100" src="/cc_2.0/images/landing-page-slider-img.png" alt="First slide">
          </div>
          <div class="carousel-item">
            <img class="d-block w-100" src="/cc_2.0/images/banner02.jpg" alt="Second slide">
          </div>
          <div class="carousel-item">
            <img class="d-block w-100" src="/cc_2.0/images/banner01.jpg" alt="Third slide">
          </div>
        </div>
        <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-slide="prev">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          <span class="sr-only">Previous</span>
        </a>
        <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-slide="next">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
          <span class="sr-only">Next</span>
        </a>
      </div>
      <!-- Slider Advance SearchBox -->
      <div class="slider-advance-searchbox">
        <div class="heading">
          <h3>Shop Local, Shop Easily.</h3>
        </div>
        <div class="searchbox">
          <div class="container">
            <%= form_tag "#{@base_path}search", class: 'search-form', method: :get do %>
              <div class="row">
                <div class="col-lg-12">
                  <div class="row">
                    <div class="col-lg-4 col-md-3 col-sm-12 divider">
                      <label>&nbsp;</label>
                      <%= search_field_tag :search, params[:search], placeholder: "What are you looking for?", class: "form-control search-column" %>
                    </div>
                    <div class="col-lg-3 col-md-3 col-sm-12 divider">
                      <label>Categories</label>
                      <%= select_tag 'market', options_from_collection_for_select(@vertical_markets_all, 'id', 'name', @vertical_market.try(:id)), prompt: 'all categories', class: 'form-control search-column' %>
                    </div>
                    <div class="col-lg-3 col-md-3 col-sm-12 divider">
                      <label>Area</label>
                      <%= select_tag 'business_improvement_area', options_from_collection_for_select(BusinessImprovementArea.all, 'id', 'name', @vertical_market.try(:id)), prompt: 'all places', class: 'form-control search-column' %>
                    </div>
                    <div class="col-lg-1 col-md-3 col-sm-12 search-btn">
                      <label>&nbsp;</label>
                      <button type="submit" value="submit" class="btn btn-primary"><img src="/cc_2.0/icon/search-icon.svg"></button>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- End -->
<!-- Main Section -->
<div class="landing-page-card-section">
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-6">
        <div class="card">
          <div class="card-body">
            <div class="row">
              <div class="col-md-6">
                <div class="card-text">
                  <h4>Sign Up for a FREE ConnectedShopper <sup>TM</sup> </h4>
                  <div class="heading-line"></div>
                  <ul>
                    <li>Personalize Your Shopping Experience</li>
                    <li>Receive Updates Of Every Kind</li>
                    <li>Claim Deals & Coupons</li>
                    <li>Earn Loyalty Rewards</li>
                    <li>Win Free Stuff!</li>
                  </ul>
                  <div class="card-btn">
                    <a href="<%= new_user_registration_path%>">
                      <button type="button" class="btn-primary btn"> Get Started  <i class="far fa-chevron-right"></i></button>
                    </a>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="card-img">
                  <img src="/cc_2.0/images/cc-shopper.png">
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!--  -->
      <div class="col-md-6">
        <div class="card">
          <div class="card-body">
            <div class="row">
              <div class="col-md-6">
                <div class="card-text">
                  <h4>Sign Up for a ConnectedAdvertiser <sup>TM</sup> </h4>
                  <div class="heading-line"></div>
                  <ul>
                    <li>Lower Your Advertising Costs</li>
                    <li>Easily Manage Your Marketing</li>
                    <li>Compete With Major Brands</li>
                    <li>Generate Repeat Purchases</li>
                    <li>Create Happy Customers</li>
                  </ul>
                  <div class="card-btn">
                    <a href="<%= business_sign_up_path%>">
                      <button type="button" class="btn-primary btn"> Get Started  <i class="far fa-chevron-right"></i></button>
                    </a>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="card-img">
                  <img src="/cc_2.0/images/cc-business-owner-.png">
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!--  -->
    </div>
  </div>
</div>
<!-- End -->
<%= render "/layouts/application_v_2/neighbourhoods_and_shopping _districts"%>
<%= render "/layouts/application_v_2/shop_your_interest"%>

<div class="landing-page-three-column-section">
  <div class="container-fluid">
    <div class="row justify-content-between">
      <div class="col-md-3 column-1">
        <div class="update-card">
          <div class="update-heading">
            <h3>Updates</h3>
          </div>
          <% if @status_updates.size > 0 %>
            <% @status_updates.each do |status_update|%>
              <div class="row">
                <div class="col-md-3 col-4">
                  <div class="inner-img">
                    <%= image_tag status_update.statusable.logo.url %>
                  </div>
                </div>
                <div class="col-md-9 col-8">
                  <div class="row">
                    <div class="inner-card-title col-md-7">
                      <h5><%= link_to status_update.statusable.name, statusable_path(status_update.statusable) %></h5>
                    </div>
                    <div class="inner-card-time col-md-5">
                      <span><%= "#{time_ago_in_words(status_update.created_at)} ago" %></span>
                    </div>
                  </div>
                  <div class="inner-card-description">
                    <p><%= status_update.content %>
                      <a href="#"> See More </a>
                    </p>
                  </div>
                </div>
                <div class="col-md-12">
                  <div class="update-banner">
                    <% if status_update.image? %>
                      <%= image_tag status_update.image.url %>
                    <% end %>
                  </div>
                </div>
              </div>
              <hr>
            <% end %>
          <% else %>
            <div class="alert">No Market Updates found.</div>
          <% end %>
        </div>
      </div>
      <!-- End -->
      <div class="col-md-3 column-2">
        <div class="event-card">
          <div class="event-heading">
            <h3>Videos</h3>
          </div>
          <% if @media_attachments.size > 0 %>
            <% @media_attachments.each do |media_attachment| %>
              <div class="row">
                <div class="col-md-3 col-4">
                 <div class="inner-img">
                    <%= image_tag media_attachment.attachable.logo.url %>
                  </div>
                </div>
                <div class="col-md-9 col-8">
                  <div class="row">
                    <div class="inner-card-title col-md-7">
                      <h5><%= link_to media_attachment.title, [media_attachment.attachable, media_attachment] %></h5>
                    </div>
                    <div class="inner-card-time col-md-5">
                      <span><%= "#{time_ago_in_words(media_attachment.created_at)} ago" %></span>
                    </div>
                  </div>
                  <div class="inner-card-description">
                    <p>by <%= link_to media_attachment.attachable.name, media_attachment.attachable %></p>
                  </div>
                </div>
                <div class="col-md-12">
                  <div class="update-banner video-card">
                    <%= link_to(image_tag(media_attachment.thumb_url), [media_attachment.attachable, media_attachment]) %>
                    <div class="card-video-box">
                      <i class="far fa-play-circle" data-toggle="modal" data-target="#video-modal"></i>
                    </div>
                  </div>
                </div>
              </div>
              <hr>
            <% end %>
          <% else %>
            <div class="alert">No Videos found.</div>
          <% end %>
        </div>
      </div>
      <!-- End -->
      <div class="col-md-3 column-3">
        <div class="event-card">
          <div class="event-heading">
            <h3>Events</h3>
          </div>
            <% if @events.any? %>
              <% @events.each do |event|%>
                <div class="row">
                  <div class="col-md-3 col-4">
                    <div class="inner-img">
                      <%= image_tag event.location.logo.url %>
                    </div>
                  </div>
                  <div class="col-md-9 col-8">
                    <div class="row">
                      <div class="inner-card-title col-md-7">
                        <h5><%= link_to event.name, [event.location, event] %></h5>
                      </div>
                      <div class="inner-card-time col-md-5">
                        <span><% if event.starts_at.present? %><span class="time-ago">in <%= "#{time_ago_in_words(event.starts_at)}" %><% end %></span>
                      </div>
                    </div>
                    <div class="inner-card-description">
                      <p><%= truncate_html( event.description, :length => 150 ) %>
                        <a href="#"> See More </a>
                      </p>
                    </div>
                  </div>
                  <div class="col-md-12">
                    <div class="update-banner">
                      <% if event.image? %>
                        <%= image_tag event.image.url %>
                      <% end %>
                    </div>
                  </div>
                </div>
                <hr>
              <% end %>
            <% else %>
              <div class="alert">No Events found.</div>
            <% end %>
        </div>
      </div>
      <!--  -->
    </div>
  </div>
</div>
<!-- End -->
<%= render "/layouts/application_v_2/global_footer" %>
<!-- End -->
<!-- Script -->
<!-- Carousel -->
<script type="text/javascript">
    $(document).ready(function(){
        $('.shop-interest-items').slick({
            infinite: true,
            lazyLoad: 'ondemand',
            slidesToShow: 4,
            slidesToScroll: 2,
            responsive: [
                {
                    breakpoint: 1024,
                    settings: {
                        slidesToShow: 3,
                        slidesToScroll: 5,
                    }
                },
                {
                    breakpoint: 600,
                    settings: {
                        slidesToShow: 2,
                        slidesToScroll: 3
                    }
                },
                {
                    breakpoint: 480,
                    settings: {
                        slidesToShow: 1,
                        slidesToScroll: 2
                    }
                }

            ]
        });
    });
</script>