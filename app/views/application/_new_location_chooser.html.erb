<% if @district == nil
     current_district = @city
   else
     current_district = @district
   end
%>
<div class="location-block">
    <a class="open" href="#">Select Location</a>
    <div class="dropdown">
      <ul>
        <li>
          <a href='/'>Vancouver</a>
        </li>
        <li>
          <a href='/vancouver-downtown/'>Vancouver Downtown</a>
        </li>
        <li>
          <a href='/vancouver-eastside/'>Vancouver Eastside</a>
        </li>
        <li>
          <a href='/vancouver-westside/'>Vancouver Westside</a>
        </li>
      </ul>
      <ul>
        <% current_district.business_improvement_areas.each do |bia| %>
            <li><%= link_to bia.name, bia %></li>
        <% end %>
      </ul>
    </div>
</div>