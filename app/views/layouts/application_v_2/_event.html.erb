<div class="row">
  <div class="col-12">
    <%= link_to image_tag(event.location.logo.url, class: "w-25 m-auto"), event.location %></a>
  </div>
  <div class="col-12 px-3 pt-2">
    <div class="row">
      <div class="inner-card-title col-md-7">
        <h5><%#= link_to event.name, [event.location, event] %>
          <%= link_to ("#{event.name}"), "#", class: "status-update-image", data: { 'bs-target': "#event-#{event.id}-model", 'bs-toggle': 'modal'} %>
        </h5>
      </div>
      <div class="inner-card-time col-md-5">
        <% if event.starts_at.present? %><span class="time-ago">in <%= "#{time_ago_in_words(event.starts_at)}" %><% end %></span>
      </div>
    </div>
    <div class="inner-card-description">
      <div class="content"> <%= sanitize(event.description) %> </div>
      <%= link_to "View More", "#", class: "status-update-image", data: { 'bs-target': "#event-#{event.id}-model", 'bs-toggle': 'modal'} if event.description.present? %>
      </p>
    </div>
  </div>
  <div class="col-md-12">
    <% if event.image? %>
      <div class="update-banner">
        <%= link_to (image_tag event.image.url), "#", class: "status-update-image", data: { 'bs-target': "#event-#{event.id}-model", 'bs-toggle': 'modal'} %>
        <%#= render 'status_updates/modal_event_latest', event: event %>
      </div>
    <% end %>
  </div>
</div>
<hr>
