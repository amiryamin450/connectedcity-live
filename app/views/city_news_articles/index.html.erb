<h1>Listing City News Articles</h1>

<table class="table table-bordered table-striped table-hover">
  <tr>
    <th>Title</th>
    <th>Category</th>
    <th></th>
  </tr>

<% @news_articles.each do |news_article| %>
  <tr>
    <td><%= news_article.title %></td>
    <td><%= news_article.city_news_category.name %></td>
    <td>
      <div class='btn-group'>
        <%= link_to 'Show', news_article, class: 'btn btn-mini' %>
        <%= link_to 'Edit', edit_city_news_article_path(news_article), class: 'btn btn-mini' %>
        <%= link_to 'Destroy', news_article, method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-mini' %>
      </div>
    </td>
  </tr>
<% end %>
</table>

<br />

<%= link_to 'New City news article', new_city_news_article_path, class: 'btn btn-primary' %>
<%= link_to 'Back', :back, class: 'btn' %>
