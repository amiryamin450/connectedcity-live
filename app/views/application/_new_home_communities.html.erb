<% new_home_styles.each_with_index do |style, r| %>
  <div class="category">
    <div class="heading index-<%= r %>">
      <h5><%= style %></h5>
      <%= link_to 'More +', '#', class: 'see-more', data: { element: 'new-home-listings' } %>
    </div>
    <div class="location-holder" id="new-home-listings">
      <div class="clearfix">
        <% new_homes.each do |listing| %>
          <%= render 'new_home', listing: listing, style: style %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
