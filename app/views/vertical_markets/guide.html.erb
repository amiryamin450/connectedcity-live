<% @current_market =
    if @sub_market
      @sub_market.name
    elsif @vertical_market.respond_to?(:name)
      @vertical_market.name
    else
      @vertical_market
    end
%>
<%
  @neighbourhood_param = params[:neighborhood] || params[:neighborhood_slug]
  @neighbourhood_slug = params[:neighborhood]  || params[:neighborhood_slug]
  if @neighbourhood_param
    @neighbourhood_slug = "kitsilano"  if @neighbourhood_param.include? "kitsilano"
    @neighbourhood = Neighborhood.where('slug LIKE ?', @neighbourhood_slug).first
  end

  @current_district = @district != nil ? @district.name : @city.csdname
%>
<% if params[:market] == 'news' %>
<%= render 'news'%>
<% else %>
<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="<%= root_path %>">Home</a></li>
    <!-- provincial-services: 164 , federal-services: 174 -->
    <% if [174, 164].include?(@vertical_market.id) %>
      <li class="breadcrumb-item" aria-current="page"><a style="margin-left: 10px;" href="#"><%= @city.name %></a></li>
      <% @vertical_market.ancestors.each do |ancestor| %>
        <li class="breadcrumb-item active" aria-current="page"><a style="margin-left: 10px;" href="<%="#{@base_path}guide/#{ancestor.slug}"%>"><%=ancestor.name%></a></li>
      <% end %>
      <li class="breadcrumb-item" aria-current="page"><a style="margin-left: 10px;" href="<%="#{@base_path}guide/#{@vertical_market.slug}"%>"><%= " #{@vertical_market.name}" %></a></li>
    <% else %>
      <li class="breadcrumb-item" aria-current="page"><a style="margin-left: 10px;" href="#"><%= @city.name %></a></li>
      <%if @district %>
        <li class="breadcrumb-item active" aria-current="page"><a style="margin-left: 10px;" href="#"><%=@district.name%></a></li>
      <% end %>
      <%if @neighborhood %>
        <li class="breadcrumb-item" aria-current="page"><%= @neighborhood.name%></li>
      <% end %>
      <%if @sub_neighborhood %>
        <li class="breadcrumb-item" aria-current="page"><%= @sub_neighborhood.name%></li>
      <% end %>
      <% @vertical_market.ancestors.each do |ancestor| %>
        <li class="breadcrumb-item active" aria-current="page"><a style="margin-left: 10px;" href="<%="#{@base_path}guide/#{ancestor.slug}"%>"><%=ancestor.name%></a></li>
      <% end %>
      <% if @sub_market %>
        <li class="breadcrumb-item" aria-current="page"><a style="margin-left: 10px;" href="#"><%= " #{@vertical_market.name}" %></a></li>
        <li class="breadcrumb-item" aria-current="page"><a style="margin-left: 10px;" href="#"><%= " #{@sub_market.name} Guide" %></a></li>
      <% else %>
        <li class="breadcrumb-item" aria-current="page"><a style="margin-left: 10px;" href="#"><%= " #{@vertical_market.name} Guide" %></a></li>
      <% end %>
    <% end %>
  </ol>
</nav>
<!-- Breadcrumb End -->
<div class="category-body-section">
    <div class="container-fluid">
      <div class="row">
          <div class="col-md-12">
            <!--  Category -->
            <div class="page-title">
              <% if [174, 164].include?(@vertical_market.id) %>
                <h3>Browse Members of <%= @vertical_market.id === 164 ? 'the Legislative Assembly in' : 'Parliament in' %> <%= @neighbourhood ? @neighbourhood.name : @current_district %></h3>
              <% else %>
                <%
                  address =
                    if @sub_neighborhood
                      @sub_neighborhood.name
                    elsif @neighborhood
                      @neighborhood.name
                    else
                      @current_district
                    end
                %>
                <h3><%= @current_market %> in <%= address %></h3>
              <% end %>
            </div>
            <!-- End -->
          </div>
      </div>
      <div class="row">
          <div class="col-md-4">
            <div class="category-sidebar">
                <div class="map-section">
                  <div id="map"></div>
                </div>
                <div class="SideBar-tabs">
                  <!-- municipal-services 114-->
                  <% if [174, 164, 114].include?(@vertical_market.id) %>
                    <%= render 'layouts/application_v_2/guide_sidebar_municipality' %>
                  <% else %>
                    <%= render 'layouts/application_v_2/guide_sidebar' %>
                  <% end %>
                </div>
            </div>
          </div>
          <!-- SideBar End -->
          <div class="col-md-8">
            <div class="category-body">
              <br>
              <div class="search-box advance-search-box">
                <%= form_tag "#{@base_path}search", class: 'search-form', method: :get do %>
                    <div class="input-group">
                      <%# <input type="text" class="form-control search-input" placeholder="What are you looking for?" aria-label="Search input with dropdown button"> %>
                      <%= search_field_tag :search, params[:search], placeholder: "What are you looking for?", class: "form-control search-column" %>
                      <div class="input-group-prepend search-box ">
                        <%= select_tag 'market', options_from_collection_for_select(@vertical_markets_all, 'id', 'name', @vertical_market.try(:id)), prompt: 'all categories', class: 'form-control' %>
                      </div>
                      <div class="input-group-append">
                        <button class="btn search-box-btn" type="submit"><img src="/cc_2.0/icon/search-icon.svg"></button>
                      </div>
                    </div>
                  <% end %>
              </div>
              <div class="vertical-market-categories">
                <%= render 'guide/vertical_market_categories', :type_arg => 'country' %>
              </div>
            </div>
          </div>
      </div>
    </div>
</div>
<br>
<% end %>
