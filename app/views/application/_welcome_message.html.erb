<div class="current-user-block">
    <% if user_signed_in? %>
        <%
           current_district_link = ""
           current_district_link = get_current_district&.slug 
        %>
        <p>Welcome <%= @current_user&.name %>! You are now searching <%= (get_current_bia.nil? ? link_to(get_current_district&.name, "/" + current_district_link.to_s) : get_current_bia&.name) %></p>
    <% else %>
    	<p><%= link_to("Sign Up", new_user_registration_path, style: 'color: #FFFFFF') %> | <%= link_to("Login", new_user_session_path, style: 'color: #FFFFFF') %></p>
    <% end %>
</div>
