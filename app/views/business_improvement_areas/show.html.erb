<div class="row-fluid">
  <div class="span8">
    <h3><%= @business_improvement_area.name %>
      <% if user_signed_in? && (current_user.has_role?(:admin) || @business_improvement_area.user_id == current_user.id) %>
      <small>
        <%= link_to 'edit', edit_business_improvement_area_path(@business_improvement_area) %>
        <% if @business_improvement_area.use_carousel %>
        | <%= link_to 'edit carousel', polymorphic_path([@business_improvement_area, :carousel_images])  %>
        <% end %>
        <% if current_user.business_improvement_area_ids.include? @business_improvement_area.id %>
          | <%= link_to "message members", "#", role: "button", data: { toggle: "modal", target: "#new_message" } %>
        <% end %>
      </small>
      <% end -%>
    </h3>
  </div>
  <div class="span4">
    <%= render 'search_form', { locals: {css_class: 'hidden-mobile'} } %>
  </div>
</div>

<div class="row-fluid">
  <div class="span8">
    <div class="row-fluid">


      <% if @business_improvement_area.use_carousel and @business_improvement_area.carousel_images.present? and @business_improvement_area.carousel_images.size > 0 %>
      <div id="carousel" class="carousel slide" data-interval="8000">
        <ol class="carousel-indicators">
          <% @business_improvement_area.carousel_images.each_with_index do |img, i|  %>
            <li data-target="#carousel" data-slide-to="<%= i %>"></li>
          <% end %>
        </ol>
        <div class="carousel-inner">
          <% @business_improvement_area.carousel_images.each_with_index do |img, i|  %>
          <div class="item <%= "active" if i == 0 %>">
            <%=  image_tag img.image.url(:default) %>
            <% if !img.caption.blank? %>
              <div class="carousel-caption">
                <h4><%= img.title %></h4>
                <p><%= img.caption.html_safe %></p>
              </div>
            <% end %>
          </div>
          <% end %>
        </div>
        <!-- Carousel nav -->
        <a class="carousel-control left" href="#carousel" data-slide="prev">&lsaquo;</a>
        <a class="carousel-control right" href="#carousel" data-slide="next">&rsaquo;</a>

      </div>

      <% else %>
      <div class="span12 metro-img">
        <%= image_tag @business_improvement_area.home_page_image.url %>
      </div>
      <% end %>



    </div>

    <div class="row-fluid">
      <div class="span12">
        <div class="holder pad10">
          <h5>Featured Businesses</h5>
          <div class="row-fluid">
            <% @business_improvement_area.locations.order("RAND()").limit(6).each do |location| %>
            <div class="span2">
              <div class="thumbnail">
                <div style="min-height: 100px; text-align: center;">
                  <%= link_to(image_tag(get_location_image_url location), location) %>
                </div>

                <div style="font-size: 11px; font-weight: bold; text-align: center;"><%= link_to location.name, location %></div>
              </div>
            </div>
            <% end -%>
          </div>
        </div>
      </div>
    </div>
    <div class="row-fluid">
      <div class="span6">
        <div class="holder pad10">
          <h5>Status Updates
           <% if user_signed_in? && (current_user.has_role?(:admin) || @business_improvement_area.user_id == current_user.id) %>
           <small><%= link_to "(add)", "#status_update", class: 'small', role: :button, data: {toggle: 'modal'} %></small>
           <% end %>
         </h5>
         <% if @status_updates.size > 0 %>
         <% @status_updates.sort_by(&:created_at).reverse!.each do |status_update| %>
         <div class="row-fluid status-update">
            <div class="span2">
                <%= image_tag status_update.statusable.logo.url %>
            </div>
            <div class="span10">
              <div class="name"><%= link_to status_update.statusable.name, statusable_path(status_update.statusable) %> <span class="time-ago"> <%= "#{time_ago_in_words(status_update.created_at)} ago" %></span></div>
              <div><%= status_update.content %> 
              <% if status_update.image? %>
                <%= link_to(content_tag(:span, "View Image", class: "status-update-image", data: {"large-image" => status_update.image.url, "location-name" => status_update.statusable.name}), '#status_update_image', data: {toggle: 'modal'}) %>
              <% end %>
              </div>
              <% status_update = {url: location_url(status_update.statusable), title: status_update.statusable.name, content: status_update.content, image: status_update.image.url} %>
              <%= render_social_media_buttons(status_update) %>
            </div>
        </div>
        <% end %>
        <% else %>
        <div class="alert">No Market Updates found.</div>
        <% end %>

      </div>
    </div>
    <div class="span6">
        <!--<div class="holder pad10">
          <h5>News</h5>
          <% if @business_improvement_area.news_articles.size > 0 %>
          <%= render @business_improvement_area.news_articles.limit(3).order(:created_at) %>
          <% else %>
          <div class="alert">No News Articles found.</div>
          <% end %>
        </div>-->

        <div class="holder pad10">
          <h5>Events</h5>
          <% if @business_improvement_area.events.size > 0 %>
          <%= render @business_improvement_area.events.limit(200).order(:starts_at) %>
          <% else %>
          <div class="alert">No News Articles found.</div>
          <% end %>
        </div>
    </div>
  </div>
</div>


<div class="span4">
  <%= render 'application/join_now' %>

  <div class="row-fluid">
    <div class="holder pad10 clearfix">
      <h5>About <%= @business_improvement_area.name %></h5>
      <div class="pull-left clearfix" style="margin-right: 10px; margin-bottom: 10px;">
        <%= image_tag(@business_improvement_area.logo.url(:display), class: '') %>
      </div>
      <%= @business_improvement_area.description.html_safe %>
      <div class="" style="margin-top: 10px; clear: both;">
        <%= link_to "Visit us online!", @business_improvement_area.website_url, class: 'btn btn-success input-block-level' if @business_improvement_area.website_url.present? %>
      </div>
    </div>
  </div>

  <% if @tag_cloud.present? and @tag_cloud.size > 0 %>
  <div class="row-fluid">
    <div class="holder pad10 clearfix">
      <h5>Tag Cloud</h5>
      <div class="pad10 clearfix">
        <div id="tag_cloud" style="min-height: 600px; overflow-y: auto;"></div>
        <%= javascript_tag do %>
          var word_list = <%= raw @tag_cloud.sort_by!{ |tag| tag[:text].downcase }.to_json %>
        <% end %>
      </div>
    </div>
  </div>
  <% end %>
</div>
</div>
<%= render 'status_updates/show_image' %>
<% if user_signed_in? && (current_user.has_role?(:admin) || @business_improvement_area.user_id == current_user.id) %>
<%############# status update ###############%>

<div class="modal fade hide" id="new_message" tabindex="-1" role="dialog" aria-labelledby="new_message" aria-hidden="true" data-remote="<%= url_for([:new, @business_improvement_area, :message]) %>">
  <div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
    <h3 id="myModalLabel">Message members</h3>
  </div>
  <div class="modal-body"></div>
  <div class="modal-footer">
    <button class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
    <button class="btn btn-primary">Send</button>
  </div>
</div>

<%= render 'status_update_form' %>

<% end %>
