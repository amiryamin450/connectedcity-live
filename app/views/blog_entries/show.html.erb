
<% content_for :page_title do %>
  <%= "#{@blog_entry.bloggable.name}'s Blog" %>
<% end %>
<div class="row-fluid">
  <div class="span9">
    <h4><%= @blog_entry.title %></h4>
    <div class="submitted">
      <%= @blog_entry.created_at.strftime('%m-%d-%Y %l:%M %p') %>
    </div>
    <%= @blog_entry.content.html_safe %>
    
    <% if (user_signed_in? and current_user.has_role? :admin) or (user_signed_in? and current_user.can_manage_location? @location) %>
      <div style="margin-top: 1.5em">
        <%= link_to "Edit", edit_location_blog_entry_path(@location, @blog_entry), class: 'btn btn-primary' %>
        <%= link_to "Create New Blog Entry", new_location_blog_entry_path(@location), class: 'btn' %>
      </div>
    <% end %>

  </div>
  <div class="span3">
    <div class="thumbnail"><%= image_tag "http://placehold.it/320x240" %></div>
    
    <div class="info">
      <address>
        <strong><%= link_to @location.name, @location %></strong><br />
        <%= @location.address %><br/>
        <%= "#{@location.city.name} #{@location.province.abbr}, #{@location.postal_code}" %><br />
      </address>
    </div>
    
    <% if @location.blog_entries.size > 1 %>
    <div class="blog-entries">
      <h5>Recent Blog Entries</h5>
      <ul>
        <% @location.blog_entries.each do |blog| %>
          <% unless blog == @blog_entry %>
            <li><%= link_to blog.title, [@location, blog] %></li>
          <% end %>
        <% end %>
      </ul>      
    </div>
    <% end %>
  </div>  
</div>

