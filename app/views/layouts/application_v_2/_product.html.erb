<div class="row">
  <div class="col-12">
    <%= link_to (image_tag product.location.logo.url, class: "w-100 h-100"), product.location %></a>
  </div>
  <div class="col-12 px-3 pt-2">
    <div class="row">
      <div class="inner-card-title col-md-7">
        <h5><%#= link_to(product.name, [product.location, product]) %>
          <%= link_to ("#{product.name}"), "#", class: "status-update-image", data: { 'bs-target': "#product-#{product.id}-model", 'bs-toggle': 'modal'} %>
        </h5>
      </div>
      <div class="inner-card-time col-md-5">
        <span><%= "#{time_ago_in_words(product.created_at)} ago" %></span>
      </div>
      <div class="inner-card-title col-md-12 inner-by">
        by <%= link_to product.location.name, product.location %>
      </div>
    </div>
    <div class="inner-card-description">
      <div class="content"> <%= sanitize(product.description) %> </div>
      <p><%= raw "<span class='price' >Price: $#{product.price}</span>" if product.price.present? %></p>
    </div>
  </div>
  <% if product.image? %>
    <div class="col-md-12">
      <div class="update-banner">
        <%= link_to (image_tag product.image.url), "#", class: "status-update-image", data: { 'bs-target': "#product-#{product.id}-model", 'bs-toggle': 'modal'} %>
      </div>
    </div>
  <% end %>
  <%#= render 'status_updates/modal_content_latest', status_update: status_update %>
</div>
<hr>
