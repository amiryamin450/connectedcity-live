<h1><%= @product.name %></h1>
<br>
<%= render "product_images_swiper" %>
<div class="row-fluid">
  <div class="span6">
    <div class=""><%#= image_tag @product.image.url(:display), class: 'thumbnail' %></div>

    <% if @product.sku.present? && (user_signed_in? && current_user.can_manage_location?(@location)) %>
      <div><strong>Sku: </strong><%= @product.sku %></div>
    <% end %>

    <div><strong>Price: </strong><%= display_pricing @product %></div>
    <div><%= @product.description.html_safe %></div>
    <form action="https://connected-checkout-staging.herokuapp.com/create-checkout-session?product=<%=location_product_path(@location, @product)%>" method="POST">
      <div class="add_to_quantity buttons_added">
        <input type="button" value="-" class="minus">
          <input type="number" name="quantity" id="quantity" step="1" min="1" max=""  value="1" title="Qty" class="input-text qty text" size="4" pattern="" inputmode="">
          <input type="button" value="+" class="plus">
      </div>
      <%# <button type="submit" id="submit" class="btn btn-primary">Buy</button> %>
    </form>


    <%= link_to 'Add to Cart', line_items_path(product_id: @product, quantity: 1), id: "btn_add_to_cart", class: "product-button", method: :post %>
    <% if (user_signed_in? && current_user.has_role?(:admin)) or (user_signed_in? && current_user.can_manage_location?(@location)) %>
    <div style="margin-top: 1.5em">
      <%= link_to "Edit", edit_location_product_path(@location, @product), class: 'btn btn-primary' %>
      <%= link_to "Create New Product", new_location_product_path(@location), class: 'btn' %>
    </div>
    <% end %>

  </div>
</div>
<br>
<script>
  newHref = "<%= line_items_path(product_id: @product)%>";

  $(".plus").on("click", function() {
    var $button = $(this);
    var oldValue = $("#quantity").val();
    var newVal = parseFloat(oldValue) + 1;
    $("#quantity").val(newVal);
    document.getElementById("btn_add_to_cart").href = newHref + "&quantity="+document.getElementById("quantity").value;
  });

  $(".minus").on("click", function() {
    var $button = $(this);
    var oldValue = $("#quantity").val();
    if (oldValue > 1) {
      var newVal = parseFloat(oldValue) - 1;
    } else {
      newVal = 1;
    }
    $("#quantity").val(newVal);
    document.getElementById("btn_add_to_cart").href = newHref + "&quantity="+document.getElementById("quantity").value;
  });
</script>