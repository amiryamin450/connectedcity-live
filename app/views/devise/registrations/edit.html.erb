<div class="row">
  <div class="container-fluid content-holder p-5 col-12 col-md-8">
    <h2>Edit <%= resource_name.to_s.humanize %></h2>

    <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), method: :put, html: { class: 'form-vertical' }) do |f| %>
      <%= f.error_notification %>

      <div class="form-inputs form-group">
        <%= f.input :email, required: true, autofocus: true, input_html: { class: "form-control w-100 w-md-50" }, wrapper_html: { class: "col-12 col-md-6" }, label_html: { class: 'fw-bold mt-2' } %>
        <%= f.input :password, autocomplete: "off", hint: "leave it blank if you don't want to change it", required: false, input_html: { class: "form-control w-100 w-md-50" }, wrapper_html: { class: "col-12 col-md-6" }, label_html: { class: 'fw-bold mt-2' } %>
        <%= f.input :password_confirmation, required: false, input_html: { class: "form-control w-100 w-md-50" }, wrapper_html: { class: "col-12 col-md-6" }, label_html: { class: 'fw-bold mt-2' } %>
        <%= f.input :current_password, hint: "we need your current password to confirm your changes", required: true, input_html: { class: "form-control w-100 w-md-50" }, wrapper_html: { class: "col-12 col-md-6" }, label_html: { class: 'fw-bold mt-2' } %>
      </div>

      <div class="form-actions">
        <%= f.button :submit, "Update", class: 'btn-primary' %>
      </div>
    <% end %>

    <h3>Cancel my account</h3>

    <p>Unhappy? <%= link_to "Cancel my account", registration_path(resource_name), data: { confirm: "Are you sure?" }, method: :delete %>.</p>

    <%= link_to "Back", :back %>
  </div>

  <div class="col-12 col-md-4 p-5">
    <% if @profile %>
      <%= simple_form_for(@profile, url: update_profile_user_path(current_user), method: :put, html: { class: 'form-vertical' }) do |f| %>
        <h2>Update your profile</h2>
        <% img = @profile&.logo&.present? ? @profile&.logo&.url : "default-avatar-icon.jpeg" %>
        <%= image_tag img, class: "w-75" %>
        <%= f.input :logo, as: :file, wrapper_html: { class: "mt-2" }, label_html: { class: 'd-none' } %>
        <%= f.button :submit, "Update", class: 'btn-primary mt-2' %>
      <% end %>
    <% else %>
    <% end %>
  </div>
</div>
