<% if favorite = user_has_favorite?(location_id) %>
  <%= link_to("Following", favorite_path(favorite), method: :delete, remote: true, class: "btn btn-danger font-size-14 px-1") %>
<% else %>
  <%= link_to("Follow", favorites_path(current_user.favorites.build, location_id: location_id, user_id: current_user.id, category: vertical_market_slug), method: :post, remote: true, class: "btn btn-primary font-size-14 px-1") %>
<% end %>
