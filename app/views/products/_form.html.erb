<%= simple_form_for [@location, @product], :html => { :multipart => true, class: 'form-horizontal', id: 'new_product' } do |f| %>
<%= f.error_notification %>

<div class="form-inputs category-form">
  <%= f.input :name %>
  <div class="control-group string required category">
    <%= f.label :category %>
    <a class="btn btn-primary controls category-select-btn" data-toggle="collapse" role="button" aria-expanded="false" data-target="#collapseCategoriesProduct" aria-controls="collapseCategories">Select product category</a>
    <div class="collapse controls hideCollapse" id="collapseCategoriesProduct">
      <div style="display: flex;">
        <div class="categories level-1-category">
          <%= render 'categories', categories: @categories, lv: 1 %>
        </div>
        <div class="categories level-2-category hidden"></div>
        <div class="categories level-3-category hidden"></div>
        <div class="categories level-4-category hidden"></div>
      </div>
    </div>
  </div>
  <%= f.hidden_field :category_id %>
  <%= f.input :description, input_html: { class: 'input-block-level wysihtml5' } %>
  <div class="control-group string required">
    <%= f.label :price %>
    <%= f.number_field :price, class: "controls" %>
  </div>
  <%= f.input :sku %>
  <%= f.input :quantity %>
  <%= f.input :image, as: :logo_preview %>
  <%= render "product_images_fields", f: f %>
  <div class="form-actions">
    <%= f.button :submit,  class: 'btn btn-primary' %>
    <%= link_to 'Cancel', location_products_path(@location), class: 'btn'  %>
  </div>
<% end %>

<script type="text/javascript" src="https://code.jquery.com/jquery-1.7.1.min.js"></script>

<script type="text/javascript">
  $(document).ready(function() {
    var fileUploadErrors = {
      maxFileSize: 'File is too big',
      minFileSize: 'File is too small',
      acceptFileTypes: 'Filetype not allowed',
      maxNumberOfFiles: 'Max number of files exceeded',
      uploadedBytes: 'Uploaded bytes exceed file size',
      emptyResult: 'Empty file upload result'
    };

    $(function () {
      // Initialize the jQuery File Upload widget:
      $('#new_product #product_image').fileupload({
        fileInput: $('#product_product_images_attributes_0_image'),
        limitMultiFileUploads: 5,
        maxFileSize: 4000000
      });
      //
      // Load existing files:
      // fix below for browser back/forward buttons when erroneous AJAX call was made to action
      // when $('#fileupload').prop('action') was returning undefined.
      // # TODO: This partial should only be rendered when it's actually needed, instead of in the application layout.
      var url = $('#new_product').prop('action');
      if(jQuery.type( url ) !== "undefined")
      {
        $.getJSON($('#new_product').prop('action'), function (data) {
            var fu = $('#new_product').data('blueimpFileupload'),
                    template;
            fu._adjustMaxNumberOfFiles(-data.length);
            template = fu._renderDownload(data)
                    .appendTo($('#new_product .files'));
            // Force reflow:
            fu._reflow = fu._transition && template.length &&
                    template[0].offsetWidth;
            template.addClass('in');
            $('#loading').remove();
        });

      }
    });

    $('input#product_price').blur(function(){
      var num = parseFloat($(this).val());
      var cleanNum = num.toFixed(2);
      $(this).val(cleanNum);
    });

    $("#new_product").validate({
      rules: {
        'product[name]': {
          required: true,
        },
        'product[category_id]': {
          required: true
        },
        'product[description]': {
          required: true,
          minlength: 100,
          maxlength: 1500,
        },
        'product[sku]': {
          required: true,
          maxlength: 25,
        },
        'product[price]': {
          required: true,
          range: [0.1, 1000000],
          pattern: /^(\d+|\d+,\d{1,2})$/,
        },
        'product[quantity]': {
          required: true,
          minlength: 1,
          maxlength: 6,
          digits: true
        },
        'product[image]': {
          required: true,
        }
      }
    });
  });
</script>
