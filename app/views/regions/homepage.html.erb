
<h3><%= @region.name %></h3>
<div class="row-fluid">
  <div class="span8">
    <div class="row-fluid">
      <div class="span12 metro-img">
        <%= image_tag @region.home_page_image.url %>
      </div>
    </div>
    

    <div class="row-fluid">
      <div class="span12">
        <div class="holder pad10">
          <h5>Featured Listings</h5>
        </div>
      </div>
    </div>
    <div class="row-fluid">
      <div class="span6">
        <div class="holder pad10">
          <h5>Market Updates</h5>
          <% if @region.status_updates.size > 0 %>
          <% @region.status_updates.order(:created_at).each do |update| %>
          <div class="row-fluid status-update">
            <div class="span1">
              <%= image_tag update.statusable.logo.url(:thumb) if update.statusable.logo? %>
            </div>
            <div class="span11">
              <div class="name"><%= link_to update.statusable.name, update.statusable %> <span class="time-ago"> <%= "#{time_ago_in_words(update.created_at)} ago" %></span></div>
              <div><%= update.content %></div>
            </div>                
          </div>
          <% end %>
          <% else %>
          <div class="alert">No Market Updates found.</div>
          <% end %>

        </div>
      </div>
      <div class="span6">
        <div class="holder pad10">
          <h5>News</h5>
          <% if @region.news_articles.size > 0 %>
          <% @region.news_articles.order(:created_at).each do |article| %>

          <div class="row-fluid article">
            <div class="span1">
              <%= image_tag article.newsable.logo.url(:thumb) if article.newsable.logo? %>
            </div>
            <div class="span11">
              <div class="name"><%= link_to article.title, [article.newsable, article] %> <span class="time-ago"> <%= "#{time_ago_in_words(article.created_at)} ago" %>. by <%= link_to article.newsable.name, article.newsable %></span></div>
              <div><%= truncate_html(article.content, :length => 300) %></div>

            </div>                
          </div>
          <% end %>
          <% else %>
          <div class="alert">No News Articles found.</div>
          <% end %>
        </div>
      </div>
    </div>

  </div>


  <div class="span4">
    <div class="row-fluid">
      <div class="holder pad10">
        <h5>Join Now</h5>
      </div>
    </div>
    <div class="row-fluid">
      <div class="holder pad10">
        <h5>Regions in the <%= @region.name %></h5>
        <ul class="list-none">
          <% @sub_regions.each do |subregion| %>
          <li><%= link_to subregion.name, subregion_guide_path(subregion) %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>



