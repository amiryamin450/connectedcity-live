<div class="category">
  <div class="heading index-1">
  <h5>Rental Units</h5>
   <% if (user_signed_in? and current_user.has_role? :admin) or (user_signed_in? and current_user.can_manage_location? @location) %>
 <small><%= link_to "add", new_location_rental_property_rental_unit_path(@location, @rental_property), class: 'small' %> | <%= link_to 'manage', location_rental_property_rental_units_path(@location, @rental_property) %></small>
 <% end %>
</div>
</div>
<% if @rental_property.rental_units.size > 0 %>
<% @rental_property.rental_units.in_groups_of(4) do |group| %>
<div class="row-fluid product">
    <ul class="thumbnails">
    <% group.each do |unit| %>
      <% if unit %>
      <li class="span3">
        <div class="thumbnail">
          <%= link_to(image_tag(unit.cover_photo.url), [@location, @rental_property, unit]) %>
          <div class="clearfix">
            <div class="pull-left"><%= number_to_currency unit.rent_amount %></div>            
            <div class="pull-right"><%= "#{unit.bedrooms} bed | #{unit.bathrooms} baths" %></div>
          </div>
        </div>
        <% end -%>
      </li>
    <% end -%>
  </ul>
</div>

<% end -%>   

<% else %>
<div class="alert">
  No Units found.
</div>
<% end %>