<h1>Listing locations</h1>

<div class="pull-right">
  <%= link_to 'Show Pending Claims', pending_claims_locations_path %>
</div>

<%= search_form_for @search, class: 'form-search' do |f| %>
  <div class="input-append">
      <%= f.text_field :name_cont, class: 'search-query' %>
      <%= f.submit "Search", class: 'btn' %>
  </div>

<% end -%>

<table class="table table-striped table-compact table-bordered">
  <tr>
    <th>Name</th>
    <th>Address</th>
    <th>City</th>
    <th>State</th>
    <th>Postal Code</th>
    <th>Country</th>
    <th></th>
  </tr>

  <% @locations.each do |location| %>
      <tr>
        <td><%= location.name %></td>
        <td><%= location.address %></td>
        <td><%= location.city.name if location.city.present? %></td>
        <td><%= location.province.abbr %></td>
        <td><%= location.postal_code %></td>
        <td><%= location.country.country_code %></td>
        <td>
          <div class="btn-group">
            <%= link_to 'Show', location, :class => 'btn btn-mini' %>
            <%= link_to 'Edit', edit_location_path(location), :class => 'btn btn-mini' %>
            <%= link_to 'Destroy', location, method: :delete, data: {confirm: 'Are you sure?'}, :class => 'btn btn-mini' %>
          </div>
        </td>
      </tr>
  <% end %>
</table>
<%= paginate @locations %>


<%= link_to 'New Location', new_location_path, class: 'btn btn-primary' %>
