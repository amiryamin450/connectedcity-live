<div class="modal fade" data-id="<%= "video-#{media_attachment.id}-model" %>" id="<%="video-#{media_attachment.id}-model"%>" data-backdrop="static">
  <div class="modal-dialog modal-xl" style="max-width: 80%;">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="statusModalLongTitle"><%= media_attachment.attachable.name%></h5>
        <button data-id="<%="video-#{media_attachment.id}-model"%>" type="button" class="close media-attachment" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <div class="row">
          <div class="col-md-6">
            <div class="cover">
              <% if media_attachment.is_stream_video %>
                <%
                  video = media_attachment.videos&.first
                  is_livestream = video && video.livestream && video.status == "started"
                  is_processing_video = video && video.broadcast_id.present? && !video.video_url.present?
                %>
                <% if video&.livestream %>
                  <div id="streams"></div>
                <% elsif is_processing_video && !is_livestream %>
                  <img src="/assets/placeholder_stream_video.png" />
                <% else %>
                  <iframe width='100%' height='480' src="" data-src="<%= video&.video_url %>" id="<%="video-#{media_attachment.id}-vonage"%>" frameborder='0' allowfullscreen></iframe>
                <% end %>
              <% else %>
                <iframe width='100%' height='480' src="" data-src="https://www.youtube.com/embed/<%= media_attachment.media_source_id %>" id="<%="video-#{media_attachment.media_source_id}-#{media_attachment.id}-player"%>" frameborder='0' allowfullscreen></iframe>
              <% end %>
            </div>
          </div>
          <div class="col-md-6">
            <div class="location-info-popup" style="margin-top: 5px;">
              <%= render 'locations/location_information', location: media_attachment.location, content: media_attachment.description, claim_business: false, show_neighborhood: true %>
              <div class="row-fluid">
                <div class="span12">
                  <div class="pad10 holder" style="margin-top: 1.5em;">
                    <div class="clearfix profile-map" data-coordinates=<%= raw media_attachment.geo_location.to_json() %> ></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  $(document).ready(function() {
    // when the modal is opened autoplay it
    var streamVideo = <%= media_attachment.is_stream_video %>
    var isLivestream = <%= media_attachment.videos&.first&.livestream %>
    // stop playing the youtube video when I close the modal
    $('#<%="video-#{media_attachment.id}-model"%>').on('hide.bs.modal', function (e) {
      if (streamVideo) {
        $("#<%="video-#{media_attachment.id}-vonage"%>").attr('src', "");
      } else {
        $('#<%="video-#{media_attachment.media_source_id}-#{media_attachment.id}-player"%>').attr("src", "");
      }
    });
    var sessionId = "<%= media_attachment.videos&.first&.session_id %>";
    if (sessionId && isLivestream) {
      var locationSlug = "<%= media_attachment.location.slug %>";
      var apiKey = "<%= ENV['VONAGE_API_KEY'] %>";
      var broadcastId;

      async function fetchToken() {
        var token;
        token = await fetch(`/media_attachments/get_livestream_token.json?session_id=${sessionId}`, {
          method: 'get',
          }).then(function(response) {
          if (response.ok) {
            return response.json();
          }
          return Promise.reject(response);
          }).then(function (data) {
          return data.token
        })
        return token;
      }

      fetchToken().then(token => {
        var session = OT.initSession(apiKey, sessionId);
        var publisher;
        var container = $('<div id = "publisher"></div>');
        $('#streams').append(container);
        // publisher = OT.initPublisher('publisher', {
        //   insertMode: 'append',
        //   width: '100%',
        //   height: '100%',
        //   resolution: '1280x720'
        // });

        session.connect(token, function (err) {
          if (err) {
            alert(err.message || err);
          }

          // session.publish(publisher);
        });

        session.on('streamCreated', function (event) {
          console.log(event);
          var streamId = event.stream.id;
          container = document.createElement('div');
          container.id = streamId;
          $('#streams').append(container);
          session.subscribe(event.stream, streamId, {
            insertMode: 'append',
            width: '100%',
            height: '480px'
          });
          // if (streamId === focusStreamId) {
            // focusStream(streamId);
          // }
          // positionStreams();
        });
      })
    }
  });

</script>
