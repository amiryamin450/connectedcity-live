<%
  if @business_improvement_area
    @district = District.find(@business_improvement_area.district_id)
    @district_name = @district.slug

    @slug = @business_improvement_area.slug

    if @business_improvement_area.slug.include? "kitsilano"
      @slug = "kitsilano"
    end

    @neighbourhood = Neighborhood.where('slug LIKE ?', @slug)
  end
%>


<%
  @neighbourhood_param = params[:neighborhood]
  @neighbourhood_slug = params[:neighborhood]

  if @neighbourhood_param
    
    if @neighbourhood_param.include? "kitsilano"
      @neighbourhood_slug = "kitsilano"
    end
    
    @neighbourhood = Neighborhood.where('slug LIKE ?', @neighbourhood_slug).first
  end
%>
<nav id="nav">
  <a href="#" class="opener"><span></span></a>
  <div class="drop win-height">
    <div class="drop-holder">

      <ul class="main-nav">
        <li class="small active">
          <div>
            <a href="#"><i class="account"></i>account</a>
            <div class="sub-drop">
              <ul>
                <li>
                  <%= link_to "Login", new_user_session_path %>
                </li>
                <li>
                  <%= link_to "Sign Up", new_user_registration_path %>
                </li>
              </ul>
            </div>
          </div>
        </li>

        <li>
          <div><%= link_to @base_path, class: request.path == @base_path ? "active" : nil do %><i class="home"></i>Home<% end %></div>
        </li>

        <% @vertical_markets_all.each_with_index do |vm, index| %>
          <li>
            <div>
              <% if params[:sub_neighborhood_slug] || @location&.sub_neighborhood%>
                <% if params[:sub_neighborhood_slug]%>
                  <a href="<%=city_district_nbh_sub_guide_path(params[:city_slug], @district_slug, params[:neighborhood_slug], params[:sub_neighborhood_slug], vm.slug)%>"><%=vm.name%></a>
                <%else%>
                  <a href="<%=city_district_nbh_sub_guide_path(@location&.city&.slug, @location&.district&.slug, @location&.neighborhood&.slug, @location&.sub_neighborhood&.slug, vm.slug)%>"><%=vm.name%></a>
                <%end%>
              <% elsif params[:neighborhood_slug] || @location&.neighborhood%>
               <% if params[:neighborhood_slug]%>
                  <a href="<%=city_district_neighborhood_guide_path(params[:city_slug], @district_slug, params[:neighborhood_slug], vm.slug)%>"><%=vm.name%></a>
                <%else%>
                  <a href="<%=city_district_neighborhood_guide_path(@location&.city&.slug, @location&.district&.slug, @location&.neighborhood&.slug, vm.slug)%>"><%=vm.name%></a>
                <%end%>
              <% elsif @district_slug || @location&.district%>
                <% if @district_slug%>
                  <a href="<%=city_district_guide_path(params[:city_slug], @district_slug, vm.slug)%>"><%=vm.name%></a>
                <%else%>
                  <a href="<%=city_district_guide_path(@location&.city&.slug, @location&.district&.slug, vm.slug)%>"><%=vm.name%></a>
                <%end%>
              <% elsif params[:city_slug] || @location&.city%>
                <% if params[:city_slug]%>
                  <a href="<%=city_guide_path(params[:city_slug], vm.slug)%>"><%=vm.name%></a>
                <%else%>
                  <a href="<%=city_guide_path(@location&.city&.slug, vm.slug)%>"><%=vm.name%></a>
                <%end%>
              <% elsif params[:municipality_slug] || @location&.municipality%>
                <% if params[:municipality_slug]%>
                  <a href="<%=municipality_guide_path(params[:municipality_slug], vm.slug)%>"><%=vm.name%></a>
                <%else%>
                  <a href="<%=municipality_guide_path(@location&.municipality&.slug, vm.slug)%>"><%=vm.name%></a>
                <%end%>
              <%else%>
                <a href=<%="#"%>><%=vm.name%></a>
              <% end %>

              <% if vm.has_children? %>
                <div class="sub-drop">
                  <ul>
                    <% vm.children.sort_by(&:name).each do |child| %>
                      <% if params[:sub_neighborhood_slug] || @location&.sub_neighborhood%>
                        <% if params[:sub_neighborhood_slug]%>
                          <li><%= link_to child.name, city_district_nbh_sub_sub_market_guide_path(params[:city_slug], @district_slug, params[:neighborhood_slug], params[:sub_neighborhood_slug], vm.slug, child.slug), class: "dropdown-item nv-mn-lnk" %></li>
                        <% else %>
                          <li><%= link_to child.name, city_district_nbh_sub_sub_market_guide_path(@location&.city&.slug, @location&.district&.slug, @location&.neighborhood&.slug, @location&.sub_neighborhood&.slug, vm.slug, child.slug), class: "dropdown-item nv-mn-lnk" %></li>
                        <% end %>
                      <% elsif params[:neighborhood_slug] || @location&.neighborhood%>
                        <% if params[:neighborhood_slug]%>
                          <li><%= link_to child.name, city_district_neighborhood_sub_market_guide_path(params[:city_slug], @district_slug, params[:neighborhood_slug], vm.slug, child.slug), class: "dropdown-item nv-mn-lnk" %></li>
                        <% else %>
                          <li><%= link_to child.name, city_district_neighborhood_sub_market_guide_path(@location&.city&.slug, @location&.district&.slug, @location&.neighborhood&.slug, vm.slug, child.slug), class: "dropdown-item nv-mn-lnk" %></li>
                        <% end %>
                      <% elsif @district_slug || @location&.district%>
                        <% if @district_slug%>
                          <li><%= link_to child.name, city_district_sub_market_guide_path(params[:city_slug], @district_slug, vm.slug, child.slug), class: "dropdown-item nv-mn-lnk" %></li>
                        <%else%>
                          <li><%= link_to child.name, city_district_sub_market_guide_path(@location&.city&.slug, @location&.district&.slug, vm.slug, child.slug), class: "dropdown-item nv-mn-lnk" %></li>
                        <% end %>
                    <% elsif params[:city_slug] || @location&.city  %>
                        <%if params[:city_slug]%>
                          <li><%= link_to child.name, city_sub_market_guide_path(params[:city_slug], vm.slug, child.slug), class: "dropdown-item nv-mn-lnk" %></li>
                        <% else %>
                          <li><%= link_to child.name, city_sub_market_guide_path(@location&.city.slug, vm.slug, child.slug), class: "dropdown-item nv-mn-lnk" %></li>
                        <% end %>
                      <% elsif params[:municipality_slug] || @location&.municipality  %>
                        <%if params[:municipality_slug]%>
                          <li><%= link_to child.name, municipality_sub_market_guide_path(params[:municipality_slug], vm.slug, child.slug), class: "dropdown-item nv-mn-lnk" %></li>
                        <% else %>
                          <li><%= link_to child.name, municipality_sub_market_guide_path(@location&.municipality&.slug, vm.slug, child.slug), class: "dropdown-item nv-mn-lnk" %></li>
                        <% end %>
                      <% else %>
                        <a href=<%="#"%>><%=child.name%></a>
                      <% end %>
                    <% end %>
                  </ul>
                </div>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>

      <div class="add-nav">
        <a href="#" class="add-opener">more</a>
        <div class="add-drop">
          <ul></ul>
        </div>
      </div>

      <ul class="side-nav">
        <li><div><a href="/employment-opportunities"><i class="jobs"></i>Jobs</a></div></li>
        <li class="right bottom"><div><a href="/classifieds"><i class="classified"></i>Classifieds</a></div></li>
        <li class="right"><div><a href="#{@base_path}news"><i class="city"></i>City News</a></div></li>
      </ul>
    </div>
  </div>
</nav>
