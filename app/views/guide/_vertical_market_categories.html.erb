<%

# Dynamically constructed title for guide/vertical market pages can consist of
# one of more of these 4 different pieces of information depending on what is
# available:
#
# - vertical market
# - neighborhood
# - district
# - city

guide = @vertical_market ? "#{@vertical_market.name} In #{@neighborhood.try(:name) || @district.try(:name) || @city.try(:name)}" : nil
metamagic title: "#{guide}".strip,
          description: "",
          canonical: url_for(Rails.application.routes.recognize_path(request.path).merge({only_path: false, protocol: 'https'}))

%>
<%

markers = []

content_for :title do [@page_title_part, @vertical_market.name, (@vertical_market.parent.name if @vertical_market.parent), 'Guide'].reject(&:blank?).join ' ' end

%>

<%#

NOTE Rental (rental)
     Resale (resale)
     New Home (newhome)
     Commercial (commercial)

%>
<%# NOTE: APRIL 7, 2017 - Commented out code will be needed for upcoming changes. Don't remove them as THEY WILL be needed shortly - Don Marges %>
<%# if [1, 17, 18, 19, 20].include?(@vertical_market.id) %>
<% if [17, 18, 19, 20].include?(@vertical_market.id) %>
  <%# TODO Optimize %>
  <% case @vertical_market.id %>
  <%# when 1 %>
    <%#= render 'automotive_listings', auto_listings: @auto_listings, auto_makes: @auto_makes %>
  	<%#= render 'original_automotive' %>
	<% when 17 %>
    <% markers |= @rental_properties %>
    <%# @rental_properties.each_with_index do |rental_property, r| %>
      <%# if rental_property.rental_units.any? %>
        <%#= render 'rental_properties', rental_property: rental_property, rental_units: rental_property.rental_units, r: r %>
      <%# end %>
    <%# end %>
		<%= render 'original_rental' %>
  <% when 18 %>
    <% markers |= @listings %>
    <%#= render 'residential', residential_units: @listings, styles: @residential_styles %>
  	<%= render 'original_resale' %>
	<% when 19 %>
    <% markers |= @new_home_communities %>
    <%# @new_home_communities.each_with_index do |new_home_community, r| %>
      <%# if new_home_community.new_homes.any? %>
        <%#= render 'new_home_communities', new_home_community: new_home_community, new_homes: new_home_community.new_homes, r: r %>
      <%# end %>
    <%# end %>
		<%= render 'original_new_home' %>
  <% when 20 %>
    <% markers |= @commercial_listings %>
    <%#= render 'commercial_properties', commercial_units: @commercial_listings, styles: @commercial_styles %>
    <%= render 'original_commercial', commercial_listings: @commercial_listings %>
	<% end %>
<% else %>
  <%# NOTE Automotive (automotive) %>
  <% if @vertical_market.id == 1 %>
    <div class="category">
      <div class="heading index-11">
        <h5>Automotive Listings</h5>
        <%= link_to 'More +', '#', class: 'see-more', data: { element: 'auto-listings' } %>
        <%= link_to 'See All', "#", class: 'see-all' %>
      </div>
      <div class="location-holder" id="auto-listings">
        <div class="clearfix">
          <% @auto_listings.each do |listing| %>
            <%# FIXME Move inline styles to a stylesheet %>
            <div class="location-teaser clearfix">
              <div style="height: 74px; text-align: center;">
                <%= link_to image_tag(listing.main_image.url(:hp_list)), [listing.location, listing] %>
              </div>
              <div style="margin-top: 5px; margin-bottom: 5px;"><%= humanized_money_with_symbol listing.price %></div>
              <div style="width: 168px; font-size: 12px; min-height:24px;"><strong><%= link_to [listing.year, listing.make, listing.model].reject(&:blank?).join(' '), [listing.location, listing] %></strong></div>
              <div style="width: 168px; margin-top: 5px; font-weight: bold;"><%= link_to listing.location.name, listing.location %></div>
          </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
  <% @vertical_market.categories_new(@city, @district, @neighborhood).each_with_index do |category, r| %>
    <%

    locations = category.locations[0..19]
    markers |= category.locations

    %>

    <% if locations.any? %>
      <%= render 'guide/category', category: category, r: r, locations: locations %>
    <% end %>
  <% end %>
<% end %>

<%= javascript_tag do %>
  window.locations = <%= raw markers.collect { |m|
    u = if m.respond_to?(:location)
      url_for([m.location, m])
    else
      url_for(m)
    end

    {:name => m.name, :url => u, :latitude => m.latitude, :longitude => m.longitude, :thumb => m.logo.file? ? m.logo.url(:bia_display) : nil}
  }.to_json %>;
<% end %>

<%= render 'locations/modal_show' %>
<%= render 'status_updates/show_image' %>
