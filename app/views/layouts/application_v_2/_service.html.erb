<div class="row">
  <div class="col-12">
    <%= link_to (image_tag service.location.logo.url, class: "w-100 h-100"), service.location %></a>
  </div>
  <div class="col-12 px-3 pt-2">
    <div class="row">
      <div class="inner-card-title col-md-7">
        <h5>
          <%= link_to ("#{service.name}"), "#", class: "status-update-image", data: { 'bs-target': "#service-#{service.id}-model", 'bs-toggle': 'modal'} %>
        </h5>
      </div>
      <div class="inner-card-time col-md-5">
        <span><%= "#{time_ago_in_words(service.created_at)} ago" %></span>
      </div>
      <div class="inner-card-title col-md-12 inner-by">
        by <%= link_to service.location.name, service.location %>
      </div>
    </div>
    <div class="inner-card-description">
      <div class="content"> <%= sanitize(service.description) %> </div>
      <p><%= raw "<span class='price' >Price: $#{service.price}</span>" if service.price.present? %></p>
    </div>
  </div>
  <% if service.image? %>
    <div class="col-md-12">
      <div class="update-banner">
        <%= link_to (image_tag service.image.url), "#", class: "status-update-image", data: { 'bs-target': "#service-#{service.id}-model", 'bs-toggle': 'modal'} %>
      </div>
    </div>
  <% end %>
  <%#= render 'status_updates/modal_content_latest', status_update: service %>
</div>
<hr>
