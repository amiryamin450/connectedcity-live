<%= simple_form_for @vertical_market_category, :html => { :multipart => true, :class => 'form-vertical' } do |f| %>


  <div class="form-inputs">
    <%= f.input :name %>
    <%= f.input :description, input_html: { class: 'input-block-level' } %>
    <%= f.association :vertical_market, :prompt => "Select a Category" %>
    <%= f.file_field :default_logo %>
  </div>

  <div class="form-actions">
    <%= f.button :submit, :class => 'btn btn-primary' %>
    <%= link_to "Cancel", vertical_market_categories_path, class: 'btn' %>
  </div>
<% end %>
