<div class="px-3 pb-3 px-md-5 pb-md-5">
  <h1 class="my-4">Manage <%= @location.name %>'s Products </h1>
  <% if @products.size > 0 %>
    <table class="table table-bordered table-striped table-hover">
      <thead>
      <tr>
        <th>Name</th>
        <th>Sku</th>
        <th>Price</th>
        <th></th>
      </tr>
      </thead>
      <tbody>
        <% @products.each do |product| %>
          <tr>
            <td><%= product.name %></td>
            <td><%= product.sku %></td>
            <td><%= display_pricing product %></td>
            <td>
              <div class="btn-group">
                <%= link_to 'Show', [@location, product], class: 'btn btn-mini' %>
                <%= link_to 'Edit', edit_location_product_path(@location, product), class: 'btn btn-mini' %>
                <%= link_to 'Delete', [@location, product], method: :delete, data: {confirm: 'Are you sure?' }, class: 'btn btn-mini' %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="alert notice">No products found.</div>
  <% end %>

  <%# TODO: Require connect to Stripe before add product %>
  <%# can_add_product = StripeService.new(@location).stripe_connect_status %>
  <%#= link_to 'New Product', can_add_product ? new_location_product_path(@location) : edit_location_path(@location), onclick: can_add_product ? nil : "return confirm('Please connect to Stripe before add products.\\nSelect eCommerce Store tab on your business page to add it.')", class: 'btn btn-primary' %>
  <%= link_to 'New Product', new_location_product_path(@location), class: 'btn btn-primary' %>
  <%= link_to "Back to #{@location.name}", @location, class: 'btn' %>
</div>
