<% @current_market = @vertical_market.respond_to?(:name) ? @vertical_market.name : @vertical_market %>
<% @current_district = (@municipality&.name || @sub_neighborhood&.name || @neighborhood&.name || @district&.name || @city&.name || 'Vancouver') %>
<% @employment_category = [
  ['Accounting and Finance', 'Accounting and Finance'],
  ['Administrative and Clerical', 'Administrative and Clerical'],
  ['Arts, Media and Entertainment', 'Arts, Media and Entertainment'],
  ['Customer Service', 'Customer Service'],
  ['Engineering', 'Engineering'],
  ['Environmental', 'Environmental'],
  ['Financial Services', 'Financial Services'],
  ['Healthcare Services and Wellness', 'Healthcare Services and Wellness'],
  ['Hospitality and Food Service', 'Hospitality and Food Service'],
  ['Human Resources and Recruitment', 'Human Resources and Recruitment'],
  ['Legal', 'Legal'],
  ['Manufacturing', 'Manufacturing'],
  ['Marketing', 'Marketing'],
  ['Operations', 'Operations'],
  ['Project Management and Business Analysis', 'Project Management and Business Analysis'],
  ['Sales and Business Development', 'Sales and Business Development'],
  ['Science and Research', 'Science and Research'],
  ['Security and Surveillance', 'Security and Surveillance'],
  ['Supply Chain and Logistics', 'Supply Chain and Logistics'],
  ['Technology and Digital Media', 'Technology and Digital Media'],
  ['Training and Education', 'Training and Education'],
  ['Retail In-Store', 'Retail In-Store'],
  ['Real Estate', 'Real Estate'],
  ['Other', 'Other']
] %>
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="<%= root_path %>">Home</a></li>
      <li class="breadcrumb-item" aria-current="page"><a href="/employment-opportunities" style="margin-left: 10px;">Employment Opportunities</a></li>
    </ol>
</nav>
<!-- Breadcrumb End -->
<div class="category-body-section">
    <div class="container-fluid">
      <div class="row">
          <div class="col-md-12">
            <!--  Category -->
            <div class="page-title">
              <h1 style="font-weight: bold;">Browse Jobs in Vancouver</h1>
            </div>
            <!-- End -->
          </div>
      </div>
      <div class="row">
          <div class="col-md-5">
            <div class="category-sidebar landing-page-heading-filter communities-page">
                <div class="map-section">
                  <div id="map"></div>
                </div>
                <div class="row filter" style="padding: 0 10px 15px;">
                  <div class="col-11">
                    <div class="row">
                      <div class="col-3 container-box">
                        <%= select_tag 'civic-news-disctrict-dropdown', options_from_collection_for_select(@districts, 'id', 'name'), prompt: 'District', class: 'form-control search-column input-group-prepend search-box', style: 'font-size: 15px; padding-right: 0.25rem; padding-left: 0.25rem;' %>
                      </div>
                      <div class="col-4 container-box">
                        <%= select_tag 'civic-news-neighborhoods-dropdown', raw("<option>Neighbourhood</option>"), prompt: 'Neighbourhood', class: 'form-control search-column input-group-prepend search-box', style: 'font-size: 15px; padding-right: 0.25rem; padding-left: 0.25rem;' %>
                      </div>
                      <div class="col-5 container-box">
                        <%= select_tag 'civic-news-sub-neighborhoods-dropdown', raw("<option>Sub-Neighbourhood</option>"), prompt: 'Sub-Neighbourhood', class: 'form-control search-column input-group-prepend search-box', style: 'font-size: 15px; padding-right: 0.25rem; padding-left: 0.25rem;' %>
                      </div>
                    </div>
                  </div>
                  <div class="col-1 btn-search">
                    <a href="#" id="city-landing-paths">
                      <button type="button" class="btn-primary btn" style="font-size: 15px; justify-content: center;">Go</button>
                    </a>
                  </div>
                </div>
                <div class="SideBar-tabs">
                  <%= render 'layouts/application_v_2/guide_sidebar' %>
                </div>
            </div>
          </div>
          <!-- SideBar End -->
          <div class="col-md-7">
            <div class="category-body">
              <br>
              <%= render 'search_box/search_box', url: "#{@base_path}search", opts: options_for_select(@employment_category), all_promt: 'All Categories' %>
              <div class="row py-2" style="display: flex;">
                <p class="col-md-5" style="display: flex; align-items: center; margin-bottom: 0px;">Filter by Employment Categogy</p>
                 <%= select_tag 'market', options_for_select(@employment_category), prompt: '(All)', class: 'form-control col-md-5' %>
                 <div class="col-md-2 btn-refesh">
                  <a href="#">
                    <button type="button" class="btn-primary btn w-100" style="background-color: #10375C;">Refesh</button>
                  </a>
                </div>
              </div>
              <div class="vertical-market-categories">
                <% @employment_category.each do |item| %>
                  <div class="card-label-one">
                  <div class="title">
                    <h4>&nbsp;<%= item[0] %>&nbsp;</h4>
                    <%= link_to 'More + ', '#', class: 'see-more' %>

                    <% #if @business_improvement_area_id %>
                      &nbsp;&nbsp;&nbsp;
                      <%= link_to ' See All', "#", class: 'see-all' %>
                    <%# end %>
                  </div>
                </div>
                <div class="alert alert-dark" role="alert"><%="No #{item[0]} Jobs found."%></div>
                <% end %>
              </div>
            </div>
          </div>
      </div>
    </div>
</div>
<br>
