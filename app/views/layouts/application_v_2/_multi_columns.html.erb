        <% end %>
      </div>
      <!--  -->
      <div id="Products" class="container tab-pane">
        <br>
        <h3>Products</h3>
        <% if @products.size > 0 %>
            <% @products.each do |product| %>
              <%= render 'layouts/application_v_2/product', product: product %>
            <% end %>
        <% else %>
          <div class="alert">No Products found.</div>
        <% end %>
      </div>
      <!--  -->
      <div id="Services" class="container tab-pane">
        <br>
        <h3>Services</h3>
        <% if @services && @services.size > 0 %>
            <% @services.each do |service| %>
              <%= render 'layouts/application_v_2/product', product: service %>
            <% end %>
        <% else %>
          <div class="alert">No services found.</div>
        <% end %>
      </div>
      <!--  -->
      <div id="Events" class="container tab-pane">
        <br>
        <h3>Events</h3><br>
        <% if @events.size > 0 %>
            <% @events.each do |event| %>
              <%= render 'layouts/application_v_2/event', event: event %>
            <% end %>
        <% else %>
          <div class="alert">No Events found.</div>
        <% end %>
      </div>
      <div id="News" class="container tab-pane">
        <br>
        <h3>News</h3><br>
        <% if @news_articles && @news_articles.size > 0 %>
            <% @news_articles.each do |news_article| %>
              <%= render 'layouts/application_v_2/news_article', news_article: news_article %>
            <% end %>
        <% else %>
          <div class="alert">No News found.</div>
        <% end %>
      </div>
      <div id="Blogs" class="container tab-pane">
        <br>
        <h3>Blogs</h3><br>
        <% if @blog_entries.size > 0 %>
            <% @blog_entries.each do |blog_entry| %>
              <%= render 'layouts/application_v_2/blog_entry', blog_entry: blog_entry %>
            <% end %>
        <% else %>
          <div class="alert">No Blogs found.</div>
        <% end %>
      </div>
      <div id="Offers" class="container tab-pane">
        <br>
        <h3>Deals</h3><br>
        <%#= render @coupons %>
        <% if @coupons.size > 0 %>
          <% @coupons.each do |coupon| %>
            <%= render 'layouts/application_v_2/coupon', coupon: coupon %>
          <% end %>
        <% else %>
          <div class="alert">No Deals found.</div>
        <% end %>
      </div>
    </div>
  </div></div>
</div>

<% if @status_updates.size > 0 %>
