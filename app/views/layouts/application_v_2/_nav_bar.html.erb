<%
  if @business_improvement_area
    @district = District.find(@business_improvement_area.district_id)
    @district_name = @district.slug
    @slug = @business_improvement_area.slug
    @slug = "kitsilano" if @business_improvement_area.slug.include? "kitsilano"
    @neighbourhood = Neighborhood.where('slug LIKE ?', @slug)
  end
%>
<%
  @neighbourhood_param = params[:neighborhood]
  @neighbourhood_slug = params[:neighborhood]
  if @neighbourhood_param
    @neighbourhood_slug = "kitsilano" if @neighbourhood_param.include? "kitsilano"
    @neighbourhood = Neighborhood.where('slug LIKE ?', @neighbourhood_slug).first
  end
%>
<div class="nav-bar">
  <div class="container-fluid p-0">
    <nav role="navigation" id="nav-main">	
      <ul id="main">
        <% klass = request.path == @base_path ? "selected" : ""%>
        <li class="selected"> <%= link_to "Home", @base_path%></li>
        <% @vertical_markets_all.each_with_index do |vm, index| %>
          <% if vm.has_children? %>
            <li>
              <% if @business_improvement_area %>
                <a href="<%=district_neighborhood_guide_path(@district_name, @slug, vm.slug)%>"><%=vm.name%></a>
              <% elsif @district && @neighbourhood_slug %>
                <a href="<%=district_neighborhood_guide_path(@district.slug, @neighbourhood_slug, vm.slug)%>"><%=vm.name%></a>
              <% else %>
                <a href=<%="#{@base_path}guide/#{vm.slug}"%>><%=vm.name%></a>
              <% end %>
              <ul>
                <% vm.children.sort_by(&:name).each do |child| %>
                  <% if @business_improvement_area %>
                    <li><%= link_to child.name, district_neighborhood_guide_path(@district_name, @slug, child.slug), class: "dropdown-item nv-mn-lnk" %></li>
                  <% else %>
                    <% if @neighbourhood %>
                      <li><%= link_to child.name, district_neighborhood_guide_path(@district, @neighbourhood.slug, child.slug), class: "dropdown-item nv-mn-lnk" %></li>
                    <% else %>
                      <% if @district %>
                        <li><%= link_to child.name, top_district_guide_path(@district, child.slug), class: "dropdown-item nv-mn-lnk" %></li>
                      <% else %>
                        <li><%= link_to child.name, "#{@base_path}guide/#{child.slug}", class: "dropdown-item nv-mn-lnk" %></li>
                      <% end %>
                    <% end %>
                  <% end %>
                <% end %>
              </ul>
            </li>
          <% end %>
        <% end %>
        <li class="more" data-width="70">
            <a href="#">More</a>
            <ul></ul>
        </li>
      </ul>
    </nav>
    <div class="menu-nav-right">
      <a href="/employment-opportunities">Jobs</a>
      <a href="/classifieds">Classfieds</a>
      <a href=<%="#{@base_path}news"%>>News</a>
    </div>
  </div>
</div>
<script>

  function calcWidth() {
    var navwidth = 0;
    var morewidth = $('#main .more').outerWidth(true);
    $('#main > li:not(.more)').each(function() {
      navwidth += $(this).outerWidth( true );
    });
    
    //var availablespace = $('nav').outerWidth(true) - morewidth;
    var availablespace = $('#nav-main').width() - morewidth;
    
    if (navwidth > availablespace) {
      var lastItem = $('#main > li:not(.more)').last();
      lastItem.attr('data-width', lastItem.outerWidth(true));
      lastItem.prependTo($('#main .more ul'));
      calcWidth();
    } else {
      var firstMoreElement = $('#main li.more li').first();
      if (navwidth + firstMoreElement.data('width') < availablespace) {
        firstMoreElement.insertBefore($('#main .more'));
      }
    }
    if ($('.more li').length > 0) {
      $('.more').css('display','block');
    } else {
      $('.more').css('display','none');
    }
  }

  $(document).ready(function(){
    calcWidth();
  });

  $(window).on('resize load',function(){
    calcWidth();
  });
  
</script>