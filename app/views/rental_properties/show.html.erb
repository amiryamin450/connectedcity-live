<div class="span6">
  <div class="pad10 holder clearfix">
    <div class="row-fluid">
      <div class="span12">
        <% if @rental_property.cover_photo %>
        <%= image_tag @rental_property.cover_photo.url %>
        <% else %>
        <%= image_tag "http://placehold.it/1280x400" %>
        <% end -%>
      </div>

    </div>
    <div class="row-fluid" style="margin-top:5px;">

      <div class="span3">
        <div class="thumbnail logo" style="margin-top: 10px;">
          <%= image_tag @rental_property.location.logo.url %>
        </div>
      </div>

      <div class="span9">
        <h4><%= @rental_property.name %></h4>
        
        
        <div class="address-line">
          <div style="margin-bottom: 10px;">
           <%= "#{@rental_property.address_1} &middot;".html_safe %> <%= "#{@rental_property.address_2} &middot;".html_safe if @rental_property.address_2.present? %> <%= "#{@rental_property.city.name} #{@rental_property&.province&.preabbr}, #{@rental_property.postal_code}" %>
         </div>

       </div>


       <% if (user_signed_in? and current_user.has_role? :admin) or (user_signed_in? and current_user.can_manage_location? @location) %>
       <div class="btn-group">
         <%= link_to "Edit", edit_location_rental_property_path(@location, @rental_property), class: 'btn btn-mini btn-primary' %>
       </div>
       <% end %>

     </div>
   </div>
 </div>




 <div class="pad10 holder">

  <div class="row-fluid">
    <div class="span12">
      <h4>Property Description</h4>
      <%= @rental_property.description.html_safe %>
    </div>
  </div>
  <div class="well" style="margin-top: 10px;">
    <div class="row-fluid">
      <div class="span6">

        <% if @rental_property.property_highlights %>
        <h6>Property Highlights</h6>
        <ul>
          <% @rental_property.property_highlights.each_line do |item| %>
          <li><%= item %></li>
          <% end -%>
        </ul>
        <% end -%>
      </div>
      <div class="span6">
        <% if @rental_property.property_features %>
        <h6>Property Features</h6>
        <ul>
          <% @rental_property.property_features.each_line do |item| %>
          <li><%= item %></li>
          <% end -%>
        </ul>
        <% end -%>
      </div>
    </div>
  </div>
  <% if @rental_property.neighborhood_description.present? %>
  <div class="row-fluid">
    <div class="span12">
      <h4>Neighborhood Description</h4>
      <%= @rental_property.description.html_safe %>
    </div>
  </div>
  <% end -%>
  <div class="well" style="margin-top: 10px;" >
    <div class="row-fluid">
      <div class="span6">

        <% if @rental_property.neighborhood_highlights %>
        <h6>Neighborhood Highlights</h6>
        <ul>
          <% @rental_property.neighborhood_highlights.each_line do |item| %>
          <li><%= item %></li>
          <% end -%>
        </ul>
        <% end -%>
      </div>
      <div class="span6">

      </div>
    </div>
  </div>

</div>

</div>
<div class="span6">
  <div class="row-fluid">
    <div class="span12">
      <div class="pad10 holder">
       <div id="profile-map" class="clearfix"></div>
     </div>


    <div class="pad10 holder">
  <div class="row-fluid">
    <div class="span12">
      <h4 class="title">Status Updates
       <% if (user_signed_in? and current_user.has_role? :admin) or (user_signed_in? and current_user.can_manage_location? @location) %>
       <small><%= link_to "add", "#status_update", class: 'small', role: :button, data: {toggle: 'modal'} %></small>
       <% end %>
     </h4>

     <div id="status_updates">
      <% if @rental_property.status_updates.size > 0 %>


      <% @rental_property.status_updates.each do |s| %>
      <article class="teaser">
        <div style="float:right">
          <button type="button" class="close">
            <%= link_to '×', [s.statusable.location, s.statusable, s], method: :delete, data: { confirm: 'Are you sure?' }, class: 'delete' %>
          </button>
        </div>
        <div class="article-content"><%= truncate(s.content, length: 200, seperator: ' ') %></div>
        <div class="article-published"><%= "#{time_ago_in_words(s.created_at)} ago" %></div>
      </article>

      <% end %>
     

      <% else %>
      <div class="alert">No Status Updates found.</div>
      <% end %>
    </div>
  </div>
</div>
</div>


   </div>
 </div>
 <div class="row-fluid">
   <div class="span12">
     <%= render 'rental_units' %>
   </div>
 </div>
</div>


<%= javascript_tag do %>

<% ## TODO Limit the number of locations returned  %>

Window.profile_marker = <%= raw @rental_property.geo_location.to_json() %>
<% end %>


<div class='modal hide fade' id="status_update" tabindex="-1" role="dialog" aria-labelledby="status_update_label" aria-hidden="true">
  <%= simple_form_for [@location,@rental_property], :html => {:style => 'margin-bottom: 0;'} do |f| %>
  <div class="modal-header">
      <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
      <h3 id="status_update_label">What's Happening?</h3>
  </div>
  <div class="modal-body">
    <%= f.fields_for :status_updates, @rental_property.status_updates.build() do |b| %>
    <div>
      <%= b.label 'Update Text' %>
      <%= b.text_area :content, :rows => 3, style: 'width: 515px' %>
    </div>
    <% end %>
  </div>
  <div class="modal-footer">
      <input type="button" class="btn" data-dismiss="modal" aria-hidden="true" value="Cancel" />
      <%= f.button :submit, :class => 'btn btn-primary' %>
  </div>
  <% end %>
</div>

