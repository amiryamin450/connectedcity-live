<% if favorite = user_has_favorite?(location_id) %>
    <%= link_to  "remove", favorite_path(favorite), :method => :delete, :remote => true, :class => 'remove-favorite', :title => 'Remove from favorites.' %>
<% else %>
    <%= link_to "add", favorites_path(current_user.favorites.build, :location_id => location_id, :user_id => current_user.id, :category => @vertical_market.slug), :method => :post, :remote => true, :class => 'add-favorite', :title => 'Add to favorites.' %>
<% end %>