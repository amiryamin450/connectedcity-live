<div class="category">
  <div class="heading index-<%= r %>">
    <h5><%= category.name %></h5>

    <%= link_to 'More +', '#', class: 'see-more', data: { element: category.id } %>
    <%= link_to 'See All', "#{@base_path}category/#{category.slug}" %>

    <% if user_signed_in? && current_user.has_role?(:admin) %>
      <%= link_to 'Edit', edit_vertical_market_category_path(category), class: 'admin-link' %>
    <% end %>
  </div>

  <div class="location-holder" id="cat-<%= category.id %>">
    <div class="clearfix">
      <% locations.each do |location| %>
        <% cache "location_#{location.id}_#{location.updated_at}" do %>
        <%= render 'guide/location', location: location %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
