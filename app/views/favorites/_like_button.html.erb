<% if favorite = user_has_favorite?(location_id) %>
    <%= link_to(image_tag("button_following.jpg", class: "follow_button_image"), favorite_path(favorite), :method => :delete, :remote => true) %>
<% else %>
    <%= link_to(image_tag("button_follow.jpg", class: "follow_button_image"), favorites_path(current_user.favorites.build, :location_id => location_id, :user_id => current_user.id, :category => vertical_market_slug), :method => :post, :remote => true) %>
<% end %>
