<div class="card-label-four">
  <div class="title">
    <%= link_to specific_location_products_path(@location, :category_id => 'all'), remote: true, class: "category-tab" do %>
      <h4 class=<%="#{@category_id === 'all' ? 'active' : 'secondary'}"%> data-index=0>Products</h4>
    <% end %>
    <% @categories.each.with_index(1) do |category, idx| %>
      <%= link_to specific_location_products_path(@location, :category_id => category.id), remote: true, class: "category-tab" do %>
        <h4 class=<%="#{@category_id.to_i === category.id ? 'active' : 'secondary'}"%> data-index=<%= idx %> data-id=<%= category.id %>><%= category.name %></h4>
      <% end %>
    <% end %>
    <button id="less" class="less-than" style="padding: 0px; border: none;">
      <h4 class='secondary' style="padding: 6px 10px;"><</h4>
    </button>
    <button id="more" class="more-than" style="padding: 0px; border: none;">
      <h4 class='secondary'  style="padding: 6px 10px;">></h4>
    </button>
  </div>
</div>
<div style="font-size: 15px; margin-bottom: 5px;">
  <span class="see-more" style="cursor: pointer;" data-element=<%= "products-#{@location.id}" %>>See More +</span>
  &nbsp;|&nbsp;
  <%= link_to 'See All', location_automotive_listings_path(@location), class: 'see-all' %>
  &nbsp;|&nbsp;
  <%= link_to 'Manage', location_products_path(@location) %>
  &nbsp;|&nbsp;
  <%# TODO: Require connect to Stripe before add product %>
  <%# can_add_product = StripeService.new(@location).stripe_connect_status %>
  <%#= link_to 'Add', can_add_product ? new_location_product_path(@location, category_id: @category_id) : edit_location_path(@location), onclick: can_add_product ? nil : "return confirm('Please connect to Stripe before add products.\\nSelect eCommerce Store tab on your business page to add it.')" %>
  <%= link_to 'Add', new_location_product_path(@location, category_id: @category_id) %>
</div>
<% if @products.size > 0 %>
  <div class="row card-row media-row-holder" id="cat-products-<%= @location.id %>">
    <div id="loader" class="hide"></div>
    <div class="product-items row" style="margin-left: 0px; margin-right: 0px;">
      <% @products.each do |product| %>
        <% if product %>
          <div class="col-md-2">
            <div class="business-body-card">
              <div class="img">
                <%= link_to(image_tag(product.image.url(:list)), [@location, product]) %>
              </div>
              <div class="title" style="margin-bottom: 0px">
                <h3><%= link_to product.name, [@location, product] %></h3>
              </div>
              <p style="font-size: 13px; margin-bottom: 5px;" >$<%= product.price %></p>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="alert alert-dark" role="alert">
    No products found.
  </div>
<% end %>

<style>
  #loader {
    margin: auto;
    border: 5px solid #f3f3f3;
    border-top: 5px solid #555;
    border-radius: 50%;
    width: 50px;
    height: 50px;
    animation: spin 2s linear infinite;
  }

  .hide {
    display: none;
  }
</style>

<script type="text/javascript">
  $(document).ready(function () {
    var locationSlug = "<%= @location.slug %>";
    var max = <%= @categories.length %>

    var idxCurrent = +$('.category-tab h4.active').attr('data-index');
    <% if (@category_id === 'all') %>
      $('button.less-than').attr('disabled', true);
      $('button.less-than').find('h4').css('opacity', 0.5);
    <% else %>
      $('button.less-than').removeAttr('disabled');
      $('button.less-than').find('h4').css('opacity', 1);
    <% end %>

    if (idxCurrent === max) {
      $('button.more-than').attr('disabled', true)
      $('button.more-than').find('h4').css('opacity', 0.5);
    } else {
      $('button.more-than').removeAttr('disabled');
      $('button.more-than').find('h4').css('opacity', 1);
    }

    $('.category-tab').bind('click',function () {
      loading()
    })

    $('span.see-more').bind('click', function () {
      id = $(this).data('element')
      $('#cat-' + id).toggleClass('show')
      if($(this).html() == "See More +")
        $(this).html("See Less +")
      else
        $(this).html("See More +")
    })
    $('#less').bind('click', function(e) {
      loading()
      var categoryId = idxCurrent === 1 ? 'all' : +$(`.category-tab h4.secondary[data-index=${idxCurrent - 1}]`).attr('data-id')
      $(this).attr('disabled', true)
      $.get(`/business/${locationSlug}/products/specific/${categoryId}`)
        .done(function (response) {
          $(this).removeAttr('disabled')
        })
        .fail(function (jqXHR) { console.error(jqXHR.responseText); });
    })
    $('#more').bind('click', function(e) {
      loading()
      $('button.less-than').attr('disabled', idxCurrent === max);
      var categoryId = idxCurrent === max ? 'all' : +$(`.category-tab h4.secondary[data-index=${idxCurrent + 1}]`).attr('data-id')
      $(this).attr('disabled', true)
      $.get(`/business/${locationSlug}/products/specific/${categoryId}`)
        .done(function (response) {
          $(this).removeAttr('disabled')
        })
        .fail(function (jqXHR) { console.error(jqXHR.responseText); });
    })

    function loading() {
      $('#loader').removeClass('hide')
      $('.product-items').addClass('hide')
    }
  })
</script>

