<%= simple_form_for([@carouselable, @carousel_image]) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.input :title %>
    <%= f.input :caption, as: :text, input_html: { rows: 4, class: 'input-xxlarge' }, hint: 'If left blank a caption won\'t be shown' %>
    <%= f.input :image, as: :logo_preview, hint: 'Image needs to be 1600x500 in size. Otherwise it will be resized and cropped to fit those dimensions' %>
  </div>

  <div class="form-actions">
    <%= f.button :submit, class: 'btn btn-primary' %>
    <%= link_to 'Cancel', :back, class: 'btn' %>
  </div>
<% end %>
