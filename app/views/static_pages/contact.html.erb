<h1>Contact</h1>
<%= form_tag("/search", method: "get") do %>
  <%= label_tag(:q, "Name:") %>
  <%= text_field_tag(:q) %>
  <%= label_tag(:q, "Email:") %>
  <%= text_field_tag(:q) %>
  <%= label_tag(:q, "Your message") %>
  <%= text_area_tag(:q) %>
  <br /><br />
  <%= submit_tag("Send") %>
<% end %>