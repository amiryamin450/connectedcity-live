<div class="card-label-one">
  <div class="title">
    <h4>
      <% if is_food_and_dining(@location) %>
        Menus
      <% else %>
        Flyers
      <% end %>
    </h4>
    <% if (user_signed_in? and current_user.has_role? :admin) or (user_signed_in? and current_user.can_manage_location? @location) %>
      <small><%= link_to "add", new_location_location_menu_path(@location.id), class: 'small' %> | <%= link_to 'manage', location_location_menus_path(@location) %></small>
    <% end %>
  </div>
</div>
<% if @location_menu_images.any? %>
  <div class="row card-row">
    <div id="carouselExampleIndicators" class="carousel slide" data-ride="carousel">
      <ol class="carousel-indicators">
        <% @location_menu_images.each_with_index do |image, index| %>
          <li data-target="#carouselExampleIndicators" data-slide-to="<%=index%>" class="<%= index == 0 ? 'active' : ''  %>"></li>
        <% end %>
      </ol>
      <div class="carousel-inner">
        <% @location_menu_images.each_with_index do |menu_image, index| %>
          <div class="carousel-item <%= index == 0 ? 'active' : '' %>">
            <%= image_tag(menu_image.url, class: "d-block w-100") %>
          </div>
        <% end %>
      </div>
      <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="sr-only">Previous</span>
      </a>
      <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="sr-only">Next</span>
      </a>
    </div>
  </div>
<% else %>
  <div class="alert alert-dark" role="alert">
    No Brands found.
  </div>
<% end %>