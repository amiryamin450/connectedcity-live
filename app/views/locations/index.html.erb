<h1>Listing locations</h1>

<div class="pull-right">
  <%= link_to 'Show Pending Claims', pending_claims_locations_path %><br />
  <%= link_to 'Import Businesses', import_locations_path %>
  <%= link_to 'Export Businesses', export_locations_path %>
</div>
<%= search_form_for @search, class: 'form-search mb-3' do |f| %>
  <% @statuses_options = [
      ['Active', :active],
      ['In-Active', :in_active]
    ]
  %>
  <div class="input-append">
    <%= f.text_field :name_or_neighborhood_neighborhd_cont, class: 'search-query', id: 'business-search' %>
    <%= select_tag :status, options_for_select(@statuses_options, params[:status]), prompt: 'All', class: 'status-filter' %>
    <%= f.submit "Search", class: 'btn' %>
  </div>
<% end -%>

<div class="clearfix"></div>

<%= form_tag bulk_delete_locations_path, class: 'businesses-form' do %>
  <div class="p-3 d-flex justify-content-between header-actions">
    <div class="buttons-group">
      <%= link_to 'New Location', new_location_path, class: 'btn btn-primary' %>
      <%= submit_tag "Delete selected Businesses", class: 'btn btn-danger' %>
    </div>
    <div class="filter">
      <!--<% select_tag :per_page, collection: [25, 50, 100] %>-->
    </div>
  </div>

  <table class="table table-striped table-compact table-bordered">
    <tr>
      <th>
        <%= check_box_tag :selecte_all, false, false %>
      </th>
      <th><%= sort_link(@search, :name, "Name") %></th>
      <th><%= sort_link(@search, :status, "Active") %></th>
      <th><%= sort_link(@search, :address, "Address") %></th>
      <th><%= sort_link(@search, :city_cdname, "City") %></th>
      <th><%= sort_link(@search, :province_province_code, "State") %></th>
      <th><%= sort_link(@search, :district_name, "District") %></th>
      <th><%= sort_link(@search, :neighborhood_neighborhd, "Neighborhood") %></th>
      <th><%= sort_link(@search, :postal_code, "Postal Code") %></th>
      <th><%= sort_link(@search, :country_country_code, "Country") %></th>
      <th>Category</th>
      <th>Sub-Category</th>
      <th>Sub-Sub Category</th>
      <th></th>
    </tr>

    <% @locations.each do |location| %>
      <% @sub_sub_categories = location.vertical_market_categories %>
      <% @vertical_markets = location.vertical_markets %>
      <% @sub_categories = @vertical_markets %>
      <% @categories = @vertical_markets.map(&:ancestors).flatten.uniq %>

        <tr>
          <td>
            <%= check_box_tag "location_ids[]", location.id, false %>
          </td>
          <td><%= location.name %></td>
          <td><%= location.active? %></td>
          <td><%= location.address %></td>
          <td><%= location.city.name if location.city.present? %></td>
          <td><%= location.province.province_code if location.province %></td>
          <td><%= location.district&.name %></td>
          <td><%= location.neighborhood&.neighborhd %></td>
          <td><%= location.postal_code %></td>
          <td><%= location.country.country_code if location.country %></td>
          <td>
            <% @categories.map do |c| %>
              <p><%= c.name %></p>
            <% end %>
          </td>
          <td>
            <% @sub_categories.map do |sc| %>
              <p><%= sc.name %></p>
            <% end %>
          </td>
          <td>
            <% @sub_sub_categories.map do |ssc| %>
              <p><%= ssc.name %></p>
            <% end %>
          </td>
          <td>
            <div class="btn-group">
              <%= link_to 'Show', location, :class => 'btn btn-mini' %>
              <%= link_to 'Edit', edit_location_path(location), :class => 'btn btn-mini' %>
              <% if location.active? %>
                <%= link_to 'In-Active', update_status_location_path(location, :in_active), :class => 'btn btn-mini' %>
              <% else %>
                <%= link_to 'Active', update_status_location_path(location, :active), :class => 'btn btn-mini' %>
              <% end %>
              <%= link_to 'Destroy', location, method: :delete, data: {confirm: 'Are you sure?'}, :class => 'btn btn-mini' %>
            </div>
          </td>
        </tr>
    <% end %>
  </table>
<% end %>

<div class="d-flex justify-content-center location-paginate">
  <%= paginate @locations %>
</div>

<script>
  $(document).ready(function() {
    $('#selecte_all').on('change', function(){
      current_locations =  $('input[name="location_ids[]"]')
      if (current_locations.length < 1) return

      if (this.checked) {        
        current_locations.prop('checked', true);
      } else {
        current_locations.prop('checked', false);
      }
    })
  })
</script>