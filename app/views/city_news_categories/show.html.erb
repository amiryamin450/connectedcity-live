<%

meta title: "#{@neighborhood.try(:name) || @district.try(:name) || @city.try(:name)} #{@city_news_category.name} City News".strip,
     description: "",
     canonical: url_for(Rails.application.routes.recognize_path(request.path).merge({only_path: false, protocol: 'https'}))

%>

<h1>Classifieds - <%= @city_news_category.name %> </h1>

<% if @city_news_category.city_news_articles.size > 0 %>
<div class="row-fluid classified-category">
  <div class="row-fluid classified-header" style="background-color: <%= "#{@city_news_category.heading_color}" %>">

    <div class="span12 head-cell"><%= @city_news_category.name %></div>
  </div>

  <% @city_news_category.city_news_articles.each do |listing| %>
  <div class="row-fluid classified-detail-row" style="border-color: <%= @city_news_category.heading_color %>">
    <div class="span12" style="border-color: <%= @city_news_category.heading_color %>"><%= link_to listing.title, listing %></div>
  </div>
  <% end -%>

</div>
<% end -%>
